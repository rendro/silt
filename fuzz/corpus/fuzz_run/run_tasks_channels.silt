import channel
import list
import task

fn main() {
  let ch = channel.new(2)
  let producer = { ->
    list.each([1, 2, 3, 4, 5]) { n -> channel.send(ch, n * n) }
    channel.close(ch)
  }
  let total = task.background([producer]) { ->
    let go = { acc ->
      match channel.receive(ch) {
        Some(n) -> go(acc + n)
        None -> acc
      }
    }
    go(0)
  }
  println(total)
  println("produced")
  let values = task.map([1, 2, 3], 3) { n -> n * 10 }
  let _ = list.fold(values, 0) { acc, v -> acc + v }
}
