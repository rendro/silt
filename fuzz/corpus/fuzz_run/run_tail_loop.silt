fn sum_to(n) {
  let go = { i, acc ->
    match i > n {
      true -> acc
      false -> go(i + 1, acc + i)
    }
  }
  go(0, 0)
}

fn count_down(n, acc) {
  match n {
    0 -> acc
    _ -> count_down(n - 1, acc + 1)
  }
}

deep fn fib(n) {
  match n < 2 {
    true -> n
    false -> fib(n - 1) + fib(n - 2)
  }
}

fn main() {
  println(sum_to(1000))
  println(count_down(5000, 0))
  let _ = fib(15)
}
