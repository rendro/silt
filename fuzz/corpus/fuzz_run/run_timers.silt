import channel
import task
import time

fn main() {
  let ch = channel.new(0)
  let sleeper = { ->
    time.sleep(time.ms(5))
    channel.send(ch, "late")
  }
  let first = task.background([sleeper]) { -> channel.receive_timeout(ch, time.seconds(2)) }
  println(first)
  let _ = task.deadline(time.seconds(1), { -> 1 + 1 })
}
