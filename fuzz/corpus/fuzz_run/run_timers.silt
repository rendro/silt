import channel
import task
import time

fn main() {
  let ch = channel.new(0)
  let sleeper = task.spawn({ ->
    time.sleep(time.ms(5))
    channel.send(ch, "late")
  })
  let first = channel.recv_timeout(ch, time.seconds(2))
  println(first)
  task.join(sleeper)
  task.deadline(time.seconds(1), { -> 1 + 1 })
}
