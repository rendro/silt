import http
import int
import json
import list
import string
import tcp

-- A minimal JSON API server demonstrating pattern-matched routing.

type Todo {
  id: Int,
  title: String,
  done: Bool,
}

fn json_response(status, data) {
  http.Response {
    status: status,
    body: json.stringify(data),
    headers: #{ "Content-Type": "application/json" },
  }
}

fn main() {
  -- 127.0.0.1: reached from this machine only. "0.0.0.0:8080" would
  -- serve on every network interface.
  when let Ok(listener) = tcp.listen("127.0.0.1:8080") else {
    panic("cannot listen on port 8080")
  }
  println("Listening on http://localhost:{tcp.local_port(listener)}")
  http.serve(listener) { req ->
    let segments = string.split(req.path, "/") |> list.filter { s -> !string.is_empty(s) }
    match (req.method, segments) {
      (http.GET, []) -> http.Response { status: 200, body: "Welcome to silt!", headers: #{} }
      (http.GET, ["todos"]) -> {
        let todos = [
          Todo { id: 1, title: "Learn silt", done: true },
          Todo { id: 2, title: "Build an API", done: false },
        ]
        json_response(200, todos)
      }
      (http.POST, ["todos"]) -> match json.parse(req.body, Todo) {
        Ok(todo) -> json_response(201, todo)
        Err(e) -> json_response(400, #{ "error": e.message() })
      }
      (http.GET, ["todos", id_str]) -> match int.parse(id_str) {
        Ok(id) -> json_response(200, Todo { id: id, title: "Todo {id}", done: false })
        Err(_) -> json_response(400, #{ "error": "invalid id" })
      }
      (http.DELETE, ["todos", _]) -> http.Response { status: 204, body: "", headers: #{} }
      _ -> http.Response { status: 404, body: "Not found", headers: #{} }
    }
  }
}
