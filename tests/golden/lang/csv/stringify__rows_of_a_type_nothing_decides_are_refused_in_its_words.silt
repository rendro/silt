-- cmd: check
-- exit: 1
-- Rows whose type a use leaves undecided (the parameter of `Ph` here) are
-- refused in the words of a writer: csv.stringify decodes nothing. The use
-- is named as the program writes it, in a call and in a pipe.
import csv as c

type Ph(a) { n: Int }

fn main() {
  println(c.stringify([Ph { n: 1 }]))
  println([Ph { n: 1 }] |> c.stringify)
}
