type C { c: Color }
type D { v: json.Value }
type E { o: Option(Option(Int)) }
type F { m: Map(String, Int) }
type W { n: Int }
trait json.Decode for W {
  fn decode(value: json.Value) -> Result(W, json.JsonError) { Ok(W { n: 1 }) }
}
fn main() {
  let _ = csv.parse("", A)
  let _ = csv.parse("", B)
  let _ = csv.parse("", C)
  let _ = csv.parse("", D)
  let _ = csv.parse("", E)
  let _ = csv.parse("", F)
  let _ = csv.parse("", W)
  let _ = csv.parse("", Int)
  let _ = csv.parse("", List(Inner))
  let _ = csv.parse("", Color)
}
