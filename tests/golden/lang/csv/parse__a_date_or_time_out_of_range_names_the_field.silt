-- A cell written as a date or a time whose field is out of its range says
-- which field, as time.parse_date does; only a cell not written so says how
-- a date or a time is written, and a text not in the shape of the type keeps
-- that hint whatever its fields hold (11-23-2026, 930). A date and time
-- ending in Z says its field as one with +00:00 does.
import csv
import json
import time
import toml

type U {
  id: String,
  signup: time.Date,
}

type T {
  at: time.Time,
  when: time.DateTime,
}

fn main() {
  println(csv.parse("id,signup\nu1,2025-03-09\nu2,2025-13-01\n", U))
  println(csv.parse("id,signup\nu2,2026-02-30\n", U))
  println(csv.parse("id,signup\nu2,2026/02/03\n", U))
  println(csv.parse("at,when\n25:00,2026-01-01T00:00\n", T))
  println(csv.parse("at,when\n12:00,2026-01-01T24:00\n", T))
  println(csv.parse("at,when\nnoon,2026-01-01T00:00\n", T))
  println(json.parse("""{"id": "u", "signup": "2026-11-31"}""", U))
  println(json.parse("""{"at": "12:00", "when": "2026-11-01T08:00:00+24:00"}""", T))
  println(csv.parse("id,signup\nu2,11-23-2026\n", U))
  println(csv.parse("at,when\n930,2026-01-01T00:00\n", T))
  println(json.parse("""{"at": "12:00", "when": "2026-02-30T10:00:00Z"}""", T))
  println(toml.parse("at = \"12:00\"\nwhen = 2026-02-30T10:00:00Z\n", T))
  println(json.parse("""{"at": "12:00", "when": "11-23-2026 10:00"}""", T))
}
