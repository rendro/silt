import list

trait Deep { fn go(self) -> Int }
trait Deep for Int {
  fn go(self) -> Int {
    match self {
      0 -> 0
      _ -> 1 + Deep.go(self - 1)
    }
  }
}


fn deep(n) {
  match n {
    0 -> 0
    _ -> list.fold([1], 0) { acc, x -> acc + x + deep(n - 1) }
  }
}

fn main() {
  println("method {Deep.go(500)}")
  println("fold {deep(500)}")
}
