-- repeat: 3
import list
import task
import time
deep fn nest(level, round) {
  match level {
    0 -> {
      time.sleep(time.ms(1))
      round
    }
    _ -> list.fold([1], 0) { acc, x -> acc + nest(level - 1, round) }
  }
}
fn main() {
  let t = task.map([0], 1) { _ ->
    list.fold(1..40, 0) { total, round -> total + nest(5, round) }
  }
  list.each(t) { v -> println(v) }
}
