-- Same as the qualified-global case, through a function stored in a
-- record field and called as `r.bump()`.
import io
import task

fn make_bump() -> Fn() -> Int {
  fn() {
    println("before-io")
    let _ = io.read_file("round77-no-such-file.txt")
    println("after-io")
    1
  }
}

type Holder { bump: Fn() -> Int }

fn main() {
  let h = task.spawn(fn() {
    let r = Holder { bump: make_bump() }
    r.bump()
  })
  println(task.join(h))
}
