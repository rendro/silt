-- A direct io.read_file call (Op::CallBuiltin) inside a spawned task.
-- direct call
import io
import string
import task

fn main() {
  let h = task.spawn({ -> io.read_file("indirect_builtin_call__direct_read_file_in_spawned_task.silt") })
  match task.join(h) {
    Ok(s) -> println(string.contains(s, "-- direct call"))
    Err(e) -> println(e.message())
  }
}
