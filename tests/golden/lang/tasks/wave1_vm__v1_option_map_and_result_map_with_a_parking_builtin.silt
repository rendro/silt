-- repeat: 5
import channel
import option
import result
import task
import time
fn pair(x, y) { (x, y) }
fn main() {
  let a = channel.new(1)
  let b = channel.new(1)
  let sender = { ->
    time.sleep(time.ms(50))
    channel.send(a, 1)
    time.sleep(time.ms(20))
    channel.send(b, 2)
  }
  let worker = { ->
    println(pair("option", option.map(Some(a), channel.receive)))
    println(pair("result", result.map(Ok(b), channel.receive)))
  }
  task.join([sender, worker])
}
