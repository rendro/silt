-- io.write_file bound to a variable and called indirectly inside a spawned
-- task; the main thread then reads the file back.
import io
import task

fn main() {
  let write = io.write_file
  let h = task.spawn({ -> write("indirect_write.txt", "written indirectly") })
  match task.join(h) {
    Ok(_) -> println("ok")
    Err(e) -> println(e.message())
  }
  match io.read_file("indirect_write.txt") {
    Ok(s) -> println(s)
    Err(e) -> println(e.message())
  }
}
