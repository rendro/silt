-- cmd: test
-- exit: 1
-- stderr-contains: stack overflow: recursion depth exceeded 100000 frames
-- stderr-not-contains: overflowed its stack
-- stderr-contains: 2 tests: 1 passed, 1 failed, 0 skipped
-- stderr-contains: FAIL wave1_vm__v2_a_test_run_continues_after_the_overflow.silt::test_a_recursion_far_beyond_the_budget
-- stderr-contains: PASS wave1_vm__v2_a_test_run_continues_after_the_overflow.silt::test_b_moderate_recursion_afterwards
import test

-- (The method is called on a value of a bounded type variable: the VM
-- finds it by the value's type and runs it in a nested loop.)
trait Deep { fn go(self) -> Int }
fn next(x: a) -> Int where a: Deep { x.go() }
trait Deep for Int {
  fn go(self) -> Int {
    match self {
      0 -> 0
      _ -> 1 + next(self - 1)
    }
  }
}

fn test_a_recursion_far_beyond_the_budget() {
  test.assert_eq(200000.go(), 200000)
}
fn test_b_moderate_recursion_afterwards() {
  test.assert_eq(500.go(), 500)
}
