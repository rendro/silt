-- repeat: 5
import channel
import task
import time
fn outer(g, y) { "outer called" }
fn inner(c, y) { "INNER called instead" }
fn main() {
  let worker = { ->
    let groups = channel.new(4)
    channel.send(groups, [{ -> time.sleep(time.ms(30)) }])
    channel.send(groups, [{ -> time.sleep(time.ms(30)) }])
    channel.close(groups)
    println(outer(inner, channel.each(groups, task.join)))
  }
  task.join([worker])
}
