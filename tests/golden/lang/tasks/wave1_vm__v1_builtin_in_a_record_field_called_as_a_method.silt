-- repeat: 5
import channel
import task
import time
type R { recv: Fn(Channel(Int)) -> Option(Int) }
fn outer(g, y) { "outer called with {y}" }
fn inner(c, y) { "INNER called instead" }
fn main() {
  let a = channel.new(1)
  let sender = { ->
    time.sleep(time.ms(50))
    channel.send(a, 1)
  }
  let worker = { ->
    let r = R { recv: channel.receive }
    println(outer(inner, r.recv(a)))
  }
  task.join([sender, worker])
}
