-- repeat: 5
import channel
import list
import task
import time
fn pair(x, ys) { (x, ys) }
fn main() {
  let a = channel.new(1)
  let b = channel.new(1)
  let sender = { ->
    time.sleep(time.ms(50))
    channel.send(a, 1)
    time.sleep(time.ms(20))
    channel.send(b, 2)
  }
  task.join([sender, { -> println(pair("x", list.map([a, b], channel.receive))) }])
}
