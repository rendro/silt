-- exit: 1
-- stderr-contains: error[runtime]
-- frame-budget: 1
-- stderr-contains: stack overflow: call frames take more than 1 MiB
-- stderr-not-contains: overflowed its stack
import task

trait Deep { fn go(self) -> Int }
trait Deep for Int {
  fn go(self) -> Int {
    match self {
      0 -> 0
      _ -> 1 + Deep.go(self - 1)
    }
  }
}

fn main() {
  println(task.map([200000], 1) { n -> Deep.go(n) })
}
