-- exit: 1
-- stderr-contains: error[runtime]
-- stderr-contains: stack overflow: recursion depth exceeded
-- stderr-not-contains: overflowed its stack
-- (The method is called on a value of a bounded type variable: the VM
-- finds it by the value's type and runs it in a nested loop.)
trait Deep { fn go(self) -> Int }
fn next(x: a) -> Int where a: Deep { x.go() }
trait Deep for Int {
  fn go(self) -> Int {
    match self {
      0 -> 0
      _ -> 1 + next(self - 1)
    }
  }
}

fn main() {
  println(50000.go())
}
