-- repeat: 5
import channel
import list
import task
import time
fn pair(x, y) { (x, y) }
fn main() {
  let a = channel.new(1)
  let b = channel.new(1)
  let sender = task.spawn { ->
    time.sleep(time.ms(50))
    channel.send(a, 1)
    time.sleep(time.ms(20))
    channel.send(b, 2)
  }
  let worker = task.spawn { ->
    let drain = { c ->
      let m = channel.receive(c)
      println("received {m}")
      c
    }
    let chans = list.fold([drain], [a, b], list.map)
    pair("x", list.length(chans))
  }
  println(task.join(worker))
  task.join(sender)
}
