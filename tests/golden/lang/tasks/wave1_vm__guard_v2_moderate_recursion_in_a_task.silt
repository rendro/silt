-- repeat: 3
import list
import task

trait Deep { fn go(self) -> Int }
trait Deep for Int {
  fn go(self) -> Int {
    match self {
      0 -> 0
      _ -> 1 + Deep.go(self - 1)
    }
  }
}


fn deep(n) {
  match n {
    0 -> 0
    _ -> list.fold([1], 0) { acc, x -> acc + x + deep(n - 1) }
  }
}

fn main() {
  let a = task.map([6], 1) { n -> Deep.go(n) }
  let b = task.map([6], 1) { n -> deep(n) }
  list.each(a) { v -> println("method {v}") }
  list.each(b) { v -> println("fold {v}") }
}
