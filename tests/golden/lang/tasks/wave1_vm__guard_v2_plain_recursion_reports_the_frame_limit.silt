-- exit: 1
-- stderr-contains: error[runtime]
-- frame-budget: 1
-- stderr-contains: stack overflow: call frames take more than
-- stderr-not-contains: overflowed its stack
-- stderr-contains: stack overflow: call frames take more than 1 MiB; this task holds 1 MiB
fn deep(n) {
  match n {
    0 -> 0
    _ -> 1 + deep(n - 1)
  }
}
fn main() {
  println(deep(200000))
}
