-- exit: 3
-- `main` may return (), Result((), e), or never return: a main that
-- ends the program itself with `process.exit`.
import process

fn unit() {
  println("unit")
}

fn ok() -> Result((), String) {
  println("ok")
  Ok(())
}

fn main() {
  unit()
  match ok() {
    Ok(()) -> process.exit(3)
    Err(e) -> panic(e)
  }
}
