-- cmd: check
-- exit: 1
-- `import Shape` is refused (a module name is all lowercase), and a
-- local type has its name: `Shape.describe(s)` reports nothing about
-- the module, which is never read.
-- stderr-not-contains: on module
-- stderr-contains: `Shape` is not a valid module name
import Shape

type Shape { sides: Int }

trait Describe {
  fn describe(self) -> String
}

trait Describe for Shape {
  fn describe(self) -> String = "TRAIT method on Shape with {self.sides} sides"
}

fn main() {
  let s = Shape { sides: 4 }
  println(s.describe())
  println(Shape.describe(s))
  println(Shape.other(s))
}
