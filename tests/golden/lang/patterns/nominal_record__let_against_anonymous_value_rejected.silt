-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: record pattern requires a record value, but '{a: Int, b: Int}' is not a record type
-- A `let` has no branch for a value of another record type with the same
-- fields: a pattern that names a record type needs a value of that type.
type P { a: Int, b: Int }
type Q { a: Int, b: Int }
fn k(r: {a: Int, b: Int}) -> Int {
  let Q { b, .. } = r
  b
}
fn main() {
  println(k(P { a: 1, b: 2 }))
}
