-- Eleven pairs of Bool columns, each pair covered by four arms that leave
-- the other twenty columns alone: exhaustive, and seen to be at once (the
-- columns are not gone through from left to right).
fn f(v: (Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool)) -> Int {
  match v {
    (true, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _) -> 0
    (true, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _) -> 1
    (false, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _) -> 2
    (false, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _) -> 3
    (_, true, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _) -> 4
    (_, true, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _) -> 5
    (_, false, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _) -> 6
    (_, false, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _) -> 7
    (_, _, true, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _) -> 8
    (_, _, true, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _) -> 9
    (_, _, false, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _) -> 10
    (_, _, false, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _) -> 11
    (_, _, _, true, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _) -> 12
    (_, _, _, true, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _) -> 13
    (_, _, _, false, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _) -> 14
    (_, _, _, false, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _) -> 15
    (_, _, _, _, true, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _) -> 16
    (_, _, _, _, true, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _) -> 17
    (_, _, _, _, false, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _) -> 18
    (_, _, _, _, false, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _) -> 19
    (_, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _) -> 20
    (_, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _) -> 21
    (_, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _) -> 22
    (_, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _) -> 23
    (_, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _) -> 24
    (_, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _) -> 25
    (_, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, true, _, _, _, _) -> 26
    (_, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, false, _, _, _, _) -> 27
    (_, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, true, _, _, _) -> 28
    (_, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, false, _, _, _) -> 29
    (_, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, true, _, _, _) -> 30
    (_, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, false, _, _, _) -> 31
    (_, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, true, _, _) -> 32
    (_, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, false, _, _) -> 33
    (_, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, true, _, _) -> 34
    (_, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, false, _, _) -> 35
    (_, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, true, _) -> 36
    (_, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, false, _) -> 37
    (_, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, true, _) -> 38
    (_, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, false, _) -> 39
    (_, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, true) -> 40
    (_, _, _, _, _, _, _, _, _, _, true, _, _, _, _, _, _, _, _, _, _, false) -> 41
    (_, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, true) -> 42
    (_, _, _, _, _, _, _, _, _, _, false, _, _, _, _, _, _, _, _, _, _, false) -> 43
  }
}
fn main() { println(f((true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true))) }
