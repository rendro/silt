-- Against a value typed as an anonymous record, a pattern that names a
-- record type is a test of the value's type: it is not taken for a value
-- of another record type with the same fields, in an arm or a `when let`.
type P { a: Int, b: Int }
type Q { a: Int, b: Int }
fn f(r: {a: Int, b: Int}) -> Int {
  match r {
    Q { a, .. } -> a + 100
    _ -> 0
  }
}
fn h(r: {a: Int, b: Int}) -> Int {
  when let Q { a, .. } = r else { return -1 }
  a
}
fn which(r: {a: Int, b: Int}) -> String {
  match r {
    P { .. } -> "P"
    Q { .. } -> "Q"
    _ -> "neither"
  }
}
fn main() {
  println(f(P { a: 1, b: 2 }))
  println(f(Q { a: 1, b: 2 }))
  println(h(P { a: 1, b: 2 }))
  println(h(Q { a: 1, b: 2 }))
  println(which(P { a: 1, b: 2 }))
  println(which(Q { a: 1, b: 2 }))
}
