-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: non-exhaustive match
-- Patterns that name record types do not cover a value typed as an
-- anonymous record: it may be of a third type, or of none.
type P { a: Int, b: Int }
type Q { a: Int, b: Int }
fn which(r: {a: Int, b: Int}) -> String {
  match r {
    P { .. } -> "P"
    Q { .. } -> "Q"
  }
}
fn main() {
  println(which({a: 1, b: 2}))
}
