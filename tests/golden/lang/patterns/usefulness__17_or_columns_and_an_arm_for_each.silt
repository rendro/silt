-- One arm with `A | B` in each of 17 columns and one arm for `C` in each
-- column: exhaustive. The two alternatives of a column leave the same
-- rows, which are looked at once.
type T { A, B, C }
fn f(v: (T, T, T, T, T, T, T, T, T, T, T, T, T, T, T, T, T)) -> Int {
  match v {
    (A | B, A | B, A | B, A | B, A | B, A | B, A | B, A | B, A | B, A | B, A | B, A | B, A | B, A | B, A | B, A | B, A | B) -> 0
    (C, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> 1
    (_, C, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> 2
    (_, _, C, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> 3
    (_, _, _, C, _, _, _, _, _, _, _, _, _, _, _, _, _) -> 4
    (_, _, _, _, C, _, _, _, _, _, _, _, _, _, _, _, _) -> 5
    (_, _, _, _, _, C, _, _, _, _, _, _, _, _, _, _, _) -> 6
    (_, _, _, _, _, _, C, _, _, _, _, _, _, _, _, _, _) -> 7
    (_, _, _, _, _, _, _, C, _, _, _, _, _, _, _, _, _) -> 8
    (_, _, _, _, _, _, _, _, C, _, _, _, _, _, _, _, _) -> 9
    (_, _, _, _, _, _, _, _, _, C, _, _, _, _, _, _, _) -> 10
    (_, _, _, _, _, _, _, _, _, _, C, _, _, _, _, _, _) -> 11
    (_, _, _, _, _, _, _, _, _, _, _, C, _, _, _, _, _) -> 12
    (_, _, _, _, _, _, _, _, _, _, _, _, C, _, _, _, _) -> 13
    (_, _, _, _, _, _, _, _, _, _, _, _, _, C, _, _, _) -> 14
    (_, _, _, _, _, _, _, _, _, _, _, _, _, _, C, _, _) -> 15
    (_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, C, _) -> 16
    (_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, C) -> 17
  }
}
fn main() { println(f((A, A, A, A, A, A, A, A, A, A, A, A, A, A, A, A, C))) }
