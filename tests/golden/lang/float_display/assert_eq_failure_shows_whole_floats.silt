-- cmd: test
-- exit: 1
-- stderr-contains: assertion failed: 1.0 != 2.0
-- stderr-contains: assertion failed: [1.0, 2.5] != [1.0, 3.0]
-- stderr-contains: assertion failed: 4.0 == 4.0
-- A failed `test.assert_eq` writes both values as a program writes them.
import test

fn test_whole_floats_differ() {
  test.assert_eq(1.0, 2.0)
}

fn test_lists_of_floats_differ() {
  test.assert_eq([1.0, 2.5], [1.0, 3.0])
}

fn test_a_float_is_itself() {
  test.assert_ne(4.0, 4.0)
}
