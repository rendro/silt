-- A function bounded by a trait of type constructors (`where m:
-- Functor`) runs over every type with an impl: a program's own types,
-- Option, Result with any error type, and a type whose impl asks a trait
-- of its fixed argument (`Tagged(_, t) where t: Named`), whose impl is
-- passed on with that trait's.
trait Named {
  fn name(self) -> String
}
trait Named for Int {
  fn name(self) -> String { "int {self}" }
}
trait Functor {
  fn map(xs: Self(a), f: Fn(a) -> b) -> Self(b)
}
type Box(a) { value: a }
trait Functor for Box(_) {
  fn map(xs, f) { Box { value: f(xs.value) } }
}
trait Functor for Option(_) {
  fn map(xs, f) {
    match xs {
      Some(x) -> Some(f(x))
      None -> None
    }
  }
}
trait Functor for Result(_, e) {
  fn map(xs, f) {
    match xs {
      Ok(x) -> Ok(f(x))
      Err(e) -> Err(e)
    }
  }
}
type Tagged(a, t) { value: a, tag: t }
trait Functor for Tagged(_, t) where t: Named {
  fn map(x, f) {
    println(Named.name(x.tag))
    Tagged { value: f(x.value), tag: x.tag }
  }
}
fn double_all(xs: m(Int)) -> m(Int) where m: Functor {
  Functor.map(xs) { x -> x * 2 }
}
fn quadruple(xs: m(Int)) -> m(Int) where m: Functor {
  double_all(double_all(xs))
}
fn shown(xs: m(Int)) -> m(String) where m: Functor {
  Functor.map(xs) { x -> "<{x}>" }
}
fn main() {
  println(double_all(Box { value: 3 }).value)
  println(double_all(Some(4)))
  let none: Option(Int) = None
  println(double_all(none))
  let ok: Result(Int, String) = Ok(5)
  println(double_all(ok))
  let err: Result(Int, Int) = Err(9)
  println(double_all(err))
  println(quadruple(Some(1)))
  println(shown(Some(1)))
  println(quadruple(Tagged { value: 1, tag: 7 }).value)
}
