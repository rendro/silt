-- A function without annotations that calls a method of a trait of type
-- constructors is generic over the constructor, its bound inferred; a
-- trait's default body calls its methods through the trait on `Self(a)`.
trait Mapping {
  fn map(xs: Self(a), f: Fn(a) -> b) -> Self(b)
  fn replace(xs: Self(a), y: b) -> Self(b) {
    Mapping.map(xs) { _ -> y }
  }
}
type Box(a) { value: a }
trait Mapping for Box(_) {
  fn map(xs, f) { Box { value: f(xs.value) } }
}
trait Mapping for Option(_) {
  fn map(xs, f) {
    match xs {
      Some(x) -> Some(f(x))
      None -> None
    }
  }
}
fn twice(xs) { Mapping.map(xs) { x -> x * 2 } }
fn four_times(xs) { twice(twice(xs)) }
fn main() {
  println(twice(Some(3)))
  println(twice(Box { value: 3 }).value)
  println(four_times(Some(1)))
  println(Mapping.replace(Some(1), "x"))
  println(Mapping.replace(Box { value: 1 }, true).value)
}
