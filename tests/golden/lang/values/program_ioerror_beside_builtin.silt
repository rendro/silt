-- A program's type named like the builtin io.IoError, with impls of its
-- own: its impls do not replace the builtin type's, and each prints as
-- itself (`println` of a value shows its fields; `.display()` runs the
-- impl).
import io

type IoError { Oops(String) }

trait Error for IoError {
  fn message(self) -> String {
    match self {
      Oops(m) -> "mine: {m}"
    }
  }
}

trait Display for IoError {
  fn display(self) -> String { "my IoError" }
}

fn main() {
  let mine = Oops("x")
  println(mine.message())
  println(mine.display())
  println(mine)
  match io.read_file("does-not-exist.txt") {
    Ok(_) -> println("read")
    Err(e) -> {
      println(e.message())
      println(e.display())
      println(e)
    }
  }
}
