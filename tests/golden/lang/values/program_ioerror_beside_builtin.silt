-- A program's type named like the builtin io.IoError, with a Display
-- impl of its own: the impl does not replace the builtin type's, and
-- each prints as itself.
import io

type IoError { Oops(String) }

trait Display for IoError {
  fn display(self) -> String { "my IoError" }
}

fn main() {
  let mine = Oops("x")
  println("{mine}")
  println(mine)
  match io.read_file("does-not-exist.txt") {
    Ok(_) -> println("read")
    Err(e) -> {
      println("{e}")
      println(e)
    }
  }
}
