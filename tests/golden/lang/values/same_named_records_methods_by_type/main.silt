-- Two modules' record types of one name, Pt, each with its own impls of
-- a builtin trait and of a trait of one name: interpolation, a call
-- through each module's trait (`a.Scale.scale(p)`) and that method as a
-- value run the impl of the value's own type, which the VM finds by the
-- type's id.
import a
import b
fn main() {
  let p = a.make(1)
  let q = b.make(2)
  println("{p}")
  println("{q}")
  println(a.Scale.scale(p))
  println(b.Scale.scale(q))
  let scale_a = a.Scale.scale
  let scale_b = b.Scale.scale
  println(scale_a(p) + scale_b(q))
}
