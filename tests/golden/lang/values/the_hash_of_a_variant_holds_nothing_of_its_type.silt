-- The hash of a variant is which variant of its type it is, and its
-- fields: nothing of the type. Two enums that are declared alike hash
-- alike, variant for variant. (The hash held the id of the type, a
-- number that depends on how many types are declared before it: a
-- type added to a program changed the hash of every value of the
-- enums after it, and so did a builtin type added to silt.)
type Here {
  Dot,
  Box(Int, Int),
}

type Between {
  v: Int,
}

type There {
  Point,
  Rect(Int, Int),
}

fn main() {
  println(Hash.hash(Dot) == Hash.hash(Point))
  println(Hash.hash(Box(3, 4)) == Hash.hash(Rect(3, 4)))
  println(Hash.hash([Box(3, 4), Dot]) == Hash.hash([Rect(3, 4), Point]))
  -- Which variant it is, and its fields, are in the hash.
  println(Hash.hash(Dot) == Hash.hash(Box(0, 0)))
  println(Hash.hash(Box(3, 4)) == Hash.hash(Box(4, 3)))
  println(Hash.hash(Between { v: 1 }) == Hash.hash(Between { v: 1 }))
}
