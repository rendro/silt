-- Two enums of one module share the variant Circle; each value runs its
-- own type's Display impl (F1).
type Shape { Circle(Int), Sq }
trait Display for Shape { fn display(self) -> String { "A-shape" } }
type Form { Circle(Int), Tri(Int) }
trait Display for Form { fn display(self) -> String { "B-form" } }
fn show(x: t) -> String where t: Display { x.display() }
fn main() {
  println(Shape.Circle(1).display())
  println(Form.Circle(1).display())
  println(show(Shape.Circle(1)))
}
