-- cmd: check
-- exit: 1
-- stderr-contains: error[parse]: record field 'B' starts with a capital: a record's fields start with a lower-case letter
-- stderr-contains: help: write `b: Int`
-- stderr-contains: help: write `http_code: List(Int)`
-- stderr-not-contains: 'c'
-- stderr-not-contains: error[type]
-- Every field of a record starts lower case, not only the first one,
-- which tells a record from an enum. The field goes on under its
-- lower-case name, so its uses raise no more errors.
type T {
  a: Int,
  B: Int,
  c: Int,
  HTTPCode: List(Int),
}

fn main() {
  println(T { a: 1, b: 2, c: 3, http_code: [] })
}
