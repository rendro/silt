-- cmd: check
-- exit: 1
-- stderr-contains: help: write `url: String`
-- stderr-contains: help: write `http_code: Int`
-- stderr-contains: help: write `date_time: String`
-- The help writes the field in snake case, as record fields are written:
-- an acronym is one word, and each capital that starts a word after the
-- first starts a word behind an underscore.
type Link {
  URL: String,
}

type Reply {
  HTTPCode: Int,
}

type Stamp {
  DateTime: String,
}

fn main() {
  println(Link { url: "x" })
  println(Reply { http_code: 1 })
  println(Stamp { date_time: "t" })
}
