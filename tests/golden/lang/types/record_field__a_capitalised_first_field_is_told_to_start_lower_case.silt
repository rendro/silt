-- cmd: check
-- exit: 1
-- stderr-contains: error[parse]: a record field's name starts with a lower-case letter, so 'Date' reads as an enum variant
-- stderr-contains: help: write `date: String`
-- stderr-not-contains: enum variant list
-- A record whose first field is spelled with a capital (a CSV header
-- copied as it is) was read as an enum and refused at the `:`; the error
-- says field names start lower case and writes the field so.
type Row {
  Date: String,
  Amount: String,
}

fn main() {
  println(Row { date: "x", amount: "y" })
}
