-- `.encode()` of a value whose type has `json.Encode` is a `json.Value`,
-- by a concrete type and through a bound, and a value of a type without
-- the trait has no such method. (It was taken as of any type.)
import json

type Money { cents: Int }

fn main() {
  let a: Int = 5.encode()
  let b: json.Value = Money { cents: 1 }.encode()
  println(b)
}

fn via(x: a) -> Int where a: json.Encode { x.encode() }

fn f() { { x -> x }.encode() }
