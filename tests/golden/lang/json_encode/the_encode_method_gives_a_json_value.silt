-- `json.Encode.encode` of a value whose type has the trait is a
-- `json.Value`, by a concrete type and through a bound; a dot after a
-- value is a field. (It was taken as of any type.)
import json

type Money { cents: Int }

fn main() {
  let a: Int = json.Encode.encode(5)
  let b: json.Value = json.Encode.encode(Money { cents: 1 })
  println(b)
}

fn via(x: a) -> Int where a: json.Encode { json.Encode.encode(x) }

fn f() { { x -> x }.encode() }
