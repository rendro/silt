-- exit: 1
-- stderr-contains: json.stringify: two keys of a map show as the same text: bytes(61 61
import bytes
import json
import string

-- Two keys that show as one text would be one key of the object, and a
-- value would be lost: json.stringify refuses the map. Strings in a key
-- are quoted, so `["a, b"]` and `["a", "b"]` stay apart; two long Bytes
-- whose shown text is cut after the same first bytes do not.
fn main() {
  println(json.stringify(#{[1]: "one", [2]: "two"}))
  println(json.stringify(#{["a, b"]: 1, ["a", "b"]: 2}))
  let a = string.repeat("a", 39)
  let one = bytes.from_string("{a}b")
  let two = bytes.from_string("{a}c")
  println(json.stringify(#{one: 1, two: 2}))
}
