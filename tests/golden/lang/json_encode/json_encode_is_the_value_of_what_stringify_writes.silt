-- `json.encode(x)` is the `json.Value` of what `json.stringify(x)` writes:
-- what `json.parse` reads of that text (`1.0` is `json.Int(1)`, a record
-- an object, whose keys come out sorted), written impls included, at the
-- top too. `.encode()` is the same on a value of any type that has
-- `json.Encode`, through a bound and by a concrete type, and an impl
-- uses `json.encode` for the parts it writes.
import json
import time

type Money { cents: Int }

trait json.Encode for Money {
  fn encode(self) -> json.Value { json.Int(self.cents) }
}

type P { x: Int, total: Money, tags: List(String) }

type Pair(a) { left: a, right: a }

trait json.Encode for Pair(a) where a: json.Encode {
  fn encode(self) -> json.Value {
    json.Array([json.encode(self.left), json.encode(self.right)])
  }
}

fn twice(x: a) -> List(json.Value) where a: json.Encode {
  [json.Encode.encode(x), json.encode(x)]
}

fn same(x: a) -> Bool where a: json.Encode {
  json.parse(json.stringify(x), json.Value) == Ok(json.encode(x))
}

fn main() {
  println(json.encode(1))
  println(json.encode(1.0))
  println(json.encode(2.5))
  println(json.encode(()))
  println(json.encode(None))
  println(json.encode(Some("a")))
  println(json.encode((1, "a")))
  println(json.encode(P { x: 1, total: Money { cents: 5 }, tags: ["t"] }))
  println(json.encode(Pair { left: Money { cents: 1 }, right: Money { cents: 2 } }))
  println(json.Encode.encode(5))
  println(json.Encode.encode(Money { cents: 9 }))
  println(twice(Money { cents: 3 }))
  println(twice([1, 2]))
  println(json.stringify(json.encode(P { x: 1, total: Money { cents: 5 }, tags: [] })))
  println(json.stringify(P { x: 1, total: Money { cents: 5 }, tags: [] }))
  println([same(1), same(1.0e21), same(-0.5), same("s"), same([Some(1), None]), same(#{"k": 1.5}), same(time.date(2026, 10, 21)), same(P { x: 1, total: Money { cents: 5 }, tags: ["a"] })])
  let f = json.Encode.encode
  println(f(Money { cents: 4 }))
}
