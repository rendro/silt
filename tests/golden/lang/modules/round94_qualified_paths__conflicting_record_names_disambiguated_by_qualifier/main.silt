-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: modules 'a' and 'b' both declare a type 'Pt': one module cannot use two types of one name
-- The checker knows a type by its name, so two imported types of one
-- name cannot be told apart in one module: the second import is
-- rejected, with the first as a label.
import a
import b

fn main() {
  let p = a.Pt { x: 1, y: 2 }
  let q = b.Pt { label: "hi", v: 3 }
  print(p.x + p.y)
  print(q.label)
  let b.Pt { label, .. } = q
  print(label)
}
