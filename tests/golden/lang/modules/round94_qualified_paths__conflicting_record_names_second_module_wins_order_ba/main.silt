-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: modules 'b' and 'a' both declare a type 'Pt': one module cannot use two types of one name
-- The checker knows a type by its name, so two imported types of one
-- name cannot be told apart in one module: the second import is
-- rejected, with the first as a label.
import b
import a

fn main() {
  let q = b.Pt { label: "hi", v: 3 }
  let p = a.Pt { x: 1, y: 2 }
  print(p.x + q.v)
}
