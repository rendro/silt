import float
import list
import set
-- -0.0 and 0.0 are one value: every producer prints 0, and a set holds it once.
fn main() {
  println(0.0 * -1.0)
  println(-0.0)
  println(-1.0 * 0.0)
  println(0.0 / -5.0)
  println(float.round(-0.4))
  println(set.length(#[0.0, -0.0, 0.0 * -1.0]))
  println(0.0 == -0.0)
  println(list.sort([1.0, -0.0, -1.0, 0.0]))
}
