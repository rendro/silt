-- cmd: check
-- exit: 1
-- A trait that has `json.Decode` among its supertraits may be
-- implemented for a generic type over its type variables when the header
-- asks `json.Decode` of each (`Box`, `Pick`). Its impl for a type the
-- json decoder does not decode is refused, with the decoder's reason: a
-- record with a field of a generic record type at an argument that has
-- no decoder. A type the decoder decodes is not, a record with a field
-- of a generic record type at its arguments among them.
import json

trait Dec: json.Decode {
  fn read(s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
  fn again(self, s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

type Box(a) {
  v: a,
}

type Pick(a) {
  One(a),
  Other,
}

type W {
  b: Box(Int),
}

type V {
  b: Box(Set(Int)),
}

type Pt {
  x: Int,
}

trait Dec for Box(a) where a: json.Decode {}

trait Dec for Pick(a) where a: json.Decode {}

trait Dec for W {}

trait Dec for V {}

trait Dec for Pt {}

fn pass(s: String, type a) -> Result(a, json.JsonError) where a: Dec {
  json.parse(s, a)
}

fn main() {
  println(pass("\{\"b\": \{\"v\": 1}}", W))
  println(pass("\{\"x\": 1}", Pt))
  println(Pt.read("\{\"x\": 2}"))
  println(Dec.again(Pt { x: 0 }, "\{\"x\": 3}"))
}
