-- cmd: check
-- exit: 1
-- A type given to a bound whose trait has `json.Decode` among its
-- supertraits is judged as one given to a bound of `json.Decode` itself:
-- a generic record type is refused where it is given, through a function's
-- bound, a method called on the type (a default that decodes `Self`) and
-- to toml's decoder. A type the decoder decodes is not.
import json
import toml

trait Dec: json.Decode {
  fn read(s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

type Box(a) {
  v: a,
}

type Pt {
  x: Int,
}

trait Dec for Box(a) where a: json.Decode {}

trait Dec for Pt {}

fn pass(s: String, type a) -> Result(a, json.JsonError) where a: Dec {
  json.parse(s, a)
}

fn tpass(s: String, type a) -> Result(a, toml.TomlError) where a: Dec {
  toml.parse(s, a)
}

fn main() {
  let c: Result(Box(Int), json.JsonError) = pass("\{\"v\": 7}", Box)
  println(c)
  let e: Result(Box(Int), json.JsonError) = Box.read("\{\"v\": 7}")
  println(e)
  let f: Result(Box(Int), toml.TomlError) = tpass("v = 7", Box)
  println(f)
  println(pass("\{\"x\": 1}", Pt))
  println(Pt.read("\{\"x\": 2}"))
  println(tpass("x = 3", Pt))
}
