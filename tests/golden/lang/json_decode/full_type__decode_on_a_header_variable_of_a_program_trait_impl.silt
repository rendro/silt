-- cmd: run
-- exit: 0
-- `a.decode(v)` in an impl of a program's trait for a generic type whose
-- header asks `json.Decode` of `a` decodes at the type argument the use
-- gives (`Box(Int)`): the impl's dictionary carries the type in full.
import json

fn g(type t) -> t where t: Mk { t.mk(json.Int(3)) }

type Box(a) { v: a }

trait Mk {
  fn mk(v: json.Value) -> Self
}

trait Mk for Box(a) where a: json.Decode {
  fn mk(v: json.Value) -> Self {
    match a.decode(v) {
      Ok(x) -> Box { v: x }
      Err(_) -> panic("no")
    }
  }
}

fn main() {
  println(g(Box(Int)).v)
}
