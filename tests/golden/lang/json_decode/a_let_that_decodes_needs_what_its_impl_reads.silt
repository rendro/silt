-- A top-level `let` that decodes a document into a type with a written
-- `json.Decode` impl needs what the impl reads: it is initialised after
-- `later`, whether it decodes with `json.parse` (of the type, a list of
-- it), `json.decode`, `T.decode`, a function with `where a: json.Decode`, or
-- into a type that holds the type, as one that shows a value needs what
-- a `Display` impl reads.
import json

type T { n: Int }

trait json.Decode for T {
  fn decode(value: json.Value) -> Result(Self, json.JsonError) {
    match value {
      json.Int(n) -> Ok(T { n: n + later })
      _ -> Err(json.Other("no"))
    }
  }
}

type Holder { t: T }

fn load(text: String, type a) -> Result(a, json.JsonError) where a: json.Decode {
  json.parse(text, a)
}

let p = json.parse("1", T)
let l = json.parse("[2]", List(T))
let d = json.decode(json.Int(3), T)
let m = T.decode(json.Int(4))
let f = load("5", T)
let h = json.parse("""{"t": 6}""", Holder)
let later = 10

fn main() {
  println([p, d, m, f])
  println(l)
  println(h)
}
