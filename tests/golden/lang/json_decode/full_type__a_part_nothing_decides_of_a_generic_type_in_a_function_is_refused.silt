-- cmd: check
-- exit: 1
-- A value of a generic type of the program with a part nothing decides
-- (`Box { v: [] }`, `R { xs: [] }`, `[Box { v: None }]`), given in a
-- function to a function that decodes its argument's type, is refused
-- once at its place as a type nothing decides, as in `main`
-- (full_type__a_type_nothing_decides_is_refused): no letter the program
-- wrote names the part, and nothing the function is given holds it. Not
-- by what a decoder says of the type the scope's end picks for the part.
import json

trait Dec: json.Decode {
  fn again(self, s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

type Box(a) {
  v: a,
}

type R(a) {
  xs: List(a),
}

trait Dec for List(a) where a: json.Decode {}

trait Dec for Box(a) where a: json.Decode {}

trait Dec for R(a) where a: json.Decode {}

fn twice(b, s) {
  Dec.again(b, s)
}

fn show(s: String) {
  println(twice(Box { v: [] }, s))
  println(twice(R { xs: [] }, s))
  println(twice([Box { v: None }], s))
}

fn main() {
  show("\{\"v\": [1]}")
}
