-- cmd: check
-- exit: 1
-- A method that makes `Self`, called through a generic type, is called
-- through it with its arguments (`Box(Int).mk`): through the bare type
-- (`Box.mk`), called, passed as a value or kept in a `let`, local or
-- top-level, and of the structural `decode`, it is refused.
import json

trait Mk: json.Decode {
  fn mk(s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

type Box(a) {
  v: a,
}

trait Mk for Box(a) where a: json.Decode {}

type Plain(a) {
  v: a,
}

fn apply1(f: Fn(x) -> r, x: x) -> r {
  f(x)
}

let top = Box.mk

fn main() {
  let r: Result(Box(Int), json.JsonError) = Box.mk("\{\"v\": 9}")
  println(r)
  let p: Result(Box(Int), json.JsonError) = apply1(Box.mk, "\{\"v\": 9}")
  println(p)
  let f = Box.mk
  println(f("\{\"v\": 9}"))
  let d: Result(Plain(Int), json.JsonError) = Plain.decode(json.Null)
  println(d)
  println(top("\{\"v\": 9}"))
}
