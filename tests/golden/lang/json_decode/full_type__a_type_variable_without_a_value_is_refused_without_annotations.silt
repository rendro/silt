-- cmd: check
-- exit: 1
-- The unannotated twin of full_type__a_type_variable_without_a_value_is_refused:
-- a dictionary that carries its type in full needs a value of each type
-- variable in it where the code runs. In a function with no annotations
-- (`wrap(x, s)`) or a closure, a variable known only by a value's type
-- is refused at the method call, named as the definition's type names
-- it. A value whose type the caller gives (`twice`) passes the
-- caller's dictionary.
import json

trait Dec: json.Decode {
  fn again(self, s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

type Box(a) {
  v: a,
}

trait Dec for Box(a) where a: json.Decode {}

fn wrap(x, s) {
  Dec.again(Box { v: x }, s)
}

fn twice(b, s) {
  Dec.again(b, s)
}

fn main() {
  println(wrap(1, "\{\"v\": 9}"))
  println(twice(Box { v: 1 }, "\{\"v\": 9}"))
  let k = { x -> Dec.again(Box { v: x }, "\{\"v\": 9}") }
  println(k(1))
}
