-- A method that makes `Self`, of a trait that has `json.Decode` among its
-- supertraits, called through a generic type with its arguments
-- (`Box(Int).mk`), passed as a value or kept in a `let`, decodes that
-- type, at its arguments: written, or a `type a` parameter (`Box(a).mk`).
import json

trait Mk: json.Decode {
  fn mk(s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

type Box(a) {
  v: a,
}

trait Mk for Box(a) where a: json.Decode {}

fn apply1(f: Fn(x) -> r, x: x) -> r {
  f(x)
}

fn with_type(s: String, type a) -> Result(Box(a), json.JsonError) where a: json.Decode {
  Box(a).mk(s)
}

fn kept(s: String) -> Result(Box(Int), json.JsonError) {
  let f = Box(Int).mk
  f(s)
}

fn main() {
  let r: Result(Box(Int), json.JsonError) = Box(Int).mk("\{\"v\": 9}")
  println(r)
  let r: Result(Box(Int), json.JsonError) = apply1(Box(Int).mk, "\{\"v\": 8}")
  println(r)
  println(with_type("\{\"v\": \"seven\"}", String))
  let r: Result(Box(String), json.JsonError) = Box(String).mk("\{\"v\": 6}")
  println(r)
  println(kept("\{\"v\": 5}"))
  let g = Box(Int).mk
  let r: Result(Box(Int), json.JsonError) = g("\{\"v\": 4}")
  println(r)
}
