-- cmd: check
-- exit: 1
-- The list and option twins of
-- full_type__a_value_s_generic_type_passed_on_to_a_decoding_function_is_refused:
-- a function with no annotations that gives a list or an option of a
-- value whose type only the value knows (`[x]`, `Some(x)`) to a function
-- that decodes its argument's type (`twice`) is refused, in a function
-- and in a closure: nothing gives that type where the code runs. (A
-- list the call knows the type of, `twice([1], s)`, runs.)
import json

trait Dec: json.Decode {
  fn again(self, s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

trait Dec for List(a) where a: json.Decode {}

trait Dec for Option(a) where a: json.Decode {}

fn twice(b, s) {
  Dec.again(b, s)
}

fn deep(x, s) {
  twice([x], s)
}

fn maybe(x, s) {
  twice(Some(x), s)
}

fn main() {
  println(deep(1, "[2]"))
  println(maybe(1, "2"))
  println(twice([1], "[2]"))
  let k = { x -> twice([x], "[3]") }
  println(k(1))
}
