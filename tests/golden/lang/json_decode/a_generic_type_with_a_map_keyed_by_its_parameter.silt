-- cmd: run
-- exit: 0
-- A field `Map(k, Int)` of a generic type `M(k)` decodes at `M(String)`:
-- the key type is the type argument, as in json, toml and through a
-- supertrait impl.
import json
import toml

type M(k) { m: Map(k, Int) }

trait Dec: json.Decode {
  fn read(s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

trait Dec for M(k) where k: json.Decode {}

fn via(s: String, type a) -> Result(a, json.JsonError) where a: Dec {
  a.read(s)
}

fn main() {
  println(json.parse("\{\"m\": \{\"x\": 1}}", M(String)))
  println(json.parse("\{\"m\": \{\"x\": \"no\"}}", M(String)))
  println(toml.parse("""[m]
x = 2
""", M(String)))
  println(via("\{\"m\": \{\"y\": 3}}", M(String)))
}
