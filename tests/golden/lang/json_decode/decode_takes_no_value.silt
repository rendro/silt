-- cmd: check
-- exit: 1
-- stderr-contains: type 'P' has no field 'decode'
-- `decode` of json.Decode takes no value of the type: it is called
-- through the type. A program's own `decode` that takes one is called
-- through its trait, and a dot after a value is a field.
import json

type P { x: Int }

trait Load { fn decode(self, text: String) -> Int }

trait Load for String {
  fn decode(self, text: String) -> Int { 1 }
}

fn main() {
  let _ = Load.decode("x", "y")
  let p = P { x: 1 }
  println(p.decode(json.Null))
}
