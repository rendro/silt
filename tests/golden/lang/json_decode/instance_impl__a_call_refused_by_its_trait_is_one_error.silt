-- cmd: check
-- exit: 1
-- A call of a trait whose supertrait is json.Decode (`Dec`), given a
-- type the trait has no impl for, is one error at its place: the one of
-- the trait the call names, not also the decoder's (a type with no
-- json.Decode impl, `Box(Bool)`; a type nothing decides in full,
-- `Box(List(_))`).
import json

type Box(a) {
  v: a,
}

trait json.Decode for Box(Int) {
  fn decode(v: json.Value) -> Result(Self, json.JsonError) { Ok(Box { v: 1 }) }
}

trait json.Decode for Box(String) {
  fn decode(v: json.Value) -> Result(Self, json.JsonError) { Ok(Box { v: "s" }) }
}

trait Dec: json.Decode {
  fn again(self, s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

trait Dec for Box(Int) {}

trait Dec for Box(String) {}

fn twice(b, s) {
  Dec.again(b, s)
}

fn main() {
  println(twice(Box { v: true }, "0"))
  println(Dec.again(Box { v: [] }, "0"))
  println(twice(Box { v: 1 }, "0"))
}
