-- cmd: check
-- exit: 1
-- `List`, `Map` and `Option` are generic types: an impl of a trait that
-- has `json.Decode` among its supertraits is accepted for them when the
-- header asks `json.Decode` of each parameter, and refused when it does
-- not (`k` of `Map(k, a)`). A use at arguments the decoder cannot build
-- is refused (`Map(Int, Int)`).
import json

trait Dec: json.Decode {
  fn read(s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

trait Dec for List(a) where a: json.Decode {}

trait Dec for Map(k, a) where a: json.Decode {}

trait Dec for Option(a) where a: json.Decode {}

trait Dec2: json.Decode {
  fn read2(s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

trait Dec2 for Map(k, a) where k: json.Decode, a: json.Decode {}

fn via(s: String, type a) -> Result(a, json.JsonError) where a: Dec2 {
  a.read2(s)
}

fn main() {
  println(via("\{\"x\": 1}", Map(String, Int)))
  println(via("\{\"x\": 1}", Map(Int, Int)))
}
