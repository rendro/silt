-- A top-level `let` whose value uses a method that makes `Self` at a
-- known type (`Box.mk` at `Box(Int)`) is general in everything else:
-- the closure takes an Int and a String.
import json

trait Mk: json.Decode {
  fn mk(s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

type Box(a) {
  v: a,
}

trait Mk for Box(a) where a: json.Decode {}

let f = { x, s ->
  let r: Result(Box(Int), json.JsonError) = Box.mk(s)
  println(r)
  x
}

fn main() {
  println(f(1, "\{\"v\": 3}"))
  println(f("a", "\{\"v\": 4}"))
}
