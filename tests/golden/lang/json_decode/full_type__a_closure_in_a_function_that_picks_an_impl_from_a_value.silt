-- cmd: check
-- exit: 1
-- A closure that would decode through a dictionary carrying its type in
-- full, the type known only from its parameter's value (`{ x, s ->
-- Dec.again(Box { v: x }, s) }`), is refused with one text wherever the
-- closure is, in `main` or in another function: the type nothing decides,
-- and the way that decides it, a closure that takes the type. It names
-- no letter the program did not write. (A letter the function's
-- signature writes keeps the in-full text:
-- full_type__a_type_variable_without_a_value_is_refused.)
import json

type Box(a) {
  v: a,
}

trait Dec: json.Decode {
  fn again(self, s: String) -> Result(Self, json.JsonError) { json.parse(s, Self) }
}

trait Dec for Box(a) where a: json.Decode {}

fn more() {
  let l7 = { x, s -> Dec.again(Box { v: x }, s) }
  println(l7(1, "\{\"v\": 8}"))
}

fn more_unit() -> () {
  let l8 = { x, s -> Dec.again(Box { v: x }, s) }
  println(l8(1, "\{\"v\": 8}"))
}

fn main() {
  let l9 = { x, s -> Dec.again(Box { v: x }, s) }
  println(l9(1, "\{\"v\": 8}"))
  more()
  more_unit()
}
