type Person { x: Int }
fn main() {
  let p: Person = Person { x: 1 }
  let q = {...p}
  let r: {x: Int} = {x: 1}
  -- anonrec_spread_of_nominal_eq_anon_literal_prints_true
  println(q == r)
  -- anonrec_spread_of_nominal_neq_anon_literal_prints_false
  println(q != r)
  -- anonrec_spread_different_values_eq_false
  let r2: {x: Int} = {x: 2}
  println(q == r2)
}
