-- `point { ... }` on one line is a record literal with a lowercase name,
-- not two statements: the error is the undefined name, not the
-- same-line newline rule.
-- cmd: check
-- exit: 1
-- stderr-contains: undefined variable 'point'
-- stderr-not-contains: expected a newline
fn main() {
  let p = point { x: 1, y: 2 }
  println(p)
}
