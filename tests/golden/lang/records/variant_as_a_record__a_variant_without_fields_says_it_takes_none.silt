-- exit: 1
-- A variant written with braces, as a record literal or a record
-- pattern, names no record type: the error says whose variant it is
-- and that it has no fields, rather than that the type is undefined.
type Light { Go, Stop }

fn main() {
  let r = Go { x: 1 }
  match r {
    Stop { x } -> println(x)
    _ -> println("go")
  }
}
