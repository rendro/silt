-- `==` and `!=` of two Ints are compared in the instruction loop (the
-- other kinds by a call): as a value and as the branch of a match, of
-- equal, unequal, negative and extreme Ints, and beside other kinds.
fn same(a: Int, b: Int) -> String {
  match a == b {
    true -> "same"
    false -> "different"
  }
}

fn main() {
  let big = 9223372036854775807
  let least = -big - 1
  println("{1 == 1} {1 == 2} {1 != 2} {2 != 2} {-5 == -5} {big == big} {big == least} {least != big}")
  println("{same(3, 3)} {same(3, -3)} {same(least, least)}")
  let n = 1000
  let count = loop i = 0, acc = 0 {
    match i >= n {
      true -> acc
      false -> loop(i + 1, acc + (match i % 3 == 0 {
        true -> 1
        false -> 0
      }))
    }
  }
  println(count)
  println("{"a" == "a"} {[1, 2] == [1, 2]} {Some(1) != Some(2)} {(1, "x") == (1, "x")}")
}
