-- cmd: check
-- exit: 1
-- A top-level `let` whose value is a function's name is that function:
-- `let g = f` is `f`, so a recursion through `g` is checked (here
-- refused), not switched off. A table that its handlers only read calls
-- nothing (init_order__a_plain_value_runs_nothing).
fn f(n: Int) -> Int {
  1 + g(n + 1)
}

let g = f

fn main() {
  println(f(0))
}
