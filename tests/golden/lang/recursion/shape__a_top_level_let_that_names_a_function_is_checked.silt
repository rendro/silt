-- cmd: check
-- exit: 1
-- A top-level `let` is a function of the graph whatever its value:
-- `let g = f` names `f` as a value, so a recursion through a call of
-- `g` is checked (here refused), not switched off. A table that its
-- handlers only read calls nothing (init_order__a_plain_value_runs_nothing).
fn f(n: Int) -> Int {
  1 + g(n + 1)
}

let g = f

fn main() {
  println(f(0))
}
