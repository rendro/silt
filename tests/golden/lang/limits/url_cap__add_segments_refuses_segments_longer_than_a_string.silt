-- exit: 1
-- stderr-contains: url.add_segments: result would exceed maximum string size (15000000 bytes > 10000000 limit)
-- stderr-not-contains: not reached
-- Segments longer together than a string may be make a Url that is
-- longer: they are refused before they are copied.
import list
import string
import url

fn main() {
  let big = string.repeat("a", 5000000)
  when let Ok(u) = url.parse("http://h/") else { panic("no URL") }
  let _ = url.add_segments(u, list.map(1..3000) { _ -> big })
  println("not reached")
}
