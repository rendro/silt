-- exit: 1
-- stderr-contains: error[runtime]
-- stderr-contains: bytes.concat: result would exceed maximum size (16777216 bytes > 10000000 limit)
-- Bytes are at most ten million: doubling them stops there.
import bytes
import list

fn main() {
  let r = list.fold(1..40, bytes.from_string("x")) { acc, _ -> bytes.concat(acc, acc) }
  println(bytes.length(r))
}
