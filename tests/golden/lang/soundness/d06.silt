-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type variable `Self` is not known to implement trait 'Equal'
-- A default body interpolates, compares and orders `self`; the impl is
-- for a record that holds a function.
type F { f: Fn(Int) -> Int }
trait S {
  fn s(self) -> String { "{self}" }
  fn e(self) -> Bool { self == self }
  fn c(self) -> Bool { self < self }
}
trait S for F {}
fn main() {
  let x = F { f: { a -> a } }
  println(x.s())
  println(x.e())
  println(x.c())
}
