-- cmd: check
-- exit: 1
-- stderr-contains: type 'Fn' does not implement trait 'Display'
-- Port of repros/type_soundness/z2.silt, in brace closures.
type Box(a) { Box(a) }
fn show(x) { "{x}" }
fn show2(x) { x.display() }
fn pr(x) { println(x) }
fn main() {
  let f = { x -> x }
  println(show([f]))
  println(show(Box(f)))
  println(show((1, f)))
  println(show2(Box(f)))
  println(show2(f))
  pr([f])
  pr(Box(f))
  println([f])
  println(show(f))
}
