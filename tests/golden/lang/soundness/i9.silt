-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type variable `a` is not known to implement trait 'Equal'
-- Port of repros/type_soundness/i9.silt, in brace closures.
type Box(a) { Box(a) }
fn same(x: Box(a), y: Box(a)) -> Bool { x == y }
fn main() {
  println(same(Box(1), Box(1)))
  println(same(Box({ x -> x }), Box({ x -> x })))
}
