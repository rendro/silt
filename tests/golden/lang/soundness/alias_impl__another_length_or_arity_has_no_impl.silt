type P2 = (Int, Int)
type Op = Fn(Int) -> Int
type Tag { Tag(String) }
trait T { fn sum(self) -> Int }
trait T for P2 {
  fn sum(self) -> Int {
    let (a, b) = self
    a + b
  }
}
trait U { fn ap(self) -> Int }
trait U for Op { fn ap(self) -> Int { self(1) + 1 } }
fn s(x: a) -> Int where a: T { x.sum() }
fn u(x: a) -> Int where a: U { x.ap() }
fn two(a: Int, b: Int) -> Int { a + b }
fn tag(n: Int) -> Tag { Tag("t") }
fn main() {
  println(s((1, 2)))
  println(s((1, 2, 3)))
  println(u(two))
  println(u(tag))
}
