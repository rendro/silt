-- cmd: check
-- exit: 1
-- stderr-contains: type mismatch: expected String, got Int
-- Port of repros/type_soundness/q3.silt: the arguments of a self call
-- have the types of the parameters.
fn f(i: Int, acc: String) -> String {
  match i {
    3 -> acc
    _ -> f(i + 1, i)
  }
}
fn main() { println(f(0, "")) }
