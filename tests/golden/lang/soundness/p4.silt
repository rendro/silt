-- cmd: check
-- exit: 1
-- stderr-contains: type mismatch: expected Int, got String
-- Port of repros/type_soundness/p4.silt, in brace closures.
import channel

fn main() {
  let mk = { -> channel.new(10) }
  let ch = mk()
  let pair = (ch, ch)
  let (a, b) = pair
  channel.send(a, 1)
  channel.send(b, "hello")
  match channel.receive(ch) {
    channel.Message(v) -> println(v)
    _ -> ()
  }
}
