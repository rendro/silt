-- Port of repros/type_soundness/ex9.silt, two statements on one line split.
fn l(xs: List(Bool)) -> Int {
  match xs {
    [] -> 0
    [true, ..rest] -> 1
    [false, ..rest] -> 2
  }
}
fn o(xs: List(Option(Int))) -> Int {
  match xs {
    [] -> 0
    [Some(n), ..rest] -> n
    [None, ..rest] -> 2
  }
}
fn main() {
  println(l([false]))
  println(o([None]))
}
