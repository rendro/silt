-- cmd: check
-- exit: 1
-- stderr-contains: undefined variable 'self'
-- Port of repros/type_soundness/se2.silt, in brace closures.
type P { v: Int }
trait Get { fn get(self) -> Int }
trait Get for P {
  fn get(self) -> Int {
    let f = { -> self.v + 1 }
    f()
  }
}
fn main() {
  println(P { v: 1 }.get())
  let g = { x -> self }
  println(1)
}
