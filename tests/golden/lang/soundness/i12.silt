-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'Fn' does not implement trait 'Hash'
-- Port of repros/type_soundness/i12.silt, in brace closures.
-- (only `map.length`'s bound, which a reader of a map does not owe,
-- rejected the program before).
import map
fn put(m, k, v) { map.set(m, k, v) }
fn mk(k) { #{ k: 1 } }
fn main() {
  let f = { x -> x + 1 }
  let m = mk(f)
  println(map.length(m))
}
