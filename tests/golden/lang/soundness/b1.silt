-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'Fn' does not implement trait 'Compare'
-- Port of repros/type_soundness/b1.silt, in brace closures.
fn lt(a, b) { a < b }
fn eq(a, b) { a == b }
fn add(a, b) { a + b }

fn main() {
  let f = { x -> x + 1 }
  let g = { x -> x + 2 }
  println(eq(f, g))
  println(eq(f, f))
  println(lt(f, g))
  println(lt(g, f))
}
