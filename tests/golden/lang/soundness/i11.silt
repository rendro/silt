-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'Fn' does not implement trait 'Hash'
-- Port of repros/type_soundness/i11.silt, in brace closures.
import set
fn main() {
  let f = { x -> x + 1 }
  let g = { x -> x + 1 }
  let s = #[f, g, f]
  println(set.length(s))
  println(set.contains(s, f))
}
