-- error[runtime]: unsupported operation: cannot compare Fn and Fn
fn pick(flag, a, b) {
  match flag {
    true -> a < b
    false -> true
  }
}
fn main() {
  let f = { x -> x }
  println(pick(false, f, f))
  println(pick(true, f, f))
}
