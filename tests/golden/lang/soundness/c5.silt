-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'Fn' does not implement trait 'Compare'
-- Port of repros/type_soundness/c5.silt, in brace closures.
fn pick(flag, a, b) {
  match flag {
    true -> a < b
    false -> true
  }
}
fn main() {
  let f = { x -> x }
  println(pick(false, f, f))
  println(pick(true, f, f))
}
