-- cmd: check
-- exit: 1
-- stderr-contains: non-exhaustive match: `(_, 11)` is not covered
-- stderr-contains: non-exhaustive match: `Some(101)` is not covered
-- Port of repros/type_soundness/ex6.silt, two statements on one line split.
fn s(x: String, y: Int) -> Int {
  match (x, y) {
    ("a", _) -> 1
    (_, 0) -> 2
    (_, 1..10) -> 3
  }
}
fn o(x: Option(Int)) -> Int {
  match x {
    Some(0..100) -> 1
    Some(n) when n > 100 -> 2
    None -> 3
  }
}
fn main() {
  println(s("b", 50))
  println(o(Some(-5)))
}
