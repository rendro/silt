-- exit: 1
-- stderr-contains: type 'Fn' does not implement trait 'Compare'
-- Port of repros/type_soundness/w3d.silt, in brace closures, without its last line.
import list
fn smallest(xs: List(a)) -> List(a) where a: Compare { list.sort(xs) }
fn run(f, x) { f(x) }
fn main() {
  let fs = [{ x -> x + 1 }, { x -> x + 2 }]
  let r = run(smallest, fs)
  println(list.length(r))
}
