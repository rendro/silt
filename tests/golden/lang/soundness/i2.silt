-- cmd: check
-- exit: 0
-- Port of repros/type_soundness/i2.silt, in brace closures.
-- A hole, pending in repros/SOUNDNESS.tsv. `check` passes and `run` prints
-- the lengths: a map or set literal does not ask its keys for `Hash` yet
-- (only `map.length`'s bound, which a reader of a map does not owe,
-- rejected the program before).
import map
import set
type W(a) { W(a) }
fn main() {
  let w1 = W({ x -> x + 1 })
  let m = #{ w1: 1 }
  println(map.length(m))
  let s = #[w1]
  println(set.length(s))
}
