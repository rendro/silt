-- Port of repros/type_soundness/ex10.silt, two statements on one line split.
-- Literal fields of anonymous-record patterns count towards coverage.
fn h(r: {on: Bool, n: Int}) -> Int {
  match r {
    {on: true, n: n} -> n
    {on: false, n: n} -> n
  }
}
fn h2(r: {on: Bool}) -> Int {
  match r {
    {on: true} -> 1
    {on: false} -> 0
  }
}
fn main() {
  println(h({on: false, n: 5}))
  println(h2({on: true}))
}
