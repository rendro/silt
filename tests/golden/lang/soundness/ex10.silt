-- Port of repros/type_soundness/ex10.silt, two statements on one line split.
-- Literal fields of record patterns count towards coverage.
type R { on: Bool, n: Int }
type S { on: Bool }
fn h(r: R) -> Int {
  match r {
    R { on: true, n: n } -> n
    R { on: false, n: n } -> n
  }
}
fn h2(r: S) -> Int {
  match r {
    S { on: true } -> 1
    S { on: false } -> 0
  }
}
fn main() {
  println(h(R { on: false, n: 5 }))
  println(h2(S { on: true }))
}
