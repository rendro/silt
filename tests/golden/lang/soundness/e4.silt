-- cmd: check
-- exit: 1
-- stderr-contains: type 'Int' has no field 'nonexistent_method'
-- Port of repros/type_soundness/e4.silt, in brace closures.
import list
fn main() {
  let xs = [1, 2, 3]
  let ys = list.map(xs) { x -> "{x}" }
  println(ys)
  let f = { x -> x.nonexistent_method() }
  println(f(1))
}
