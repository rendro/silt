import list
import map
fn keyed(k: a) -> Map(a, Int) where a: Hash { #{ k: 1 } }
fn main() {
  let ms = list.map([{ x -> x }], keyed)
  println(list.length(ms))
  let sorted = [{ x -> x + 1 }] |> list.map({ f -> f }) |> list.sort
  println(list.length(sorted))
}
