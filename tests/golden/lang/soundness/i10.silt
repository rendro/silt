-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'Box(Fn(_) -> _)' does not implement trait 'Equal': variant 'Box' payload #1 is of type 'Fn(_) -> _', which does not
-- Port of repros/type_soundness/i10.silt, in brace closures.
type Box(a) { Box(a) }
fn same(x, y) { x == y }
fn less(x, y) { x < y }
fn main() {
  let b = Box({ x -> x })
  let c = Box({ x -> x })
  println(same(b, b))
  println(same(b, c))
  println(less(b, c))
  println(less(c, b))
  println(same([{ x -> x }], [{ x -> x }]))
  println(same((1, { x -> x }), (1, { x -> x })))
  println(less([{ x -> x }], [{ x -> x }]))
}
