-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'Fn' does not implement trait 'Compare'
-- Port of repros/type_soundness/i4.silt, in brace closures.
import list
type W(a) { W(a) }
fn main() {
  let fs = [{ x -> x + 1 }, { x -> x + 2 }]
  let sorted = list.sort(fs)
  println(list.length(sorted))
  let ws = [W({ x -> x }), W({ x -> x })]
  println(list.length(list.sort(ws)))
  println(list.contains(fs, { x -> x + 1 }))
  println(list.unique(fs) |> list.length)
}
