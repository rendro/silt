-- cmd: check
-- exit: 1
-- `import da as other` beside a module named `other` that this file does
-- not import: `other.T` is da's type here, and the module `other`'s own
-- `T` and its trait `Shown` are described, so that two types (or
-- traits) are never written alike in one message.
import da as other

fn f(a: other.T) -> Int {
  let b = other.theirs()
  let n: Int = b
  let m: Int = a
  match {
    a == b -> 1
    _ -> n + m
  }
}

fn main() {
  println(f(other.A))
  println(other.show(1))
}
