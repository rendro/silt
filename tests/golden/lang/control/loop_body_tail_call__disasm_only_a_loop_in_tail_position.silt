-- cmd: disasm
-- The call in the body of a loop in tail position is a `TailCall`; the
-- same call in a loop whose value a `let` takes is a `Call`, and the
-- loop's value is slid over its binding.
fn tail(n: Int) -> Int {
  loop k = n {
    match k {
      0 -> 0
      _ -> kept(k - 1)
    }
  }
}

fn kept(n: Int) -> Int {
  let x = loop k = n {
    match k {
      0 -> 0
      _ -> tail(k - 1)
    }
  }
  x
}

fn main() {
  println(tail(3) + kept(3))
}
