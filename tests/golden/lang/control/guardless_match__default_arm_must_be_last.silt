-- The `_` arm has to be the last one; a condition after it is not enough.
-- cmd: check
-- exit: 1
-- stderr-contains: a `match` without a scrutinee must end with a `_ -> ...` arm
fn size(n: Int) -> String {
  match {
    n > 100 -> "big"
    _ -> "small"
    n > 10 -> "medium"
  }
}

fn main() {
  println(size(50))
}
