-- `loop(...)` restarts the loop and never produces a value, so it may only
-- appear in tail position: `i * loop(i - 1)` uses its result.
-- cmd: check
-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: `loop(...)` must be in tail position
-- stderr-contains: loop_tail_position__non_tail_recur_rejected.silt:12:16
fn fact(n: Int) -> Int {
  loop i = n {
    match i {
      0 -> 1
      _ -> i * loop(i - 1)
    }
  }
}

fn main() {
  println(fact(5))
}
