-- verdict: same
-- The Error trait's `message` of a builtin error type is reached through
-- the type as `display` is: qualified (`io.IoError.message(e)`), through
-- an imported name (`IoError.message(e)`), and as a function value.
import io
import io.{ IoError }
fn main() {
  match io.read_file("/nonexistent/silt/r5") {
    Ok(_) -> println("ok")
    Err(e) -> {
      println(Error.message(e) == Error.message(e))
      println(Error.message(e) == Error.message(e))
      println("{e}" == "{e}")
      let m = Error.message
      println(m(e) == Error.message(e))
    }
  }
}
