-- The postgres module's opaque types are named through it.
import postgres
fn pool(p: postgres.PgPool) -> postgres.PgPool { p }
fn v(x: postgres.Value) -> postgres.Value { x }
fn q(r: postgres.QueryResult, e: postgres.ExecResult, t: postgres.PgTx, c: postgres.PgCursor) -> Int { 1 }
fn main() {
  println(1)
}
