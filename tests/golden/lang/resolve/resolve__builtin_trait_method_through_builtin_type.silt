-- verdict: same
-- The builtin traits' methods of a builtin type are reached through the
-- type as through a value: `Int.display(1)` is `1.display()`, called or
-- as a function value.
import string
fn main() {
  println("{1}")
  println(Compare.compare(1, 2))
  println(1 == 1)
  println(Hash.hash(1) == Hash.hash(1))
  println(Compare.compare(1.5, 0.5))
  println("a" == "b")
  println("{true}")
  println("{[1, 2]}")
  let show = string.from
  println(show(4))
  let cmp = Compare.compare
  println(cmp("a", "b"))
}
