-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'P' does not implement trait 'b.Show'
-- stderr-contains: error[type]: ambiguous method 'show' on type 'Int': provided by traits a.Show, Show
-- Two modules' traits named Show: messages that name one write it with
-- its module; a module's own keeps its bare name.
import a
import b
type P { v: Int }
trait a.Show for P { fn show(self) -> String { "P-a" } }
fn main() {
  println(b.use_show(P { v: 1 }))
}
