-- verdict: same
-- A variant named like a builtin variant is the file's own: a local
-- `Stop` hides the prelude's, and `channel.Message` is no bare name to
-- collide with.
type T { Stop, Go }
type U { Message(Int), Other }
fn main() {
  println(Stop)
  match Message(3) {
    Message(n) -> println(n)
    Other -> println("other")
  }
}
