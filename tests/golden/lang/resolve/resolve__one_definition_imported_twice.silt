-- verdict: same
-- Importing one definition by name on two lines binds one name to one
-- definition, which is no clash. Two different definitions of one name
-- are.
import int
import int.{ IntError }
import int.{ IntError, Empty }
fn kind(e: IntError) -> String {
  match e {
    Empty -> "empty"
    _ -> "other"
  }
}
fn main() {
  match int.parse("") {
    Ok(_) -> println("ok")
    Err(e) -> println(kind(e))
  }
}
