import json
import map

type M { m: Map(String, Int), t: (Int, Int) }

fn main() {
  match json.parse("\{\"m\": \"oops\", \"t\": \"also\"\}", M) {
    Ok(v) -> {
      println(v)
      println(map.length(v.m))
    }
    Err(e) -> println("err: {e.message()}")
  }
  match json.parse("\{\"m\": \{\"a\": \"one\"\}, \"t\": [1, 2]\}", M) {
    Ok(v) -> println(v)
    Err(e) -> println("err: {e.message()}")
  }
  match json.parse("\{\"m\": \{\"a\": 1\}, \"t\": [1, 2, 3]\}", M) {
    Ok(v) -> println(v)
    Err(e) -> println("err: {e.message()}")
  }
}
