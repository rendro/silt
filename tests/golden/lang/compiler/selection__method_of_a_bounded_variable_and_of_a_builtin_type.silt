-- A method called on a value whose type is a bounded variable is found
-- by the value's type where the code runs; a method of a builtin trait
-- on a type with no written impl is the builtin one; a default method
-- is the trait's one function for every impl that leaves it out.
type Cat { name: String }
type Dog { name: String }
trait Speak {
  fn word(self) -> String
  fn twice(self) -> String { "{self.word()} {self.word()}" }
  fn loud(self) -> String { "{self.twice()}!" }
}
trait Speak for Cat { fn word(self) -> String { "meow" } }
trait Speak for Dog {
  fn word(self) -> String { "woof" }
  fn loud(self) -> String { "WOOF" }
}
trait Speak for Int { fn word(self) -> String { "{self}" } }
fn all(x: a) -> String where a: Speak { "{x.word()} / {x.twice()} / {x.loud()}" }
fn main() {
  println(all(Cat { name: "c" }))
  println(all(Dog { name: "d" }))
  println(all(7))
  println(Cat { name: "c" }.loud())
  println(Dog { name: "d" }.loud())
  println(Dog { name: "d" }.twice())
  println(Cat.twice(Cat { name: "c" }))
  println(3.display())
  println([1, 2].display())
  println(Int.display(5))
  println(Cat { name: "c" }.equal(Cat { name: "c" }))
  println((1, "a").compare((1, "b")))
  println(Some(2).hash() == Some(2).hash())
}
