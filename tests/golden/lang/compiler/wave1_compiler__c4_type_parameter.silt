-- cmd: check
-- exit: 1
-- A record with a field no decoder exists for, given through a
-- `type a` parameter to json.parse and to toml.parse, is refused at
-- each call that gives it.
import json
import toml

type Bag { name: String, items: Set(Int) }

fn from_json(text: String, type a) -> Result(a, json.JsonError) {
  json.parse(text, a)
}

fn from_toml(text: String, type a) -> Result(a, toml.TomlError) {
  toml.parse(text, a)
}

fn main() {
  match from_json("\{\"name\": \"b\", \"items\": \"oops\"\}", Bag) {
    Ok(v) -> println(v.name)
    Err(e) -> println("err: {e.message()}")
  }
  match from_toml("name = \"b\"\nitems = \"oops\"\n", Bag) {
    Ok(v) -> println(v.name)
    Err(e) -> println("err: {e.message()}")
  }
}
