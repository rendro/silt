-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: `parse` cannot decode
-- stderr-contains: Bag
-- stderr-contains: items
-- stderr-contains: Set(Int)
import json.{ parse }

type Bag { name: String, items: Set(Int) }

fn main() {
  match parse("""{"name": "b", "items": [1]}""", Bag) {
    Ok(b) -> println(b.name)
    Err(e) -> println("{e}")
  }
}
