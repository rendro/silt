import json
import map

type M { m: Map(String, Int), t: (Int, String), o: Option((Int, Int)) }

fn main() {
  match json.parse("\{\"m\": \{\"a\": 1, \"b\": 2\}, \"t\": [7, \"seven\"]\}", M) {
    Ok(v) -> {
      println(map.length(v.m))
      println(map.get(v.m, "b"))
      let (n, s) = v.t
      println(n + 1)
      println(s)
      println(v.o)
    }
    Err(e) -> println("err: {e.message()}")
  }
}
