-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: json.parse
-- stderr-contains: Outer
-- stderr-contains: Inner
-- stderr-contains: key
-- stderr-contains: Map(Int, String)
import json

type Inner { key: Map(Int, String) }
type Outer { inners: List(Inner) }

fn main() {
  match json.parse("[]", List(Outer)) {
    Ok(v) -> println(v)
    Err(e) -> println("err: {Error.message(e)}")
  }
}
