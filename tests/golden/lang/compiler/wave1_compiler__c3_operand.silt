import channel

fn total(ch, base) {
  base + loop {
    match channel.try_receive(ch) {
      channel.Message(v) when v < 3 -> loop()
      channel.Message(v) -> v
      _ -> 0
    }
  }
}

fn main() {
  let ch = channel.new(10)
  channel.send(ch, 1)
  channel.send(ch, 2)
  channel.send(ch, 3)
  println(total(ch, 100))
}
