-- toml decodes a record with an enum field: a variant without fields
-- from the string of its name.
import toml

type Color { Red, Green }
type Pixel { x: Int, c: Color }

fn main() {
  match toml.parse("x = 1\nc = \"Red\"\n", Pixel) {
    Ok(v) -> println("{v.x} {v.c}")
    Err(e) -> println("err: {Error.message(e)}")
  }
}
