-- `r.f(x)` on a record whose field `f` holds a function calls the
-- function: with a record, a field that is itself read off a field,
-- and a record that also has a method of another name.
type Holder { run: Fn(Int) -> Int, name: String }
type Inner { go: Fn(String) -> String }
type Runner { run: Fn(Int) -> Int, inner: Inner }
trait Describe { fn describe(self) -> String }
trait Describe for Holder { fn describe(self) -> String { "holder {self.name}" } }
fn tail(r: Holder, n: Int, acc: Int) -> Int {
  match n {
    0 -> acc
    _ -> tail(r, n - 1, r.run(acc))
  }
}
fn main() {
  let h = Holder { run: { x -> x + 1 }, name: "h" }
  println(h.run(1))
  println(Describe.describe(h))
  let r = Runner { run: { x -> x * 2 }, inner: Inner { go: { s -> "go {s}" } } }
  println(r.run(4))
  println(r.inner.go("on"))
  println(tail(h, 100000, 0))
  println(3 |> h.run)
  println(3 |> r.run())
}
