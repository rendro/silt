import channel

fn drain(ch, label) {
  let prefix = "got"
  loop {
    match channel.try_receive(ch) {
      channel.Message(v) -> {
        println("{prefix} {label} {v}")
        loop()
      }
      _ -> "done {label}"
    }
  }
}

fn main() {
  let ch = channel.new(10)
  channel.send(ch, 1)
  channel.send(ch, 2)
  channel.send(ch, 3)
  println(drain(ch, "x"))
}
