-- timeout: 90
-- A method call whose method is found where the code runs (the receiver
-- is a bounded type variable, or `self` in a default method) is a tail
-- call in tail position too: a default method that calls itself a
-- million levels deep runs in one frame, for each impl that leaves it
-- out, and so does a `where a: T` function and the method it calls,
-- calling each other. A method that is not a closure (a builtin type's `display`)
-- returns its value.
type C { n: Int }
trait Walk {
  fn base(self) -> Int
  fn walk(self, k: Int, acc: Int) -> Int {
    match k {
      0 -> acc + Walk.base(self)
      _ -> Walk.walk(self, k - 1, acc + 1)
    }
  }
  fn show(self) -> String { "{Walk.base(self)}" }
}
trait Walk for C { fn base(self) -> Int { self.n } }
trait Walk for Int { fn base(self) -> Int { self } }
fn go(x: a, k: Int) -> Int where a: Walk {
  match k {
    0 -> Walk.base(x)
    _ -> go(x, k - 1)
  }
}
fn last(x: a) -> Int where a: Walk { Walk.walk(x, 1000000, 0) }
trait Hop { fn hop(self, k: Int) -> Int }
trait Hop for C { fn hop(self, k: Int) -> Int { bounce(self, k) } }
fn bounce(x: a, k: Int) -> Int where a: Hop {
  match k {
    0 -> 42
    _ -> Hop.hop(x, k - 1)
  }
}
fn shown(x: a) -> String where a: Display { "{x}" }
fn main() {
  println(Walk.walk(C { n: 5 }, 1000000, 0))
  println(last(7))
  println(go(C { n: 3 }, 1000000))
  println(Walk.show(C { n: 9 }))
  println(shown([1, 2]))
  println(shown(C { n: 1 }))
  println(bounce(C { n: 1 }, 1000000))
}
