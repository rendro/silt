-- cmd: check
-- exit: 1
-- stderr-contains: error[compile]
-- stderr-contains: json.parse
-- stderr-contains: Bag
-- stderr-contains: items
-- stderr-contains: Set(Int)
import json

type Bag { name: String, items: Set(Int) }

fn main() {
  match json.parse("\{\"name\": \"b\", \"items\": \"oops\"\}", Bag) {
    Ok(v) -> println(v.name)
    Err(e) -> println("err: {e.message()}")
  }
}
