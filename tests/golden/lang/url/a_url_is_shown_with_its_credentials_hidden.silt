-- println and interpolation hide the user and password as `***@`;
-- io.inspect and a Url inside a structure write `<url:...>`;
-- url.to_string gives the whole text. An `@` in the path is no user.
import io
import url

type Site {
  name: String,
  home: url.Url,
}

fn main() -> Result((), url.UrlError) {
  let u = url.parse("https://ann:s3cret@example.com/x")?
  println(u)
  println("site: {u}")
  println(io.inspect(u))
  println([u])
  println(Some(u))
  println(Site { name: "ex", home: u })
  println(url.to_string(u))
  println(url.parse("https://h/users/@me")?)
  println(url.parse("https://TOKEN@github.com/")?)
  Ok(())
}
