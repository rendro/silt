-- the callback's io.read_file suspends the task mid-iteration
import task
import io
import list
fn main() {
  let xs: List(Int) = [3, 1, 2]
  let h = task.spawn({ ->
    list.max_by(xs, { x ->
      let _ = io.read_file("vm_higher_order_yield__list_max_by_callback_yield.silt")
      x
    })
  })
  let v = task.join(h)
  println(v)
}
