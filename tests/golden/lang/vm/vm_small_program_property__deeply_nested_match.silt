fn main() {
  let s = (1, 2, 3, 4, 5)
  let r = match s {
    (1, b, c, d, e) -> match b {
      0 -> 100
      1 -> 101
      2 -> match c {
        0 -> 200
        1 -> 201
        3 -> match d {
          0 -> 300
          1 -> 301
          4 -> match e {
            0 -> 400
            1 -> 401
            5 -> 555
            _ -> 499
          }
          _ -> 399
        }
        _ -> 299
      }
      _ -> 199
    }
    (_, _, _, _, _) -> 0
  }
  println(r)
}
