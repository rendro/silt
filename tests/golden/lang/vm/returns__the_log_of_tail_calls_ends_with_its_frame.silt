-- cmd: test
-- exit: 1
-- The log of the tail calls that took no frame belongs to the frame that
-- made them. When that frame has returned (a number, a Bool or unit,
-- which is written into the caller's slot; a value of any other kind), a
-- later failure at the same depth shows none of them in its call stack.
-- (A tail call of a function to itself takes no line: the functions here
-- call each other.)
import list
import task

fn count(n: Int, acc: Int) -> Int {
  match n {
    0 -> acc
    _ -> count_on(n - 1, acc + 1)
  }
}

fn count_on(n: Int, acc: Int) -> Int {
  count(n, acc)
}

fn countf(n: Int, acc: Float) -> Float {
  match n {
    0 -> acc
    _ -> countf_on(n - 1, acc + 0.5)
  }
}

fn countf_on(n: Int, acc: Float) -> Float {
  countf(n, acc)
}

fn countb(n: Int, acc: Bool) -> Bool {
  match n {
    0 -> acc
    _ -> countb_on(n - 1, acc != true)
  }
}

fn countb_on(n: Int, acc: Bool) -> Bool {
  countb(n, acc)
}

fn countu(n: Int) -> () {
  match n {
    0 -> ()
    _ -> countu_on(n - 1)
  }
}

fn countu_on(n: Int) -> () {
  countu(n)
}

fn counts(n: Int, acc: String) -> String {
  match n {
    0 -> acc
    _ -> counts_on(n - 1, "{acc}.")
  }
}

fn counts_on(n: Int, acc: String) -> String {
  counts(n, acc)
}

fn boom(n: Int) -> Int {
  10 / (n - n)
}

fn tailboom(n: Int) -> Int {
  match n {
    0 -> 10 / n
    _ -> tailboom_on(n - 1)
  }
}

fn tailboom_on(n: Int) -> Int {
  tailboom(n)
}

fn wrap(n: Int) -> Int {
  let v = count(n, 0)
  v + boom(v)
}

fn test_stale_int() {
  let a = count(50, 0)
  println(a)
  println(boom(a))
}

fn test_stale_float() {
  let a = countf(50, 0.0)
  println(a)
  println(boom(1))
}

fn test_stale_bool() {
  let a = countb(50, true)
  println(a)
  println(boom(1))
}

fn test_stale_unit() {
  let a = countu(50)
  println(a)
  println(boom(1))
}

fn test_stale_string() {
  let a = counts(50, "")
  println(a)
  println(boom(1))
}

fn test_real() {
  println(tailboom(30))
}

fn test_mixed() {
  let a = count(5, 0)
  println(tailboom(a))
}

fn test_nested() {
  println(1 + wrap(7))
}

fn test_callback() {
  println(list.map([3, 4]) { n -> count(n, 0) + boom(n) })
}

fn test_task() {
  println(task.map([3], 1) { n -> count(9, 0) + wrap(n) })
}

fn test_twice() {
  let a = count(3, 0) + count(4, 0)
  let b = countu(2)
  println(tailboom(a - 7 + 2))
}
