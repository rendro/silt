-- the callback's io.read_file suspends the task mid-iteration
import task
import io
import stream
fn main() {
  let h = task.spawn(fn() {
    let s = stream.from_list([10, 20, 30])
    stream.each(s, fn(x) {
      let _ = io.read_file("vm_higher_order_yield__stream_each_callback_yield.silt")
      println(x)
    })
  })
  let _ = task.join(h)
}
