-- the callback's io.read_file suspends the task mid-iteration
import task
import io
import list
fn main() {
  let h = task.spawn(fn() {
    list.unfold(0, fn(s) {
      let _ = io.read_file("vm_higher_order_yield__list_unfold_callback_yield.silt")
      match s < 3 {
        true -> Some((s * 10, s + 1)),
        false -> None,
      }
    })
  })
  let v = task.join(h)
  println(v)
}
