-- the callback's io.read_file suspends the task mid-iteration
import task
import io
import list
fn main() {
  let h = task.map([0], 1) { _ ->
    list.unfold(0, { s ->
      let _ = io.read_file("vm_higher_order_yield__list_unfold_callback_yield.silt")
      match s < 3 {
        true -> Some((s * 10, s + 1))
        false -> None
      }
    })
  }
  list.each(h) { v -> println(v) }
}
