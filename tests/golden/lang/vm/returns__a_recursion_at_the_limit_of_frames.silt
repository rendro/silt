-- A recursion may be 100,000 frames deep. One call under that limit every
-- frame returns its result, an Int (written into the caller's slot) or a
-- String (taken off the stack and pushed again); one call more is refused.
fn down(n: Int) -> Int {
  match n {
    0 -> 0
    _ -> 1 + down(n - 1)
  }
}

fn downs(n: Int) -> String {
  match n {
    0 -> "s"
    _ -> {
      let s = downs(n - 1)
      s
    }
  }
}

fn test_an_int_one_call_under_the_limit() {
  println(down(99997))
}

fn test_an_int_at_the_limit() {
  println(down(99998))
}

fn test_a_string_one_call_under_the_limit() {
  println(downs(99997))
}

fn test_a_string_at_the_limit() {
  println(downs(99998))
}
