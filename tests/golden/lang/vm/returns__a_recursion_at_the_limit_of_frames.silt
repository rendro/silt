-- A recursion may be as deep as the frame budget allows: with 1 MiB,
-- 11,603 levels of `down` and 15,471 of `downs` beside the frames of the
-- test. One call under that limit every frame returns its result, an Int
-- (written into the caller's slot) or a String (taken off the stack and
-- pushed again); one call more is refused.
fn down(n: Int) -> Int {
  match n {
    0 -> 0
    _ -> 1 + down(n - 1)
  }
}

fn downs(n: Int) -> String {
  match n {
    0 -> "s"
    _ -> {
      let s = downs(n - 1)
      s
    }
  }
}

fn test_an_int_one_call_under_the_limit() {
  println(down(11603))
}

fn test_an_int_at_the_limit() {
  println(down(11604))
}

fn test_a_string_one_call_under_the_limit() {
  println(downs(15471))
}

fn test_a_string_at_the_limit() {
  println(downs(15472))
}
