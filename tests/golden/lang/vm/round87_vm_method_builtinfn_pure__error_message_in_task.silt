-- `<ErrorEnum>.message` is a qualified-method BuiltinFn reached through
-- Op::CallMethod; calling it from inside a task and interleaving
-- with a channel hand-off must leave the task's stack intact.
import channel
import int
import io
import option
import task
fn main() {
  let ch = channel.new(1)
  let out = channel.new(1)
  let worker = { ->
    let a = match int.parse("x") {
      Ok(_) -> "ok"
      Err(e) -> "{e}"
    }
    channel.send(ch, a)
    let b = match io.read_file("round87_missing_file.txt") {
      Ok(_) -> "ok"
      Err(e) -> "{e}"
    }
    channel.send(out, "{a} | {b}")
  }
  let reader = { ->
    match channel.receive(ch) {
      Some(m) -> println(m)
      None -> println("no message")
    }
  }
  task.join([worker, reader])
  println(channel.receive(out) |> option.unwrap_or("no result"))
}
