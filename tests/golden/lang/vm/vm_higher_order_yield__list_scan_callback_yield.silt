-- the callback's io.read_file suspends the task mid-iteration
import task
import io
import list
fn main() {
  let xs: List(Int) = [1, 2, 3]
  let h = task.spawn({ ->
    list.scan(xs, 0, { acc, x ->
      let _ = io.read_file("vm_higher_order_yield__list_scan_callback_yield.silt")
      acc + x
    })
  })
  let v = task.join(h)
  println(v)
}
