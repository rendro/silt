-- `list.sort_with` sorts by a comparison function: below 0 puts the
-- first argument before the second, above 0 after it, 0 keeps the two
-- in the order of the list (the sort is stable). Checked against
-- `list.sort_by`, which is stable too, on lists of many lengths.
import list

fn by_key(a: (Int, Int), b: (Int, Int)) -> Int {
  let (x, _) = a
  let (y, _) = b
  x.compare(y)
}

fn main() {
  println(list.sort_with([]) { a, b -> a.compare(b) })
  println(list.sort_with([5]) { a, b -> a.compare(b) })
  println(list.sort_with([5, 3, 9, 1, 7]) { a, b -> a.compare(b) })
  println(list.sort_with([5, 3, 9, 1, 7]) { a, b -> b.compare(a) })
  -- Any Int counts, not only -1, 0 and 1.
  println(list.sort_with([2, 1, 3]) { a, b -> a.compare(b) * 1000000 })
  -- All equal: the order of the list.
  println(list.sort_with(["c", "a", "b"]) { _, _ -> 0 })
  -- A range.
  println(list.sort_with(1..6) { a, b -> b.compare(a) })
  -- Every length from 0 to 40, keys with many ties: the same as sort_by.
  let lengths = 0..40
  let all_same = lengths |> list.all { n ->
    let pairs = 0..n |> list.map { i -> ((i * 7) % 5, i) }
    list.sort_with(pairs, by_key) == list.sort_by(pairs) { (k, _) -> k }
  }
  println(all_same)
  println(list.sort_with([(1, 0), (0, 1), (1, 2), (0, 3)], by_key))
}
