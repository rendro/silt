-- exit: 1
-- stderr-contains: error[type]: type 'Fn' does not implement trait 'Equal'
import stream
import list
fn main() {
  let f = { y -> y }
  let g = { z -> z + 100 }
  let out = stream.from_list([f, g])
    |> stream.dedup
    |> stream.map({ x -> x })
    |> stream.collect
  println(list.length(out))
}
