  rowL("{kind} 16 arms that read other fields", before, shownL(nest), shownL(parmL(0, 7, nest)))
  rowL("{kind} 16 an alias read after", before, shownL(nest), shownL(paliasL(0, 5, nest)))
  rowL(
    "{kind} 16 another field read, the old one too",
    before,
    shownL(nest),
    poldL(0, 5, nest, nest),
  )
  let deep = DeepL { top: nest, n: 0 }
  let made = pdeepL(0, 7, deep)
  rowL("{kind} 16 three deep, fields read", before, shownL(deep.top), "{shownL(made.top)} {made.n}")
  let made = list.fold(xs, nest) { o, x ->
    o.{
      inner: o.inner.{
        c: match list.set(o.inner.c, x, x * 5 + 7) {
          Some(next) -> next
          None -> []
