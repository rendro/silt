        i + 1,
        n,
        o.{
          inner: o.inner.{ c: map.update(o.inner.c, i % 3, 0) { v -> v + 1 } },
          label: "{o.label}e",
        },
      )
      false -> parmU(
        i + 1,
        n,
        o.{ inner: o.inner.{ c: map.update(o.inner.c, i % 3, 0) { v -> v + 1 } }, spare: o.inner },
      )
    }
  }
}

fn paliasU(i: Int, n: Int, o: NestU) -> NestU {
  match i == n {
    true -> o
    false -> {
      let next = o.inner.{ c: map.update(o.inner.c, i % 3, 0) { v -> v + 1 } }
      let p = o
      paliasU(i + 1, n, o.{ inner: next, label: "{p.label}a", spare: p.inner })
    }
  }
}

fn poldU(i: Int, n: Int, o: NestU, old: NestU) -> String {
  match i == n {
    true -> "{shownU(o)} old {shownU(old)}"
    false -> poldU(
      i + 1,
      n,
      o.{
        inner: o.inner.{ c: map.update(o.inner.c, i % 3, 0) { v -> v + 1 } },
        label: "{o.label}o",
      },
      o,
    )
  }
}

fn pdeepU(i: Int, n: Int, d: DeepU) -> DeepU {
  match i == n {
    true -> d
    false -> pdeepU(
      i + 1,
