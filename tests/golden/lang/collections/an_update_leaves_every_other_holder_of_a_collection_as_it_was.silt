  rowL("{kind} 16 a fold, another field read", before, shownL(nest), shownL(made))
  let made = list.fold(xs, nest) { o, x ->
    o.{
      inner: o.inner.{
        c: match list.set(o.inner.c, x, x * 5 + 7) {
