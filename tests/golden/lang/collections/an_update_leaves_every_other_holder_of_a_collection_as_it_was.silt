-- ── list.set: a field of the outer record read in the same update ──

fn shownL(o: NestL) -> String {
  "{o.label}:{fpL(o.inner.c)}:{fpL(o.spare.c)}"
}

fn plabelL(i: Int, n: Int, o: NestL) -> NestL {
  match i == n {
    true -> o
    false -> plabelL(
      i + 1,
      n,
      o.{
        inner: o.inner.{
          c: match list.set(o.inner.c, i % 3, i % 3 * 5 + 7) {
            Some(next) -> next
            None -> []
          },
        },
        label: "{o.label}.",
      },
    )
  }
}

fn pinnerL(i: Int, n: Int, o: NestL) -> NestL {
  match i == n {
    true -> o
    false -> pinnerL(
      i + 1,
