    NestL { label: "own", inner: BoxL { label: "i", c: make(), d: make() }, spare: box },
  )
  rowL("{kind} 16 held nowhere else, another field read", before, shownL(nest), shownL(own))
}

fn main() {
  eachM("tree", treeM)
  eachM("small", flatM)
  eachU("tree", treeU)
  eachU("small", flatU)
  eachS("tree", treeS)
  eachS("small", flatS)
  eachA("tree", treeA)
  eachA("small", flatA)
  eachL("tree", treeL)
  eachL("small", flatL)
  moreM("tree", treeM)
  moreM("small", flatM)
  moreU("tree", treeU)
  moreU("small", flatU)
  moreS("tree", treeS)
  moreS("small", flatS)
  moreA("tree", treeA)
  moreA("small", flatA)
  moreL("tree", treeL)
  moreL("small", flatL)
  partM("tree", treeM)
  partM("small", flatM)
  partU("tree", treeU)
  partU("small", flatU)
  partS("tree", treeS)
  partS("small", flatS)
  partA("tree", treeA)
  partA("small", flatA)
  partL("tree", treeL)
  partL("small", flatL)
}
