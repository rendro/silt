      d.{
        top: d.top.{
          inner: d.top.inner.{ c: map.update(d.top.inner.c, i % 3, 0) { v -> v + 1 } },
          label: "{d.top.label}d",
        },
        n: d.n + 1,
      },
    )
  }
}

fn partU(kind: String, make: Fn() -> Map(Int, Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let box = BoxU { label: "b", c: c, d: c }
  let nest = NestU { label: "o", inner: box, spare: box }
  let before = shownU(nest)
  rowU(
    "{kind} 16 another field read in the update",
    before,
    shownU(nest),
    shownU(plabelU(0, 7, nest)),
  )
  rowU(
    "{kind} 16 the inner record read in the update",
    before,
    shownU(nest),
    shownU(pinnerU(0, 7, nest)),
  )
  rowU(
    "{kind} 16 the whole record read in the update",
    before,
    shownU(nest),
    shownU(pwholeU(0, 3, nest)),
  )
  rowU("{kind} 16 two other fields read", before, shownU(nest), shownU(ptwoU(0, 5, nest)))
  rowU("{kind} 16 arms that read other fields", before, shownU(nest), shownU(parmU(0, 7, nest)))
  rowU("{kind} 16 an alias read after", before, shownU(nest), shownU(paliasU(0, 5, nest)))
  rowU(
    "{kind} 16 another field read, the old one too",
    before,
    shownU(nest),
    poldU(0, 5, nest, nest),
  )
  let deep = DeepU { top: nest, n: 0 }
  let made = pdeepU(0, 7, deep)
  rowU("{kind} 16 three deep, fields read", before, shownU(deep.top), "{shownU(made.top)} {made.n}")
  let made = list.fold(xs, nest) { o, x ->
    o.{ inner: o.inner.{ c: map.update(o.inner.c, x, 0) { v -> v + 1 } }, label: "{o.label}f" }
  }
  rowU("{kind} 16 a fold, another field read", before, shownU(nest), shownU(made))
  let made = list.fold(xs, nest) { o, x ->
    o.{ inner: o.inner.{ c: map.update(o.inner.c, x, 0) { v -> v + 1 } }, spare: o.inner }
  }
  rowU("{kind} 16 a fold, the inner record read", before, shownU(nest), shownU(made))
  let own = plabelU(
    0,
    3,
    NestU { label: "own", inner: BoxU { label: "i", c: make(), d: make() }, spare: box },
  )
  rowU("{kind} 16 held nowhere else, another field read", before, shownU(nest), shownU(own))
}

