-- A collection that a program holds anywhere else stays as it was when an
-- update is made of it: a let, a function's frame, a closure, a record,
-- a tuple, a list, an Option, a channel, another task, a fold's state, a
-- function that calls itself with it (with the old one, with it twice,
-- with a history of them), a record that holds it in such a function.
-- Each row prints the held one before and after ("same") and the one
-- made. map.set, map.update, set.insert, list.append and list.set may
-- change a collection in place when nothing else holds it; this file's
-- output is what it was when each was a copy. Rows 12 to 15: the update
-- made by a function of the program or a method, a method called after
-- it, the builtin as a value, a record in a record. Rows 16: a record in
-- a record whose outer record is read in the same update, by another
-- field, by the inner one, whole, in arms, through an alias.
import channel
import list
import map
import option
import set
import task

-- ── map.set ───────────────────────────────────────────────

type BoxM {
  label: String,
  c: Map(Int, Int),
  d: Map(Int, Int),
}

fn fpM(c: Map(Int, Int)) -> String {
  "{map.length(c)}/{map.fold(c, 0) { a, k, v -> a + k * 7 + v }}"
}

fn treeM() -> Map(Int, Int) {
  list.fold(0..99, #{}) { a, i -> map.set(a, i, i) }
}

fn flatM() -> Map(Int, Int) {
  #{ 1: 10, 2: 20, 3: 30 }
}

fn tailM(c: Map(Int, Int)) -> Map(Int, Int) {
  map.set(c, 1, 1 * 3 + 1)
}

fn viaM(c: Map(Int, Int)) -> Map(Int, Int) {
  tailM(c)
}

fn localsM(c: Map(Int, Int)) -> Map(Int, Int) {
  let a = c
  let b = a
  match b {
    e -> map.set(e, 2, 2 * 3 + 1)
  }
}

fn foldM(c: Map(Int, Int), xs: List(Int)) -> Map(Int, Int) {
  list.fold(xs, c) { acc, x -> map.set(acc, x, x * 3 + 1) }
}

-- a function that calls itself with the collection as its last argument
fn lastM(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> lastM(i + 1, n, map.set(acc, i % 3, i % 3 * 3 + 1))
  }
}

-- with it as its first argument
fn firstM(acc: Map(Int, Int), i: Int, n: Int) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> firstM(map.set(acc, i % 3, i % 3 * 3 + 1), i + 1, n)
  }
}

-- through a let
fn namedM(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> {
      let next = map.set(acc, i % 3, i % 3 * 3 + 1)
      namedM(i + 1, n, next)
    }
  }
}

-- the old one handed on too
fn oldM(i: Int, n: Int, acc: Map(Int, Int), old: Map(Int, Int)) -> String {
  match i == n {
    true -> "{fpM(acc)} old {fpM(old)}"
    false -> oldM(i + 1, n, map.set(acc, i % 3, i % 3 * 3 + 1), acc)
  }
}

-- the same one handed on twice
fn twiceM(i: Int, n: Int, acc: Map(Int, Int), same: Map(Int, Int)) -> String {
  match i == n {
    true -> "{fpM(acc)} same {fpM(same)}"
    false -> twiceM(i + 1, n, acc, map.set(acc, i % 3, i % 3 * 3 + 1))
  }
}

-- every old one kept in a list
fn histM(i: Int, n: Int, acc: Map(Int, Int), olds: List(Map(Int, Int))) -> String {
  match i == n {
    true -> "{fpM(acc)} olds {list.map(olds) { o -> fpM(o) }}"
    false -> histM(i + 1, n, map.set(acc, i % 3, i % 3 * 3 + 1), [acc, ..olds])
  }
}

-- a closure of each round keeps the old one
fn seenM(i: Int, n: Int, acc: Map(Int, Int), looks: List(Fn() -> String)) -> String {
  match i == n {
    true -> "{fpM(acc)} looks {list.map(looks) { f -> f() }}"
    false -> seenM(i + 1, n, map.set(acc, i % 3, i % 3 * 3 + 1), [{ -> fpM(acc) }, ..looks])
  }
}

-- an arm that does not change it reads it
fn armM(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> match i % 2 == 0 {
      true -> armM(i + 1, n, map.set(acc, i % 3, i % 3 * 3 + 1))
      false -> armM(i + 1, n, acc)
    }
  }
}

-- each old one sent on a channel
fn sentM(i: Int, n: Int, acc: Map(Int, Int), ch: Channel(Map(Int, Int))) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> {
      channel.send(ch, acc)
      sentM(i + 1, n, map.set(acc, i % 3, i % 3 * 3 + 1), ch)
    }
  }
}

-- a record that holds it, handed on
fn recM(i: Int, n: Int, b: BoxM) -> BoxM {
  match i == n {
    true -> b
    false -> recM(i + 1, n, b.{ c: map.set(b.c, i % 3, i % 3 * 3 + 1) })
  }
}

-- the record handed on, and the old record too
fn recoldM(i: Int, n: Int, b: BoxM, old: BoxM) -> String {
  match i == n {
    true -> "{fpM(b.c)} old {fpM(old.c)} {old.label}"
    false -> recoldM(i + 1, n, b.{ c: map.set(b.c, i % 3, i % 3 * 3 + 1), label: "r{i}" }, b)
  }
}

-- a field updated from another one
fn recotherM(i: Int, n: Int, b: BoxM) -> BoxM {
  match i == n {
    true -> b
    false -> recotherM(i + 1, n, b.{ d: map.set(b.c, i % 3, i % 3 * 3 + 1) })
  }
}

-- two updates of the record in a row
fn rectwoM(i: Int, n: Int, b: BoxM) -> BoxM {
  match i == n {
    true -> b
    false -> rectwoM(
      i + 1,
      n,
      b.{ c: map.set(b.c, i % 3, i % 3 * 3 + 1) }
        .{ d: map.set(b.d, (i + 1) % 3, (i + 1) % 3 * 3 + 1) },
    )
  }
}

-- a record whose function reads it again in an arm
fn recarmM(i: Int, n: Int, b: BoxM) -> BoxM {
  match i == n {
    true -> b
    false -> match i % 2 == 0 {
      true -> recarmM(i + 1, n, b.{ c: map.set(b.c, i % 3, i % 3 * 3 + 1) })
      false -> recarmM(i + 1, n, b.{ label: "{b.label}." })
    }
  }
}

fn rowM(name: String, before: String, after: String, made: String) {
  let verdict = match before == after {
    true -> "same"
    false -> "CHANGED UNDER ITS HOLDER"
  }
  println("map.set {name}: {verdict} {before} -> {after}; made {made}")
}

fn eachM(kind: String, make: Fn() -> Map(Int, Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let before = fpM(c)
  let n = map.set(c, 1, 1 * 3 + 1)
  rowM("{kind} 1 a let read after", before, fpM(c), fpM(n))
  rowM("{kind} 2 returned at once", before, fpM(c), fpM(tailM(c)))
  rowM("{kind} 2 through a tail call", before, fpM(c), fpM(viaM(c)))
  rowM("{kind} 2 copies in the frame", before, fpM(c), fpM(localsM(c)))
  let look = { -> fpM(c) }
  rowM("{kind} 3 a closure", before, look(), fpM(foldM(c, xs)))
  let box = BoxM { label: "b", c: c, d: c }
  let pair = (c, 1)
  let items = [c, c]
  let maybe = Some(c)
  rowM("{kind} 4 a record field", before, fpM(box.c), fpM(foldM(box.c, xs)))
  let (first, _) = pair
  let made = foldM(first, xs)
  let (again, _) = pair
  rowM("{kind} 4 a tuple", before, fpM(again), fpM(made))
  let changed = list.map(items) { it -> tailM(it) }
  rowM(
    "{kind} 4 list elements",
    "{[before, before]}",
    "{list.map(items) { it -> fpM(it) }}",
    "{list.map(changed) { it -> fpM(it) }}",
  )
  let changed = option.map(maybe) { it -> tailM(it) }
  rowM(
    "{kind} 4 an Option",
    before,
    fpM(option.unwrap_or(maybe, #{})),
    fpM(option.unwrap_or(changed, #{})),
  )
  let updated = box.{ c: map.set(box.c, 1, 1 * 3 + 1) }
  rowM(
    "{kind} 4 a record update",
    "{before} {before}",
    "{fpM(box.c)} {fpM(box.d)}",
    "{fpM(updated.c)} {fpM(updated.d)}",
  )
  let ch = channel.new(4)
  channel.send(ch, c)
  let made = foldM(c, xs)
  let got = match channel.receive(ch) {
    Some(v) -> fpM(v)
    None -> "closed"
  }
  rowM("{kind} 5 a channel message", before, got, fpM(made))
  let go = channel.new(1)
  let seen = channel.new(1)
  let results = channel.new(2)
  task.join(
    [
      { ->
        let _ = channel.receive(go)
        channel.send(seen, fpM(c))
      },
      { ->
        channel.send(results, foldM(c, xs))
        channel.send(results, lastM(0, 5, c))
        channel.send(go, ())
      },
    ],
  )
  let got = match channel.receive(seen) {
    Some(v) -> v
    None -> "closed"
  }
  let made = list.map(0..1) { _ ->
    match channel.receive(results) {
      Some(v) -> fpM(v)
      None -> "closed"
    }
  }
  rowM("{kind} 5 another task", before, got, "{made}")
  let made = task.map([c, c], 2) { it -> lastM(0, 6, foldM(it, xs)) }
  rowM("{kind} 5 changed in other tasks", before, fpM(c), "{list.map(made) { it -> fpM(it) }}")
  let made = list.fold_until(xs, c) { acc, x ->
    match x == 0 {
      true -> Stop(map.set(acc, x, x * 3 + 1))
      false -> Continue(map.set(acc, x, x * 3 + 1))
    }
  }
  rowM("{kind} 6 fold_until", before, fpM(c), fpM(made))
  let made = set.fold(set.from_list(xs), c) { acc, x -> map.set(acc, x, x * 3 + 1) }
  rowM("{kind} 6 set.fold", before, fpM(c), fpM(made))
  let olds = channel.new(16)
  let made = list.fold(xs, c) { acc, x ->
    channel.send(olds, acc)
    map.set(acc, x, x * 3 + 1)
  }
  channel.close(olds)
  let kept = list.map(0..6) { _ ->
    match channel.receive(olds) {
      Some(v) -> fpM(v)
      None -> "closed"
    }
  }
  println("map.set {kind} 7 a step that sends the old one away: {kept}; made {fpM(made)}")
  let (made, history) = list.fold(xs, (c, [])) { (acc, hist), x ->
    let next = map.set(acc, x, x * 3 + 1)
    (next, [acc, ..hist])
  }
  println(
    "map.set {kind} 7 a step that keeps the old ones: {list.map(history) { h -> fpM(h) }}; made {fpM(made)}",
  )
  let snapshots = list.scan(xs, c) { acc, x -> map.set(acc, x, x * 3 + 1) }
  println("map.set {kind} 7 list.scan: {list.map(snapshots) { s -> fpM(s) }}")
  let made = list.fold(xs, c) { acc, x ->
    match x == 1 {
      true -> acc
      false -> map.set(acc, x, x * 3 + 1)
    }
  }
  rowM("{kind} 7 a step that sometimes gives it back", before, fpM(c), fpM(made))
  let made = list.fold(xs, c) { acc, x ->
    list.fold(xs, acc) { inner, y -> map.set(inner, (x + y) % 3, (x + y) % 3 * 3 + 1) }
  }
  rowM("{kind} 7 a fold in a fold", before, fpM(c), fpM(made))
  let made = list.fold(xs, c) { acc, x ->
    let size = fpM(acc)
    let next = map.set(acc, x, x * 3 + 1)
    match size == fpM(acc) {
      true -> next
      false -> #{}
    }
  }
  rowM("{kind} 7 a step that reads it after the change", before, fpM(c), fpM(made))
  rowM("{kind} 8 a loop, last argument", before, fpM(c), fpM(lastM(0, 7, c)))
  rowM("{kind} 8 a loop, first argument", before, fpM(c), fpM(firstM(c, 0, 7)))
  rowM("{kind} 8 a loop through a let", before, fpM(c), fpM(namedM(0, 7, c)))
  rowM("{kind} 8 a loop with the old one", before, fpM(c), oldM(0, 7, c, c))
  rowM("{kind} 8 a loop with it twice", before, fpM(c), twiceM(0, 7, c, c))
  rowM("{kind} 8 a loop that keeps the old ones", before, fpM(c), histM(0, 4, c, []))
  rowM("{kind} 8 a loop whose closures keep the old ones", before, fpM(c), seenM(0, 4, c, []))
  rowM("{kind} 8 a loop whose other arm reads it", before, fpM(c), fpM(armM(0, 7, c)))
  let ch = channel.new(16)
  let made = sentM(0, 4, c, ch)
  channel.close(ch)
  let got = list.map(0..3) { _ ->
    match channel.receive(ch) {
      Some(v) -> fpM(v)
      None -> "closed"
    }
  }
  rowM("{kind} 8 a loop that sends the old ones", before, fpM(c), "{fpM(made)} sent {got}")
  let start = BoxM { label: "s", c: c, d: c }
  let made = recM(0, 7, start)
  rowM(
    "{kind} 9 a record in a loop",
    "{before} {before}",
    "{fpM(start.c)} {fpM(start.d)}",
    "{fpM(made.c)} {fpM(made.d)}",
  )
  rowM(
    "{kind} 9 a record in a loop, its old one too",
    before,
    fpM(start.c),
    recoldM(0, 5, start, start),
  )
  let made = recotherM(0, 7, start)
  rowM(
    "{kind} 9 a record field from another",
    "{before} {before}",
    "{fpM(start.c)} {fpM(start.d)}",
    "{fpM(made.c)} {fpM(made.d)}",
  )
  let made = rectwoM(0, 7, start)
  rowM(
    "{kind} 9 two record updates",
    "{before} {before}",
    "{fpM(start.c)} {fpM(start.d)}",
    "{fpM(made.c)} {fpM(made.d)}",
  )
  let made = recarmM(0, 7, start)
  rowM("{kind} 9 a record read in another arm", before, fpM(start.c), "{fpM(made.c)} {made.label}")
  let made = recM(0, 3, BoxM { label: "own", c: make(), d: #{} })
  rowM("{kind} 9 a record held nowhere else", before, fpM(c), fpM(made.c))
  let made = list.fold(xs, start) { b, x -> b.{ c: map.set(b.c, x, x * 3 + 1) } }
  rowM(
    "{kind} 9 a record in a fold",
    "{before} {before}",
    "{fpM(start.c)} {fpM(start.d)}",
    fpM(made.c),
  )
  let kept = [start]
  let made = list.fold(xs, start) { b, x -> b.{ d: map.set(b.d, x, x * 3 + 1) } }
  rowM(
    "{kind} 9 a record in a fold, held in a list",
    before,
    fpM(option.unwrap_or(list.first(kept), start).d),
    fpM(made.d),
  )
  let failing = task.guard { ->
    list.fold(xs, c) { acc, x ->
      match x == 0 {
        true -> panic("stop")
        false -> map.set(acc, x, x * 3 + 1)
      }
    }
  }
  let ended = match failing {
    Ok(_) -> "done"
    Err(_) -> "failed"
  }
  rowM("{kind} 10 a task that fails part way", before, fpM(c), ended)
  let other = make()
  let by = #{ c: "first" }
  let members = set.from_list([c])
  let made = foldM(c, xs)
  let made2 = lastM(0, 5, other)
  println(
    "map.set {kind} 11 a key and a member: {map.get(by, c)} {set.contains(members, c)} {c == other} {made == foldM(make(), xs)} {made2 == lastM(0, 5, make())} {map.get(#{ made: 1 }, foldM(make(), xs))}",
  )
}

-- ── map.update ───────────────────────────────────────────────

type BoxU {
  label: String,
  c: Map(Int, Int),
  d: Map(Int, Int),
}

fn fpU(c: Map(Int, Int)) -> String {
  "{map.length(c)}/{map.fold(c, 0) { a, k, v -> a + k * 7 + v }}"
}

fn treeU() -> Map(Int, Int) {
  list.fold(0..99, #{}) { a, i -> map.set(a, i, i) }
}

fn flatU() -> Map(Int, Int) {
  #{ 1: 10, 2: 20, 3: 30 }
}

fn tailU(c: Map(Int, Int)) -> Map(Int, Int) {
  map.update(c, 1, 0) { v -> v + 1 }
}

fn viaU(c: Map(Int, Int)) -> Map(Int, Int) {
  tailU(c)
}

fn localsU(c: Map(Int, Int)) -> Map(Int, Int) {
  let a = c
  let b = a
  match b {
    e -> map.update(e, 2, 0) { v -> v + 1 }
  }
}

fn foldU(c: Map(Int, Int), xs: List(Int)) -> Map(Int, Int) {
  list.fold(xs, c) { acc, x -> map.update(acc, x, 0) { v -> v + 1 } }
}

-- a function that calls itself with the collection as its last argument
fn lastU(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> lastU(i + 1, n, map.update(acc, i % 3, 0) { v -> v + 1 })
  }
}

-- with it as its first argument
fn firstU(acc: Map(Int, Int), i: Int, n: Int) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> firstU(map.update(acc, i % 3, 0) { v -> v + 1 }, i + 1, n)
  }
}

-- through a let
fn namedU(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> {
      let next = map.update(acc, i % 3, 0) { v -> v + 1 }
      namedU(i + 1, n, next)
    }
  }
}

-- the old one handed on too
fn oldU(i: Int, n: Int, acc: Map(Int, Int), old: Map(Int, Int)) -> String {
  match i == n {
    true -> "{fpU(acc)} old {fpU(old)}"
    false -> oldU(i + 1, n, map.update(acc, i % 3, 0) { v -> v + 1 }, acc)
  }
}

-- the same one handed on twice
fn twiceU(i: Int, n: Int, acc: Map(Int, Int), same: Map(Int, Int)) -> String {
  match i == n {
    true -> "{fpU(acc)} same {fpU(same)}"
    false -> twiceU(i + 1, n, acc, map.update(acc, i % 3, 0) { v -> v + 1 })
  }
}

-- every old one kept in a list
fn histU(i: Int, n: Int, acc: Map(Int, Int), olds: List(Map(Int, Int))) -> String {
  match i == n {
    true -> "{fpU(acc)} olds {list.map(olds) { o -> fpU(o) }}"
    false -> histU(i + 1, n, map.update(acc, i % 3, 0) { v -> v + 1 }, [acc, ..olds])
  }
}

-- a closure of each round keeps the old one
fn seenU(i: Int, n: Int, acc: Map(Int, Int), looks: List(Fn() -> String)) -> String {
  match i == n {
    true -> "{fpU(acc)} looks {list.map(looks) { f -> f() }}"
    false -> seenU(i + 1, n, map.update(acc, i % 3, 0) { v -> v + 1 }, [{ -> fpU(acc) }, ..looks])
  }
}

-- an arm that does not change it reads it
fn armU(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> match i % 2 == 0 {
      true -> armU(i + 1, n, map.update(acc, i % 3, 0) { v -> v + 1 })
      false -> armU(i + 1, n, acc)
    }
  }
}

-- each old one sent on a channel
fn sentU(i: Int, n: Int, acc: Map(Int, Int), ch: Channel(Map(Int, Int))) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> {
      channel.send(ch, acc)
      sentU(i + 1, n, map.update(acc, i % 3, 0) { v -> v + 1 }, ch)
    }
  }
}

-- a record that holds it, handed on
fn recU(i: Int, n: Int, b: BoxU) -> BoxU {
  match i == n {
    true -> b
    false -> recU(i + 1, n, b.{ c: map.update(b.c, i % 3, 0) { v -> v + 1 } })
  }
}

-- the record handed on, and the old record too
fn recoldU(i: Int, n: Int, b: BoxU, old: BoxU) -> String {
  match i == n {
    true -> "{fpU(b.c)} old {fpU(old.c)} {old.label}"
    false -> recoldU(i + 1, n, b.{ c: map.update(b.c, i % 3, 0) { v -> v + 1 }, label: "r{i}" }, b)
  }
}

-- a field updated from another one
fn recotherU(i: Int, n: Int, b: BoxU) -> BoxU {
  match i == n {
    true -> b
    false -> recotherU(i + 1, n, b.{ d: map.update(b.c, i % 3, 0) { v -> v + 1 } })
  }
}

-- two updates of the record in a row
fn rectwoU(i: Int, n: Int, b: BoxU) -> BoxU {
  match i == n {
    true -> b
    false -> rectwoU(
      i + 1,
      n,
      b.{ c: map.update(b.c, i % 3, 0) { v -> v + 1 } }
        .{ d: map.update(b.d, (i + 1) % 3, 0) { v -> v + 1 } },
    )
  }
}

-- a record whose function reads it again in an arm
fn recarmU(i: Int, n: Int, b: BoxU) -> BoxU {
  match i == n {
    true -> b
    false -> match i % 2 == 0 {
      true -> recarmU(i + 1, n, b.{ c: map.update(b.c, i % 3, 0) { v -> v + 1 } })
      false -> recarmU(i + 1, n, b.{ label: "{b.label}." })
    }
  }
}

fn rowU(name: String, before: String, after: String, made: String) {
  let verdict = match before == after {
    true -> "same"
    false -> "CHANGED UNDER ITS HOLDER"
  }
  println("map.update {name}: {verdict} {before} -> {after}; made {made}")
}

fn eachU(kind: String, make: Fn() -> Map(Int, Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let before = fpU(c)
  let n = map.update(c, 1, 0) { v -> v + 1 }
  rowU("{kind} 1 a let read after", before, fpU(c), fpU(n))
  rowU("{kind} 2 returned at once", before, fpU(c), fpU(tailU(c)))
  rowU("{kind} 2 through a tail call", before, fpU(c), fpU(viaU(c)))
  rowU("{kind} 2 copies in the frame", before, fpU(c), fpU(localsU(c)))
  let look = { -> fpU(c) }
  rowU("{kind} 3 a closure", before, look(), fpU(foldU(c, xs)))
  let box = BoxU { label: "b", c: c, d: c }
  let pair = (c, 1)
  let items = [c, c]
  let maybe = Some(c)
  rowU("{kind} 4 a record field", before, fpU(box.c), fpU(foldU(box.c, xs)))
  let (first, _) = pair
  let made = foldU(first, xs)
  let (again, _) = pair
  rowU("{kind} 4 a tuple", before, fpU(again), fpU(made))
  let changed = list.map(items) { it -> tailU(it) }
  rowU(
    "{kind} 4 list elements",
    "{[before, before]}",
    "{list.map(items) { it -> fpU(it) }}",
    "{list.map(changed) { it -> fpU(it) }}",
  )
  let changed = option.map(maybe) { it -> tailU(it) }
  rowU(
    "{kind} 4 an Option",
    before,
    fpU(option.unwrap_or(maybe, #{})),
    fpU(option.unwrap_or(changed, #{})),
  )
  let updated = box.{ c: map.update(box.c, 1, 0) { v -> v + 1 } }
  rowU(
    "{kind} 4 a record update",
    "{before} {before}",
    "{fpU(box.c)} {fpU(box.d)}",
    "{fpU(updated.c)} {fpU(updated.d)}",
  )
  let ch = channel.new(4)
  channel.send(ch, c)
  let made = foldU(c, xs)
  let got = match channel.receive(ch) {
    Some(v) -> fpU(v)
    None -> "closed"
  }
  rowU("{kind} 5 a channel message", before, got, fpU(made))
  let go = channel.new(1)
  let seen = channel.new(1)
  let results = channel.new(2)
  task.join(
    [
      { ->
        let _ = channel.receive(go)
        channel.send(seen, fpU(c))
      },
      { ->
        channel.send(results, foldU(c, xs))
        channel.send(results, lastU(0, 5, c))
        channel.send(go, ())
      },
    ],
  )
  let got = match channel.receive(seen) {
    Some(v) -> v
    None -> "closed"
  }
  let made = list.map(0..1) { _ ->
    match channel.receive(results) {
      Some(v) -> fpU(v)
      None -> "closed"
    }
  }
  rowU("{kind} 5 another task", before, got, "{made}")
  let made = task.map([c, c], 2) { it -> lastU(0, 6, foldU(it, xs)) }
  rowU("{kind} 5 changed in other tasks", before, fpU(c), "{list.map(made) { it -> fpU(it) }}")
  let made = list.fold_until(xs, c) { acc, x ->
    match x == 0 {
      true -> Stop(map.update(acc, x, 0) { v -> v + 1 })
      false -> Continue(map.update(acc, x, 0) { v -> v + 1 })
    }
  }
  rowU("{kind} 6 fold_until", before, fpU(c), fpU(made))
  let made = set.fold(set.from_list(xs), c) { acc, x -> map.update(acc, x, 0) { v -> v + 1 } }
  rowU("{kind} 6 set.fold", before, fpU(c), fpU(made))
  let olds = channel.new(16)
  let made = list.fold(xs, c) { acc, x ->
    channel.send(olds, acc)
    map.update(acc, x, 0) { v -> v + 1 }
  }
  channel.close(olds)
  let kept = list.map(0..6) { _ ->
    match channel.receive(olds) {
      Some(v) -> fpU(v)
      None -> "closed"
    }
  }
  println("map.update {kind} 7 a step that sends the old one away: {kept}; made {fpU(made)}")
  let (made, history) = list.fold(xs, (c, [])) { (acc, hist), x ->
    let next = map.update(acc, x, 0) { v -> v + 1 }
    (next, [acc, ..hist])
  }
  println(
    "map.update {kind} 7 a step that keeps the old ones: {list.map(history) { h -> fpU(h) }}; made {fpU(made)}",
  )
  let snapshots = list.scan(xs, c) { acc, x -> map.update(acc, x, 0) { v -> v + 1 } }
  println("map.update {kind} 7 list.scan: {list.map(snapshots) { s -> fpU(s) }}")
  let made = list.fold(xs, c) { acc, x ->
    match x == 1 {
      true -> acc
      false -> map.update(acc, x, 0) { v -> v + 1 }
    }
  }
  rowU("{kind} 7 a step that sometimes gives it back", before, fpU(c), fpU(made))
  let made = list.fold(xs, c) { acc, x ->
    list.fold(xs, acc) { inner, y -> map.update(inner, (x + y) % 3, 0) { v -> v + 1 } }
  }
  rowU("{kind} 7 a fold in a fold", before, fpU(c), fpU(made))
  let made = list.fold(xs, c) { acc, x ->
    let size = fpU(acc)
    let next = map.update(acc, x, 0) { v -> v + 1 }
    match size == fpU(acc) {
      true -> next
      false -> #{}
    }
  }
  rowU("{kind} 7 a step that reads it after the change", before, fpU(c), fpU(made))
  rowU("{kind} 8 a loop, last argument", before, fpU(c), fpU(lastU(0, 7, c)))
  rowU("{kind} 8 a loop, first argument", before, fpU(c), fpU(firstU(c, 0, 7)))
  rowU("{kind} 8 a loop through a let", before, fpU(c), fpU(namedU(0, 7, c)))
  rowU("{kind} 8 a loop with the old one", before, fpU(c), oldU(0, 7, c, c))
  rowU("{kind} 8 a loop with it twice", before, fpU(c), twiceU(0, 7, c, c))
  rowU("{kind} 8 a loop that keeps the old ones", before, fpU(c), histU(0, 4, c, []))
  rowU("{kind} 8 a loop whose closures keep the old ones", before, fpU(c), seenU(0, 4, c, []))
  rowU("{kind} 8 a loop whose other arm reads it", before, fpU(c), fpU(armU(0, 7, c)))
  let ch = channel.new(16)
  let made = sentU(0, 4, c, ch)
  channel.close(ch)
  let got = list.map(0..3) { _ ->
    match channel.receive(ch) {
      Some(v) -> fpU(v)
      None -> "closed"
    }
  }
  rowU("{kind} 8 a loop that sends the old ones", before, fpU(c), "{fpU(made)} sent {got}")
  let start = BoxU { label: "s", c: c, d: c }
  let made = recU(0, 7, start)
  rowU(
    "{kind} 9 a record in a loop",
    "{before} {before}",
    "{fpU(start.c)} {fpU(start.d)}",
    "{fpU(made.c)} {fpU(made.d)}",
  )
  rowU(
    "{kind} 9 a record in a loop, its old one too",
    before,
    fpU(start.c),
    recoldU(0, 5, start, start),
  )
  let made = recotherU(0, 7, start)
  rowU(
    "{kind} 9 a record field from another",
    "{before} {before}",
    "{fpU(start.c)} {fpU(start.d)}",
    "{fpU(made.c)} {fpU(made.d)}",
  )
  let made = rectwoU(0, 7, start)
  rowU(
    "{kind} 9 two record updates",
    "{before} {before}",
    "{fpU(start.c)} {fpU(start.d)}",
    "{fpU(made.c)} {fpU(made.d)}",
  )
  let made = recarmU(0, 7, start)
  rowU("{kind} 9 a record read in another arm", before, fpU(start.c), "{fpU(made.c)} {made.label}")
  let made = recU(0, 3, BoxU { label: "own", c: make(), d: #{} })
  rowU("{kind} 9 a record held nowhere else", before, fpU(c), fpU(made.c))
  let made = list.fold(xs, start) { b, x -> b.{ c: map.update(b.c, x, 0) { v -> v + 1 } } }
  rowU(
    "{kind} 9 a record in a fold",
    "{before} {before}",
    "{fpU(start.c)} {fpU(start.d)}",
    fpU(made.c),
  )
  let kept = [start]
  let made = list.fold(xs, start) { b, x -> b.{ d: map.update(b.d, x, 0) { v -> v + 1 } } }
  rowU(
    "{kind} 9 a record in a fold, held in a list",
    before,
    fpU(option.unwrap_or(list.first(kept), start).d),
    fpU(made.d),
  )
  let failing = task.guard { ->
    list.fold(xs, c) { acc, x ->
      match x == 0 {
        true -> panic("stop")
        false -> map.update(acc, x, 0) { v -> v + 1 }
      }
    }
  }
  let ended = match failing {
    Ok(_) -> "done"
    Err(_) -> "failed"
  }
  rowU("{kind} 10 a task that fails part way", before, fpU(c), ended)
  let other = make()
  let by = #{ c: "first" }
  let members = set.from_list([c])
  let made = foldU(c, xs)
  let made2 = lastU(0, 5, other)
  println(
    "map.update {kind} 11 a key and a member: {map.get(by, c)} {set.contains(members, c)} {c == other} {made == foldU(make(), xs)} {made2 == lastU(0, 5, make())} {map.get(#{ made: 1 }, foldU(make(), xs))}",
  )
}

-- ── set.insert ───────────────────────────────────────────────

type BoxS {
  label: String,
  c: Set(Int),
  d: Set(Int),
}

fn fpS(c: Set(Int)) -> String {
  "{set.length(c)}/{set.fold(c, 0) { a, x -> a + x }}"
}

fn treeS() -> Set(Int) {
  list.fold(0..99, #[]) { a, i -> set.insert(a, i) }
}

fn flatS() -> Set(Int) {
  #[1, 2, 3]
}

fn tailS(c: Set(Int)) -> Set(Int) {
  set.insert(c, 1 + 500)
}

fn viaS(c: Set(Int)) -> Set(Int) {
  tailS(c)
}

fn localsS(c: Set(Int)) -> Set(Int) {
  let a = c
  let b = a
  match b {
    e -> set.insert(e, 2 + 500)
  }
}

fn foldS(c: Set(Int), xs: List(Int)) -> Set(Int) {
  list.fold(xs, c) { acc, x -> set.insert(acc, x + 500) }
}

-- a function that calls itself with the collection as its last argument
fn lastS(i: Int, n: Int, acc: Set(Int)) -> Set(Int) {
  match i == n {
    true -> acc
    false -> lastS(i + 1, n, set.insert(acc, i % 3 + 500))
  }
}

-- with it as its first argument
fn firstS(acc: Set(Int), i: Int, n: Int) -> Set(Int) {
  match i == n {
    true -> acc
    false -> firstS(set.insert(acc, i % 3 + 500), i + 1, n)
  }
}

-- through a let
fn namedS(i: Int, n: Int, acc: Set(Int)) -> Set(Int) {
  match i == n {
    true -> acc
    false -> {
      let next = set.insert(acc, i % 3 + 500)
      namedS(i + 1, n, next)
    }
  }
}

-- the old one handed on too
fn oldS(i: Int, n: Int, acc: Set(Int), old: Set(Int)) -> String {
  match i == n {
    true -> "{fpS(acc)} old {fpS(old)}"
    false -> oldS(i + 1, n, set.insert(acc, i % 3 + 500), acc)
  }
}

-- the same one handed on twice
fn twiceS(i: Int, n: Int, acc: Set(Int), same: Set(Int)) -> String {
  match i == n {
    true -> "{fpS(acc)} same {fpS(same)}"
    false -> twiceS(i + 1, n, acc, set.insert(acc, i % 3 + 500))
  }
}

-- every old one kept in a list
fn histS(i: Int, n: Int, acc: Set(Int), olds: List(Set(Int))) -> String {
  match i == n {
    true -> "{fpS(acc)} olds {list.map(olds) { o -> fpS(o) }}"
    false -> histS(i + 1, n, set.insert(acc, i % 3 + 500), [acc, ..olds])
  }
}

-- a closure of each round keeps the old one
fn seenS(i: Int, n: Int, acc: Set(Int), looks: List(Fn() -> String)) -> String {
  match i == n {
    true -> "{fpS(acc)} looks {list.map(looks) { f -> f() }}"
    false -> seenS(i + 1, n, set.insert(acc, i % 3 + 500), [{ -> fpS(acc) }, ..looks])
  }
}

-- an arm that does not change it reads it
fn armS(i: Int, n: Int, acc: Set(Int)) -> Set(Int) {
  match i == n {
    true -> acc
    false -> match i % 2 == 0 {
      true -> armS(i + 1, n, set.insert(acc, i % 3 + 500))
      false -> armS(i + 1, n, acc)
    }
  }
}

-- each old one sent on a channel
fn sentS(i: Int, n: Int, acc: Set(Int), ch: Channel(Set(Int))) -> Set(Int) {
  match i == n {
    true -> acc
    false -> {
      channel.send(ch, acc)
      sentS(i + 1, n, set.insert(acc, i % 3 + 500), ch)
    }
  }
}

-- a record that holds it, handed on
fn recS(i: Int, n: Int, b: BoxS) -> BoxS {
  match i == n {
    true -> b
    false -> recS(i + 1, n, b.{ c: set.insert(b.c, i % 3 + 500) })
  }
}

-- the record handed on, and the old record too
fn recoldS(i: Int, n: Int, b: BoxS, old: BoxS) -> String {
  match i == n {
    true -> "{fpS(b.c)} old {fpS(old.c)} {old.label}"
    false -> recoldS(i + 1, n, b.{ c: set.insert(b.c, i % 3 + 500), label: "r{i}" }, b)
  }
}

-- a field updated from another one
fn recotherS(i: Int, n: Int, b: BoxS) -> BoxS {
  match i == n {
    true -> b
    false -> recotherS(i + 1, n, b.{ d: set.insert(b.c, i % 3 + 500) })
  }
}

-- two updates of the record in a row
fn rectwoS(i: Int, n: Int, b: BoxS) -> BoxS {
  match i == n {
    true -> b
    false -> rectwoS(
      i + 1,
      n,
      b.{ c: set.insert(b.c, i % 3 + 500) }.{ d: set.insert(b.d, (i + 1) % 3 + 500) },
    )
  }
}

-- a record whose function reads it again in an arm
fn recarmS(i: Int, n: Int, b: BoxS) -> BoxS {
  match i == n {
    true -> b
    false -> match i % 2 == 0 {
      true -> recarmS(i + 1, n, b.{ c: set.insert(b.c, i % 3 + 500) })
      false -> recarmS(i + 1, n, b.{ label: "{b.label}." })
    }
  }
}

fn rowS(name: String, before: String, after: String, made: String) {
  let verdict = match before == after {
    true -> "same"
    false -> "CHANGED UNDER ITS HOLDER"
  }
  println("set.insert {name}: {verdict} {before} -> {after}; made {made}")
}

fn eachS(kind: String, make: Fn() -> Set(Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let before = fpS(c)
  let n = set.insert(c, 1 + 500)
  rowS("{kind} 1 a let read after", before, fpS(c), fpS(n))
  rowS("{kind} 2 returned at once", before, fpS(c), fpS(tailS(c)))
  rowS("{kind} 2 through a tail call", before, fpS(c), fpS(viaS(c)))
  rowS("{kind} 2 copies in the frame", before, fpS(c), fpS(localsS(c)))
  let look = { -> fpS(c) }
  rowS("{kind} 3 a closure", before, look(), fpS(foldS(c, xs)))
  let box = BoxS { label: "b", c: c, d: c }
  let pair = (c, 1)
  let items = [c, c]
  let maybe = Some(c)
  rowS("{kind} 4 a record field", before, fpS(box.c), fpS(foldS(box.c, xs)))
  let (first, _) = pair
  let made = foldS(first, xs)
  let (again, _) = pair
  rowS("{kind} 4 a tuple", before, fpS(again), fpS(made))
  let changed = list.map(items) { it -> tailS(it) }
  rowS(
    "{kind} 4 list elements",
    "{[before, before]}",
    "{list.map(items) { it -> fpS(it) }}",
    "{list.map(changed) { it -> fpS(it) }}",
  )
  let changed = option.map(maybe) { it -> tailS(it) }
  rowS(
    "{kind} 4 an Option",
    before,
    fpS(option.unwrap_or(maybe, #[])),
    fpS(option.unwrap_or(changed, #[])),
  )
  let updated = box.{ c: set.insert(box.c, 1 + 500) }
  rowS(
    "{kind} 4 a record update",
    "{before} {before}",
    "{fpS(box.c)} {fpS(box.d)}",
    "{fpS(updated.c)} {fpS(updated.d)}",
  )
  let ch = channel.new(4)
  channel.send(ch, c)
  let made = foldS(c, xs)
  let got = match channel.receive(ch) {
    Some(v) -> fpS(v)
    None -> "closed"
  }
  rowS("{kind} 5 a channel message", before, got, fpS(made))
  let go = channel.new(1)
  let seen = channel.new(1)
  let results = channel.new(2)
  task.join(
    [
      { ->
        let _ = channel.receive(go)
        channel.send(seen, fpS(c))
      },
      { ->
        channel.send(results, foldS(c, xs))
        channel.send(results, lastS(0, 5, c))
        channel.send(go, ())
      },
    ],
  )
  let got = match channel.receive(seen) {
    Some(v) -> v
    None -> "closed"
  }
  let made = list.map(0..1) { _ ->
    match channel.receive(results) {
      Some(v) -> fpS(v)
      None -> "closed"
    }
  }
  rowS("{kind} 5 another task", before, got, "{made}")
  let made = task.map([c, c], 2) { it -> lastS(0, 6, foldS(it, xs)) }
  rowS("{kind} 5 changed in other tasks", before, fpS(c), "{list.map(made) { it -> fpS(it) }}")
  let made = list.fold_until(xs, c) { acc, x ->
    match x == 0 {
      true -> Stop(set.insert(acc, x + 500))
      false -> Continue(set.insert(acc, x + 500))
    }
  }
  rowS("{kind} 6 fold_until", before, fpS(c), fpS(made))
  let made = set.fold(set.from_list(xs), c) { acc, x -> set.insert(acc, x + 500) }
  rowS("{kind} 6 set.fold", before, fpS(c), fpS(made))
  let olds = channel.new(16)
  let made = list.fold(xs, c) { acc, x ->
    channel.send(olds, acc)
    set.insert(acc, x + 500)
  }
  channel.close(olds)
  let kept = list.map(0..6) { _ ->
    match channel.receive(olds) {
      Some(v) -> fpS(v)
      None -> "closed"
    }
  }
  println("set.insert {kind} 7 a step that sends the old one away: {kept}; made {fpS(made)}")
  let (made, history) = list.fold(xs, (c, [])) { (acc, hist), x ->
    let next = set.insert(acc, x + 500)
    (next, [acc, ..hist])
  }
  println(
    "set.insert {kind} 7 a step that keeps the old ones: {list.map(history) { h -> fpS(h) }}; made {fpS(made)}",
  )
  let snapshots = list.scan(xs, c) { acc, x -> set.insert(acc, x + 500) }
  println("set.insert {kind} 7 list.scan: {list.map(snapshots) { s -> fpS(s) }}")
  let made = list.fold(xs, c) { acc, x ->
    match x == 1 {
      true -> acc
      false -> set.insert(acc, x + 500)
    }
  }
  rowS("{kind} 7 a step that sometimes gives it back", before, fpS(c), fpS(made))
  let made = list.fold(xs, c) { acc, x ->
    list.fold(xs, acc) { inner, y -> set.insert(inner, (x + y) % 3 + 500) }
  }
  rowS("{kind} 7 a fold in a fold", before, fpS(c), fpS(made))
  let made = list.fold(xs, c) { acc, x ->
    let size = fpS(acc)
    let next = set.insert(acc, x + 500)
    match size == fpS(acc) {
      true -> next
      false -> #[]
    }
  }
  rowS("{kind} 7 a step that reads it after the change", before, fpS(c), fpS(made))
  rowS("{kind} 8 a loop, last argument", before, fpS(c), fpS(lastS(0, 7, c)))
  rowS("{kind} 8 a loop, first argument", before, fpS(c), fpS(firstS(c, 0, 7)))
  rowS("{kind} 8 a loop through a let", before, fpS(c), fpS(namedS(0, 7, c)))
  rowS("{kind} 8 a loop with the old one", before, fpS(c), oldS(0, 7, c, c))
  rowS("{kind} 8 a loop with it twice", before, fpS(c), twiceS(0, 7, c, c))
  rowS("{kind} 8 a loop that keeps the old ones", before, fpS(c), histS(0, 4, c, []))
  rowS("{kind} 8 a loop whose closures keep the old ones", before, fpS(c), seenS(0, 4, c, []))
  rowS("{kind} 8 a loop whose other arm reads it", before, fpS(c), fpS(armS(0, 7, c)))
  let ch = channel.new(16)
  let made = sentS(0, 4, c, ch)
  channel.close(ch)
  let got = list.map(0..3) { _ ->
    match channel.receive(ch) {
      Some(v) -> fpS(v)
      None -> "closed"
    }
  }
  rowS("{kind} 8 a loop that sends the old ones", before, fpS(c), "{fpS(made)} sent {got}")
  let start = BoxS { label: "s", c: c, d: c }
  let made = recS(0, 7, start)
  rowS(
    "{kind} 9 a record in a loop",
    "{before} {before}",
    "{fpS(start.c)} {fpS(start.d)}",
    "{fpS(made.c)} {fpS(made.d)}",
  )
  rowS(
    "{kind} 9 a record in a loop, its old one too",
    before,
    fpS(start.c),
    recoldS(0, 5, start, start),
  )
  let made = recotherS(0, 7, start)
  rowS(
    "{kind} 9 a record field from another",
    "{before} {before}",
    "{fpS(start.c)} {fpS(start.d)}",
    "{fpS(made.c)} {fpS(made.d)}",
  )
  let made = rectwoS(0, 7, start)
  rowS(
    "{kind} 9 two record updates",
    "{before} {before}",
    "{fpS(start.c)} {fpS(start.d)}",
    "{fpS(made.c)} {fpS(made.d)}",
  )
  let made = recarmS(0, 7, start)
  rowS("{kind} 9 a record read in another arm", before, fpS(start.c), "{fpS(made.c)} {made.label}")
  let made = recS(0, 3, BoxS { label: "own", c: make(), d: #[] })
  rowS("{kind} 9 a record held nowhere else", before, fpS(c), fpS(made.c))
  let made = list.fold(xs, start) { b, x -> b.{ c: set.insert(b.c, x + 500) } }
  rowS(
    "{kind} 9 a record in a fold",
    "{before} {before}",
    "{fpS(start.c)} {fpS(start.d)}",
    fpS(made.c),
  )
  let kept = [start]
  let made = list.fold(xs, start) { b, x -> b.{ d: set.insert(b.d, x + 500) } }
  rowS(
    "{kind} 9 a record in a fold, held in a list",
    before,
    fpS(option.unwrap_or(list.first(kept), start).d),
    fpS(made.d),
  )
  let failing = task.guard { ->
    list.fold(xs, c) { acc, x ->
      match x == 0 {
        true -> panic("stop")
        false -> set.insert(acc, x + 500)
      }
    }
  }
  let ended = match failing {
    Ok(_) -> "done"
    Err(_) -> "failed"
  }
  rowS("{kind} 10 a task that fails part way", before, fpS(c), ended)
  let other = make()
  let by = #{ c: "first" }
  let members = set.from_list([c])
  let made = foldS(c, xs)
  let made2 = lastS(0, 5, other)
  println(
    "set.insert {kind} 11 a key and a member: {map.get(by, c)} {set.contains(members, c)} {c == other} {made == foldS(make(), xs)} {made2 == lastS(0, 5, make())} {map.get(#{ made: 1 }, foldS(make(), xs))}",
  )
}

-- ── list.append ───────────────────────────────────────────────

type BoxA {
  label: String,
  c: List(Int),
  d: List(Int),
}

fn fpA(c: List(Int)) -> String {
  "{list.length(c)}/{list.sum(c)}/{list.get(c, list.length(c) - 1)}"
}

fn treeA() -> List(Int) {
  list.fold(0..199, []) { a, i -> list.append(a, i) }
}

fn flatA() -> List(Int) {
  [1, 2, 3]
}

fn tailA(c: List(Int)) -> List(Int) {
  list.append(c, 1)
}

fn viaA(c: List(Int)) -> List(Int) {
  tailA(c)
}

fn localsA(c: List(Int)) -> List(Int) {
  let a = c
  let b = a
  match b {
    e -> list.append(e, 2)
  }
}

fn foldA(c: List(Int), xs: List(Int)) -> List(Int) {
  list.fold(xs, c) { acc, x -> list.append(acc, x) }
}

-- a function that calls itself with the collection as its last argument
fn lastA(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  match i == n {
    true -> acc
    false -> lastA(i + 1, n, list.append(acc, i % 3))
  }
}

-- with it as its first argument
fn firstA(acc: List(Int), i: Int, n: Int) -> List(Int) {
  match i == n {
    true -> acc
    false -> firstA(list.append(acc, i % 3), i + 1, n)
  }
}

-- through a let
fn namedA(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  match i == n {
    true -> acc
    false -> {
      let next = list.append(acc, i % 3)
      namedA(i + 1, n, next)
    }
  }
}

-- the old one handed on too
fn oldA(i: Int, n: Int, acc: List(Int), old: List(Int)) -> String {
  match i == n {
    true -> "{fpA(acc)} old {fpA(old)}"
    false -> oldA(i + 1, n, list.append(acc, i % 3), acc)
  }
}

-- the same one handed on twice
fn twiceA(i: Int, n: Int, acc: List(Int), same: List(Int)) -> String {
  match i == n {
    true -> "{fpA(acc)} same {fpA(same)}"
    false -> twiceA(i + 1, n, acc, list.append(acc, i % 3))
  }
}

-- every old one kept in a list
fn histA(i: Int, n: Int, acc: List(Int), olds: List(List(Int))) -> String {
  match i == n {
    true -> "{fpA(acc)} olds {list.map(olds) { o -> fpA(o) }}"
    false -> histA(i + 1, n, list.append(acc, i % 3), [acc, ..olds])
  }
}

-- a closure of each round keeps the old one
fn seenA(i: Int, n: Int, acc: List(Int), looks: List(Fn() -> String)) -> String {
  match i == n {
    true -> "{fpA(acc)} looks {list.map(looks) { f -> f() }}"
    false -> seenA(i + 1, n, list.append(acc, i % 3), [{ -> fpA(acc) }, ..looks])
  }
}

-- an arm that does not change it reads it
fn armA(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  match i == n {
    true -> acc
    false -> match i % 2 == 0 {
      true -> armA(i + 1, n, list.append(acc, i % 3))
      false -> armA(i + 1, n, acc)
    }
  }
}

-- each old one sent on a channel
fn sentA(i: Int, n: Int, acc: List(Int), ch: Channel(List(Int))) -> List(Int) {
  match i == n {
    true -> acc
    false -> {
      channel.send(ch, acc)
      sentA(i + 1, n, list.append(acc, i % 3), ch)
    }
  }
}

-- a record that holds it, handed on
fn recA(i: Int, n: Int, b: BoxA) -> BoxA {
  match i == n {
    true -> b
    false -> recA(i + 1, n, b.{ c: list.append(b.c, i % 3) })
  }
}

-- the record handed on, and the old record too
fn recoldA(i: Int, n: Int, b: BoxA, old: BoxA) -> String {
  match i == n {
    true -> "{fpA(b.c)} old {fpA(old.c)} {old.label}"
    false -> recoldA(i + 1, n, b.{ c: list.append(b.c, i % 3), label: "r{i}" }, b)
  }
}

-- a field updated from another one
fn recotherA(i: Int, n: Int, b: BoxA) -> BoxA {
  match i == n {
    true -> b
    false -> recotherA(i + 1, n, b.{ d: list.append(b.c, i % 3) })
  }
}

-- two updates of the record in a row
fn rectwoA(i: Int, n: Int, b: BoxA) -> BoxA {
  match i == n {
    true -> b
    false ->
      rectwoA(i + 1, n, b.{ c: list.append(b.c, i % 3) }.{ d: list.append(b.d, (i + 1) % 3) })
  }
}

-- a record whose function reads it again in an arm
fn recarmA(i: Int, n: Int, b: BoxA) -> BoxA {
  match i == n {
    true -> b
    false -> match i % 2 == 0 {
      true -> recarmA(i + 1, n, b.{ c: list.append(b.c, i % 3) })
      false -> recarmA(i + 1, n, b.{ label: "{b.label}." })
    }
  }
}

fn rowA(name: String, before: String, after: String, made: String) {
  let verdict = match before == after {
    true -> "same"
    false -> "CHANGED UNDER ITS HOLDER"
  }
  println("list.append {name}: {verdict} {before} -> {after}; made {made}")
}

fn eachA(kind: String, make: Fn() -> List(Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let before = fpA(c)
  let n = list.append(c, 1)
  rowA("{kind} 1 a let read after", before, fpA(c), fpA(n))
  rowA("{kind} 2 returned at once", before, fpA(c), fpA(tailA(c)))
  rowA("{kind} 2 through a tail call", before, fpA(c), fpA(viaA(c)))
  rowA("{kind} 2 copies in the frame", before, fpA(c), fpA(localsA(c)))
  let look = { -> fpA(c) }
  rowA("{kind} 3 a closure", before, look(), fpA(foldA(c, xs)))
  let box = BoxA { label: "b", c: c, d: c }
  let pair = (c, 1)
  let items = [c, c]
  let maybe = Some(c)
  rowA("{kind} 4 a record field", before, fpA(box.c), fpA(foldA(box.c, xs)))
  let (first, _) = pair
  let made = foldA(first, xs)
  let (again, _) = pair
  rowA("{kind} 4 a tuple", before, fpA(again), fpA(made))
  let changed = list.map(items) { it -> tailA(it) }
  rowA(
    "{kind} 4 list elements",
    "{[before, before]}",
    "{list.map(items) { it -> fpA(it) }}",
    "{list.map(changed) { it -> fpA(it) }}",
  )
  let changed = option.map(maybe) { it -> tailA(it) }
  rowA(
    "{kind} 4 an Option",
    before,
    fpA(option.unwrap_or(maybe, [])),
    fpA(option.unwrap_or(changed, [])),
  )
  let updated = box.{ c: list.append(box.c, 1) }
  rowA(
    "{kind} 4 a record update",
    "{before} {before}",
    "{fpA(box.c)} {fpA(box.d)}",
    "{fpA(updated.c)} {fpA(updated.d)}",
  )
  let ch = channel.new(4)
  channel.send(ch, c)
  let made = foldA(c, xs)
  let got = match channel.receive(ch) {
    Some(v) -> fpA(v)
    None -> "closed"
  }
  rowA("{kind} 5 a channel message", before, got, fpA(made))
  let go = channel.new(1)
  let seen = channel.new(1)
  let results = channel.new(2)
  task.join(
    [
      { ->
        let _ = channel.receive(go)
        channel.send(seen, fpA(c))
      },
      { ->
        channel.send(results, foldA(c, xs))
        channel.send(results, lastA(0, 5, c))
        channel.send(go, ())
      },
    ],
  )
  let got = match channel.receive(seen) {
    Some(v) -> v
    None -> "closed"
  }
  let made = list.map(0..1) { _ ->
    match channel.receive(results) {
      Some(v) -> fpA(v)
      None -> "closed"
    }
  }
  rowA("{kind} 5 another task", before, got, "{made}")
  let made = task.map([c, c], 2) { it -> lastA(0, 6, foldA(it, xs)) }
  rowA("{kind} 5 changed in other tasks", before, fpA(c), "{list.map(made) { it -> fpA(it) }}")
  let made = list.fold_until(xs, c) { acc, x ->
    match x == 0 {
      true -> Stop(list.append(acc, x))
      false -> Continue(list.append(acc, x))
    }
  }
  rowA("{kind} 6 fold_until", before, fpA(c), fpA(made))
  let made = set.fold(set.from_list(xs), c) { acc, x -> list.append(acc, x) }
  rowA("{kind} 6 set.fold", before, fpA(c), fpA(made))
  let olds = channel.new(16)
  let made = list.fold(xs, c) { acc, x ->
    channel.send(olds, acc)
    list.append(acc, x)
  }
  channel.close(olds)
  let kept = list.map(0..6) { _ ->
    match channel.receive(olds) {
      Some(v) -> fpA(v)
      None -> "closed"
    }
  }
  println("list.append {kind} 7 a step that sends the old one away: {kept}; made {fpA(made)}")
  let (made, history) = list.fold(xs, (c, [])) { (acc, hist), x ->
    let next = list.append(acc, x)
    (next, [acc, ..hist])
  }
  println(
    "list.append {kind} 7 a step that keeps the old ones: {list.map(history) { h -> fpA(h) }}; made {fpA(made)}",
  )
  let snapshots = list.scan(xs, c) { acc, x -> list.append(acc, x) }
  println("list.append {kind} 7 list.scan: {list.map(snapshots) { s -> fpA(s) }}")
  let made = list.fold(xs, c) { acc, x ->
    match x == 1 {
      true -> acc
      false -> list.append(acc, x)
    }
  }
  rowA("{kind} 7 a step that sometimes gives it back", before, fpA(c), fpA(made))
  let made = list.fold(xs, c) { acc, x ->
    list.fold(xs, acc) { inner, y -> list.append(inner, (x + y) % 3) }
  }
  rowA("{kind} 7 a fold in a fold", before, fpA(c), fpA(made))
  let made = list.fold(xs, c) { acc, x ->
    let size = fpA(acc)
    let next = list.append(acc, x)
    match size == fpA(acc) {
      true -> next
      false -> []
    }
  }
  rowA("{kind} 7 a step that reads it after the change", before, fpA(c), fpA(made))
  rowA("{kind} 8 a loop, last argument", before, fpA(c), fpA(lastA(0, 7, c)))
  rowA("{kind} 8 a loop, first argument", before, fpA(c), fpA(firstA(c, 0, 7)))
  rowA("{kind} 8 a loop through a let", before, fpA(c), fpA(namedA(0, 7, c)))
  rowA("{kind} 8 a loop with the old one", before, fpA(c), oldA(0, 7, c, c))
  rowA("{kind} 8 a loop with it twice", before, fpA(c), twiceA(0, 7, c, c))
  rowA("{kind} 8 a loop that keeps the old ones", before, fpA(c), histA(0, 4, c, []))
  rowA("{kind} 8 a loop whose closures keep the old ones", before, fpA(c), seenA(0, 4, c, []))
  rowA("{kind} 8 a loop whose other arm reads it", before, fpA(c), fpA(armA(0, 7, c)))
  let ch = channel.new(16)
  let made = sentA(0, 4, c, ch)
  channel.close(ch)
  let got = list.map(0..3) { _ ->
    match channel.receive(ch) {
      Some(v) -> fpA(v)
      None -> "closed"
    }
  }
  rowA("{kind} 8 a loop that sends the old ones", before, fpA(c), "{fpA(made)} sent {got}")
  let start = BoxA { label: "s", c: c, d: c }
  let made = recA(0, 7, start)
  rowA(
    "{kind} 9 a record in a loop",
    "{before} {before}",
    "{fpA(start.c)} {fpA(start.d)}",
    "{fpA(made.c)} {fpA(made.d)}",
  )
  rowA(
    "{kind} 9 a record in a loop, its old one too",
    before,
    fpA(start.c),
    recoldA(0, 5, start, start),
  )
  let made = recotherA(0, 7, start)
  rowA(
    "{kind} 9 a record field from another",
    "{before} {before}",
    "{fpA(start.c)} {fpA(start.d)}",
    "{fpA(made.c)} {fpA(made.d)}",
  )
  let made = rectwoA(0, 7, start)
  rowA(
    "{kind} 9 two record updates",
    "{before} {before}",
    "{fpA(start.c)} {fpA(start.d)}",
    "{fpA(made.c)} {fpA(made.d)}",
  )
  let made = recarmA(0, 7, start)
  rowA("{kind} 9 a record read in another arm", before, fpA(start.c), "{fpA(made.c)} {made.label}")
  let made = recA(0, 3, BoxA { label: "own", c: make(), d: [] })
  rowA("{kind} 9 a record held nowhere else", before, fpA(c), fpA(made.c))
  let made = list.fold(xs, start) { b, x -> b.{ c: list.append(b.c, x) } }
  rowA(
    "{kind} 9 a record in a fold",
    "{before} {before}",
    "{fpA(start.c)} {fpA(start.d)}",
    fpA(made.c),
  )
  let kept = [start]
  let made = list.fold(xs, start) { b, x -> b.{ d: list.append(b.d, x) } }
  rowA(
    "{kind} 9 a record in a fold, held in a list",
    before,
    fpA(option.unwrap_or(list.first(kept), start).d),
    fpA(made.d),
  )
  let failing = task.guard { ->
    list.fold(xs, c) { acc, x ->
      match x == 0 {
        true -> panic("stop")
        false -> list.append(acc, x)
      }
    }
  }
  let ended = match failing {
    Ok(_) -> "done"
    Err(_) -> "failed"
  }
  rowA("{kind} 10 a task that fails part way", before, fpA(c), ended)
  let other = make()
  let by = #{ c: "first" }
  let members = set.from_list([c])
  let made = foldA(c, xs)
  let made2 = lastA(0, 5, other)
  println(
    "list.append {kind} 11 a key and a member: {map.get(by, c)} {set.contains(members, c)} {c == other} {made == foldA(make(), xs)} {made2 == lastA(0, 5, make())} {map.get(#{ made: 1 }, foldA(make(), xs))}",
  )
}

-- ── list.set ───────────────────────────────────────────────

type BoxL {
  label: String,
  c: List(Int),
  d: List(Int),
}

fn fpL(c: List(Int)) -> String {
  "{list.length(c)}/{list.sum(c)}/{list.get(c, 1)}"
}

fn treeL() -> List(Int) {
  list.fold(0..199, []) { a, i -> list.append(a, i) }
}

fn flatL() -> List(Int) {
  [1, 2, 3]
}

fn tailL(c: List(Int)) -> List(Int) {
  match list.set(c, 1, 1 * 5 + 7) {
    Some(next) -> next
    None -> []
  }
}

fn viaL(c: List(Int)) -> List(Int) {
  tailL(c)
}

fn localsL(c: List(Int)) -> List(Int) {
  let a = c
  let b = a
  match b {
    e -> match list.set(e, 2, 2 * 5 + 7) {
      Some(next) -> next
      None -> []
    }
  }
}

fn foldL(c: List(Int), xs: List(Int)) -> List(Int) {
  list.fold(xs, c) { acc, x ->
    match list.set(acc, x, x * 5 + 7) {
      Some(next) -> next
      None -> []
    }
  }
}

-- a function that calls itself with the collection as its last argument
fn lastL(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  match i == n {
    true -> acc
    false -> lastL(
      i + 1,
      n,
      match list.set(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      },
    )
  }
}

-- with it as its first argument
fn firstL(acc: List(Int), i: Int, n: Int) -> List(Int) {
  match i == n {
    true -> acc
    false -> firstL(
      match list.set(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      },
      i + 1,
      n,
    )
  }
}

-- through a let
fn namedL(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  match i == n {
    true -> acc
    false -> {
      let next = match list.set(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      }
      namedL(i + 1, n, next)
    }
  }
}

-- the old one handed on too
fn oldL(i: Int, n: Int, acc: List(Int), old: List(Int)) -> String {
  match i == n {
    true -> "{fpL(acc)} old {fpL(old)}"
    false -> oldL(
      i + 1,
      n,
      match list.set(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      },
      acc,
    )
  }
}

-- the same one handed on twice
fn twiceL(i: Int, n: Int, acc: List(Int), same: List(Int)) -> String {
  match i == n {
    true -> "{fpL(acc)} same {fpL(same)}"
    false -> twiceL(
      i + 1,
      n,
      acc,
      match list.set(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      },
    )
  }
}

-- every old one kept in a list
fn histL(i: Int, n: Int, acc: List(Int), olds: List(List(Int))) -> String {
  match i == n {
    true -> "{fpL(acc)} olds {list.map(olds) { o -> fpL(o) }}"
    false -> histL(
      i + 1,
      n,
      match list.set(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      },
      [acc, ..olds],
    )
  }
}

-- a closure of each round keeps the old one
fn seenL(i: Int, n: Int, acc: List(Int), looks: List(Fn() -> String)) -> String {
  match i == n {
    true -> "{fpL(acc)} looks {list.map(looks) { f -> f() }}"
    false -> seenL(
      i + 1,
      n,
      match list.set(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      },
      [{ -> fpL(acc) }, ..looks],
    )
  }
}

-- an arm that does not change it reads it
fn armL(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  match i == n {
    true -> acc
    false -> match i % 2 == 0 {
      true -> armL(
        i + 1,
        n,
        match list.set(acc, i % 3, i % 3 * 5 + 7) {
          Some(next) -> next
          None -> []
        },
      )
      false -> armL(i + 1, n, acc)
    }
  }
}

-- each old one sent on a channel
fn sentL(i: Int, n: Int, acc: List(Int), ch: Channel(List(Int))) -> List(Int) {
  match i == n {
    true -> acc
    false -> {
      channel.send(ch, acc)
      sentL(
        i + 1,
        n,
        match list.set(acc, i % 3, i % 3 * 5 + 7) {
          Some(next) -> next
          None -> []
        },
        ch,
      )
    }
  }
}

-- a record that holds it, handed on
fn recL(i: Int, n: Int, b: BoxL) -> BoxL {
  match i == n {
    true -> b
    false -> recL(
      i + 1,
      n,
      b.{
        c: match list.set(b.c, i % 3, i % 3 * 5 + 7) {
          Some(next) -> next
          None -> []
        },
      },
    )
  }
}

-- the record handed on, and the old record too
fn recoldL(i: Int, n: Int, b: BoxL, old: BoxL) -> String {
  match i == n {
    true -> "{fpL(b.c)} old {fpL(old.c)} {old.label}"
    false -> recoldL(
      i + 1,
      n,
      b.{
        c: match list.set(b.c, i % 3, i % 3 * 5 + 7) {
          Some(next) -> next
          None -> []
        },
        label: "r{i}",
      },
      b,
    )
  }
}

-- a field updated from another one
fn recotherL(i: Int, n: Int, b: BoxL) -> BoxL {
  match i == n {
    true -> b
    false -> recotherL(
      i + 1,
      n,
      b.{
        d: match list.set(b.c, i % 3, i % 3 * 5 + 7) {
          Some(next) -> next
          None -> []
        },
      },
    )
  }
}

-- two updates of the record in a row
fn rectwoL(i: Int, n: Int, b: BoxL) -> BoxL {
  match i == n {
    true -> b
    false -> rectwoL(
      i + 1,
      n,
      b.{
          c: match list.set(b.c, i % 3, i % 3 * 5 + 7) {
            Some(next) -> next
            None -> []
          },
        }
        .{
          d: match list.set(b.d, (i + 1) % 3, (i + 1) % 3 * 5 + 7) {
            Some(next) -> next
            None -> []
          },
        },
    )
  }
}

-- a record whose function reads it again in an arm
fn recarmL(i: Int, n: Int, b: BoxL) -> BoxL {
  match i == n {
    true -> b
    false -> match i % 2 == 0 {
      true -> recarmL(
        i + 1,
        n,
        b.{
          c: match list.set(b.c, i % 3, i % 3 * 5 + 7) {
            Some(next) -> next
            None -> []
          },
        },
      )
      false -> recarmL(i + 1, n, b.{ label: "{b.label}." })
    }
  }
}

fn rowL(name: String, before: String, after: String, made: String) {
  let verdict = match before == after {
    true -> "same"
    false -> "CHANGED UNDER ITS HOLDER"
  }
  println("list.set {name}: {verdict} {before} -> {after}; made {made}")
}

fn eachL(kind: String, make: Fn() -> List(Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let before = fpL(c)
  let n = match list.set(c, 1, 1 * 5 + 7) {
    Some(next) -> next
    None -> []
  }
  rowL("{kind} 1 a let read after", before, fpL(c), fpL(n))
  rowL("{kind} 2 returned at once", before, fpL(c), fpL(tailL(c)))
  rowL("{kind} 2 through a tail call", before, fpL(c), fpL(viaL(c)))
  rowL("{kind} 2 copies in the frame", before, fpL(c), fpL(localsL(c)))
  let look = { -> fpL(c) }
  rowL("{kind} 3 a closure", before, look(), fpL(foldL(c, xs)))
  let box = BoxL { label: "b", c: c, d: c }
  let pair = (c, 1)
  let items = [c, c]
  let maybe = Some(c)
  rowL("{kind} 4 a record field", before, fpL(box.c), fpL(foldL(box.c, xs)))
  let (first, _) = pair
  let made = foldL(first, xs)
  let (again, _) = pair
  rowL("{kind} 4 a tuple", before, fpL(again), fpL(made))
  let changed = list.map(items) { it -> tailL(it) }
  rowL(
    "{kind} 4 list elements",
    "{[before, before]}",
    "{list.map(items) { it -> fpL(it) }}",
    "{list.map(changed) { it -> fpL(it) }}",
  )
  let changed = option.map(maybe) { it -> tailL(it) }
  rowL(
    "{kind} 4 an Option",
    before,
    fpL(option.unwrap_or(maybe, [])),
    fpL(option.unwrap_or(changed, [])),
  )
  let updated = box.{
    c: match list.set(box.c, 1, 1 * 5 + 7) {
      Some(next) -> next
      None -> []
    },
  }
  rowL(
    "{kind} 4 a record update",
    "{before} {before}",
    "{fpL(box.c)} {fpL(box.d)}",
    "{fpL(updated.c)} {fpL(updated.d)}",
  )
  let ch = channel.new(4)
  channel.send(ch, c)
  let made = foldL(c, xs)
  let got = match channel.receive(ch) {
    Some(v) -> fpL(v)
    None -> "closed"
  }
  rowL("{kind} 5 a channel message", before, got, fpL(made))
  let go = channel.new(1)
  let seen = channel.new(1)
  let results = channel.new(2)
  task.join(
    [
      { ->
        let _ = channel.receive(go)
        channel.send(seen, fpL(c))
      },
      { ->
        channel.send(results, foldL(c, xs))
        channel.send(results, lastL(0, 5, c))
        channel.send(go, ())
      },
    ],
  )
  let got = match channel.receive(seen) {
    Some(v) -> v
    None -> "closed"
  }
  let made = list.map(0..1) { _ ->
    match channel.receive(results) {
      Some(v) -> fpL(v)
      None -> "closed"
    }
  }
  rowL("{kind} 5 another task", before, got, "{made}")
  let made = task.map([c, c], 2) { it -> lastL(0, 6, foldL(it, xs)) }
  rowL("{kind} 5 changed in other tasks", before, fpL(c), "{list.map(made) { it -> fpL(it) }}")
  let made = list.fold_until(xs, c) { acc, x ->
    match x == 0 {
      true -> Stop(
        match list.set(acc, x, x * 5 + 7) {
          Some(next) -> next
          None -> []
        },
      )
      false -> Continue(
        match list.set(acc, x, x * 5 + 7) {
          Some(next) -> next
          None -> []
        },
      )
    }
  }
  rowL("{kind} 6 fold_until", before, fpL(c), fpL(made))
  let made = set.fold(set.from_list(xs), c) { acc, x ->
    match list.set(acc, x, x * 5 + 7) {
      Some(next) -> next
      None -> []
    }
  }
  rowL("{kind} 6 set.fold", before, fpL(c), fpL(made))
  let olds = channel.new(16)
  let made = list.fold(xs, c) { acc, x ->
    channel.send(olds, acc)
    match list.set(acc, x, x * 5 + 7) {
      Some(next) -> next
      None -> []
    }
  }
  channel.close(olds)
  let kept = list.map(0..6) { _ ->
    match channel.receive(olds) {
      Some(v) -> fpL(v)
      None -> "closed"
    }
  }
  println("list.set {kind} 7 a step that sends the old one away: {kept}; made {fpL(made)}")
  let (made, history) = list.fold(xs, (c, [])) { (acc, hist), x ->
    let next = match list.set(acc, x, x * 5 + 7) {
      Some(next) -> next
      None -> []
    }
    (next, [acc, ..hist])
  }
  println(
    "list.set {kind} 7 a step that keeps the old ones: {list.map(history) { h -> fpL(h) }}; made {fpL(made)}",
  )
  let snapshots = list.scan(xs, c) { acc, x ->
    match list.set(acc, x, x * 5 + 7) {
      Some(next) -> next
      None -> []
    }
  }
  println("list.set {kind} 7 list.scan: {list.map(snapshots) { s -> fpL(s) }}")
  let made = list.fold(xs, c) { acc, x ->
    match x == 1 {
      true -> acc
      false -> match list.set(acc, x, x * 5 + 7) {
        Some(next) -> next
        None -> []
      }
    }
  }
  rowL("{kind} 7 a step that sometimes gives it back", before, fpL(c), fpL(made))
  let made = list.fold(xs, c) { acc, x ->
    list.fold(xs, acc) { inner, y ->
      match list.set(inner, (x + y) % 3, (x + y) % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      }
    }
  }
  rowL("{kind} 7 a fold in a fold", before, fpL(c), fpL(made))
  let made = list.fold(xs, c) { acc, x ->
    let size = fpL(acc)
    let next = match list.set(acc, x, x * 5 + 7) {
      Some(next) -> next
      None -> []
    }
    match size == fpL(acc) {
      true -> next
      false -> []
    }
  }
  rowL("{kind} 7 a step that reads it after the change", before, fpL(c), fpL(made))
  rowL("{kind} 8 a loop, last argument", before, fpL(c), fpL(lastL(0, 7, c)))
  rowL("{kind} 8 a loop, first argument", before, fpL(c), fpL(firstL(c, 0, 7)))
  rowL("{kind} 8 a loop through a let", before, fpL(c), fpL(namedL(0, 7, c)))
  rowL("{kind} 8 a loop with the old one", before, fpL(c), oldL(0, 7, c, c))
  rowL("{kind} 8 a loop with it twice", before, fpL(c), twiceL(0, 7, c, c))
  rowL("{kind} 8 a loop that keeps the old ones", before, fpL(c), histL(0, 4, c, []))
  rowL("{kind} 8 a loop whose closures keep the old ones", before, fpL(c), seenL(0, 4, c, []))
  rowL("{kind} 8 a loop whose other arm reads it", before, fpL(c), fpL(armL(0, 7, c)))
  let ch = channel.new(16)
  let made = sentL(0, 4, c, ch)
  channel.close(ch)
  let got = list.map(0..3) { _ ->
    match channel.receive(ch) {
      Some(v) -> fpL(v)
      None -> "closed"
    }
  }
  rowL("{kind} 8 a loop that sends the old ones", before, fpL(c), "{fpL(made)} sent {got}")
  let start = BoxL { label: "s", c: c, d: c }
  let made = recL(0, 7, start)
  rowL(
    "{kind} 9 a record in a loop",
    "{before} {before}",
    "{fpL(start.c)} {fpL(start.d)}",
    "{fpL(made.c)} {fpL(made.d)}",
  )
  rowL(
    "{kind} 9 a record in a loop, its old one too",
    before,
    fpL(start.c),
    recoldL(0, 5, start, start),
  )
  let made = recotherL(0, 7, start)
  rowL(
    "{kind} 9 a record field from another",
    "{before} {before}",
    "{fpL(start.c)} {fpL(start.d)}",
    "{fpL(made.c)} {fpL(made.d)}",
  )
  let made = rectwoL(0, 7, start)
  rowL(
    "{kind} 9 two record updates",
    "{before} {before}",
    "{fpL(start.c)} {fpL(start.d)}",
    "{fpL(made.c)} {fpL(made.d)}",
  )
  let made = recarmL(0, 7, start)
  rowL("{kind} 9 a record read in another arm", before, fpL(start.c), "{fpL(made.c)} {made.label}")
  let made = recL(0, 3, BoxL { label: "own", c: make(), d: [] })
  rowL("{kind} 9 a record held nowhere else", before, fpL(c), fpL(made.c))
  let made = list.fold(xs, start) { b, x ->
    b.{
      c: match list.set(b.c, x, x * 5 + 7) {
        Some(next) -> next
        None -> []
      },
    }
  }
  rowL(
    "{kind} 9 a record in a fold",
    "{before} {before}",
    "{fpL(start.c)} {fpL(start.d)}",
    fpL(made.c),
  )
  let kept = [start]
  let made = list.fold(xs, start) { b, x ->
    b.{
      d: match list.set(b.d, x, x * 5 + 7) {
        Some(next) -> next
        None -> []
      },
    }
  }
  rowL(
    "{kind} 9 a record in a fold, held in a list",
    before,
    fpL(option.unwrap_or(list.first(kept), start).d),
    fpL(made.d),
  )
  let failing = task.guard { ->
    list.fold(xs, c) { acc, x ->
      match x == 0 {
        true -> panic("stop")
        false -> match list.set(acc, x, x * 5 + 7) {
          Some(next) -> next
          None -> []
        }
      }
    }
  }
  let ended = match failing {
    Ok(_) -> "done"
    Err(_) -> "failed"
  }
  rowL("{kind} 10 a task that fails part way", before, fpL(c), ended)
  let other = make()
  let by = #{ c: "first" }
  let members = set.from_list([c])
  let made = foldL(c, xs)
  let made2 = lastL(0, 5, other)
  println(
    "list.set {kind} 11 a key and a member: {map.get(by, c)} {set.contains(members, c)} {c == other} {made == foldL(make(), xs)} {made2 == lastL(0, 5, make())} {map.get(#{ made: 1 }, foldL(make(), xs))}",
  )
}

-- ── map.set: through calls, as a value, in nested records ──

type NestM {
  label: String,
  inner: BoxM,
  spare: BoxM,
}

type DeepM {
  top: NestM,
  n: Int,
}

trait StepM {
  fn step(self, x: Int) -> BoxM
}

trait StepM for BoxM {
  fn step(self, x: Int) -> BoxM {
    self.{ c: map.set(self.c, x, x * 3 + 1) }
  }
}

trait CountM {
  fn count(self) -> Int
}

trait CountM for Int {
  fn count(self) -> Int {
    self + 1
  }
}

-- a function of the program that makes the update
fn wrapM(c: Map(Int, Int), x: Int) -> Map(Int, Int) {
  map.set(c, x, x * 3 + 1)
}

fn wlastM(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> wlastM(i + 1, n, wrapM(acc, i % 3))
  }
}

fn wletM(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> {
      let next = wrapM(acc, i % 3)
      wletM(i + 1, n, next)
    }
  }
}

fn woldM(i: Int, n: Int, acc: Map(Int, Int), old: Map(Int, Int)) -> String {
  match i == n {
    true -> "{fpM(acc)} old {fpM(old)}"
    false -> woldM(i + 1, n, wrapM(acc, i % 3), acc)
  }
}

-- the old one read by a call after the update
fn wreadM(i: Int, n: Int, acc: Map(Int, Int), seen: List(String)) -> String {
  match i == n {
    true -> "{fpM(acc)} seen {seen}"
    false -> wreadM(i + 1, n, wrapM(acc, i % 3), [fpM(acc), ..seen])
  }
}

-- a closure made before the call keeps the old one
fn wlookM(i: Int, n: Int, acc: Map(Int, Int), looks: List(Fn() -> String)) -> String {
  match i == n {
    true -> "{fpM(acc)} looks {list.map(looks) { f -> f() }}"
    false -> {
      let look = { -> fpM(acc) }
      wlookM(i + 1, n, wrapM(acc, i % 3), [look, ..looks])
    }
  }
}

-- a method that makes the update of a record
fn mstepM(i: Int, n: Int, b: BoxM) -> BoxM {
  match i == n {
    true -> b
    false -> mstepM(i + 1, n, StepM.step(b, i % 3))
  }
}

fn mstepoldM(i: Int, n: Int, b: BoxM, old: BoxM) -> String {
  match i == n {
    true -> "{fpM(b.c)} old {fpM(old.c)}"
    false -> mstepoldM(i + 1, n, StepM.step(b, i % 3), b)
  }
}

-- a method called after the update
fn mafterM(acc: Map(Int, Int), i: Int, n: Int) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> mafterM(map.set(acc, i % 3, i % 3 * 3 + 1), CountM.count(i), n)
  }
}

fn mafteroldM(acc: Map(Int, Int), i: Int, n: Int, old: Map(Int, Int)) -> String {
  match i == n {
    true -> "{fpM(acc)} old {fpM(old)}"
    false -> mafteroldM(map.set(acc, i % 3, i % 3 * 3 + 1), CountM.count(i), n, acc)
  }
}

-- the builtin as a value
fn vloopM(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  let f = map.set
  match i == n {
    true -> acc
    false -> vloopM(i + 1, n, f(acc, i % 3, i % 3 * 3 + 1))
  }
}

fn voldM(i: Int, n: Int, acc: Map(Int, Int), old: Map(Int, Int)) -> String {
  let f = map.set
  match i == n {
    true -> "{fpM(acc)} old {fpM(old)}"
    false -> voldM(i + 1, n, f(acc, i % 3, i % 3 * 3 + 1), acc)
  }
}

-- a record in a record
fn nloopM(i: Int, n: Int, o: NestM) -> NestM {
  match i == n {
    true -> o
    false -> nloopM(i + 1, n, o.{ inner: o.inner.{ c: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) } })
  }
}

fn noldM(i: Int, n: Int, o: NestM, old: NestM) -> String {
  match i == n {
    true -> "{fpM(o.inner.c)} old {fpM(old.inner.c)} {old.label}"
    false -> noldM(
      i + 1,
      n,
      o.{ inner: o.inner.{ c: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) }, label: "n{i}" },
      o,
    )
  }
}

fn ndeepM(i: Int, n: Int, d: DeepM) -> DeepM {
  match i == n {
    true -> d
    false -> ndeepM(
      i + 1,
      n,
      d.{ top: d.top.{ inner: d.top.inner.{ c: map.set(d.top.inner.c, i % 3, i % 3 * 3 + 1) } } },
    )
  }
}

fn notherM(i: Int, n: Int, o: NestM) -> NestM {
  match i == n {
    true -> o
    false -> notherM(i + 1, n, o.{ inner: o.inner.{ d: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) } })
  }
}

fn moreM(kind: String, make: Fn() -> Map(Int, Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let before = fpM(c)
  rowM("{kind} 12 a function's update, last argument", before, fpM(c), fpM(wlastM(0, 7, c)))
  rowM("{kind} 12 a function's update through a let", before, fpM(c), fpM(wletM(0, 7, c)))
  rowM("{kind} 12 a function's update with the old one", before, fpM(c), woldM(0, 5, c, c))
  rowM("{kind} 12 a function's update, the old one read after", before, fpM(c), wreadM(0, 4, c, []))
  rowM(
    "{kind} 12 a function's update, a closure keeps the old one",
    before,
    fpM(c),
    wlookM(0, 4, c, []),
  )
  let made = list.fold(xs, c) { acc, x -> wrapM(acc, x) }
  rowM("{kind} 12 a function's update in a fold", before, fpM(c), fpM(made))
  let made = list.fold(xs, c) { acc, x ->
    let next = wrapM(acc, x)
    match fpM(acc) == fpM(acc) {
      true -> next
      false -> acc
    }
  }
  rowM("{kind} 12 a function's update in a fold, the old one read after", before, fpM(c), fpM(made))
  let box = BoxM { label: "b", c: c, d: c }
  let made = mstepM(0, 7, box)
  rowM(
    "{kind} 13 a method's update of a record",
    "{before} {before}",
    "{fpM(box.c)} {fpM(box.d)}",
    "{fpM(made.c)} {fpM(made.d)}",
  )
  rowM(
    "{kind} 13 a method's update, the old record too",
    before,
    fpM(box.c),
    mstepoldM(0, 5, box, box),
  )
  rowM("{kind} 13 a method after the update", before, fpM(c), fpM(mafterM(c, 0, 7)))
  rowM(
    "{kind} 13 a method after the update, the old one too",
    before,
    fpM(c),
    mafteroldM(c, 0, 5, c),
  )
  let made = list.fold(xs, box) { b, x -> StepM.step(b, x) }
  rowM("{kind} 13 a method's update in a fold", before, fpM(box.c), fpM(made.c))
  rowM("{kind} 14 the builtin as a value", before, fpM(c), fpM(vloopM(0, 7, c)))
  rowM("{kind} 14 the builtin as a value, the old one too", before, fpM(c), voldM(0, 5, c, c))
  let f = map.set
  let made = list.fold(xs, c) { acc, x -> f(acc, x, x * 3 + 1) }
  rowM("{kind} 14 the builtin as a value in a fold", before, fpM(c), fpM(made))
  let fs = [f, f]
  let made = list.fold(xs, c) { acc, x ->
    match list.get(fs, x % 2) {
      Some(g) -> g(acc, x, x * 3 + 1)
      None -> acc
    }
  }
  rowM("{kind} 14 the builtin from a list", before, fpM(c), fpM(made))
  let nest = NestM { label: "o", inner: box, spare: box }
  let made = nloopM(0, 7, nest)
  rowM(
    "{kind} 15 a record in a record",
    "{before} {before} {before}",
    "{fpM(nest.inner.c)} {fpM(nest.spare.c)} {fpM(box.c)}",
    "{fpM(made.inner.c)} {fpM(made.inner.d)} {fpM(made.spare.c)}",
  )
  rowM(
    "{kind} 15 a record in a record, the old one too",
    before,
    fpM(nest.inner.c),
    noldM(0, 5, nest, nest),
  )
  let deep = DeepM { top: nest, n: 0 }
  let made = ndeepM(0, 7, deep)
  rowM(
    "{kind} 15 three records deep",
    "{before} {before}",
    "{fpM(deep.top.inner.c)} {fpM(nest.inner.c)}",
    "{fpM(made.top.inner.c)} {fpM(made.top.spare.c)}",
  )
  let made = notherM(0, 7, nest)
  rowM(
    "{kind} 15 a record in a record, a field from another",
    before,
    fpM(nest.inner.c),
    "{fpM(made.inner.c)} {fpM(made.inner.d)}",
  )
  let own = nloopM(
    0,
    3,
    NestM {
      label: "own",
      inner: BoxM { label: "i", c: make(), d: #{} },
      spare: BoxM { label: "s", c: #{}, d: #{} },
    },
  )
  rowM("{kind} 15 a record in a record held nowhere else", before, fpM(c), fpM(own.inner.c))
  let made = list.fold(xs, nest) { o, x ->
    o.{ inner: o.inner.{ c: map.set(o.inner.c, x, x * 3 + 1) } }
  }
  rowM(
    "{kind} 15 a record in a record in a fold",
    "{before} {before}",
    "{fpM(nest.inner.c)} {fpM(box.c)}",
    fpM(made.inner.c),
  )
  let kept = [nest.inner]
  let made = list.fold(xs, nest) { o, x ->
    o.{ inner: o.inner.{ c: map.set(o.inner.c, x, x * 3 + 1) } }
  }
  rowM(
    "{kind} 15 a record in a record, its inner one in a list",
    before,
    fpM(option.unwrap_or(list.first(kept), box).c),
    fpM(made.inner.c),
  )
}

-- ── map.update: through calls, as a value, in nested records ──

type NestU {
  label: String,
  inner: BoxU,
  spare: BoxU,
}

type DeepU {
  top: NestU,
  n: Int,
}

trait StepU {
  fn step(self, x: Int) -> BoxU
}

trait StepU for BoxU {
  fn step(self, x: Int) -> BoxU {
    self.{ c: map.update(self.c, x, 0) { v -> v + 1 } }
  }
}

trait CountU {
  fn count(self) -> Int
}

trait CountU for Int {
  fn count(self) -> Int {
    self + 1
  }
}

-- a function of the program that makes the update
fn wrapU(c: Map(Int, Int), x: Int) -> Map(Int, Int) {
  map.update(c, x, 0) { v -> v + 1 }
}

fn wlastU(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> wlastU(i + 1, n, wrapU(acc, i % 3))
  }
}

fn wletU(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> {
      let next = wrapU(acc, i % 3)
      wletU(i + 1, n, next)
    }
  }
}

fn woldU(i: Int, n: Int, acc: Map(Int, Int), old: Map(Int, Int)) -> String {
  match i == n {
    true -> "{fpU(acc)} old {fpU(old)}"
    false -> woldU(i + 1, n, wrapU(acc, i % 3), acc)
  }
}

-- the old one read by a call after the update
fn wreadU(i: Int, n: Int, acc: Map(Int, Int), seen: List(String)) -> String {
  match i == n {
    true -> "{fpU(acc)} seen {seen}"
    false -> wreadU(i + 1, n, wrapU(acc, i % 3), [fpU(acc), ..seen])
  }
}

-- a closure made before the call keeps the old one
fn wlookU(i: Int, n: Int, acc: Map(Int, Int), looks: List(Fn() -> String)) -> String {
  match i == n {
    true -> "{fpU(acc)} looks {list.map(looks) { f -> f() }}"
    false -> {
      let look = { -> fpU(acc) }
      wlookU(i + 1, n, wrapU(acc, i % 3), [look, ..looks])
    }
  }
}

-- a method that makes the update of a record
fn mstepU(i: Int, n: Int, b: BoxU) -> BoxU {
  match i == n {
    true -> b
    false -> mstepU(i + 1, n, StepU.step(b, i % 3))
  }
}

fn mstepoldU(i: Int, n: Int, b: BoxU, old: BoxU) -> String {
  match i == n {
    true -> "{fpU(b.c)} old {fpU(old.c)}"
    false -> mstepoldU(i + 1, n, StepU.step(b, i % 3), b)
  }
}

-- a method called after the update
fn mafterU(acc: Map(Int, Int), i: Int, n: Int) -> Map(Int, Int) {
  match i == n {
    true -> acc
    false -> mafterU(map.update(acc, i % 3, 0) { v -> v + 1 }, CountU.count(i), n)
  }
}

fn mafteroldU(acc: Map(Int, Int), i: Int, n: Int, old: Map(Int, Int)) -> String {
  match i == n {
    true -> "{fpU(acc)} old {fpU(old)}"
    false -> mafteroldU(map.update(acc, i % 3, 0) { v -> v + 1 }, CountU.count(i), n, acc)
  }
}

-- the builtin as a value
fn vloopU(i: Int, n: Int, acc: Map(Int, Int)) -> Map(Int, Int) {
  let f = map.update
  match i == n {
    true -> acc
    false -> vloopU(i + 1, n, f(acc, i % 3, 0) { v -> v + 1 })
  }
}

fn voldU(i: Int, n: Int, acc: Map(Int, Int), old: Map(Int, Int)) -> String {
  let f = map.update
  match i == n {
    true -> "{fpU(acc)} old {fpU(old)}"
    false -> voldU(i + 1, n, f(acc, i % 3, 0) { v -> v + 1 }, acc)
  }
}

-- a record in a record
fn nloopU(i: Int, n: Int, o: NestU) -> NestU {
  match i == n {
    true -> o
    false ->
      nloopU(i + 1, n, o.{ inner: o.inner.{ c: map.update(o.inner.c, i % 3, 0) { v -> v + 1 } } })
  }
}

fn noldU(i: Int, n: Int, o: NestU, old: NestU) -> String {
  match i == n {
    true -> "{fpU(o.inner.c)} old {fpU(old.inner.c)} {old.label}"
    false -> noldU(
      i + 1,
      n,
      o.{ inner: o.inner.{ c: map.update(o.inner.c, i % 3, 0) { v -> v + 1 } }, label: "n{i}" },
      o,
    )
  }
}

fn ndeepU(i: Int, n: Int, d: DeepU) -> DeepU {
  match i == n {
    true -> d
    false -> ndeepU(
      i + 1,
      n,
      d.{
        top: d.top.{ inner: d.top.inner.{ c: map.update(d.top.inner.c, i % 3, 0) { v -> v + 1 } } },
      },
    )
  }
}

fn notherU(i: Int, n: Int, o: NestU) -> NestU {
  match i == n {
    true -> o
    false ->
      notherU(i + 1, n, o.{ inner: o.inner.{ d: map.update(o.inner.c, i % 3, 0) { v -> v + 1 } } })
  }
}

fn moreU(kind: String, make: Fn() -> Map(Int, Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let before = fpU(c)
  rowU("{kind} 12 a function's update, last argument", before, fpU(c), fpU(wlastU(0, 7, c)))
  rowU("{kind} 12 a function's update through a let", before, fpU(c), fpU(wletU(0, 7, c)))
  rowU("{kind} 12 a function's update with the old one", before, fpU(c), woldU(0, 5, c, c))
  rowU("{kind} 12 a function's update, the old one read after", before, fpU(c), wreadU(0, 4, c, []))
  rowU(
    "{kind} 12 a function's update, a closure keeps the old one",
    before,
    fpU(c),
    wlookU(0, 4, c, []),
  )
  let made = list.fold(xs, c) { acc, x -> wrapU(acc, x) }
  rowU("{kind} 12 a function's update in a fold", before, fpU(c), fpU(made))
  let made = list.fold(xs, c) { acc, x ->
    let next = wrapU(acc, x)
    match fpU(acc) == fpU(acc) {
      true -> next
      false -> acc
    }
  }
  rowU("{kind} 12 a function's update in a fold, the old one read after", before, fpU(c), fpU(made))
  let box = BoxU { label: "b", c: c, d: c }
  let made = mstepU(0, 7, box)
  rowU(
    "{kind} 13 a method's update of a record",
    "{before} {before}",
    "{fpU(box.c)} {fpU(box.d)}",
    "{fpU(made.c)} {fpU(made.d)}",
  )
  rowU(
    "{kind} 13 a method's update, the old record too",
    before,
    fpU(box.c),
    mstepoldU(0, 5, box, box),
  )
  rowU("{kind} 13 a method after the update", before, fpU(c), fpU(mafterU(c, 0, 7)))
  rowU(
    "{kind} 13 a method after the update, the old one too",
    before,
    fpU(c),
    mafteroldU(c, 0, 5, c),
  )
  let made = list.fold(xs, box) { b, x -> StepU.step(b, x) }
  rowU("{kind} 13 a method's update in a fold", before, fpU(box.c), fpU(made.c))
  rowU("{kind} 14 the builtin as a value", before, fpU(c), fpU(vloopU(0, 7, c)))
  rowU("{kind} 14 the builtin as a value, the old one too", before, fpU(c), voldU(0, 5, c, c))
  let f = map.update
  let made = list.fold(xs, c) { acc, x -> f(acc, x, 0) { v -> v + 1 } }
  rowU("{kind} 14 the builtin as a value in a fold", before, fpU(c), fpU(made))
  let fs = [f, f]
  let made = list.fold(xs, c) { acc, x ->
    match list.get(fs, x % 2) {
      Some(g) -> g(acc, x, 0) { v -> v + 1 }
      None -> acc
    }
  }
  rowU("{kind} 14 the builtin from a list", before, fpU(c), fpU(made))
  let nest = NestU { label: "o", inner: box, spare: box }
  let made = nloopU(0, 7, nest)
  rowU(
    "{kind} 15 a record in a record",
    "{before} {before} {before}",
    "{fpU(nest.inner.c)} {fpU(nest.spare.c)} {fpU(box.c)}",
    "{fpU(made.inner.c)} {fpU(made.inner.d)} {fpU(made.spare.c)}",
  )
  rowU(
    "{kind} 15 a record in a record, the old one too",
    before,
    fpU(nest.inner.c),
    noldU(0, 5, nest, nest),
  )
  let deep = DeepU { top: nest, n: 0 }
  let made = ndeepU(0, 7, deep)
  rowU(
    "{kind} 15 three records deep",
    "{before} {before}",
    "{fpU(deep.top.inner.c)} {fpU(nest.inner.c)}",
    "{fpU(made.top.inner.c)} {fpU(made.top.spare.c)}",
  )
  let made = notherU(0, 7, nest)
  rowU(
    "{kind} 15 a record in a record, a field from another",
    before,
    fpU(nest.inner.c),
    "{fpU(made.inner.c)} {fpU(made.inner.d)}",
  )
  let own = nloopU(
    0,
    3,
    NestU {
      label: "own",
      inner: BoxU { label: "i", c: make(), d: #{} },
      spare: BoxU { label: "s", c: #{}, d: #{} },
    },
  )
  rowU("{kind} 15 a record in a record held nowhere else", before, fpU(c), fpU(own.inner.c))
  let made = list.fold(xs, nest) { o, x ->
    o.{ inner: o.inner.{ c: map.update(o.inner.c, x, 0) { v -> v + 1 } } }
  }
  rowU(
    "{kind} 15 a record in a record in a fold",
    "{before} {before}",
    "{fpU(nest.inner.c)} {fpU(box.c)}",
    fpU(made.inner.c),
  )
  let kept = [nest.inner]
  let made = list.fold(xs, nest) { o, x ->
    o.{ inner: o.inner.{ c: map.update(o.inner.c, x, 0) { v -> v + 1 } } }
  }
  rowU(
    "{kind} 15 a record in a record, its inner one in a list",
    before,
    fpU(option.unwrap_or(list.first(kept), box).c),
    fpU(made.inner.c),
  )
}

-- ── set.insert: through calls, as a value, in nested records ──

type NestS {
  label: String,
  inner: BoxS,
  spare: BoxS,
}

type DeepS {
  top: NestS,
  n: Int,
}

trait StepS {
  fn step(self, x: Int) -> BoxS
}

trait StepS for BoxS {
  fn step(self, x: Int) -> BoxS {
    self.{ c: set.insert(self.c, x + 500) }
  }
}

trait CountS {
  fn count(self) -> Int
}

trait CountS for Int {
  fn count(self) -> Int {
    self + 1
  }
}

-- a function of the program that makes the update
fn wrapS(c: Set(Int), x: Int) -> Set(Int) {
  set.insert(c, x + 500)
}

fn wlastS(i: Int, n: Int, acc: Set(Int)) -> Set(Int) {
  match i == n {
    true -> acc
    false -> wlastS(i + 1, n, wrapS(acc, i % 3))
  }
}

fn wletS(i: Int, n: Int, acc: Set(Int)) -> Set(Int) {
  match i == n {
    true -> acc
    false -> {
      let next = wrapS(acc, i % 3)
      wletS(i + 1, n, next)
    }
  }
}

fn woldS(i: Int, n: Int, acc: Set(Int), old: Set(Int)) -> String {
  match i == n {
    true -> "{fpS(acc)} old {fpS(old)}"
    false -> woldS(i + 1, n, wrapS(acc, i % 3), acc)
  }
}

-- the old one read by a call after the update
fn wreadS(i: Int, n: Int, acc: Set(Int), seen: List(String)) -> String {
  match i == n {
    true -> "{fpS(acc)} seen {seen}"
    false -> wreadS(i + 1, n, wrapS(acc, i % 3), [fpS(acc), ..seen])
  }
}

-- a closure made before the call keeps the old one
fn wlookS(i: Int, n: Int, acc: Set(Int), looks: List(Fn() -> String)) -> String {
  match i == n {
    true -> "{fpS(acc)} looks {list.map(looks) { f -> f() }}"
    false -> {
      let look = { -> fpS(acc) }
      wlookS(i + 1, n, wrapS(acc, i % 3), [look, ..looks])
    }
  }
}

-- a method that makes the update of a record
fn mstepS(i: Int, n: Int, b: BoxS) -> BoxS {
  match i == n {
    true -> b
    false -> mstepS(i + 1, n, StepS.step(b, i % 3))
  }
}

fn mstepoldS(i: Int, n: Int, b: BoxS, old: BoxS) -> String {
  match i == n {
    true -> "{fpS(b.c)} old {fpS(old.c)}"
    false -> mstepoldS(i + 1, n, StepS.step(b, i % 3), b)
  }
}

-- a method called after the update
fn mafterS(acc: Set(Int), i: Int, n: Int) -> Set(Int) {
  match i == n {
    true -> acc
    false -> mafterS(set.insert(acc, i % 3 + 500), CountS.count(i), n)
  }
}

fn mafteroldS(acc: Set(Int), i: Int, n: Int, old: Set(Int)) -> String {
  match i == n {
    true -> "{fpS(acc)} old {fpS(old)}"
    false -> mafteroldS(set.insert(acc, i % 3 + 500), CountS.count(i), n, acc)
  }
}

-- the builtin as a value
fn vloopS(i: Int, n: Int, acc: Set(Int)) -> Set(Int) {
  let f = set.insert
  match i == n {
    true -> acc
    false -> vloopS(i + 1, n, f(acc, i % 3 + 500))
  }
}

fn voldS(i: Int, n: Int, acc: Set(Int), old: Set(Int)) -> String {
  let f = set.insert
  match i == n {
    true -> "{fpS(acc)} old {fpS(old)}"
    false -> voldS(i + 1, n, f(acc, i % 3 + 500), acc)
  }
}

-- a record in a record
fn nloopS(i: Int, n: Int, o: NestS) -> NestS {
  match i == n {
    true -> o
    false -> nloopS(i + 1, n, o.{ inner: o.inner.{ c: set.insert(o.inner.c, i % 3 + 500) } })
  }
}

fn noldS(i: Int, n: Int, o: NestS, old: NestS) -> String {
  match i == n {
    true -> "{fpS(o.inner.c)} old {fpS(old.inner.c)} {old.label}"
    false -> noldS(
      i + 1,
      n,
      o.{ inner: o.inner.{ c: set.insert(o.inner.c, i % 3 + 500) }, label: "n{i}" },
      o,
    )
  }
}

fn ndeepS(i: Int, n: Int, d: DeepS) -> DeepS {
  match i == n {
    true -> d
    false -> ndeepS(
      i + 1,
      n,
      d.{ top: d.top.{ inner: d.top.inner.{ c: set.insert(d.top.inner.c, i % 3 + 500) } } },
    )
  }
}

fn notherS(i: Int, n: Int, o: NestS) -> NestS {
  match i == n {
    true -> o
    false -> notherS(i + 1, n, o.{ inner: o.inner.{ d: set.insert(o.inner.c, i % 3 + 500) } })
  }
}

fn moreS(kind: String, make: Fn() -> Set(Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let before = fpS(c)
  rowS("{kind} 12 a function's update, last argument", before, fpS(c), fpS(wlastS(0, 7, c)))
  rowS("{kind} 12 a function's update through a let", before, fpS(c), fpS(wletS(0, 7, c)))
  rowS("{kind} 12 a function's update with the old one", before, fpS(c), woldS(0, 5, c, c))
  rowS("{kind} 12 a function's update, the old one read after", before, fpS(c), wreadS(0, 4, c, []))
  rowS(
    "{kind} 12 a function's update, a closure keeps the old one",
    before,
    fpS(c),
    wlookS(0, 4, c, []),
  )
  let made = list.fold(xs, c) { acc, x -> wrapS(acc, x) }
  rowS("{kind} 12 a function's update in a fold", before, fpS(c), fpS(made))
  let made = list.fold(xs, c) { acc, x ->
    let next = wrapS(acc, x)
    match fpS(acc) == fpS(acc) {
      true -> next
      false -> acc
    }
  }
  rowS("{kind} 12 a function's update in a fold, the old one read after", before, fpS(c), fpS(made))
  let box = BoxS { label: "b", c: c, d: c }
  let made = mstepS(0, 7, box)
  rowS(
    "{kind} 13 a method's update of a record",
    "{before} {before}",
    "{fpS(box.c)} {fpS(box.d)}",
    "{fpS(made.c)} {fpS(made.d)}",
  )
  rowS(
    "{kind} 13 a method's update, the old record too",
    before,
    fpS(box.c),
    mstepoldS(0, 5, box, box),
  )
  rowS("{kind} 13 a method after the update", before, fpS(c), fpS(mafterS(c, 0, 7)))
  rowS(
    "{kind} 13 a method after the update, the old one too",
    before,
    fpS(c),
    mafteroldS(c, 0, 5, c),
  )
  let made = list.fold(xs, box) { b, x -> StepS.step(b, x) }
  rowS("{kind} 13 a method's update in a fold", before, fpS(box.c), fpS(made.c))
  rowS("{kind} 14 the builtin as a value", before, fpS(c), fpS(vloopS(0, 7, c)))
  rowS("{kind} 14 the builtin as a value, the old one too", before, fpS(c), voldS(0, 5, c, c))
  let f = set.insert
  let made = list.fold(xs, c) { acc, x -> f(acc, x + 500) }
  rowS("{kind} 14 the builtin as a value in a fold", before, fpS(c), fpS(made))
  let fs = [f, f]
  let made = list.fold(xs, c) { acc, x ->
    match list.get(fs, x % 2) {
      Some(g) -> g(acc, x + 500)
      None -> acc
    }
  }
  rowS("{kind} 14 the builtin from a list", before, fpS(c), fpS(made))
  let made = list.fold(xs, c, set.insert)
  rowS("{kind} 14 the builtin given to a fold", before, fpS(c), fpS(made))
  let made = list.fold([c, c], [], list.append)
  rowS("{kind} 14 list.append given to a fold of it", before, fpS(c), "{list.length(made)}")
  let nest = NestS { label: "o", inner: box, spare: box }
  let made = nloopS(0, 7, nest)
  rowS(
    "{kind} 15 a record in a record",
    "{before} {before} {before}",
    "{fpS(nest.inner.c)} {fpS(nest.spare.c)} {fpS(box.c)}",
    "{fpS(made.inner.c)} {fpS(made.inner.d)} {fpS(made.spare.c)}",
  )
  rowS(
    "{kind} 15 a record in a record, the old one too",
    before,
    fpS(nest.inner.c),
    noldS(0, 5, nest, nest),
  )
  let deep = DeepS { top: nest, n: 0 }
  let made = ndeepS(0, 7, deep)
  rowS(
    "{kind} 15 three records deep",
    "{before} {before}",
    "{fpS(deep.top.inner.c)} {fpS(nest.inner.c)}",
    "{fpS(made.top.inner.c)} {fpS(made.top.spare.c)}",
  )
  let made = notherS(0, 7, nest)
  rowS(
    "{kind} 15 a record in a record, a field from another",
    before,
    fpS(nest.inner.c),
    "{fpS(made.inner.c)} {fpS(made.inner.d)}",
  )
  let own = nloopS(
    0,
    3,
    NestS {
      label: "own",
      inner: BoxS { label: "i", c: make(), d: #[] },
      spare: BoxS { label: "s", c: #[], d: #[] },
    },
  )
  rowS("{kind} 15 a record in a record held nowhere else", before, fpS(c), fpS(own.inner.c))
  let made = list.fold(xs, nest) { o, x ->
    o.{ inner: o.inner.{ c: set.insert(o.inner.c, x + 500) } }
  }
  rowS(
    "{kind} 15 a record in a record in a fold",
    "{before} {before}",
    "{fpS(nest.inner.c)} {fpS(box.c)}",
    fpS(made.inner.c),
  )
  let kept = [nest.inner]
  let made = list.fold(xs, nest) { o, x ->
    o.{ inner: o.inner.{ c: set.insert(o.inner.c, x + 500) } }
  }
  rowS(
    "{kind} 15 a record in a record, its inner one in a list",
    before,
    fpS(option.unwrap_or(list.first(kept), box).c),
    fpS(made.inner.c),
  )
}

-- ── list.append: through calls, as a value, in nested records ──

type NestA {
  label: String,
  inner: BoxA,
  spare: BoxA,
}

type DeepA {
  top: NestA,
  n: Int,
}

trait StepA {
  fn step(self, x: Int) -> BoxA
}

trait StepA for BoxA {
  fn step(self, x: Int) -> BoxA {
    self.{ c: list.append(self.c, x) }
  }
}

trait CountA {
  fn count(self) -> Int
}

trait CountA for Int {
  fn count(self) -> Int {
    self + 1
  }
}

-- a function of the program that makes the update
fn wrapA(c: List(Int), x: Int) -> List(Int) {
  list.append(c, x)
}

fn wlastA(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  match i == n {
    true -> acc
    false -> wlastA(i + 1, n, wrapA(acc, i % 3))
  }
}

fn wletA(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  match i == n {
    true -> acc
    false -> {
      let next = wrapA(acc, i % 3)
      wletA(i + 1, n, next)
    }
  }
}

fn woldA(i: Int, n: Int, acc: List(Int), old: List(Int)) -> String {
  match i == n {
    true -> "{fpA(acc)} old {fpA(old)}"
    false -> woldA(i + 1, n, wrapA(acc, i % 3), acc)
  }
}

-- the old one read by a call after the update
fn wreadA(i: Int, n: Int, acc: List(Int), seen: List(String)) -> String {
  match i == n {
    true -> "{fpA(acc)} seen {seen}"
    false -> wreadA(i + 1, n, wrapA(acc, i % 3), [fpA(acc), ..seen])
  }
}

-- a closure made before the call keeps the old one
fn wlookA(i: Int, n: Int, acc: List(Int), looks: List(Fn() -> String)) -> String {
  match i == n {
    true -> "{fpA(acc)} looks {list.map(looks) { f -> f() }}"
    false -> {
      let look = { -> fpA(acc) }
      wlookA(i + 1, n, wrapA(acc, i % 3), [look, ..looks])
    }
  }
}

-- a method that makes the update of a record
fn mstepA(i: Int, n: Int, b: BoxA) -> BoxA {
  match i == n {
    true -> b
    false -> mstepA(i + 1, n, StepA.step(b, i % 3))
  }
}

fn mstepoldA(i: Int, n: Int, b: BoxA, old: BoxA) -> String {
  match i == n {
    true -> "{fpA(b.c)} old {fpA(old.c)}"
    false -> mstepoldA(i + 1, n, StepA.step(b, i % 3), b)
  }
}

-- a method called after the update
fn mafterA(acc: List(Int), i: Int, n: Int) -> List(Int) {
  match i == n {
    true -> acc
    false -> mafterA(list.append(acc, i % 3), CountA.count(i), n)
  }
}

fn mafteroldA(acc: List(Int), i: Int, n: Int, old: List(Int)) -> String {
  match i == n {
    true -> "{fpA(acc)} old {fpA(old)}"
    false -> mafteroldA(list.append(acc, i % 3), CountA.count(i), n, acc)
  }
}

-- the builtin as a value
fn vloopA(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  let f = list.append
  match i == n {
    true -> acc
    false -> vloopA(i + 1, n, f(acc, i % 3))
  }
}

fn voldA(i: Int, n: Int, acc: List(Int), old: List(Int)) -> String {
  let f = list.append
  match i == n {
    true -> "{fpA(acc)} old {fpA(old)}"
    false -> voldA(i + 1, n, f(acc, i % 3), acc)
  }
}

-- a record in a record
fn nloopA(i: Int, n: Int, o: NestA) -> NestA {
  match i == n {
    true -> o
    false -> nloopA(i + 1, n, o.{ inner: o.inner.{ c: list.append(o.inner.c, i % 3) } })
  }
}

fn noldA(i: Int, n: Int, o: NestA, old: NestA) -> String {
  match i == n {
    true -> "{fpA(o.inner.c)} old {fpA(old.inner.c)} {old.label}"
    false ->
      noldA(i + 1, n, o.{ inner: o.inner.{ c: list.append(o.inner.c, i % 3) }, label: "n{i}" }, o)
  }
}

fn ndeepA(i: Int, n: Int, d: DeepA) -> DeepA {
  match i == n {
    true -> d
    false -> ndeepA(
      i + 1,
      n,
      d.{ top: d.top.{ inner: d.top.inner.{ c: list.append(d.top.inner.c, i % 3) } } },
    )
  }
}

fn notherA(i: Int, n: Int, o: NestA) -> NestA {
  match i == n {
    true -> o
    false -> notherA(i + 1, n, o.{ inner: o.inner.{ d: list.append(o.inner.c, i % 3) } })
  }
}

fn moreA(kind: String, make: Fn() -> List(Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let before = fpA(c)
  rowA("{kind} 12 a function's update, last argument", before, fpA(c), fpA(wlastA(0, 7, c)))
  rowA("{kind} 12 a function's update through a let", before, fpA(c), fpA(wletA(0, 7, c)))
  rowA("{kind} 12 a function's update with the old one", before, fpA(c), woldA(0, 5, c, c))
  rowA("{kind} 12 a function's update, the old one read after", before, fpA(c), wreadA(0, 4, c, []))
  rowA(
    "{kind} 12 a function's update, a closure keeps the old one",
    before,
    fpA(c),
    wlookA(0, 4, c, []),
  )
  let made = list.fold(xs, c) { acc, x -> wrapA(acc, x) }
  rowA("{kind} 12 a function's update in a fold", before, fpA(c), fpA(made))
  let made = list.fold(xs, c) { acc, x ->
    let next = wrapA(acc, x)
    match fpA(acc) == fpA(acc) {
      true -> next
      false -> acc
    }
  }
  rowA("{kind} 12 a function's update in a fold, the old one read after", before, fpA(c), fpA(made))
  let box = BoxA { label: "b", c: c, d: c }
  let made = mstepA(0, 7, box)
  rowA(
    "{kind} 13 a method's update of a record",
    "{before} {before}",
    "{fpA(box.c)} {fpA(box.d)}",
    "{fpA(made.c)} {fpA(made.d)}",
  )
  rowA(
    "{kind} 13 a method's update, the old record too",
    before,
    fpA(box.c),
    mstepoldA(0, 5, box, box),
  )
  rowA("{kind} 13 a method after the update", before, fpA(c), fpA(mafterA(c, 0, 7)))
  rowA(
    "{kind} 13 a method after the update, the old one too",
    before,
    fpA(c),
    mafteroldA(c, 0, 5, c),
  )
  let made = list.fold(xs, box) { b, x -> StepA.step(b, x) }
  rowA("{kind} 13 a method's update in a fold", before, fpA(box.c), fpA(made.c))
  rowA("{kind} 14 the builtin as a value", before, fpA(c), fpA(vloopA(0, 7, c)))
  rowA("{kind} 14 the builtin as a value, the old one too", before, fpA(c), voldA(0, 5, c, c))
  let f = list.append
  let made = list.fold(xs, c) { acc, x -> f(acc, x) }
  rowA("{kind} 14 the builtin as a value in a fold", before, fpA(c), fpA(made))
  let fs = [f, f]
  let made = list.fold(xs, c) { acc, x ->
    match list.get(fs, x % 2) {
      Some(g) -> g(acc, x)
      None -> acc
    }
  }
  rowA("{kind} 14 the builtin from a list", before, fpA(c), fpA(made))
  let made = list.fold(xs, c, list.append)
  rowA("{kind} 14 the builtin given to a fold", before, fpA(c), fpA(made))
  let made = list.fold([c, c], [], list.append)
  rowA("{kind} 14 list.append given to a fold of it", before, fpA(c), "{list.length(made)}")
  let nest = NestA { label: "o", inner: box, spare: box }
  let made = nloopA(0, 7, nest)
  rowA(
    "{kind} 15 a record in a record",
    "{before} {before} {before}",
    "{fpA(nest.inner.c)} {fpA(nest.spare.c)} {fpA(box.c)}",
    "{fpA(made.inner.c)} {fpA(made.inner.d)} {fpA(made.spare.c)}",
  )
  rowA(
    "{kind} 15 a record in a record, the old one too",
    before,
    fpA(nest.inner.c),
    noldA(0, 5, nest, nest),
  )
  let deep = DeepA { top: nest, n: 0 }
  let made = ndeepA(0, 7, deep)
  rowA(
    "{kind} 15 three records deep",
    "{before} {before}",
    "{fpA(deep.top.inner.c)} {fpA(nest.inner.c)}",
    "{fpA(made.top.inner.c)} {fpA(made.top.spare.c)}",
  )
  let made = notherA(0, 7, nest)
  rowA(
    "{kind} 15 a record in a record, a field from another",
    before,
    fpA(nest.inner.c),
    "{fpA(made.inner.c)} {fpA(made.inner.d)}",
  )
  let own = nloopA(
    0,
    3,
    NestA {
      label: "own",
      inner: BoxA { label: "i", c: make(), d: [] },
      spare: BoxA { label: "s", c: [], d: [] },
    },
  )
  rowA("{kind} 15 a record in a record held nowhere else", before, fpA(c), fpA(own.inner.c))
  let made = list.fold(xs, nest) { o, x -> o.{ inner: o.inner.{ c: list.append(o.inner.c, x) } } }
  rowA(
    "{kind} 15 a record in a record in a fold",
    "{before} {before}",
    "{fpA(nest.inner.c)} {fpA(box.c)}",
    fpA(made.inner.c),
  )
  let kept = [nest.inner]
  let made = list.fold(xs, nest) { o, x -> o.{ inner: o.inner.{ c: list.append(o.inner.c, x) } } }
  rowA(
    "{kind} 15 a record in a record, its inner one in a list",
    before,
    fpA(option.unwrap_or(list.first(kept), box).c),
    fpA(made.inner.c),
  )
}

-- ── list.set: through calls, as a value, in nested records ──

type NestL {
  label: String,
  inner: BoxL,
  spare: BoxL,
}

type DeepL {
  top: NestL,
  n: Int,
}

trait StepL {
  fn step(self, x: Int) -> BoxL
}

trait StepL for BoxL {
  fn step(self, x: Int) -> BoxL {
    self.{
      c: match list.set(self.c, x, x * 5 + 7) {
        Some(next) -> next
        None -> []
      },
    }
  }
}

trait CountL {
  fn count(self) -> Int
}

trait CountL for Int {
  fn count(self) -> Int {
    self + 1
  }
}

-- a function of the program that makes the update
fn wrapL(c: List(Int), x: Int) -> List(Int) {
  match list.set(c, x, x * 5 + 7) {
    Some(next) -> next
    None -> []
  }
}

fn wlastL(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  match i == n {
    true -> acc
    false -> wlastL(i + 1, n, wrapL(acc, i % 3))
  }
}

fn wletL(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  match i == n {
    true -> acc
    false -> {
      let next = wrapL(acc, i % 3)
      wletL(i + 1, n, next)
    }
  }
}

fn woldL(i: Int, n: Int, acc: List(Int), old: List(Int)) -> String {
  match i == n {
    true -> "{fpL(acc)} old {fpL(old)}"
    false -> woldL(i + 1, n, wrapL(acc, i % 3), acc)
  }
}

-- the old one read by a call after the update
fn wreadL(i: Int, n: Int, acc: List(Int), seen: List(String)) -> String {
  match i == n {
    true -> "{fpL(acc)} seen {seen}"
    false -> wreadL(i + 1, n, wrapL(acc, i % 3), [fpL(acc), ..seen])
  }
}

-- a closure made before the call keeps the old one
fn wlookL(i: Int, n: Int, acc: List(Int), looks: List(Fn() -> String)) -> String {
  match i == n {
    true -> "{fpL(acc)} looks {list.map(looks) { f -> f() }}"
    false -> {
      let look = { -> fpL(acc) }
      wlookL(i + 1, n, wrapL(acc, i % 3), [look, ..looks])
    }
  }
}

-- a method that makes the update of a record
fn mstepL(i: Int, n: Int, b: BoxL) -> BoxL {
  match i == n {
    true -> b
    false -> mstepL(i + 1, n, StepL.step(b, i % 3))
  }
}

fn mstepoldL(i: Int, n: Int, b: BoxL, old: BoxL) -> String {
  match i == n {
    true -> "{fpL(b.c)} old {fpL(old.c)}"
    false -> mstepoldL(i + 1, n, StepL.step(b, i % 3), b)
  }
}

-- a method called after the update
fn mafterL(acc: List(Int), i: Int, n: Int) -> List(Int) {
  match i == n {
    true -> acc
    false -> mafterL(
      match list.set(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      },
      CountL.count(i),
      n,
    )
  }
}

fn mafteroldL(acc: List(Int), i: Int, n: Int, old: List(Int)) -> String {
  match i == n {
    true -> "{fpL(acc)} old {fpL(old)}"
    false -> mafteroldL(
      match list.set(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      },
      CountL.count(i),
      n,
      acc,
    )
  }
}

-- the builtin as a value
fn vloopL(i: Int, n: Int, acc: List(Int)) -> List(Int) {
  let f = list.set
  match i == n {
    true -> acc
    false -> vloopL(
      i + 1,
      n,
      match f(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      },
    )
  }
}

fn voldL(i: Int, n: Int, acc: List(Int), old: List(Int)) -> String {
  let f = list.set
  match i == n {
    true -> "{fpL(acc)} old {fpL(old)}"
    false -> voldL(
      i + 1,
      n,
      match f(acc, i % 3, i % 3 * 5 + 7) {
        Some(next) -> next
        None -> []
      },
      acc,
    )
  }
}

-- a record in a record
fn nloopL(i: Int, n: Int, o: NestL) -> NestL {
  match i == n {
    true -> o
    false -> nloopL(
      i + 1,
      n,
      o.{
        inner: o.inner.{
          c: match list.set(o.inner.c, i % 3, i % 3 * 5 + 7) {
            Some(next) -> next
            None -> []
          },
        },
      },
    )
  }
}

fn noldL(i: Int, n: Int, o: NestL, old: NestL) -> String {
  match i == n {
    true -> "{fpL(o.inner.c)} old {fpL(old.inner.c)} {old.label}"
    false -> noldL(
      i + 1,
      n,
      o.{
        inner: o.inner.{
          c: match list.set(o.inner.c, i % 3, i % 3 * 5 + 7) {
            Some(next) -> next
            None -> []
          },
        },
        label: "n{i}",
      },
      o,
    )
  }
}

fn ndeepL(i: Int, n: Int, d: DeepL) -> DeepL {
  match i == n {
    true -> d
    false -> ndeepL(
      i + 1,
      n,
      d.{
        top: d.top.{
          inner: d.top.inner.{
            c: match list.set(d.top.inner.c, i % 3, i % 3 * 5 + 7) {
              Some(next) -> next
              None -> []
            },
          },
        },
      },
    )
  }
}

fn notherL(i: Int, n: Int, o: NestL) -> NestL {
  match i == n {
    true -> o
    false -> notherL(
      i + 1,
      n,
      o.{
        inner: o.inner.{
          d: match list.set(o.inner.c, i % 3, i % 3 * 5 + 7) {
            Some(next) -> next
            None -> []
          },
        },
      },
    )
  }
}

fn moreL(kind: String, make: Fn() -> List(Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let before = fpL(c)
  rowL("{kind} 12 a function's update, last argument", before, fpL(c), fpL(wlastL(0, 7, c)))
  rowL("{kind} 12 a function's update through a let", before, fpL(c), fpL(wletL(0, 7, c)))
  rowL("{kind} 12 a function's update with the old one", before, fpL(c), woldL(0, 5, c, c))
  rowL("{kind} 12 a function's update, the old one read after", before, fpL(c), wreadL(0, 4, c, []))
  rowL(
    "{kind} 12 a function's update, a closure keeps the old one",
    before,
    fpL(c),
    wlookL(0, 4, c, []),
  )
  let made = list.fold(xs, c) { acc, x -> wrapL(acc, x) }
  rowL("{kind} 12 a function's update in a fold", before, fpL(c), fpL(made))
  let made = list.fold(xs, c) { acc, x ->
    let next = wrapL(acc, x)
    match fpL(acc) == fpL(acc) {
      true -> next
      false -> acc
    }
  }
  rowL("{kind} 12 a function's update in a fold, the old one read after", before, fpL(c), fpL(made))
  let box = BoxL { label: "b", c: c, d: c }
  let made = mstepL(0, 7, box)
  rowL(
    "{kind} 13 a method's update of a record",
    "{before} {before}",
    "{fpL(box.c)} {fpL(box.d)}",
    "{fpL(made.c)} {fpL(made.d)}",
  )
  rowL(
    "{kind} 13 a method's update, the old record too",
    before,
    fpL(box.c),
    mstepoldL(0, 5, box, box),
  )
  rowL("{kind} 13 a method after the update", before, fpL(c), fpL(mafterL(c, 0, 7)))
  rowL(
    "{kind} 13 a method after the update, the old one too",
    before,
    fpL(c),
    mafteroldL(c, 0, 5, c),
  )
  let made = list.fold(xs, box) { b, x -> StepL.step(b, x) }
  rowL("{kind} 13 a method's update in a fold", before, fpL(box.c), fpL(made.c))
  rowL("{kind} 14 the builtin as a value", before, fpL(c), fpL(vloopL(0, 7, c)))
  rowL("{kind} 14 the builtin as a value, the old one too", before, fpL(c), voldL(0, 5, c, c))
  let f = list.set
  let made = list.fold(xs, c) { acc, x ->
    match f(acc, x, x * 5 + 7) {
      Some(next) -> next
      None -> []
    }
  }
  rowL("{kind} 14 the builtin as a value in a fold", before, fpL(c), fpL(made))
  let fs = [f, f]
  let made = list.fold(xs, c) { acc, x ->
    match list.get(fs, x % 2) {
      Some(g) -> match g(acc, x, x * 5 + 7) {
        Some(next) -> next
        None -> []
      }
      None -> acc
    }
  }
  rowL("{kind} 14 the builtin from a list", before, fpL(c), fpL(made))
  let nest = NestL { label: "o", inner: box, spare: box }
  let made = nloopL(0, 7, nest)
  rowL(
    "{kind} 15 a record in a record",
    "{before} {before} {before}",
    "{fpL(nest.inner.c)} {fpL(nest.spare.c)} {fpL(box.c)}",
    "{fpL(made.inner.c)} {fpL(made.inner.d)} {fpL(made.spare.c)}",
  )
  rowL(
    "{kind} 15 a record in a record, the old one too",
    before,
    fpL(nest.inner.c),
    noldL(0, 5, nest, nest),
  )
  let deep = DeepL { top: nest, n: 0 }
  let made = ndeepL(0, 7, deep)
  rowL(
    "{kind} 15 three records deep",
    "{before} {before}",
    "{fpL(deep.top.inner.c)} {fpL(nest.inner.c)}",
    "{fpL(made.top.inner.c)} {fpL(made.top.spare.c)}",
  )
  let made = notherL(0, 7, nest)
  rowL(
    "{kind} 15 a record in a record, a field from another",
    before,
    fpL(nest.inner.c),
    "{fpL(made.inner.c)} {fpL(made.inner.d)}",
  )
  let own = nloopL(
    0,
    3,
    NestL {
      label: "own",
      inner: BoxL { label: "i", c: make(), d: [] },
      spare: BoxL { label: "s", c: [], d: [] },
    },
  )
  rowL("{kind} 15 a record in a record held nowhere else", before, fpL(c), fpL(own.inner.c))
  let made = list.fold(xs, nest) { o, x ->
    o.{
      inner: o.inner.{
        c: match list.set(o.inner.c, x, x * 5 + 7) {
          Some(next) -> next
          None -> []
        },
      },
    }
  }
  rowL(
    "{kind} 15 a record in a record in a fold",
    "{before} {before}",
    "{fpL(nest.inner.c)} {fpL(box.c)}",
    fpL(made.inner.c),
  )
  let kept = [nest.inner]
  let made = list.fold(xs, nest) { o, x ->
    o.{
      inner: o.inner.{
        c: match list.set(o.inner.c, x, x * 5 + 7) {
          Some(next) -> next
          None -> []
        },
      },
    }
  }
  rowL(
    "{kind} 15 a record in a record, its inner one in a list",
    before,
    fpL(option.unwrap_or(list.first(kept), box).c),
    fpL(made.inner.c),
  )
}

-- ── map.set: a field of the outer record read in the same update ──

fn shownM(o: NestM) -> String {
  "{o.label}:{fpM(o.inner.c)}:{fpM(o.spare.c)}"
}

fn plabelM(i: Int, n: Int, o: NestM) -> NestM {
  match i == n {
    true -> o
    false -> plabelM(
      i + 1,
      n,
      o.{ inner: o.inner.{ c: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) }, label: "{o.label}." },
    )
  }
}

fn pinnerM(i: Int, n: Int, o: NestM) -> NestM {
  match i == n {
    true -> o
    false -> pinnerM(
      i + 1,
      n,
      o.{ inner: o.inner.{ c: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) }, spare: o.inner },
    )
  }
}

fn pwholeM(i: Int, n: Int, o: NestM) -> NestM {
  match i == n {
    true -> o
    false -> pwholeM(
      i + 1,
      n,
      o.{ inner: o.inner.{ c: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) }, label: shownM(o) },
    )
  }
}

fn ptwoM(i: Int, n: Int, o: NestM) -> NestM {
  match i == n {
    true -> o
    false -> ptwoM(
      i + 1,
      n,
      o.{
        inner: o.inner.{ c: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) },
        label: "{o.label}{fpM(o.spare.c)}",
      },
    )
  }
}

fn parmM(i: Int, n: Int, o: NestM) -> NestM {
  match i == n {
    true -> o
    false -> match i % 2 == 0 {
      true -> parmM(
        i + 1,
        n,
        o.{ inner: o.inner.{ c: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) }, label: "{o.label}e" },
      )
      false -> parmM(
        i + 1,
        n,
        o.{ inner: o.inner.{ c: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) }, spare: o.inner },
      )
    }
  }
}

fn paliasM(i: Int, n: Int, o: NestM) -> NestM {
  match i == n {
    true -> o
    false -> {
      let next = o.inner.{ c: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) }
      let p = o
      paliasM(i + 1, n, o.{ inner: next, label: "{p.label}a", spare: p.inner })
    }
  }
}

fn poldM(i: Int, n: Int, o: NestM, old: NestM) -> String {
  match i == n {
    true -> "{shownM(o)} old {shownM(old)}"
    false -> poldM(
      i + 1,
      n,
      o.{ inner: o.inner.{ c: map.set(o.inner.c, i % 3, i % 3 * 3 + 1) }, label: "{o.label}o" },
      o,
    )
  }
}

fn pdeepM(i: Int, n: Int, d: DeepM) -> DeepM {
  match i == n {
    true -> d
    false -> pdeepM(
      i + 1,
      n,
      d.{
        top: d.top.{
          inner: d.top.inner.{ c: map.set(d.top.inner.c, i % 3, i % 3 * 3 + 1) },
          label: "{d.top.label}d",
        },
        n: d.n + 1,
      },
    )
  }
}

fn partM(kind: String, make: Fn() -> Map(Int, Int)) {
  let xs = [1, 2, 0, 2, 1, 0, 2]
  let c = make()
  let box = BoxM { label: "b", c: c, d: c }
  let nest = NestM { label: "o", inner: box, spare: box }
  let before = shownM(nest)
  rowM(
    "{kind} 16 another field read in the update",
    before,
    shownM(nest),
    shownM(plabelM(0, 7, nest)),
  )
  rowM(
    "{kind} 16 the inner record read in the update",
    before,
    shownM(nest),
    shownM(pinnerM(0, 7, nest)),
  )
  rowM(
    "{kind} 16 the whole record read in the update",
    before,
    shownM(nest),
    shownM(pwholeM(0, 3, nest)),
  )
  rowM("{kind} 16 two other fields read", before, shownM(nest), shownM(ptwoM(0, 5, nest)))
  rowM("{kind} 16 arms that read other fields", before, shownM(nest), shownM(parmM(0, 7, nest)))
  rowM("{kind} 16 an alias read after", before, shownM(nest), shownM(paliasM(0, 5, nest)))
  rowM(
    "{kind} 16 another field read, the old one too",
    before,
    shownM(nest),
    poldM(0, 5, nest, nest),
  )
  let deep = DeepM { top: nest, n: 0 }
  let made = pdeepM(0, 7, deep)
  rowM("{kind} 16 three deep, fields read", before, shownM(deep.top), "{shownM(made.top)} {made.n}")
  let made = list.fold(xs, nest) { o, x ->
    o.{ inner: o.inner.{ c: map.set(o.inner.c, x, x * 3 + 1) }, label: "{o.label}f" }
  }
  rowM("{kind} 16 a fold, another field read", before, shownM(nest), shownM(made))
  let made = list.fold(xs, nest) { o, x ->
    o.{ inner: o.inner.{ c: map.set(o.inner.c, x, x * 3 + 1) }, spare: o.inner }
  }
  rowM("{kind} 16 a fold, the inner record read", before, shownM(nest), shownM(made))
  let own = plabelM(
    0,
    3,
    NestM { label: "own", inner: BoxM { label: "i", c: make(), d: make() }, spare: box },
  )
  rowM("{kind} 16 held nowhere else, another field read", before, shownM(nest), shownM(own))
}

-- ── map.update: a field of the outer record read in the same update ──

fn shownU(o: NestU) -> String {
  "{o.label}:{fpU(o.inner.c)}:{fpU(o.spare.c)}"
}

fn plabelU(i: Int, n: Int, o: NestU) -> NestU {
  match i == n {
    true -> o
    false -> plabelU(
      i + 1,
      n,
      o.{
        inner: o.inner.{ c: map.update(o.inner.c, i % 3, 0) { v -> v + 1 } },
        label: "{o.label}.",
      },
    )
  }
}

fn pinnerU(i: Int, n: Int, o: NestU) -> NestU {
  match i == n {
    true -> o
    false -> pinnerU(
      i + 1,
      n,
      o.{ inner: o.inner.{ c: map.update(o.inner.c, i % 3, 0) { v -> v + 1 } }, spare: o.inner },
    )
  }
}

fn pwholeU(i: Int, n: Int, o: NestU) -> NestU {
  match i == n {
    true -> o
    false -> pwholeU(
      i + 1,
      n,
      o.{ inner: o.inner.{ c: map.update(o.inner.c, i % 3, 0) { v -> v + 1 } }, label: shownU(o) },
    )
  }
}

fn ptwoU(i: Int, n: Int, o: NestU) -> NestU {
  match i == n {
    true -> o
    false -> ptwoU(
