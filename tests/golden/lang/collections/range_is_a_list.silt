-- `a..b` is the list of the Ints from `a` to `b`: it is shown, compared,
-- matched and taken apart as the list of the same elements made any
-- other way. (It was a value of its own kind that printed `1..3`, and
-- whose tail printed `2..4`.)
import io
import list
import map
import set
import string

type Span {
  name: String,
  over: List(Int),
}

fn describe(xs: List(Int)) -> String {
  match xs {
    [] -> "empty"
    [only] -> "one: {only}"
    [first, ..rest] -> "{first}, then {rest}"
  }
}

fn main() {
  println(1..3)
  print(1..3)
  println("")
  println("{1..3} and {(1..3, 5..4)}")
  println(string.from(1..3))
  println((1..3).display())
  println(io.inspect(1..3))
  println(io.inspect(Span { name: "s", over: 1..3 }))
  println(Span { name: "s", over: 2..2 })
  println(Some(1..2))
  println(#{"k": 1..2})
  println(5..4)
  println(-2..2)

  -- Its parts are lists.
  println(list.tail(1..4))
  println(list.take(1..9, 2))
  println(list.drop(1..9, 7))
  println(list.take(1..9, 0))
  println(list.drop(1..9, 9))
  println(describe(1..4))
  println(describe(7..7))
  println(describe(7..6))
  println([0, ..1..3, 9])
  println(list.reverse(1..4))
  println(list.sort(3..5))
  println(list.unique(3..5))
  println(list.append(1..2, 9))
  println(list.zip(1..3, ["a", "b"]))
  println(list.flatten([1..2, [9], 4..5]))
  println(list.enumerate(5..6))
  println(list.map(1..3) { x -> x * x })
  println(list.filter(1..10) { x -> x % 3 == 0 })

  -- It is equal to the list of its elements, ordered with it, hashed
  -- as it, and one key with it.
  println(1..3 == [1, 2, 3])
  println([1, 2, 3] == 1..3)
  println(1..3 == [1, 2, 4])
  println(1..3 == 1..4)
  println(5..4 == [])
  println(1..3 < [1, 2, 4])
  println([1, 2] < 1..3)
  println(2..3 > [1, 9, 9])
  println((1..3).hash() == [1, 2, 3].hash())
  println(list.tail(0..3).hash() == [1, 2, 3].hash())
  println((1..3).hash() == [1, 2, 4].hash())
  println(set.length(#[1..3, [1, 2, 3], list.tail(0..3)]))
  println(map.get(#{[1, 2, 3]: "found"}, 1..3))
  println(list.sort([2..3, [1, 5], 1..4, []]))
  println(list.contains([[1, 2], [3]], 1..2))
  println(list.index_of([[9], [1, 2]], 1..2))
}
