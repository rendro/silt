import test
type Outcome { Fine, Bad(String) }
fn test_ok() -> Result(Int, String) {
  Ok(1)
}
fn test_unit() {
  test.assert_eq(1, 1)
}
fn test_nothing_ok() -> Result((), String) {
  Ok(())
}
fn test_int() {
  42
}
fn test_some() {
