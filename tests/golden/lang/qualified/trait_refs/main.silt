-- Trait references reached through a module: an impl of an imported
-- trait, an impl for an imported type (of a trait declared here), a
-- where bound and a supertrait.
import lib

type Local { L(Int) }

trait lib.Describe for Local {
  fn describe(self) -> String {
    match self {
      L(n) -> "local {n}"
    }
  }
}

trait Loud: lib.Describe {
  fn shout(self) -> String
}

trait Loud for Local {
  fn shout(self) -> String {
    "{self.describe()}!"
  }
}

trait Loud for lib.Pt {
  fn shout(self) -> String {
    "{self.describe()}!!"
  }
}

fn show(a: a) -> String where a: lib.Describe {
  a.describe()
}

fn main() {
  println(show(L(1)))
  println(show(lib.Pt { x: 1, y: 2 }))
  println(L(2).shout())
  println(lib.Pt { x: 3, y: 4 }.shout())
}
