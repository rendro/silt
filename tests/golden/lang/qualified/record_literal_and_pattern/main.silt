-- A record literal and a record pattern reached through a module, with
-- the type written qualified in the annotation.
import geo

fn sum(p: geo.Pt) -> Int {
  match p {
    geo.Pt { x, y } -> x + y
  }
}

fn main() {
  let p: geo.Pt = geo.Pt { x: 1, y: 2 }
  let geo.Pt { x, .. } = p
  println(x)
  println(sum(p))
}
