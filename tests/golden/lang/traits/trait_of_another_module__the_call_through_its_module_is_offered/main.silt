-- cmd: check
-- exit: 1
-- Under `import m` the help for a method of `m.Some` offers the call
-- through the module, which compiles (audit R9, review O7-1).
import m
fn use(x: a) -> Int where a: m.Some { x.go() }
fn use2(x: a) -> Int where a: m.Some { m.Some.go(x) }
fn main() { println((use(1), use2(1))) }
