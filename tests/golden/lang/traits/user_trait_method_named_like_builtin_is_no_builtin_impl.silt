-- A trait of the program with methods named `display` and `compare`,
-- implemented for a type of the program: no impl of Display or Compare,
-- so the type keeps its derived ones (no "duplicate implementation of
-- trait 'Display'", which the program never wrote).
type Pt { x: Int }
trait Describe { fn display(self) -> String }
trait Describe for Pt { fn display(self) -> String { "described" } }
trait Ranked { fn compare(self, other: Self) -> Int }
trait Ranked for Pt { fn compare(self, other: Self) -> Int { 99 } }
fn show_it(a: a) -> String where a: Display { "{a}" }
fn rank(a: a, b: a) -> Int where a: Ranked { a.compare(b) }
fn main() {
  println("{Pt { x: 1 }}")
  println(show_it(Pt { x: 2 }))
  println(Pt { x: 1 } < Pt { x: 2 })
  println(rank(Pt { x: 1 }, Pt { x: 2 }))
}
