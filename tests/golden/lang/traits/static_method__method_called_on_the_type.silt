-- A method with `self` is called through its trait, called or as a
-- value, with the receiver as its first argument; a method without
-- `self` is called on the type or on a `type` parameter.
trait Vals {
  fn total(self) -> Int
  fn zero() -> Self
}

trait Vals for Int {
  fn total(self) -> Int {
    self + 1
  }
  fn zero() -> Self {
    0
  }
}

fn zero_of(type b) -> b where b: Vals {
  b.zero()
}

fn main() {
  println(Vals.total(7))
  let total = Vals.total
  println(total(7))
  println(Int.zero())
  println(zero_of(Int))
}
