-- exit: 1
-- timeout: 60
-- stderr-contains: error[runtime]: stack overflow: recursion depth exceeded 100000 frames
-- stderr-not-contains: overflowed its stack
-- A Display impl that shows the value it is given recurses like any
-- function that calls itself: the frame limit ends it with an error.
type Loop {
  n: Int,
}

trait Display for Loop {
  fn display(self) -> String {
    "{self}"
  }
}

fn main() {
  println(Loop { n: 1 })
}
