-- exit: 1
-- timeout: 60
-- frame-budget: 1
-- stderr-contains: error[runtime]: stack overflow: call frames take more than 1 MiB
-- stderr-not-contains: overflowed its stack
-- A Display impl that shows the value it is given recurses like any
-- function that calls itself: the frame budget ends it with an error.
type Loop {
  n: Int,
}

trait Display for Loop {
  fn display(self) -> String {
    "{self}"
  }
}

fn main() {
  println(Loop { n: 1 })
}
