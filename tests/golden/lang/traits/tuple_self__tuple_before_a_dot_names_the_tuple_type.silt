-- exit: 1
-- `Tuple(...)` before a dot is no spelling of the tuple type: its error
-- has the help that writes the type, its parts as written and a nested
-- `Tuple(...)` as the tuple it means, on the outer `Tuple` only. No help
-- where a part is no type or `Tuple` has fewer than two parts. Anywhere
-- else `Tuple` is only undefined.
import json

trait Monoid {
  fn empty() -> Self
}

trait Monoid for Int {
  fn empty() -> Self { 0 }
}

fn main() {
  println(Tuple(Int, List(String), json.Value).empty())
  println(Tuple(Int, Tuple(Int, Int)).empty())
  println(Tuple().empty())
  println(Tuple(1, "a").empty())
  let t = Tuple(Int, Int)
  println(t)
}
