-- The same through a bound: a value of a bounded type variable has no
-- fields; `join`, which takes Self, is called through its trait.
trait Mk {
  fn make(n: Int) -> Self
  fn join(a: Self, b: Self) -> Self
  fn twice(self) -> Self
}

trait Mk for Int {
  fn make(n: Int) -> Int {
    n
  }
  fn join(a: Int, b: Int) -> Int {
    a + b
  }
  fn twice(self) -> Int {
    self * 2
  }
}

fn one(x: a) -> a where a: Mk {
  x.make()
}

fn all(x: a) -> a where a: Mk {
  x.make(1)
}

fn two(x: a, y: a) -> a where a: Mk {
  x.join(y)
}

fn main() {
  println(one(5))
  println(all(5))
  println(two(1, 2))
}
