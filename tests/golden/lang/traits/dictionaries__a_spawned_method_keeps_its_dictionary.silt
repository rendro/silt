-- A method taken as a value has its dictionary bound, and keeps it as
-- the function of a task; a closure that calls a method through a
-- bound does too.
import task
trait Name { fn name(self) -> String }
type K { K }
trait Name for K { fn name(self) -> String { "k" } }
type Bx(a) { Bx(a) }
trait Name for Bx(a) where a: Name {
  fn name(self) -> String { match self { Bx(x) -> "bx({Name.name(x)})" } }
}
trait Zero { fn zero() -> Self }
trait Zero for Int { fn zero() -> Int { 41 } }
fn later(x: a) -> String where a: Name {
  let h = task.spawn({ -> Name.name(x) })
  task.join(h)
}
fn main() {
  println(later(Bx(Bx(K))))
  let h = task.spawn(Int.zero)
  println(task.join(h) + 1)
}
