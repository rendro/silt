-- cmd: check
-- exit: 1
-- A function whose `x.m()` reads its parameter as a type (one trait in
-- sight has a method `m` that makes a value) says so at a call that
-- gives a value, and what to write instead. One whose `t.m()` would read
-- it as a record (several traits have one) that nothing decides is
-- refused where it is written, with the type parameter that says which.
trait Monoid {
  fn empty() -> Self
}

trait Monoid for Int {
  fn empty() -> Self {
    0
  }
}

trait A {
  fn mk() -> Self
}

trait B {
  fn mk() -> Self
}

type W {
  n: Int,
}

trait A for W {
  fn mk() -> Self {
    W { n: 1 }
  }
}

type Rec {
  empty: Fn() -> Int,
}

fn r(x) {
  x.empty()
}

fn go(t) {
  t.mk()
}

fn main() {
  println(r(Rec { empty: { -> 5 } }))
  println(r(7))
  println(r("s"))
  println(go(W))
}
