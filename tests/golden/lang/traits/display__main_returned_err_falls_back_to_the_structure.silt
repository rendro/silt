-- exit: 1
-- Where the Display impl of the `Err` a `main` returns fails itself,
-- the value is shown by its structure: the message is the Err.
type Code {
  n: Int,
}

trait Display for Code {
  fn display(self) -> String {
    "code {100 / self.n}"
  }
}

fn main() -> Result((), Code) {
  Err(Code { n: 0 })
}
