-- exit: 1
-- repeat: 100
-- stderr-contains: error[runtime]: panic: code 50
-- A task that panics with a value fails with the value as it is shown,
-- in the error of the `task.join` that meets it.
import task
type Code {
  n: Int,
}

trait Display for Code {
  fn display(self) -> String {
    "code {100 / self.n}"
  }
}

fn main() {
  task.join([{ -> panic(Code { n: 2 }) }])
}
