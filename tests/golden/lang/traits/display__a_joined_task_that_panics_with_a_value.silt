-- exit: 1
-- repeat: 100
-- stderr-contains: error[runtime]: joined task failed: panic: code 50
-- A task that panics with a value fails with the value as it is shown,
-- in the error of the `task.join` that meets it.
import task
type Code {
  n: Int,
}

trait Display for Code {
  fn display(self) -> String {
    "code {100 / self.n}"
  }
}

fn main() {
  let h = task.spawn({ -> panic(Code { n: 2 }) })
  task.join(h)
}
