-- cmd: check
-- exit: 1
-- The same trait with its module imported too: the help offers the call
-- through the module, `m.Some.go(x)`, which the file can write (audit R9,
-- review O7-1).
import m
import m.{ Some }
fn use(x: a) -> Int where a: Some { x.go() }
fn use2(x: a) -> Int where a: Some { m.Some.go(x) }
fn main() { println((use(1), use2(1))) }
