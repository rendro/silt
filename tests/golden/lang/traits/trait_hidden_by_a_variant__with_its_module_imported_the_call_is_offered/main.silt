-- cmd: check
-- exit: 1
-- The same trait with its module imported too: the help of `x.hop()`
-- and of `Foo.hop(x)` (where `Foo` is the variant) offers the call
-- through the module, `m.Foo.hop(x)`, which the file can write (audit
-- R9, review O7-1; rv-o8 S3).
import m
import m.{ Foo }
type T { Foo(Int), Bar }
fn use(x: a) -> Int where a: Foo { x.hop() }
fn use2(x: a) -> Int where a: Foo { Foo.hop(x) }
fn use3(x: a) -> Int where a: Foo { m.Foo.hop(x) }
fn main() { println((use(1), use2(1), use3(1), Foo(2), Bar)) }
