-- cmd: check
-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: does not implement trait 'T(Int)'
-- A method-level `where a: T(Int)` bound is validated when `a` resolves
-- to Unit, which only implements T(String).
trait T(c) { fn m(self) -> c }
trait T(String) for Unit { fn m(self) -> String { "u" } }
type Box(a) { Wrap(a) }
trait Foo { fn do_it(self) -> Int }
trait Foo for Box(a) {
    fn do_it(self) -> Int where a: T(Int) {
      match self {
          Wrap(_) -> 0
      }
    }
}
fn main() {
    let b: Box(Unit) = Wrap(())
    let r: Int = b.do_it()
    println(r)
}
