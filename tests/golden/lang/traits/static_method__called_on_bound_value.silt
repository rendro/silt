-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'b' has no field 'total'
-- stderr-contains: help: `total` is a method of trait `Vals` that makes a value: call it on the type, `b.total()`, where `b` is a `type b` parameter
-- stderr-not-contains: panicked
-- A method the trait declares without `self` is called on a type: a
-- value of a bounded type variable has no field of its name (the
-- checker used to panic here).
trait Vals {
  fn total() -> Int
}

trait Vals for Int {
  fn total() -> Int {
    3
  }
}

fn go(x: b) -> Int where b: Vals {
  x.total()
}

fn main() {
  println(go(7))
}
