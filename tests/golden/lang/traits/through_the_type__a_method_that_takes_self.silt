-- cmd: check
-- exit: 1
-- A method that takes a value of the type is called through its trait:
-- through the type it is an error, also through a `type a` parameter,
-- and for the builtin traits; a method that makes a value is called
-- through the type.
trait Monoid {
  fn empty() -> Self
  fn combine(a: Self, b: Self) -> Self
}
trait Monoid for Int {
  fn empty() -> Self { 0 }
  fn combine(a: Self, b: Self) -> Self { a + b }
}
fn sum(x: a, y: a, type a) -> a where a: Monoid { a.combine(x, y) }
fn main() {
  println(Int.combine(1, 2))
  println(Int.empty())
  println(sum(1, 2, Int))
  println(Int.compare(1, 2))
  println(Int.display(1))
}
