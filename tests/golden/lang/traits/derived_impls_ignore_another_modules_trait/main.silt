-- Two modules' trait Describe, each with a method display implemented
-- for Int: a derived Display of this module's Pt is the builtin one,
-- and each module's call through its own bound calls its impl.
import a
import helper
import string
type Pt { x: Int }
fn main() {
  println(a.f())
  println(helper.g())
  println(string.from(Pt { x: 1 }))
  println(Pt { x: 1 } == Pt { x: 1 })
  println("{Pt { x: 2 }}")
}
