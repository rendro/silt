-- Two impls no one type could be both of are two impls: `T(a, b, a, b)`
-- beside `T(List(c), List(d), d, c)` (one type would hold itself), and
-- two record types.
trait T(p, q, r, s) { fn mk(w: p, x: q, y: r, z: s) -> Self }
trait From(e) { fn from(source: e) -> Self }
type A { A(String) }
type X { x: Int }
type Y { y: String }
fn sh(a: A) -> String { match a { A(s) -> s } }
trait T(a, b, a, b) for A { fn mk(w: a, x: b, y: a, z: b) -> A { A("abab") } }
trait T(List(c), List(d), d, c) for A { fn mk(w: List(c), x: List(d), y: d, z: c) -> A { A("lists") } }
trait From(X) for A { fn from(e: X) -> A { A("x") } }
trait From(Y) for A { fn from(e: Y) -> A { A("y") } }
fn main() {
  println(sh(A.mk(1, 2, 1, 2)))
  println(sh(A.from(X { x: 1 })))
  println(sh(A.from(Y { y: "s" })))
}
