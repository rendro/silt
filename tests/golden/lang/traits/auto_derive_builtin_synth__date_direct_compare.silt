import time
fn main() {
    match time.date(2025, 1, 15) {
        Ok(a) -> match time.date(2025, 1, 20) {
            Ok(b) -> {
                println(a.compare(b))
                println(b.compare(a))
                println(a.compare(a))
            }
            Err(_) -> ()
        }
        Err(_) -> ()
    }
}
