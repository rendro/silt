import time
fn main() {
    match time.date(2025, 1, 15) {
        Ok(a) -> match time.date(2025, 1, 20) {
            Ok(b) -> {
                println(Compare.compare(a, b))
                println(Compare.compare(b, a))
                println(Compare.compare(a, a))
            }
            Err(_) -> ()
        }
        Err(_) -> ()
    }
}
