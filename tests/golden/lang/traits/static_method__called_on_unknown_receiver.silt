-- A receiver whose type is not known where the call is written, of a
-- method that makes a value of the one trait in sight that has it, is a
-- type that owes the trait (as one handed to `json.parse` is): an Int
-- given there is refused (it used to check, and fail when run).
trait Vals {
  fn total() -> Int
}

trait Vals for Int {
  fn total() -> Int {
    3
  }
}

fn go(x) {
  x.total()
}

fn first(x: a) -> a {
  x
}

fn main() {
  let f = { x -> first(x).total() }
  println(go(7))
  println(f(7))
}
