-- A module's private trait is never a candidate for a call in another
-- module: here main's own Show and helper's private Show, both for
-- Int; main's calls, concrete or polymorphic, call main's.
import helper
trait Show { fn show(self) -> String }
trait Show for Int { fn show(self) -> String { "main {self}" } }
fn apply(f: Fn(a) -> String, x: a) -> String { f(x) }
fn main() {
  println(helper.h())
  println(Show.show(2))
  let g = { y -> Show.show(y) }
  println(g(3))
  println(apply({ y -> Show.show(y) }, 4))
}
