-- exit: 1
-- stderr-contains: error[runtime]: joined task failed: panic: code 50
-- stderr-contains: failed and was never joined: panic: [code 25]
-- A task that panics with a value fails with the value as it is shown,
-- in the error of the `task.join` that meets it and in the report of a
-- failed task nobody joined.
import task
type Code {
  n: Int,
}

trait Display for Code {
  fn display(self) -> String {
    "code {100 / self.n}"
  }
}

fn main() {
  let lost = task.spawn({ -> panic([Code { n: 4 }]) })
  let h = task.spawn({ -> panic(Code { n: 2 }) })
  task.join(h)
}
