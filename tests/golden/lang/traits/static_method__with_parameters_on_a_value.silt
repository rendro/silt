-- stderr-contains: :35:11
-- stderr-contains: :36:11
-- stderr-not-contains: expects
-- A dot after a value is a field, whatever methods its type has: a
-- method that makes a value is called on the type, one that takes Self
-- through its trait (a call on a value used to take the receiver for
-- the first parameter, or say "expects 0 arguments").
trait Mk {
  fn make(n: Int) -> Self
  fn join(a: Self, b: Self) -> Self
  fn twice(self) -> Self
}

trait Mk for Int {
  fn make(n: Int) -> Int {
    n
  }
  fn join(a: Int, b: Int) -> Int {
    a + b
  }
  fn twice(self) -> Int {
    self * 2
  }
}

fn main() {
  println(5.make())
  println(5.make(1))
  println(1.join(2))
  println(1.join(2, 3))
}
