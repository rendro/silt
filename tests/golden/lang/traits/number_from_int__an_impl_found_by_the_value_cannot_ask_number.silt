-- cmd: check
-- exit: 1
-- Number is passed with a dictionary, so an impl of a trait found by the
-- value (Display) cannot ask it of its type's variables: the runtime
-- runs the impl with nothing to pass.
-- stderr-contains: error[type]: an impl of 'Display' can ask only 'Display', 'Equal', 'Compare', 'Hash', 'json.Encode', 'json.Decode' or 'Error' of its type's variables
-- stderr-contains: = help: do the arithmetic in a function bounded by Number, outside the impl
type Money(a) {
  amount: a,
}

trait Display for Money(a) where a: Number + Display {
  fn display(self) -> String {
    "{self.amount + self.amount}"
  }
}

fn main() {
  println(Money { amount: 2 })
}
