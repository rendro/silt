-- exit: 1
-- A method call on a receiver of unknown type means the one trait in
-- sight that declares the method: with a program trait that declares
-- `display` beside the builtin `Display`, the receiver needs an
-- annotation.
-- stderr-contains: error[type]: ambiguous method 'display' on type 'Int': provided by traits Describe, prelude.Display
trait Describe { fn display(self) -> String }
trait Describe for Int { fn display(self) -> String { "described {self}" } }
fn main() {
  let g = { y -> y.display() }
  println(g(5))
}
