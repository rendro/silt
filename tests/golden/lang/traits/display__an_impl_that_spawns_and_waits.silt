-- repeat: 20
-- stdout-contains: [answer 1, answer 2]
-- stdout-contains: in a task: Some(answer 3)
-- stdout-contains: late 1
-- stdout-contains: late 2
-- stdout-contains: late 3
-- A Display impl is code like any other under the scheduler too: one
-- that starts tasks and waits for what they send is parked while a
-- value is shown and goes on when the value comes, on the main thread
-- and in a task. A task the impl starts runs to its end (`late`), and
-- a helper that waits for a value nobody sends is stopped when the impl
-- is done with it.
import channel
import list
import option
import task

type Asked {
  n: Int,
}

trait Display for Asked {
  fn display(self) -> String {
    let ch = channel.new(0)
    let answer = channel.new(1)
    let n = self.n
    let never = channel.new(0)
    task.background([{ ->
      let _ = channel.receive(never)
    }]) { ->
      task.join([
        { -> channel.send(ch, "answer {n}") },
        { -> println("late {n}") },
        { -> channel.send(answer, channel.receive(ch) |> option.unwrap_or("nothing")) },
      ])
    }
    channel.receive(answer) |> option.unwrap_or("nothing")
  }
}

fn main() {
  println([Asked { n: 1 }, Asked { n: 2 }])
  let shown = task.map([0], 1) { _ -> "in a task: {Some(Asked { n: 3 })}" }
  list.each(shown) { text -> println(text) }
}
