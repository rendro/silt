-- A trait of the program with methods named like a builtin trait's,
-- implemented for Int: a call names its trait, so the program's
-- `Ranked.compare` and the builtin `Compare.compare` are told apart, and
-- the program's `Describe.display` does not change how Int is shown.
trait Describe { fn display(self) -> String }
trait Describe for Int { fn display(self) -> String { "described {self}" } }
trait Ranked { fn compare(self, other: Self) -> Int }
trait Ranked for Int { fn compare(self, other: Self) -> Int { 99 } }
fn described(x: t) -> String where t: Describe { Describe.display(x) }
fn main() {
  println(Describe.display(5))
  println(Ranked.compare(5, 6))
  println(Compare.compare(5, 6))
  println(described(5))
  println(5)
}
