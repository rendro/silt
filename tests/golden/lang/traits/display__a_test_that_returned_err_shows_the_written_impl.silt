import test
type Code {
  n: Int,
}

trait Display for Code {
  fn display(self) -> String {
    "code {100 / self.n}"
  }
}

fn test_gives_up() -> Result(Int, List(Code)) {
  Err([Code { n: 2 }, Code { n: 4 }])
}
