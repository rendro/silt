import json
import json.{ Encode }

type T { Encode(Int), Bar }

fn go(x: a) -> json.Value where a: Encode {
  Encode.encode(x)
}

fn go2(x: a) -> json.Value where a: Encode {
  x.encode()
}

fn go3(x: a) -> String where a: Encode {
  json.stringify(json.Encode.encode(x))
}

fn main() {
  println((go(1), go2(2), go3(3), Encode(4), Bar))
}
