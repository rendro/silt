-- The auto-derived traits of a type go by the builtin trait's method
-- of each field (`display` of Display, `compare` of Compare, ...),
-- whatever trait of the program has a method of that name for the
-- field's type.
import list
import map
import string
trait Describe { fn display(self) -> String }
trait Describe for Int { fn display(self) -> String { "described {self}" } }
trait Ranked { fn compare(self, other: Self) -> Int }
trait Ranked for Int { fn compare(self, other: Self) -> Int { 99 } }
trait Same { fn equal(self, other: Self) -> Bool }
trait Same for Int { fn equal(self, other: Self) -> Bool { false } }
trait Hashy { fn hash(self) -> Int }
trait Hashy for Int { fn hash(self) -> Int { 7 } }
type Pt { x: Int }
type Wrap { p: Pt }
fn by_bound(a: a, b: a) -> Int where a: Compare { Compare.compare(a, b) }
fn main() {
  println(string.from(Pt { x: 1 }))
  println(Pt { x: 1 } < Pt { x: 2 })
  println(by_bound(Pt { x: 1 }, Pt { x: 2 }))
  println(Compare.compare(Wrap { p: Pt { x: 1 } }, Wrap { p: Pt { x: 2 } }))
  println([Pt { x: 2 }, Pt { x: 1 }] |> list.sort)
  println(Pt { x: 1 } == Pt { x: 1 })
  println(Pt { x: 1 } == Pt { x: 1 })
  println(Hash.hash(Pt { x: 1 }) == Hash.hash(Pt { x: 2 }))
  println(map.get(#{ Pt { x: 1 }: "a" }, Pt { x: 1 }))
}
