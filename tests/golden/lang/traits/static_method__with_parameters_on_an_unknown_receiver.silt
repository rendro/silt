-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type mismatch: expected type _, got Int
-- stderr-contains: error[type]: type 'Int' has no field 'join'
-- stderr-contains: :38:15
-- stderr-contains: :39:15
-- The same for a receiver whose type is not known where the call is
-- written: of a method that makes a value it is a type, of one that
-- takes a value a record with the field (it used to check, and fail
-- when run: "function 'Int.make' expects 1 arguments, got 2").
trait Mk {
  fn make(n: Int) -> Self
  fn join(a: Self, b: Self) -> Self
  fn twice(self) -> Self
}

trait Mk for Int {
  fn make(n: Int) -> Int {
    n
  }
  fn join(a: Int, b: Int) -> Int {
    a + b
  }
  fn twice(self) -> Int {
    self * 2
  }
}

fn all(x) {
  x.make(1)
}

fn two(x, y) {
  x.join(y)
}

fn main() {
  println(all(5))
  println(two(1, 2))
}
