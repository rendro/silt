-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: 'all' takes a type as `x`, not a value of type `Int`: `x.make(..)` in it reads as the method of trait 'Mk' that makes a value
-- stderr-contains: error[type]: cannot infer the record type whose field 'join' this calls
-- stderr-contains: :38:15
-- stderr-contains: :34:3
-- The same for a receiver whose type is not known where the call is
-- written: of a method that makes a value it is a type; of one that
-- takes a value it would be a record with the field, which nothing
-- decides, so the receiver needs an annotation (it used to check, and
-- fail when run: "function 'Int.make' expects 1 arguments, got 2").
trait Mk {
  fn make(n: Int) -> Self
  fn join(a: Self, b: Self) -> Self
  fn twice(self) -> Self
}

trait Mk for Int {
  fn make(n: Int) -> Int {
    n
  }
  fn join(a: Int, b: Int) -> Int {
    a + b
  }
  fn twice(self) -> Int {
    self * 2
  }
}

fn all(x) {
  x.make(1)
}

fn two(x, y) {
  x.join(y)
}

fn main() {
  println(all(5))
  println(two(1, 2))
}
