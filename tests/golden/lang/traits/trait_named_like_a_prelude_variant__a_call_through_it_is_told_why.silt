-- `Some.go(1)` with a `trait Some`: in an expression `Some` is the
-- prelude's variant, and the help says to rename the trait (the
-- prelude's variant cannot be renamed) (audit R9, review N3).
-- stderr-contains: has no field 'go'
-- stderr-contains: help: `Some` here is the variant `Option.Some`, which hides the trait `Some` in expressions: rename the trait to call `Some.go`
trait Some {
  fn go(self) -> Int
}

trait Some for Int {
  fn go(self) -> Int { self }
}

fn main() {
  println(Some.go(1))
}
