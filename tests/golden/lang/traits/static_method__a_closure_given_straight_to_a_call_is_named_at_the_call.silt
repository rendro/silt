-- cmd: check
-- exit: 1
-- stderr-not-contains: expected type _
-- A closure given straight to a call, whose `r.zero()` reads its
-- parameter as a type, says so at the argument of the call that gives
-- it a value, as a closure a `let` names does.
trait Zero {
  fn zero() -> Self
}

trait Zero for Int {
  fn zero() -> Self {
    0
  }
}

type Rec {
  n: Int,
  zero: Fn() -> Int,
}

fn apply(f, x) {
  f(x)
}

fn main() {
  let rec = Rec { n: 1, zero: { -> 5 } }
  println(apply({ r -> r.zero() }, rec))
  println(apply({ r -> r.zero() }, 7))
  println(apply({ r -> r.zero() }, Int))
}
