-- exit: 1
-- A tuple type before a dot is refused as any type is where its impl is
-- missing: of a part (`String` has no `Monoid`), or of the tuple type
-- itself. `Tuple(Int, Int)` is no spelling of it before a dot. The help
-- of a value of types calls it on the tuple type, `(Int, Int).empty()`;
-- its message names no type, as `(Int, Int)` there is one, nor does it
-- for a type held deeper, `(1, [Int])`. A tuple of values is named by
-- its type.
trait Monoid {
  fn empty() -> Self
}

trait Monoid for Int {
  fn empty() -> Self { 0 }
}

trait Monoid for Tuple(a, b) where a: Monoid, b: Monoid {
  fn empty() -> Self { (a.empty(), b.empty()) }
}

trait Zero {
  fn zero() -> Self
}

fn main() {
  println((Int, String).empty())
  println(Tuple(Int, Int).empty())
  println((Int, String).zero())
  let t = (Int, Int)
  println(t.empty())
  println((Int, 1).empty())
  println((1, 2).zap)
  println((1, [Int]).zap)
}
