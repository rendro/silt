-- cmd: check
-- exit: 1
-- A variant `Error` hides the prelude trait `Error` in an expression (a
-- declaration of the module comes before the prelude's): `Error.message`
-- is a field of the variant, and the help says which `Error` it is. A
-- bound and an impl still name the trait.
type Level {
  Info,
  Error,
}

fn show(e: x) -> String where x: Error {
  Error.message(e)
}

type Mine {
  Mine(String),
}

trait Error for Mine {
  fn message(self) -> String {
    "mine"
  }
}

fn main() {
  println(Level.Info)
  println(show(Mine("a")))
}
