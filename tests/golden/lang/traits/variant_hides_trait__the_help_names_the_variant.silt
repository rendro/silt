-- cmd: check
-- exit: 1
-- A variant `Equal` hides the trait `Equal` in an expression (a
-- declaration of the module comes before the prelude's), but no program
-- calls `Equal.equal`: its help is to compare with `==`, not to rename
-- the variant.
type Kind {
  Equal,
  Other,
}

fn same() -> Bool {
  Equal.equal(1, 1)
}

fn main() {
  println(Kind.Other)
  println(same())
}
