import mail

fn name_of(r: { name: String, ...rest }) -> String {
  r.name
}

fn main() {
  let e = mail.Email("a@x")
  let u = mail.User { name: "a", age: 1 }
  let v = mail.user("b")
  match mail.parse("a@x") {
    Some(mail.Email(s)) -> println(s)
    _ -> ()
  }
  let mail.User { name, .. } = v
  let w = v.{ age: 2 }
  println(v.name)
  println({ ...v })
  println(name_of(v))
}
