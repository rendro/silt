-- cmd: check
-- exit: 1
-- A function that hands its type to the opaque type's own module and on
-- another route to a decoder of its own or of a third module refuses it
-- for that route: the note names that one, not the module's.
import helper
import json
import mail

fn own(s: String, type a) -> (Result(a, json.JsonError), Result(a, json.JsonError))
  where
    a: json.Decode {
  (mail.load(s, a), json.parse(s, a))
}

fn third(s: String, type a) -> (Result(a, json.JsonError), Result(a, json.JsonError))
  where
    a: json.Decode {
  (mail.load(s, a), helper.read(s, a))
}

fn main() {
  println(own("\{\"addr\": \"x\"}", mail.Email))
  println(third("\{\"addr\": \"x\"}", mail.Email))
}
