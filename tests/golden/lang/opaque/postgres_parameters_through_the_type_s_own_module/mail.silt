import postgres

pub opaque type User {
  name: String,
  age: Int,
}

pub fn user(name: String) -> User {
  User { name: name, age: 1 }
}

pub fn send(db: postgres.PgPool, x: a) -> Result(Int, postgres.PostgresError) {
  postgres.execute(db, "select $1", (x,))
}

pub fn send_all(db: postgres.PgPool, p: p) -> Result(Int, postgres.PostgresError) {
  postgres.execute(db, "select $1", p)
}
