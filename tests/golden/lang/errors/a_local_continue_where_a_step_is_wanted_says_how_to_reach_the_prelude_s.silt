-- exit: 1
-- A variant `Continue` of the program's `Plan` hides the prelude's `Continue`:
-- as an arm of a `match` that is to give a `Step(Int)`, it is a
-- `Plan`, and the mismatch is at that arm alone: it marks the `Continue` and
-- names `Step.Continue`, which reaches the prelude's.
type Plan { Continue(Int), Halt }

fn pick(n: Int) -> Step(Int) {
  match n {
    0 -> Continue(n)
    _ -> Stop(n)
  }
}

fn main() {
  println(pick(1))
}
