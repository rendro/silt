-- exit: 1
-- A trait's method taken as a value where the impl is found when it
-- runs is a frame under the method's name, as a written method is: the
-- program wrote no closure there.
import list

type Inner {
  n: Int,
}

trait Div {
  fn div(self) -> Int
}

trait Div for Inner {
  fn div(self) -> Int {
    1 / (self.n - self.n)
  }
}

fn all(xs: List(a)) -> List(Int) where a: Div {
  list.map(xs, Div.div)
}

fn main() {
  println(all([Inner { n: 1 }]))
}
