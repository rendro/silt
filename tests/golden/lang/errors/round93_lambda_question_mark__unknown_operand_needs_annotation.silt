-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: cannot infer the type `?` is applied to: a Result or an Option
-- stderr-contains: help: annotate the value
-- `?` on a value nothing decides is not general: it needs to know
-- whether it unwraps a Result or an Option.
fn unwrap_plus(r) -> Result(Int, String) {
  let v = r?
  Ok(v + 1)
}

fn main() {
  println(unwrap_plus(Ok(1)))
}
