-- exit: 1
-- stderr-contains: error[runtime]: division by zero
-- stderr-contains: -> MyErr.display  at call_stack__a_builtin_default_method_is_at_no_place.silt:14:13
-- stderr-contains: -> Error.message  (builtin)
-- stderr-not-contains: unknown location
-- The default `message` of the builtin trait Error is silt's own code:
-- its frame in a call stack is at no place in the program, and says so.
type MyErr {
  code: Int,
}

trait Display for MyErr {
  fn display(self) -> String {
    let n = 1 / self.code
    "E{n}"
  }
}

trait Error for MyErr {}

fn main() {
  println(MyErr { code: 0 }.message())
}
