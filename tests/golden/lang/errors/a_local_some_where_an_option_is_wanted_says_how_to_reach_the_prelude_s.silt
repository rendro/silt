-- exit: 1
-- A variant `Some` of the program's `Guess` hides the prelude's `Some`:
-- as an arm of a `match` that is to give an `Option(Int)`, it is a
-- `Guess`, and the mismatch is at that arm alone: it marks the `Some` and
-- names `Option.Some`, which reaches the prelude's.
type Guess { Some(Int), Nothing }

fn pick(n: Int) -> Option(Int) {
  match n {
    0 -> Some(n)
    _ -> None
  }
}

fn main() {
  println(pick(1))
}
