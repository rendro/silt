-- exit: 1
-- A variant `Some` of the program's `Guess` hides the prelude's `Some`:
-- as an arm of a `match` that is to give an `Option(Int)`, it makes the
-- `match` a `Guess`. The mismatch, and the one at the other arm, mark the
-- `Some` and name `Option.Some`, which reaches the prelude's.
type Guess { Some(Int), Nothing }

fn pick(n: Int) -> Option(Int) {
  match n {
    0 -> Some(n)
    _ -> None
  }
}

fn main() {
  println(pick(1))
}
