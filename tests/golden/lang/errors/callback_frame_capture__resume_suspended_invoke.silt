-- exit: 1
-- repeat: 5
import channel
import task

fn consumer(c, blocker) {
  channel.each(c, { x ->
    let v = channel.receive(blocker)
    println(1 / 0)
  })
}

fn producer(blocker) {
  channel.send(blocker, 99)
}

fn main() {
  let c = channel.new(1)
  let blocker = channel.new(0)
  channel.send(c, 1)
  channel.close(c)
  task.join([{ -> consumer(c, blocker) }, { -> producer(blocker) }])
}
