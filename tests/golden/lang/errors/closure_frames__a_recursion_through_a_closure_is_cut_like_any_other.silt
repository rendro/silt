-- exit: 1
-- A long stack is cut to its first ten and its last five frames; a
-- recursion through a closure has two frames a round.
fn count(n) {
  let step = { m -> again(m - 1) + 1 }
  match n {
    0 -> 1 / n
    _ -> step(n) + 1
  }
}

fn main() {
  println(count(20))
}

-- (`step` reaches `count` through a value, which the recursion check
-- does not follow: the stack is what this case is about.)
let again = count
