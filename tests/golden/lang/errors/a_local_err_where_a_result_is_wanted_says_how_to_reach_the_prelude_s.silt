-- exit: 1
-- A variant `Err` of the program's `Fault` hides the prelude's `Err`:
-- as an arm of a `match` that is to give a `Result(Int, String)`, it is a
-- `Fault`, and the mismatch is at that arm alone: it marks the `Err` and
-- names `Result.Err`, which reaches the prelude's.
type Fault { Err(String), Fine }

fn pick(n: Int) -> Result(Int, String) {
  match n {
    0 -> Err("zero")
    _ -> Ok(n)
  }
}

fn main() {
  println(pick(1))
}
