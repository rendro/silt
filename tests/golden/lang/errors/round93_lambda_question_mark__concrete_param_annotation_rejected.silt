-- cmd: check
-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: note: the ?-ed expression is Result(Int, String), but the enclosing function returns Int
-- A lambda with a concretely typed Result parameter: `?` is checked
-- against the lambda's own body (Int), not main's: the lambda returns
-- neither a Result nor an Option.
fn main() {
  let f = { x: Result(Int, String) -> x? + 1 }
  println(f(Ok(1)))
}
