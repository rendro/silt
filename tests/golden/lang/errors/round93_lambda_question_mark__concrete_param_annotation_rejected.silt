-- cmd: check
-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: the ? on line 8 requires this function to return Result(_, String)
-- A lambda with a concretely typed Result parameter: `?` is checked
-- against the lambda's own return type (Int), not main's.
fn main() {
  let f = fn(x: Result(Int, String)) { x? + 1 }
  println(f(Ok(1)))
}
