-- exit: 1
-- A variant `None` of the program's `Slot` hides the prelude's `None`:
-- as an arm of a `match` that is to give an `Option(Int)`, it is a
-- `Slot`, and the mismatch is at that arm alone: it marks the `None` and
-- names `Option.None`, which reaches the prelude's.
type Slot { Full(Int), None }

fn pick(n: Int) -> Option(Int) {
  match n {
    0 -> None
    _ -> Some(n)
  }
}

fn main() {
  println(pick(1))
}
