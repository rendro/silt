-- exit: 1
-- A variant `None` of the program's `Slot` hides the prelude's `None`:
-- as an arm of a `match` that is to give an `Option(Int)`, it makes the
-- `match` a `Slot`. The mismatch, and the one at the other arm, mark the
-- `None` and name `Option.None`, which reaches the prelude's.
type Slot { Full(Int), None }

fn pick(n: Int) -> Option(Int) {
  match n {
    0 -> None
    _ -> Some(n)
  }
}

fn main() {
  println(pick(1))
}
