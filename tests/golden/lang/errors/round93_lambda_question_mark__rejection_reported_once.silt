-- cmd: check
-- exit: 1
-- The `?` of a lambda whose body is no Result is reported once, at the
-- body; the list of Results the map then gives does not fit the annotation.
import list
fn main() {
  let xs = [Ok(1), Err("bad"), Ok(3)]
  let ys: List(Int) = xs |> list.map({ x -> x? + 1 })
  println(ys)
}
