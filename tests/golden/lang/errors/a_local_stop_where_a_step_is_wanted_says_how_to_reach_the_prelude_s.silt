-- exit: 1
-- A variant `Stop` of the program's `Light` hides the prelude's `Stop`:
-- as an arm of a `match` that is to give a `Step(Int)`, it is a
-- `Light`, and the mismatch is at that arm alone: it marks the `Stop` and
-- names `Step.Stop`, which reaches the prelude's.
type Light { Go, Stop }

fn pick(n: Int) -> Step(Int) {
  match n {
    0 -> Stop
    _ -> Continue(n)
  }
}

fn main() {
  println(pick(1))
}
