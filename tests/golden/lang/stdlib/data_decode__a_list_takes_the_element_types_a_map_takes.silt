-- A list decoded by json.parse, and toml.parse_list, take the element
-- types that a map's values take: Int, Float, String, Bool, a record
-- type, and for json json.Value; written at the call or arriving through
-- a `type a` parameter. toml.parse_list reads the array under the one
-- top-level key.
import json
import toml

type Point {
  x: Int,
  y: Int,
}

fn json_list(text: String, type a) -> Result(List(a), json.JsonError) where a: json.Decode {
  json.parse(text, List(a))
}

fn toml_list(text: String, type a) -> Result(List(a), toml.TomlError) where a: json.Decode {
  toml.parse_list(text, a)
}

fn main() {
  println(json.parse("[1, 2, 3]", List(Int)))
  println(json.parse("[1, 2.5]", List(Float)))
  println(json.parse("""["a", "b"]""", List(String)))
  println(json.parse("[true, false]", List(Bool)))
  println(json.parse("""[1, "a", null]""", List(json.Value)))
  println(json.parse("""[{"x": 1, "y": 2}]""", List(Point)))
  println(json.parse("""[1, "b"]""", List(Int)))
  println(json.parse("""{"a": 1}""", List(Int)))
  println(json_list("[4, 5]", Int))
  println(json_list("""[{"x": 3, "y": 4}]""", Point))

  println(toml.parse_list("xs = [1, 2, 3]", Int))
  println(toml.parse_list("xs = [1.5, 2]", Float))
  println(toml.parse_list("names = [\"a\", \"b\"]", String))
  println(toml.parse_list("flags = [true, false]", Bool))
  println(toml.parse_list("[[points]]\nx = 1\ny = 2\n", Point))
  println(toml.parse_list("xs = [1, \"b\"]", Int))
  println(toml.parse_list("xs = 1", Int))
  println(toml.parse_list("xs = [1]\nys = [2]", Int))
  println(toml.parse_list("", Int))
  println(toml_list("xs = [4, 5]", Int))
  println(toml_list("[[points]]\nx = 3\ny = 4\n", Point))
}
