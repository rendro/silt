-- cmd: check
-- exit: 1
-- A type toml.parse_map does not take (json.Value), given through a
-- `type a` parameter, is refused at the call that gives it, as it is
-- where the call of toml.parse_map names it.
import json
import toml

fn decode_map(text: String, type a) -> Result(Map(String, a), toml.TomlError) where a: json.Decode {
  toml.parse_map(text, a)
}

fn main() {
  println(decode_map("a = 1", json.Value))
}
