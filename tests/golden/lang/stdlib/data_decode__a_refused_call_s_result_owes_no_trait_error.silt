-- cmd: check
-- exit: 1
-- A use of a decoder that refuses its type is the one error: what the
-- use returns owes no `Display`, `Equal` or `json.Encode` error of its
-- own, whichever decoder refuses (`json.parse`, `toml.parse`, a
-- type's `decode`, a function bounded by `json.Decode`), also where
-- what it returns is a part of the type that lacks the trait. A part
-- beside it that lacks the trait, and the same type shown elsewhere,
-- are still refused.
import json
import toml

type T(a) { n: Option(T(List(a))), x: a }
type R { f: Fn(Int) -> Int }
type S { f: Fn(Int) -> Int }
trait Display for S {
  fn display(self) -> String { "S" }
}
type U(a) { x: a, g: Fn(Int) -> Int }

fn load(type a) -> Result(a, json.JsonError) where a: json.Decode {
  json.parse("x", a)
}

fn main() {
  println(json.parse("x", T(Int)))
  println(toml.parse("x", R))
  println(R.decode(json.Null))
  println(load(R))
  println(json.parse("x", R) == json.parse("y", R))
  println(json.stringify(json.parse("x", R)))
  println((json.parse("x", U(R)), 1))
  println(R { f: { x -> x } })
  println((json.parse("x", S), { x -> x + 1 }))
  println((json.parse("x", (Int, S)), { x -> x + 1 }))
  println({
    let _ = json.parse("x", List(S))
    [{ x -> x + 1 }]
  })
  println({
    let _ = json.parse("x", R)
    R { f: { x -> x + 1 } }
  })
}
