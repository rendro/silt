-- exit: 1
-- stdout-contains: before: Some(1)
-- stderr-contains: error[runtime]
-- stderr-contains: env.set cannot change the environment while other tasks or I/O are running: set it before spawning tasks
-- stderr-not-contains: not reached
-- A task that waits is live: it could read the environment while
-- env.set changes it, so the change is refused.
import channel
import env
import task

fn main() {
  env.set("SILT_ENV_CHANGE_A", "1")
  println("before: {env.get("SILT_ENV_CHANGE_A")}")
  let never = channel.new(0)
  let _waiter = task.spawn { -> channel.receive(never) }
  env.set("SILT_ENV_CHANGE_A", "2")
  println("not reached")
}
