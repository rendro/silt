-- A type parse_map does not take (an enum, for toml), arriving through a
-- `type a` parameter, is a run-time error, as it is for toml.parse and
-- toml.parse_list; written at the call it is a compile error.
import toml

type Color {
  Red,
  Green,
}

fn decode_map(text: String, type a) -> Result(Map(String, a), toml.TomlError) {
  toml.parse_map(text, a)
}

fn main() {
  println(decode_map("a = \"Red\"", Color))
}
