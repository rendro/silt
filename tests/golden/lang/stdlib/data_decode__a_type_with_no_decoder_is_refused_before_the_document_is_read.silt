-- cmd: check
-- exit: 1
-- Every decoder refuses a type with a field no decoder exists for
-- before any document is read: a text that is no JSON or TOML does not
-- hide it, in json.parse (of the type, a list of it) as in toml.parse.
-- (Through a `type a` parameter: the checker asks of each type a call
-- gives it what the decoder the function gives it to asks.)
import json
import toml

type Blob { name: String, b: Bytes }

fn from_json(text: String, type a) -> Result(a, json.JsonError) where a: json.Decode {
  json.parse(text, a)
}

fn list_of(text: String, type a) -> Result(List(a), json.JsonError) where a: json.Decode {
  json.parse(text, List(a))
}

fn from_toml(text: String, type a) -> Result(a, toml.TomlError) where a: json.Decode {
  toml.parse(text, a)
}

fn show(r: Result(a, e)) where e: Error {
  match r {
    Ok(_) -> println("ok")
    Err(e) -> println(Error.message(e))
  }
}

fn main() {
  show(from_json("not json", Blob))
  show(list_of("[1, 2", Blob))
  show(from_toml("= =", Blob))
}
