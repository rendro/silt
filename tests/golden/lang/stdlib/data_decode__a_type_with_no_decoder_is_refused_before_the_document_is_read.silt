-- Every decoder takes its type argument, and refuses a type with a
-- field no decoder exists for, before it reads the document: a text
-- that is no JSON or TOML gives the refusal too, in json.parse as in
-- json.parse_list and toml.parse. (The type arrives at run time: written
-- at the call, the compiler refuses it.)
import json
import toml

type Blob { name: String, b: Bytes }

fn from_json(text: String, type a) -> Result(a, json.JsonError) {
  json.parse(text, a)
}

fn list_of(text: String, type a) -> Result(List(a), json.JsonError) {
  json.parse_list(text, a)
}

fn from_toml(text: String, type a) -> Result(a, toml.TomlError) {
  toml.parse(text, a)
}

fn show(r: Result(a, e)) where e: Error {
  match r {
    Ok(_) -> println("ok")
    Err(e) -> println(e.message())
  }
}

fn main() {
  show(from_json("not json", Blob))
  show(list_of("[1, 2", Blob))
  show(from_toml("= =", Blob))
}
