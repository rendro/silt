import float
import list
-- Finite results stay Float (not ExtFloat); float.to_string accepts only
-- a Float and prints the decimal.
fn main() {
  let s: Float = list.sum_float([1.0, 2.0, 3.0])
  let p: Float = list.product_float([2.0, 3.0, 4.0])
  println(float.to_string(s, 1))
  println(float.to_string(p, 1))
}
