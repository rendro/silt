import http
fn describe(e: http.HttpError) -> String {
  match e {
    http.HttpConnect(m) -> "connect"
    http.HttpTls(m) -> "tls"
    http.HttpTimeout -> "timeout"
    http.HttpInvalidUrl(u) -> "url"
    http.HttpInvalidResponse(m) -> "bad resp"
    http.HttpClosedEarly -> "closed"
    http.HttpStatusCode(s, b) -> "status"
    http.HttpUnknown(m) -> "unknown"
  }
}
fn main() { println(describe(http.HttpTimeout)) }
