import http
fn describe(e: http.HttpError) -> String {
  match e {
    http.Connect(m) -> "connect"
    http.Tls(m) -> "tls"
    http.Timeout -> "timeout"
    http.InvalidUrl(u) -> "url"
    http.InvalidResponse(m) -> "bad resp"
    http.ClosedEarly -> "closed"
    http.StatusCode(s, b) -> "status"
    http.Other(m) -> "unknown"
  }
}
fn main() { println(describe(http.Timeout)) }
