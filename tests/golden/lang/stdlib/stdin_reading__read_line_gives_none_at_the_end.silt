-- stdin: first\n  second  \n
-- io.read_line gives each line, then Ok(None) at the end of stdin, and
-- Ok(None) again on every read after it.
import io

fn main() {
  let read = { count ->
    match io.read_line() {
      Ok(Some(line)) -> {
        println("[{line}]")
        read(count + 1)
      }
      Ok(None) -> return println("end after {count} lines")
      Err(e) -> return println("error: {e}")
    }
  }
  read(0)
  println(io.read_line())
}
