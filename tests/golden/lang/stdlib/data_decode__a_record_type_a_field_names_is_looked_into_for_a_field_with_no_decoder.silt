-- cmd: check
-- exit: 1
-- A field whose type names a record type with a field no decoder exists
-- for (Bytes, in json and toml) is refused, whatever the document holds
-- there: the refusal names the field of the nested record type.
-- (Through a `type a` parameter: the checker asks of each type a call
-- gives it what the decoder the function gives it to asks.)
import json
import toml

type Blob { b: Bytes }
type One { name: String, blob: Blob }
type Maybe { name: String, blob: Option(Blob) }
type Many { name: String, blobs: List(Blob) }

fn from_json(text: String, type a) -> Result(a, json.JsonError) {
  json.parse(text, a)
}

fn from_toml(text: String, type a) -> Result(a, toml.TomlError) {
  toml.parse(text, a)
}

fn show(r: Result(a, e)) where e: Error {
  match r {
    Ok(_) -> println("ok")
    Err(e) -> println(e.message())
  }
}

fn main() {
  show(from_json("""{"name": "x"}""", One))
  show(from_json("""{"name": "x"}""", Maybe))
  show(from_json("""{"name": "x", "blobs": []}""", Many))
  show(from_json("""{"name": "x", "blob": {"b": []}}""", One))
  show(from_toml("name = \"x\"", One))
  show(from_toml("name = \"x\"", Maybe))
  show(from_toml("name = \"x\"\nblobs = []", Many))
}
