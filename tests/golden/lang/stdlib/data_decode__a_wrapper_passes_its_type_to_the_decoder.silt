-- cmd: check
-- exit: 1
-- A function whose parameter's type reaches a decoder asks of the type
-- what the decoder asks, through any number of functions: each call
-- that gives it a type is checked, and the note names the function.
import json
import toml

type Blob { data: Set(Int) }
type Fine { n: Int }

fn load(text, t) {
  json.parse(text, t)
}

fn load_twice(text, t) {
  (load(text, t), toml.parse(text, t))
}

fn main() {
  let _ = load("\{\"n\": 1}", Fine)
  let _ = load("\{}", Blob)
  let _ = load_twice("n = 1", Fine)
  let _ = load_twice("", json.Value)
}
