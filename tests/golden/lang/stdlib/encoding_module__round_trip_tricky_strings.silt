import encoding
import list
fn main() {
  let cases = [
    "hello world",
    "a & b = c ? d # e",
    "café ☕ 🚀",
    "quotes: \" and `backtick`",
    "",
    "just.a-simple_url.com/path",
  ]
  list.each(cases, { s ->
    match encoding.url_decode(encoding.url_encode(s)) {
      Ok(back) -> println("[{back}]")
      Err(e) -> println("error: {e}")
    }
  })
}
