import float
import math
fn num(s: String) -> Float {
  match float.parse(s) {
    Ok(f) -> f
    Err(_) -> 1.0
  }
}
fn main() {
  let a = num("-0.0")
  println("parse {a} {float.format(a, 1)}")
  let b = num("-1e-400")
  println("underflow {b} {float.format(b, 1)}")
  let c = math.atan2(num("-1e-300"), num("1e300"))
  println("atan2 {c} {float.format(c, 1)}")
}
