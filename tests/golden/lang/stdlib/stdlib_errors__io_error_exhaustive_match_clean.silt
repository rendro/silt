import io
fn describe(e: io.IoError) -> String {
  match e {
    io.IoNotFound(p) -> "not found"
    io.IoPermissionDenied(p) -> "denied"
    io.IoAlreadyExists(p) -> "exists"
    io.IoInvalidInput(p) -> "invalid"
    io.IoInterrupted -> "interrupted"
    io.IoUnexpectedEof -> "eof"
    io.IoWriteZero -> "write zero"
    io.IoUnknown(m) -> "unknown"
  }
}
fn main() { println(describe(io.IoNotFound("x"))) }
