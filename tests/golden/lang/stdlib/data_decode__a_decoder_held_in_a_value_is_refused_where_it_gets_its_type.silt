-- cmd: check
-- exit: 1
-- A decoder held in a local, a list, an Option or a record field, or
-- returned by a function, is refused at the type argument of the call
-- that gives it its type, with no note: no function passes the type on.
-- A function that does pass it on (it gives a decoder and a type it is
-- given to each other) is named in a note.
import json

type Blob { data: Bytes }
type D(f) { f: f }

fn dec() {
  json.parse
}

fn mk() {
  D { f: json.parse }
}

fn use_it(d, t) {
  let g = d.f
  g("\{}", t)
}

fn apply(f, s, t) {
  f(s, t)
}

fn main() {
  let p = json.parse
  let _ = p("\{}", Blob)
  let ps = [json.parse, json.parse]
  match ps {
    [q, ..rest] -> println(q("\{}", Blob))
    _ -> ()
  }
  let o = Some(json.parse)
  match o {
    Some(q) -> println(q("\{}", Blob))
    None -> ()
  }
  let d = D { f: json.parse }
  let g = d.f
  let _ = g("\{}", Blob)
  let r = dec()
  let _ = r("\{}", Blob)
  let _ = use_it(mk(), Blob)
  let _ = apply(json.parse, "\{}", Blob)
}
