-- A task that has ended and an I/O operation that has returned leave
-- the program alone again: the environment can be changed.
import env
import io
import result
import task

fn main() {
  let worker = task.spawn { -> 1 + 1 }
  println(task.join(worker))
  println(io.read_file("no such file here") |> result.is_ok)
  env.set("SILT_ENV_CHANGE_C", "set")
  println(env.get("SILT_ENV_CHANGE_C"))
  env.remove("SILT_ENV_CHANGE_C")
  println(env.get("SILT_ENV_CHANGE_C"))
}
