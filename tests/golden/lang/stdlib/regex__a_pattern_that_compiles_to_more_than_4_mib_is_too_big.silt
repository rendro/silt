import regex

-- A pattern compiles to at most 4 MiB. `\w{100}` (a hundred Unicode
-- word characters) compiles to about 5.6 MB, and a length check of 8 to
-- 4096 characters of any kind is larger still: both are refused, where
-- the regex crate's own limit of 10 MiB let them compile. A pattern for
-- a name of 3 to 32 word characters is about 1.8 MB, and compiles.
fn main() {
  match regex.is_match("x", """\w{100}""") {
    Err(regex.TooBig) -> println("TooBig")
    other -> println(other)
  }
  match regex.is_match("password1", """^.{8,4096}$""") {
    Err(regex.TooBig) -> println("TooBig")
    other -> println(other)
  }
  println(regex.is_match("silt_lang", """^\w{3,32}$"""))
}
