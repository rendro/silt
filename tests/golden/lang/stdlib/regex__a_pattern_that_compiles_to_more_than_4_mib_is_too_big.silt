import regex

-- A pattern compiles to at most 4 MiB. `\w{100}` (a hundred Unicode
-- word characters) compiles to about 5.6 MB: it is refused, where the
-- regex crate's own limit of 10 MiB let it compile. A pattern a program
-- writes for a name of 3 to 32 word characters is about 1.8 MB, and
-- compiles.
fn main() {
  match regex.is_match("x", """\w{100}""") {
    Err(regex.TooBig) -> println("TooBig")
    other -> println(other)
  }
  println(regex.is_match("silt_lang", """^\w{3,32}$"""))
}
