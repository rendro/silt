-- A pattern that matches nothing at the start or the end of the text
-- gives no empty piece there, as `string.split` with an empty
-- separator; empty text that such a match cuts is no piece. A match of
-- something at either end does give one.
import io
import regex
import string

fn main() -> Result((), regex.RegexError) {
  let nothing = regex.compile("")?
  let xs = regex.compile("x*")?
  let comma = regex.compile(",")?
  let boundary = regex.compile("\\b")?
  println(io.inspect(regex.split("abc", nothing)))
  println(io.inspect(string.split("abc", "")))
  println(io.inspect(regex.split("", nothing)))
  println(io.inspect(string.split("", "")))
  println(io.inspect(regex.split("axb", xs)))
  println(io.inspect(regex.split("", xs)))
  println(io.inspect(regex.split("", comma)))
  println(io.inspect(regex.split(",a,", comma)))
  println(io.inspect(string.split(",a,", ",")))
  println(io.inspect(regex.split("a b", boundary)))
  Ok(())
}
