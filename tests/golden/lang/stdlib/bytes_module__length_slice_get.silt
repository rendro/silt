import bytes
fn main() {
  let a = bytes.length(bytes.empty())
  let b = bytes.length(bytes.from_string("hello"))
  println([a, b])
  match bytes.to_string(bytes.slice(bytes.from_string("hello world"), 6, 11)) {
    Ok(t) -> println(t)
    Err(e) -> println(Error.message(e))
  }
  println(bytes.length(bytes.slice(bytes.from_string("hello"), 2, 2)))
  -- a start past the end gives nothing; an end past the length is the length
  println(bytes.length(bytes.slice(bytes.from_string("hello"), 4, 2)))
  println(bytes.to_string(bytes.slice(bytes.from_string("hello"), 0, 99)))
  println(bytes.length(bytes.slice(bytes.from_string("hello"), 7, 99)))
  -- 'e'
  println(bytes.get(bytes.from_string("hello"), 1))
  println(bytes.get(bytes.from_string("hi"), 5))
  println(bytes.get(bytes.from_string("hi"), -1))
}
