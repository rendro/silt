-- cmd: check
-- exit: 1
-- A field whose type holds json.Value has no decoder in toml, so toml
-- refuses it whatever the document would hold there: its key left out
-- (an Option too), an empty array, and in a record type the field
-- names. json decodes the same records.
-- (Through a `type a` parameter: the checker asks of each type a call
-- gives it what the decoder the function gives it to asks.)
import json
import toml

type Doc { n: Int, j: json.Value }
type Maybe { n: Int, j: Option(json.Value) }
type Many { n: Int, js: List(json.Value) }
type Inner { j: json.Value }
type Outer { n: Int, inner: Option(Inner) }

fn from_json(text: String, type a) -> Result(a, json.JsonError) {
  json.parse(text, a)
}

fn from_toml(text: String, type a) -> Result(a, toml.TomlError) {
  toml.parse(text, a)
}

fn show(r: Result(a, e)) where e: Error {
  match r {
    Ok(_) -> println("ok")
    Err(e) -> println(e.message())
  }
}

fn main() {
  show(from_toml("n = 1", Doc))
  show(from_toml("n = 1", Maybe))
  show(from_toml("n = 1\njs = []", Many))
  show(from_toml("n = 1", Outer))
  show(from_json("""{"n": 1}""", Maybe))
  show(from_json("""{"n": 1, "js": []}""", Many))
  show(from_json("""{"n": 1}""", Outer))
}
