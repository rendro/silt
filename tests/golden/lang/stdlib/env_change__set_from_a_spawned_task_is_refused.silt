-- exit: 1
-- stderr-contains: error[runtime]
-- stderr-contains: 
-- stderr-not-contains: not reached
-- A task can never change the environment: its start was the
-- program's first.
import env
import task

fn main() {
  task.join([{ -> env.set("SILT_ENV_CHANGE_D", "1") }])
  println("not reached")
}
