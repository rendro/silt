-- exit: 1
-- stderr-contains: error[runtime]
-- stderr-contains: env.set cannot change the environment while other tasks or I/O are running: set it before spawning tasks
-- stderr-not-contains: not reached
-- A spawned task is never alone: the program's own thread is live.
import env
import task

fn main() {
  let changer = task.spawn { -> env.set("SILT_ENV_CHANGE_D", "1") }
  task.join(changer)
  println("not reached")
}
