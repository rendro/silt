import bytes
fn main() {
  let original = bytes.from_string("hello world")
  let encoded = bytes.to_base64(original)
  match bytes.from_base64(encoded) {
    Ok(decoded) -> println(bytes.eq(original, decoded))
    Err(_) -> println(false)
  }
  println(bytes.to_base64(bytes.from_string("hello")))
  match bytes.from_base64("!!!not base64!!!") {
    Ok(_) -> println("wrong: should error")
    Err(e) -> println(e.message())
  }
}
