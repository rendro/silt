-- cmd: check
-- exit: 1
-- stderr-contains: non-exhaustive
-- stderr-contains: Other
import io
fn describe(e: io.IoError) -> String {
  match e {
    io.NotFound(p) -> "not found"
    io.PermissionDenied(p) -> "denied"
    io.AlreadyExists(p) -> "exists"
    io.InvalidInput(p) -> "invalid"
    io.Interrupted -> "interrupted"
    io.UnexpectedEof -> "eof"
    io.WriteZero -> "write zero"
  }
}
fn main() { println(describe(io.NotFound("x"))) }
