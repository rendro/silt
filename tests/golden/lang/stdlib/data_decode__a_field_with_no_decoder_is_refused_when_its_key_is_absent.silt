-- cmd: check
-- exit: 1
-- A field whose type no decoder exists for (one that holds Bytes, a Set)
-- is refused whatever the document would hold there: its key left out
-- too, where its type is an Option.
-- (Through a `type a` parameter: the checker asks of each type a call
-- gives it what the decoder the function gives it to asks.)
import json
import toml

type B { n: Int, b: Option(List(Bytes)) }
type S { n: Int, s: Option(Set(Int)) }

fn from_json(text: String, type a) -> Result(a, json.JsonError) where a: json.Decode {
  json.parse(text, a)
}

fn from_toml(text: String, type a) -> Result(a, toml.TomlError) {
  toml.parse(text, a)
}

fn show(r: Result(a, e)) where e: Error {
  match r {
    Ok(_) -> println("ok")
    Err(e) -> println(e.message())
  }
}

fn main() {
  show(from_json("""{"n": 1}""", B))
  show(from_toml("n = 1", B))
  show(from_json("""{"n": 1, "b": []}""", B))
  show(from_toml("n = 1\nb = []", B))
  show(from_json("""{"n": 1}""", S))
  show(from_toml("n = 1", S))
  show(from_json("""{"n": 1, "s": null}""", S))
}
