-- A field whose type no decoder exists for (one that holds Bytes, a Set)
-- is refused whatever the document holds there: its key left out too,
-- where its type is an Option. (The type arrives at run time: written
-- at the call, the compiler refuses it.)
import json
import toml

type B { n: Int, b: Option(List(Bytes)) }
type S { n: Int, s: Option(Set(Int)) }

fn from_json(text: String, type a) -> Result(a, json.JsonError) {
  json.parse(text, a)
}

fn from_toml(text: String, type a) -> Result(a, toml.TomlError) {
  toml.parse(text, a)
}

fn show(r: Result(a, e)) where e: Error {
  match r {
    Ok(_) -> println("ok")
    Err(e) -> println(e.message())
  }
}

fn main() {
  show(from_json("""{"n": 1}""", B))
  show(from_toml("n = 1", B))
  show(from_json("""{"n": 1, "b": []}""", B))
  show(from_toml("n = 1\nb = []", B))
  show(from_json("""{"n": 1}""", S))
  show(from_toml("n = 1", S))
  show(from_json("""{"n": 1, "s": null}""", S))
}
