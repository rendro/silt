import json

pub trait Loader {
  fn load(self, type a) -> Result(a, json.JsonError) where a: json.Decode
  fn load_again(self, type a) -> Result(a, json.JsonError) where a: json.Decode {
    self.load(a)
  }
}

pub type Src { s: String }

trait Loader for Src {
  fn load(self, type a) -> Result(a, json.JsonError) {
    json.parse(self.s, a)
  }
}
