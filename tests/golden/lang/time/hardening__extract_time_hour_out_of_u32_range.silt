-- exit: 1
-- stderr-contains: time.datetime: hour
-- stderr-contains: is out of range
import time
import result
fn main() {
  let t = time.Time { hour: 4294967305, minute: 0, second: 0, ns: 0 }
  let d = time.Date { year: 2024, month: 1, day: 1 }
  let dt = time.datetime(d, t)
  println((time.format(dt, "%H:%M:%S") |> result.unwrap_or("")))
}
