-- stderr-not-contains: a Display implementation returned an error
-- A date has no time zone: `%z` is no format for it.
import time
fn day() -> time.Date {
  time.Date { year: 2024, month: 6, day: 15 }
}
fn main() {
  match time.format_date(day(), "%z") {
    Err(e) -> println(e.message())
    Ok(text) -> println("formatted: {text}")
  }
}
