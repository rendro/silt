-- stderr-not-contains: a Display implementation returned an error
-- A DateTime is naive: `%z` is no format for it.
import time
fn day() -> time.Date {
  time.Date { year: 2024, month: 6, day: 15 }
}
fn main() {
  let t = time.Time { hour: 10, minute: 30, second: 0, ns: 0 }
  match time.format(time.datetime(day(), t), "%z") {
    Err(e) -> println(Error.message(e))
    Ok(text) -> println("formatted: {text}")
  }
}
