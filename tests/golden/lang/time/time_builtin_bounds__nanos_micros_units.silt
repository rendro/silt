import time
fn main() {
  -- test_time_nanos_is_identity_on_ns_field
  println(time.nanos(12345).ns)
  -- test_time_nanos_zero
  println(time.nanos(0).ns)
  -- test_time_micros_scales_by_thousand
  println(time.micros(7).ns)
  -- test_time_micros_and_ms_are_consistent
  println(time.ms(1).ns == time.micros(1000).ns)
}
