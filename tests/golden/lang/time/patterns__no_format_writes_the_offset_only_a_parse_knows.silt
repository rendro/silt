import time

-- `%#z` is a specifier the library can read and not write: no value
-- has what it names. It is no pattern of a date or a `DateTime`: both
-- formats and both parses say `InvalidFormat`.
fn main() -> Result((), time.TimeError) {
  let day = time.date(2001, 2, 3)?
  let moment = time.datetime(day, time.time(16, 5, 6)?)
  println(time.format(moment, "%Y-%m-%d %H:%M:%S %#z"))
  println(time.format_date(day, "%Y-%m-%d %#z"))
  println(time.parse("2001-02-03 16:05:06 +02", "%Y-%m-%d %H:%M:%S %#z"))
  println(time.parse_date("2001-02-03 +02", "%Y-%m-%d %#z"))
  Ok(())
}
