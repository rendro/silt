import string
fn main() {
  -- test_split_at_middle
  println(string.split_at("hello", 2) == Some(("he", "llo")))
  -- test_split_at_zero
  println(string.split_at("hello", 0) == Some(("", "hello")))
  -- test_split_at_len
  println(string.split_at("hello", 5) == Some(("hello", "")))
  -- test_split_at_unicode: "café" is 4 chars, 5 bytes
  println(string.split_at("café", 3) == Some(("caf", "é")))
}
