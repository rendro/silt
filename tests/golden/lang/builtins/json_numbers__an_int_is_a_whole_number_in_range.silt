-- A number of a JSON document goes into an `Int` when it is a whole
-- number in `Int`'s range, however it is written (`1`, `1.0`, `1e3`).
-- A number with a fraction, or one out of the range, is the error of a
-- value of another type, at the top, in a record's field, in a list and
-- in a map. TOML says which kind a number is: its
-- integers are Ints, and a float is none, whatever its value.
import json
import toml

type Pt { x: Int, y: Int }

fn main() {
  println(json.parse("""{"x": 1.0, "y": 2}""", Pt))
  println(json.parse("""{"x": 1.0, "y": 2.5}""", Pt))
  println(json.parse("""[{"x": 1e3, "y": -0.0}]""" |> wrap, Pt))
  println(json.parse("""[{"x": 1, "y": 2.5}]""", List(Pt)))
  println(json.parse("""{"a": 1.0, "b": 2}""", Map(String, Int)))
  println(json.parse("""{"a": 1.5}""", Map(String, Int)))
  println(json.parse("3.0", Int))
  println(json.parse("3.25", Int))
  println(json.parse("9223372036854775807", Int))
  println(json.parse("9223372036854775808", Int))
  println(json.parse("-9223372036854775808.0", Int))
  println(json.parse("1e19", Int))
  println(toml.parse("x = 1\ny = 2", Pt))
  println(toml.parse("x = 1.0\ny = 2", Pt))
  println(toml.parse_map("a = 2\nb = 1.5", Int))
}

-- The one record of a list, as a document of its own.
fn wrap(list) {
  match json.parse(list, List(Pt)) {
    Ok([only]) -> json.stringify(only)
    _ -> "no single record"
  }
}
