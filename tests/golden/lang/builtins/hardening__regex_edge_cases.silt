import regex
fn main() -> Result((), regex.RegexError) {
  let xyz = regex.compile("xyz")?
  let empty = regex.compile("")?
  -- test_regex_find_no_match
  println(regex.find("hello", xyz))
  -- test_regex_find_all_no_matches
  println(regex.find_all("hello", xyz) == [])
  -- test_regex_is_match_empty_pattern
  println(regex.is_match("hello", empty))
  -- test_regex_split_no_match
  println(regex.split("hello", xyz) == ["hello"])
  Ok(())
}
