import json
type Payload { n: Int }
fn main() {
  -- 1e100 does not fit in an Int; it must not saturate to i64::MAX
  match json.parse("""{"n": 1e100}""", Payload) {
    Ok(p) -> println("unexpected Ok: {p.n}")
    Err(json.JsonUnknown(msg)) -> println(msg)
    Err(other) -> println("unexpected error variant: {other}")
  }
}
