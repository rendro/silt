-- A value piped into a call is the call's first argument, whatever the
-- callee is: `5 |> a.add()` is `a.add(5)`, as `5 |> f(1)` is `f(5, 1)`.
import list
type Acc { base: Int }
trait Adder { fn add(self, x: Int) -> Int }
trait Adder for Acc { fn add(self, x: Int) -> Int { self.base + x } }
trait Adder for Int { fn add(self, x: Int) -> Int { self + x } }
type Opt { Wrap(Int) }
fn main() {
  let a = Acc { base: 100 }
  println(5 |> a.add())
  println(5 |> a.add)
  println(5 |> 3.add())
  println(5 |> Wrap)
  println(5 |> Wrap())
  println([1, 2] |> list.map({ x -> x + 1 }))
  println([1, 2] |> list.length)
  let f = { x, y -> x - y }
  println(10 |> f(3))
}
