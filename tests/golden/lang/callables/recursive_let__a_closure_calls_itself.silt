-- A local `let f = { … }` is `f` inside its own closure: it can call
-- itself, also where the result is still used, and with the values it
-- captures. (A closure cannot be `deep`: one that counts down carries
-- its running value, so that the call comes last.)
import int
import list

type Tree {
  Leaf,
  Node(Tree, Int, Tree),
}

type Rose {
  Rose(List(Rose)),
}

fn make_counter(step: Int) -> Fn(Int) -> Int {
  let go = { n, total ->
    match n {
      0 -> total
      _ -> go(n - 1, total + step)
    }
  }
  { n -> go(n, 0) }
}

fn chain(n: Int, inner: Rose) -> Rose {
  match n {
    0 -> inner
    _ -> chain(n - 1, Rose([inner]))
  }
}

fn main() {
  let limit = 3
  let visit = { t ->
    match t {
      Leaf -> 0
      Node(l, v, r) -> visit(l) + int.min(v, limit) + visit(r)
    }
  }
  println(visit(Node(Node(Leaf, 1, Leaf), 5, Node(Leaf, 2, Leaf))))

  -- The closure is generalised after it is checked: one type inside
  -- itself, any type where it is used.
  let len = { xs ->
    match xs {
      [] -> 0
      [_, ..rest] -> 1 + len(rest)
    }
  }
  println(len([1, 2, 3]) + len(["a"]))

  -- With an annotation.
  let fact: Fn(Int, Int) -> Int = { n, product ->
    match n {
      0 -> product
      _ -> fact(n - 1, product * n)
    }
  }
  println(fact(10, 1))

  -- A closure inside it captures it.
  let depth = { r ->
    match r {
      Rose(kids) -> kids
        |> list.map { kid -> depth(kid) + 1 }
        |> list.fold(0) { deepest, d -> int.max(deepest, d) }
    }
  }
  println(depth(chain(5, Rose([]))))

  -- It leaves the function that made it.
  let triple = make_counter(3)
  println(triple(4))

  -- A parameter of the name is the parameter.
  let f = { f -> f + 1 }
  println(f(1))
}
