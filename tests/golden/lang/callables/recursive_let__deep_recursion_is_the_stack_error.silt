-- exit: 1
-- frame-budget: 1
-- stderr-contains: stack overflow: call frames take more than 1 MiB
-- stderr-contains: deep in main
-- A call of itself whose result is still used takes a frame, as a
-- function's does.
fn main() {
  let deep = { n ->
    match n {
      0 -> 0
      _ -> 1 + deep(n - 1)
    }
  }
  println(deep(200000))
}
