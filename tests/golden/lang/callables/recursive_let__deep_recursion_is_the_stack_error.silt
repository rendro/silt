-- exit: 1
-- stderr-contains: stack overflow: recursion depth exceeded 100000 frames
-- stderr-contains: closure in main
-- A call of itself whose result is still used takes a frame, as a
-- function's does.
fn main() {
  let deep = { n ->
    match n {
      0 -> 0
      _ -> 1 + deep(n - 1)
    }
  }
  println(deep(200000))
}
