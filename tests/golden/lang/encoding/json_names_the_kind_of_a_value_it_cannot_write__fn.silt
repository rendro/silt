-- exit: 1
-- stderr-contains: json.stringify: unsupported value kind Fn
-- JSON has no form for a function: `json.stringify` ends the program
-- with a runtime error. A function is an `Fn` whether the program
-- wrote it or a builtin module has it: the first line is written (a
-- value without a function), the second is the error of the closure;
-- the builtin function has a case of its own.
import json

fn main() {
  println(json.stringify(((), None, Some(1))))
  println(json.stringify(Some({ x -> x + 1 })))
}
