import toml
type Rec { name: String, nickname: Option(String) }
fn main() {
  let r = Rec { name: "x", nickname: Some("bob") }
  println(match toml.stringify(r) {
      Ok(s) -> match toml.parse(s, Rec) {
        Ok(v) -> match v.nickname {
          Some(n) -> n
          None -> "none"
        }
        Err(e) -> "parse err"
      }
      Err(e) -> "stringify err"
    }
  )
}
