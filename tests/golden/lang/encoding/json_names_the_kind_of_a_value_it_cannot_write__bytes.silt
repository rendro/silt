-- exit: 1
-- stderr-contains: json.stringify: unsupported value kind Bytes
-- JSON has no form for bytes: `json.stringify` ends the program with a
-- runtime error that names the kind, wherever in the value the bytes
-- are (here the field of a record in a list, as the body of an HTTP
-- response is). It wrote `null` in their place.
import bytes
import json

type Reply {
  status: Int,
  body: Bytes,
}

fn main() {
  println(json.stringify([Reply { status: 200, body: bytes.from_string("ok") }]))
}
