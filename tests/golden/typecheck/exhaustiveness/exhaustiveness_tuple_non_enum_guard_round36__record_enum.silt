-- cmd: check
-- exit: 1
-- stderr-contains: non-exhaustive match
-- stderr-contains: `(Pair { a: 1, .. }, _)` is not covered
type Pair { a: Int, b: Int }
type Color { Red, Green, Blue }
fn main() {
  let t = (Pair { a: 1, b: 2 }, Red)
  match t {
    (Pair { a: 0, b: 0 }, _) -> println("origin+any")
  }
}
