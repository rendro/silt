-- cmd: check
-- exit: 1
-- A non-exhaustive match on a generic record names the record field in the witness.
-- stderr-contains: non-exhaustive
-- stderr-contains: Pair.first
-- stderr-not-contains: not all patterns are covered
type Pair(a, b) { first: a, second: b }
fn check(p: Pair(Bool, Int)) -> Int = match p { Pair{first: true, second} -> second }
fn main() { check(Pair{first: true, second: 1}) }
