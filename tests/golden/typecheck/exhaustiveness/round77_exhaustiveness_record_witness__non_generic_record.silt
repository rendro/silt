-- cmd: check
-- exit: 1
-- A non-exhaustive match on a plain record shows a value of the record no arm matches.
-- stderr-contains: non-exhaustive
-- stderr-contains: `Box { flag: false }` is not covered
type Box { flag: Bool }
fn check(b: Box) -> Int { match b { Box{flag: true} -> 1 } }
fn main() { check(Box{flag: true}) }
