-- A supertrait argument written with an alias (`Carry(Pair)`, `Carry(Wrap(b))`) is the type the alias stands for: an impl of that type meets it, also through a `where` bound.
type Bag { n: Int }
type Pair = (Int, Int)
type Wrap(a) = List(a)
trait Carry(c) { fn carry(self) -> c }
trait Holds(b): Carry(Pair) { fn hold(self) -> b }
trait Carry((Int, Int)) for Bag { fn carry(self) -> (Int, Int) { (1, 2) } }
trait Holds(Int) for Bag { fn hold(self) -> Int { 1 } }
fn carried(x: t) -> (Int, Int) where t: Holds(Int) { Carry.carry(x) }
trait Keep(b): Carry(Wrap(b)) { fn keep(self) -> b }
type Sack { n: Int }
trait Carry(List(Int)) for Sack { fn carry(self) -> List(Int) { [1] } }
trait Keep(Int) for Sack { fn keep(self) -> Int { 2 } }
fn kept(x: t) -> List(Int) where t: Keep(Int) { Carry.carry(x) }
fn main() {
  let b = Bag { n: 1 }
  let h: Int = Holds.hold(b)
  println("{h} {carried(b)} {kept(Sack { n: 1 })}")
}
