-- cmd: check
-- exit: 1
-- A value is shown by the impl of its type, whatever its type arguments:
-- a `Display` impl for one instantiation is refused.
type Box(a) { Box(a) }
trait Display for Box(Int) { fn display(self) -> String { match self { Box(n) -> "int {n + 1}" } } }
fn main() {
  println("{Box(1)}")
  println("{[Box(2)]}")
}
