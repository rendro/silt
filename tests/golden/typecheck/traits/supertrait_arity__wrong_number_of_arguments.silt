-- A supertrait is given as many type arguments as it has parameters, said
-- in the one form for a number of type arguments: checked where the trait
-- is declared, whether or not a `where` clause
-- names the trait.
trait Holds(a) { fn held(self) -> a }
trait Bad: Holds(Int, String) { fn bad(self) -> Int }
trait Bare: Holds { fn bare(self) -> Int }
trait Fine: Holds(Int) { fn fine(self) -> Int }
fn main() { println(1) }
