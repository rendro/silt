trait Mapping {
  fn map(xs: Self(a), f: Fn(a) -> b) -> Self(b)
}
trait Mapping for Result(_, e) {
  fn map(xs, f) {
    match xs {
      Ok(x) -> Ok(f(x))
      Err(e) -> Err(e)
    }
  }
}
