trait Mapping {
  fn map(xs: Self(a), f: Fn(a) -> b) -> Self(b)
}
type Box(a) { value: a }
trait Mapping for Box(_) {
  fn map(xs: Box(a), f: Fn(a) -> b) -> Option(b) { None }
}
