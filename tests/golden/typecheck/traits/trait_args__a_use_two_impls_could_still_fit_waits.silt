import list
trait From(e) { fn from(source: e) -> Self }
type A { A(String) }
fn sh(a: A) -> String { match a { A(s) -> s } }
trait From(List(Int)) for A { fn from(e: List(Int)) -> A { A("ints") } }
trait From(List(String)) for A { fn from(e: List(String)) -> A { A("strings") } }
fn main() {
  let xs = list.drop([], 0)
  let a = A.from(xs)
  let ys: List(Int) = xs
  println(sh(a))
  let zs = list.drop([], 0)
  println(sh(A.from(zs)))
}
