-- stderr-contains: type variable 'a' in impl-level where clause is a trait argument, not a target type argument; declare the bound on the method in trait 'Tbl'
-- stderr-not-contains: must implement
-- An impl for every trait argument may repeat the trait's own bound on
-- it, and only that: a bound the trait does not declare is refused,
-- written after the trait's bound as well as before it.
trait Key {
  fn key(self) -> String
}

trait Key for Int {
  fn key(self) -> String { "i{self}" }
}

trait Tbl(k) where k: Key {
  fn show(self, x: k) -> String { Key.key(x) }
}

type W {
  v: Int,
}

type V {
  v: Int,
}

trait Tbl(a) for W where a: Key + Display {}

fn main() {
  println(Tbl.show(W { v: 1 }, 5))
}

trait Tbl(a) for V where a: Display + Key {}
