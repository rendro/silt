-- cmd: check
-- exit: 1
-- stderr-contains: `Wrapper` takes 1 type argument here: write `Wrapper(a)`
type Wrapper(a) { v: a }
trait Carry(t) { fn carry(self, x: t) -> t }
trait Holds: Carry(Wrapper) { fn hold(self) -> Int }

fn use_holds(x: t) -> Int where t: Holds {
  Holds.hold(x)
}

fn main() { }
