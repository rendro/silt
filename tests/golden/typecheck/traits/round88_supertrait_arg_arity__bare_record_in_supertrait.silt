-- stderr-contains: type 'Wrapper' expects 1 type argument, got 0 in supertrait bound
type Wrapper(a) { v: a }
trait Carry(t) { fn carry(self, x: t) -> t }
trait Holds: Carry(Wrapper) { fn hold(self) -> Int }

fn use_holds(x: t) -> Int where t: Holds {
  x.hold()
}

fn main() { }
