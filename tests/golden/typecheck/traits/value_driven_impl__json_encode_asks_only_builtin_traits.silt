-- cmd: check
-- exit: 1
-- json.stringify runs an impl of json.Encode itself: its header asks
-- only builtin traits of its type's variables.
-- stderr-contains: error[type]: an impl of 'json.Encode' can ask only 'Display', 'Equal', 'Compare', 'Hash', 'json.Encode', 'json.Decode' or 'Error' of its type's variables: the runtime runs it with nothing else
import json
trait Name { fn name(self) -> String }
type Box(a) { Bx(a) }
trait json.Encode for Box(a) where a: Name {
  fn encode(self) -> json.Value { match self { Bx(x) -> json.String(Name.name(x)) } }
}
fn main() { println(json.stringify(Bx(1))) }
