-- A trait method's own `where` clause is part of its signature: in force
-- in its default body and in an impl that leaves the annotations out.
trait Loud { fn loud(self) -> String }
trait Loud for Int { fn loud(self) -> String { "INT" } }
trait Shw {
  fn shw(self, x: a) -> String where a: Loud
  fn twice(self, x: a) -> String where a: Loud { "{Loud.loud(x)}{Loud.loud(x)}" }
  fn text(self, x: a) -> String where a: Display
}
trait Shw for Int {
  fn shw(self, x) { Loud.loud(x) }
  fn text(self, x) { "{x}" }
}
trait Shw for Bool {
  fn shw(self, x: b) -> String where b: Loud { Loud.loud(x) }
  fn text(self, x: b) -> String { "bool {x}" }
}
fn main() {
  println(Shw.shw(1, 2))
  println(Shw.shw(true, 3))
  println(Shw.twice(1, 4))
  println(Shw.text(1, "s"))
  println(Shw.text(true, 5))
}
