-- cmd: check
-- exit: 1
-- The runtime runs an impl of Display itself (println, interpolation),
-- with no caller to give what a bound of a program's trait needs: such
-- an impl's header asks only builtin traits of its type's variables.
-- stderr-contains: error[type]: an impl of 'Display' can ask only 'Display', 'Equal', 'Compare', 'Hash', 'json.Encode', 'json.Decode' or 'Error' of its type's variables: the runtime runs it with nothing else
-- stderr-contains: show the part with `{x}` and bound it by Display
trait Name { fn name(self) -> String }
type Box(a) { Bx(a) }
trait Display for Box(a) where a: Name {
  fn display(self) -> String { match self { Bx(x) -> "box {Name.name(x)}" } }
}
fn main() { println(Bx(1)) }
