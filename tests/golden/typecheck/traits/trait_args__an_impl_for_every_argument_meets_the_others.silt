-- stderr-contains: = help: give each impl trait arguments of its own, which no other impl's could be
trait Wrap(e) { fn wrap(source: e) -> Self }
type A { A(Int) }
trait Wrap(Int) for A { fn wrap(e: Int) -> A { A(e) } }
type B(x) { B(x) }
trait Wrap(x) for B(x) { fn wrap(e: x) -> B(x) { B(e) } }
trait Wrap(String) for B(x) { fn wrap(e: String) -> B(x) { panic("no") } }
