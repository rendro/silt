-- cmd: check
-- exit: 1
-- The rule that a method without `self` is no candidate is for a call
-- on a value: a call on the type (`String.decode(4)`) has both traits'
-- methods, and is ambiguous. A call on a value of methods that all take
-- no `self` has no candidate: it is refused as taking no `self`, with
-- the call on the type to write.
trait Mk {
  fn decode(v: Int) -> Self
}

trait Rd {
  fn decode(self, n: Int) -> Int
}

trait Mk for String {
  fn decode(v: Int) -> Self {
    "{v}"
  }
}

trait Rd for String {
  fn decode(self, n: Int) -> Int {
    n + 1
  }
}

trait Make {
  fn make(v: Int) -> Self
}

trait Build {
  fn make(v: Int) -> Self
}

trait Make for Int {
  fn make(v: Int) -> Self {
    v
  }
}

trait Build for Int {
  fn make(v: Int) -> Self {
    v
  }
}

fn main() {
  let t: String = String.decode(4)
  println(t)
  println(7.make(1))
}
