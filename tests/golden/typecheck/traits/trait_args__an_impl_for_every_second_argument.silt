-- cmd: check
-- exit: 1
-- An impl whose second trait argument is a type variable is for every second
-- argument: it meets an impl at its first argument and another second.
-- stderr-contains: error[type]: duplicate implementation of trait 'Pair' for type 'A': the impl of 'Pair(Int, _)' is for every second trait argument, and the impl of 'Pair(Int, String)' is for one of them
trait From(e) { fn from(source: e) -> Self }
type A { A(String) }
fn sh(a: A) -> String { match a { A(s) -> s } }
trait Pair(a, b) { fn pair(x: a, y: b) -> Self }
trait Pair(Int, String) for A { fn pair(x: Int, y: String) -> A { A("is") } }
trait Pair(Int, y) for A { fn pair(x: Int, z: y) -> A { A("iy") } }
fn main() { println(sh(A.pair(1, "a"))) }
