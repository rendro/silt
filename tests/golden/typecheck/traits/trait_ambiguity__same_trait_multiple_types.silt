-- cmd: check
-- exit: 0
-- One trait on several types is fine.
trait Show { fn show(self) -> String }
trait Show for Int { fn show(self) -> String { "int" } }
trait Show for String { fn show(self) -> String { self } }
trait Show for Bool {
  fn show(self) -> String { match self {
    true -> "T"
    false -> "F"
  } }
}
fn main() {
  println(Show.show(1))
  println(Show.show("x"))
  println(Show.show(true))
}
