trait C(b) {
  fn c(self) -> b
}
trait C(Self) for Int {
  fn c(self) -> Int { self }
}
type Box(a) { v: a }
fn twice(x: Self) -> Self { x }
type Holder { h: Self }
type Same = Self
enum E { V(Self) }
trait Show2 { fn show2(self) -> String }
trait Show2 for Box(a) { fn show2(self) -> String { "box" } }
fn main() {
  let s: Self = 1
  println(s)
}
