-- cmd: check
-- exit: 1
-- A method of a structural trait written through a type (`Int.display`,
-- `P.compare`) or through a type held in a value has the type it has on
-- a value of that type, with the receiver as its first argument: the
-- arguments, their number and the result are checked.
import list

type P {
  x: Int,
}

fn main() {
  println(Int.equal(1, 2.0))
  println(P.display(5))
  let n: Int = String.display("s")
  let names: List(Int) = list.map(["a", "b"], String.display)
  let q = P
  println(q.compare(P { x: 1 }, 3))
  println(Int.display())
  println(Tuple.display((1, 2)))
  println("{n} {names}")
}
