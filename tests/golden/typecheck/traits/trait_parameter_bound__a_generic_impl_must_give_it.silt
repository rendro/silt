-- cmd: check
-- exit: 1
-- A trait's own `where` clause on its parameter (`trait Tbl(k) where k:
-- G`) is asked of an impl whose trait argument is, or is built from, a
-- variable of its type: the impl's header must give it. (Without it the
-- impl was accepted, and a default body using the bound ran with no
-- dictionary, or compared maps.)
trait G {
  fn g(self) -> String
}

trait G for Int {
  fn g(self) -> String {
    "I"
  }
}

trait Tbl(k) where k: G {
  fn key(self) -> k
  fn show(self) -> String {
    G.g(Tbl.key(self))
  }
}

type B(a) {
  B(a),
}

trait Tbl(a) for B(a) {
  fn key(self) -> a {
    match self {
      B(x) -> x
    }
  }
}

trait Keyed(k) where k: Compare {
  fn key(self) -> k
  fn lower(self, o: Self) -> Bool {
    Keyed.key(self) < Keyed.key(o)
  }
}

type Cell(a) {
  Cell(a),
}

trait Keyed(List(a)) for Cell(a) {
  fn key(self) -> List(a) {
    match self {
      Cell(v) -> [v]
    }
  }
}

fn main() {
  println(1)
}
