-- The impl of trait_parameter_bound__naming_another_parameter with the
-- help applied (`where a: Conv(b)`): it checks, and the default body
-- calls the `Conv` of the trait arguments the use gives.
trait Conv(r) {
  fn conv(self) -> r
}

trait Conv(Int) for String {
  fn conv(self) -> Int {
    7
  }
}

trait Conv(String) for String {
  fn conv(self) -> String {
    self
  }
}

trait Tbl(k, v) where k: Conv(v) {
  fn key(self) -> k
  fn show(self) -> v {
    Conv.conv(Tbl.key(self))
  }
}

type P(a, b) {
  P(a, b),
}

trait Tbl(a, b) for P(a, b) where a: Conv(b) {
  fn key(self) -> a {
    match self {
      P(x, _) -> x
    }
  }
}

fn sh(x: t, type k, type v) -> v where t: Tbl(k, v) {
  Tbl.show(x)
}

fn main() {
  println(sh(P("s", 1), String, Int) + 1)
  println(sh(P("s", "u"), String, String))
}
