-- A method of a structural trait written through a type, or through a
-- type held in a value, is the method of the type's values.
import json
import list

type P {
  x: Int,
}

type Box(a) {
  v: a,
}

type Color {
  Red,
  Green,
}

fn shown(x: a, type a) -> String where a: Display {
  a.display(x)
}

fn order(x: a, y: a, type a) -> Int where a: Compare {
  a.compare(x, y)
}

fn main() {
  println(Int.display(3))
  println(Option.display(Some(1)))
  println(Box.display(Box { v: "b" }))
  println(Color.compare(Red, Green))
  println(Float.equal(1.0, 1.0))
  println(json.Value.display(json.Null))
  println(list.map([1, 2], Int.display))
  println(list.fold([P { x: 2 }, P { x: 1 }], 0, { acc, p -> acc + P.compare(p, P { x: 1 }) }))
  let q = P
  println(q.display(P { x: 4 }))
  println(Int.hash(3) == 3.hash())
  println(shown(P { x: 5 }, P))
  println(order(2, 1, Int))
}
