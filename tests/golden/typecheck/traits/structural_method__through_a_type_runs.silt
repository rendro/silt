-- A method of a structural trait written through a type, or through a
-- type held in a value, is the method of the type's values.
import json
import list
import string

type P {
  x: Int,
}

type Box(a) {
  v: a,
}

type Color {
  Red,
  Green,
}

fn shown(x: a, type a) -> String where a: Display {
  "{x}"
}

fn order(x: a, y: a, type a) -> Int where a: Compare {
  Compare.compare(x, y)
}

fn main() {
  println("{3}")
  println("{Some(1)}")
  println(string.from(Box { v: "b" }))
  println(Compare.compare(Red, Green))
  println(1.0 == 1.0)
  println("{json.Null}")
  println(list.map([1, 2], string.from))
  println(list.fold([P { x: 2 }, P { x: 1 }], 0, { acc, p -> acc + Compare.compare(p, P { x: 1 }) }))
  let q = P
  println(string.from(P { x: 4 }))
  println(Hash.hash(3) == Hash.hash(3))
  println(shown(P { x: 5 }, P))
  println(order(2, 1, Int))
}
