-- cmd: check
-- exit: 1
-- verdict: same
-- `Compare.compare` and `==` take two values of one type: comparing an
-- Int with a String, or a record with a number, is a type mismatch and
-- not a `false` (or an error when the program runs).
type P {
  n: Int,
}

fn main() {
  let p = P { n: 1 }
  println(Compare.compare(1, "a"))
  println(p == 2)
  println(Compare.compare(p, "x"))
  println([1] == ["a"])
  println(Some(1) == Some("a"))
  println(Compare.compare(1, 1))
  println(Compare.compare(p, P { n: 2 }))
}
