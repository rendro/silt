-- A bound may name a variable of the target type or of the trait's
-- arguments; one on a variable neither writes is refused, and the example
-- keeps the trait's arguments as the impl wrote them.
trait Conv(t) {
  fn conv(self) -> t
}

type W { v: Int }

trait Conv(List(a)) for W where b: Display {
  fn conv(self) -> List(a) { [] }
}

fn main() {
  println(1)
}
