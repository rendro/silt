-- cmd: check
-- exit: 1
-- stderr-contains: type mismatch: expected Int, got String
trait Foo(a) { fn produce(self) -> a }
trait Foo(Int) for String { fn produce(self) -> String = "haha" }
fn use_foo(s: a) -> Int where a: Foo(Int) {
  s.produce()
}
fn main() {
  let s: String = "hi"
  let r: Int = use_foo(s)
  println(r)
}
