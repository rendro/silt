-- exit: 1
-- verdict: same
-- The order of the declarations does not matter: the impl is written
-- before its trait and before the record type.
trait Run for H { fn run(self, x: Int) -> Int { -1 } }
fn main() {
  let h = H { run: { x -> x + 1 }, n: 0 }
  println(h.run(1))
}
trait Run { fn run(self, x: Int) -> Int }
type H { run: Fn(Int) -> Int, n: Int }
