-- GUARD: correct impls against an alias and against `List(a)` check and dispatch, for a list and for a range.
trait Foo { fn foo(self) -> Int }
trait Bar { fn bar(self) -> Int }
type Ints = List(Int)
trait Foo for Ints {
  fn foo(self) -> Int { 7 }
}
trait Bar for List(a) {
  fn bar(self) -> Int { 8 }
}
fn main() {
  println([1, 2].foo())
  println((1..3).foo())
  println((1..3).bar())
  println([4, 5].bar())
}
