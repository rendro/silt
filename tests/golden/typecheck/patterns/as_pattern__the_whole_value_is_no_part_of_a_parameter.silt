-- exit: 1
-- stderr-contains: error[type]: this call of `walk` takes a frame for every round
-- stderr-contains: `whole` is `t` itself, not a part of it
-- stderr-not-contains: this call of `count`
-- The name behind `as` is the value itself, not a part of it: a call
-- on it does not descend. A call on what the pattern takes apart does,
-- also when the pattern is a tuple's matched against a tuple written out.
type T {
  Leaf,
  Node(T),
}

fn depth(t: T) -> Int {
  match t {
    Node(inner) as _whole -> 1 + depth(inner)
    Leaf -> 0
  }
}

fn walk(t: T) -> Int {
  match t {
    Node(_) as whole -> 1 + walk(whole)
    Leaf -> 0
  }
}

fn count(xs: List(Int), n: Int) -> Int {
  match (xs, n) {
    ([_, ..rest], m) as _both -> 1 + count(rest, m)
    ([], _) -> 0
  }
}

fn main() {
  println(depth(Node(Leaf)) + walk(Leaf) + count([1], 0))
}
