-- cmd: check
-- exit: 1
-- A parameter annotated with a type variable has the bounds its `where`
-- clauses declare and no other, also when the return type is left out.
-- stderr-contains: enclosing function does not declare constraint required by call to 'hello': `b: Greet`
-- stderr-contains: no field or method 'greet' on a value of type `c`: the type variable has no trait bound
-- stderr-contains: add `where c: SomeTrait`
trait Greet { fn greet(self) -> String }
trait Greet for Int { fn greet(self) -> String { "int" } }
fn hello(x: a) -> String where a: Greet { x.greet() }
fn partly(x: b) { hello(x) }
fn method(x: c) -> String { x.greet() }
fn main() { println(partly(1)) }
