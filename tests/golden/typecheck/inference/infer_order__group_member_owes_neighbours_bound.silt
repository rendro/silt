trait Loud { fn loud(self) -> String }
trait Loud for Int { fn loud(self) -> String { "int!" } }
fn shout(x: a, n) where a: Loud {
  match n {
    0 -> x.loud()
    _ -> relay(x, n - 1)
  }
}
fn relay(u, n) { shout(u, n) }
fn main() {
  println(relay(1, 2))
  println(relay("s", 1))
}
