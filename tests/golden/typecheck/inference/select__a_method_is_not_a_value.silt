-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'Int' has no field 'add'
-- stderr-contains: help: `add` is a method of trait `Adder`: call it as `Adder.add(x, ..)`
-- A dot after a value is a field, called or not: a trait's method is
-- taken through its trait (`Adder.add`).
trait Adder { fn add(self, x: Int) -> Int }
trait Adder for Int { fn add(self, x: Int) -> Int { self + x } }
fn main() {
  let m = 3.add
  println(m(3, 4))
}
