-- cmd: check
-- exit: 1
-- `r.x` on a record without the field `x` is refused, though a trait
-- declares a method `x`.
-- stderr-contains: error[type]: type 'R' has no field 'x'
trait HasX { fn x(self) -> Int }
type R { y: Int }
fn getx(r: R) -> Int { r.x }
fn main() {
  println(getx(R { y: 1 }))
}
