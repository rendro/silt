-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'P' has no field 'nam'
-- A closure literal passed to a function has the parameter types the
-- function expects before its body is checked: `p` is a `P` at `p.nam`.
type P { name: String }
fn apply(f: Fn(P) -> Int, x: P) -> Int { f(x) }
fn main() { println(apply({ p -> p.nam }, P { name: "a" })) }
