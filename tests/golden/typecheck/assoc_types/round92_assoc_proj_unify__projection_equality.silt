trait Stream {
  type Item
  fn first(self) -> Self::Item
}

type Wrap { v: Int }

trait Stream for Wrap {
  type Item = Int
  fn first(self) -> Int { self.v }
}

fn same(s: a) -> Bool where a: Stream {
  let x = s.first()
  let y = s.first()
  x == y
}

fn main() {
  println(same(Wrap { v: 3 }))
}
