trait Stream {
  type Item
  fn first(self) -> Self::Item
}

type A { x: Int }
type B { y: String }

trait Stream for A {
  type Item = Int
  fn first(self) -> Int { self.x }
}

trait Stream for B {
  type Item = String
  fn first(self) -> String { self.y }
}

fn main() {
  let a = A { x: 9 }
  println(a.first())
  let b = B { y: "bee" }
  println(b.first())
}
