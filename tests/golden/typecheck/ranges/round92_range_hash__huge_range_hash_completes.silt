-- Hashing a ~4e9-element range (and one near i64::MAX) is closed-form and finishes promptly.
fn main() {
  let r = 0..4000000000
  let h = Hash.hash(r)
  println("hashed ok")
  let big = 0..9223372036854775806
  let h2 = Hash.hash(big)
  println("hashed max ok")
  println(h == h)
  println(h2 == h2)
}
