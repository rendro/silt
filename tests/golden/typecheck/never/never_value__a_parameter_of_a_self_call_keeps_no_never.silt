-- cmd: check
-- exit: 1
-- A parameter of a function that calls itself, first given a function
-- that never returns, takes the type of what the self call gives it:
-- beside `{ s -> 42 }` it is a `Fn(String) -> Int`, so a use of its
-- result as a String is refused.
import string

fn fail(m: String) -> Never {
  panic(m)
}

fn go(g, i) {
  match i {
    0 -> go({ s -> 42 }, 1)
    _ -> string.length(g("x"))
  }
}

fn main() {
  println(go(fail, 0))
}
