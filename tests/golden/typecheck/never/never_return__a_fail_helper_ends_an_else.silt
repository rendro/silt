-- exit: 1
-- A function declared `-> Never` never returns, so a call of it ends
-- an `else` that must leave, as `panic` does; a function that calls
-- itself without end is such a body too.
fn fail(message: String) -> Never {
  panic("failed: {message}")
}

fn forever() -> Never {
  -- The call comes last, so it is a jump: forever runs without end
  -- and keeps one frame.
  forever()
}

fn first(xs: List(Int)) -> Int {
  when let [x, ..] = xs else {
    fail("empty")
  }
  x
}

fn positive(n: Int) -> Int {
  when n > 0 else {
    fail("{n} is not positive")
  }
  n
}

fn main() {
  println(first([7, 8]))
  println(positive(3))
  let _ = forever
  println(first([]))
}
