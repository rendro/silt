import time
fn cmp_gen(a: a, b: a) -> Int where a: Compare { a.compare(b) }
fn main() {
    println(cmp_gen(time.Monday, time.Tuesday))
    println(cmp_gen(time.Tuesday, time.Wednesday))
    println(cmp_gen(time.Wednesday, time.Thursday))
    println(cmp_gen(time.Thursday, time.Friday))
    println(cmp_gen(time.Friday, time.Saturday))
    println(cmp_gen(time.Saturday, time.Sunday))
    println(cmp_gen(time.Monday, time.Saturday))
}
