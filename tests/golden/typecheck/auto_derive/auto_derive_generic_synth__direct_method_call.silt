-- The derived Equal, Compare and Hash of a generic record, called
-- directly: by `==` and through each trait.
type Wrapped(a) { value: a }
fn main() {
    let w = Wrapped { value: 7 }
    let v = Wrapped { value: 7 }
    let u = Wrapped { value: 8 }
    println(w == v)
    println(w == u)
    println(Compare.compare(w, u))
    println(Hash.hash(w) == Hash.hash(v))
}
