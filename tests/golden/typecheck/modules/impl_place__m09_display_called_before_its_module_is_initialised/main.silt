-- cmd: check
-- exit: 1
-- `early` calls `Tag.display` in a `let`; were the impl `main`'s, the
-- call would come before `main` is initialised (it was the internal
-- error "the global 'Tag.display' is read before it is set"). The refused
-- impl is the one error: the type keeps its structural Display.
import early
import types.{ Tag }

trait Display for Tag {
  fn display(self) -> String {
    "#{self.name}{unit}"
  }
}

let unit = "!"

fn main() {
  println(early.text)
  println(early.text2)
  println(early.text3)
  println(Tag { name: "m" }.display())
  println(early.show(Tag { name: "m2" }))
}
