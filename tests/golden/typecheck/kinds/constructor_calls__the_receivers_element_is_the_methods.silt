trait Mapping {
  fn map(xs: Self(a), f: Fn(a) -> b) -> Self(b)
}
trait Combinative: Mapping {
  fn pure(x: a) -> Self(a)
  fn map2(xs: Self(a), ys: Self(b), f: Fn(a, b) -> c) -> Self(c)
}
trait Chain: Combinative {
  fn flat_map(xs: Self(a), f: Fn(a) -> Self(b)) -> Self(b)
}
trait Mapping for Option(_) {
  fn map(xs, f) {
    match xs {
      Some(x) -> Some(f(x))
      None -> None
    }
  }
}
fn t6(xs: m(String)) -> m(Int) where m: Mapping {
  Mapping.map(xs) { x -> x * 2 }
}
fn t7(xs: m(String)) -> Int where m: Mapping {
  let ys = Mapping.map(xs) { x -> x * 2 }
  1
}
fn t9(xs: m(Int)) -> m(String) where m: Mapping { Mapping.map(xs) { x: String -> x } }
fn slen(s: String) -> Int { 1 }
fn a1(xs: m(Int)) -> m(Int) where m: Mapping { Mapping.map(xs, slen) }
fn a2(xs: m(Int), ys: m(Bool)) -> m(Int) where m: Combinative {
  Combinative.map2(xs, ys) { a: String, b: String -> 1 }
}
fn a3(xs: m(Int)) -> m(Int) where m: Chain { Chain.flat_map(xs) { x: String -> m.pure(1) } }
