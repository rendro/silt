-- cmd: check
-- exit: 1
-- The type constructor variable of a function without annotations is
-- written by a name in a message, as an annotation's is.
-- stderr-contains: error[type]: type mismatch: expected m(Int), got Int
-- stderr-contains: = note: 'm' stands for a type constructor: it matches a type with a type argument, like 'List(Int)' or 'Option(Int)'
trait Mapping {
  fn map(xs: Self(a), f: Fn(a) -> b) -> Self(b)
}
fn twice(xs) { Mapping.map(xs) { x -> x * 2 } }
fn main() { println(twice(1)) }
