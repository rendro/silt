-- cmd: check
-- exit: 1
-- The fixed arguments of a constructor impl's header are types: its
-- `where` bounds them by traits of types.
-- stderr-contains: error[type]: 't' is a type, but 'Functor' is a trait of type constructors
-- stderr-not-contains: = help
trait Functor {
  fn map(xs: Self(a), f: Fn(a) -> b) -> Self(b)
}
type Tagged(a, t) { value: a, tag: t }
trait Functor for Tagged(_, t) where t: Functor {
  fn map(x, f) { Tagged { value: f(x.value), tag: x.tag } }
}
fn main() { println(1) }
