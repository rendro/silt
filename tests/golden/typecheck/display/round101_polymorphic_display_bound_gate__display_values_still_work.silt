-- Positive control: Int, String, a stdlib error variant and a user record are shown through a Display bound (`where a: Display`).
-- stdout-contains: 42
-- stdout-contains: hi
-- stdout-contains: cannot parse empty string
-- stdout-contains: P {
import int
type P { name: String, age: Int }
fn show(x: a) -> String where a: Display { "{x}" }
fn main() {
  println(show(42))
  println(show("hi"))
  println(show(int.Empty))
  println(show(P { name: "x", age: 3 }))
}
