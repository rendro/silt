-- cmd: check
-- exit: 1
-- An impl of `Display` that does not write `display` lacks its method,
-- as an impl of any trait does. (It was accepted, and the type was
-- shown by its structure.) That is the impl's one error: the type has
-- the trait by its impl for every question after it (printing, a bound,
-- `.display()`, `D.display`), and none of them is reported as well.
import string

type D {
  n: Int,
}

trait Display for D {}

type F {
  f: Fn(Int) -> Int,
}

trait Display for F {}

fn show(x: a) -> String where a: Display {
  x.display()
}

fn main() {
  println(D { n: 1 })
  println([D { n: 1 }])
  println(D { n: 1 }.display())
  println(show(D { n: 2 }))
  println(D.display(D { n: 3 }))
  println(string.from(F { f: { x -> x } }))
  println(F { f: { x -> x } }.display())
}
