-- Polymorphic `.display()` on a task handle fails at run time, prints nothing, and has no interpolation suffix.
-- exit: 1
-- stderr-contains: does not implement Display
-- stderr-contains: 'Handle'
-- stderr-not-contains: required for string interpolation
import task
fn show(x: a) -> String { x.display() }
fn main() {
  let h = task.spawn({ -> 42 })
  println(show(h))
}
