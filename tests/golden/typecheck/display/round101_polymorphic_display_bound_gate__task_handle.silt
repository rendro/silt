-- A task handle given to a function with a Display bound (`where a: Display`) is rejected at the call, with no interpolation suffix.
-- exit: 1
-- stderr-contains: does not implement trait 'Display'
-- stderr-contains: 'task.Handle'
-- stderr-not-contains: required for string interpolation
import task
fn show(x: a) -> String where a: Display { "{x}" }
fn main() {
  let h = task.spawn({ -> 42 })
  println(show(h))
}
