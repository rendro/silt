-- A function given to a function with a Display bound (`where a: Display`) is rejected at the call, with no interpolation suffix.
-- exit: 1
-- stderr-contains: does not implement trait 'Display'
-- stderr-contains: 'Fn'
-- stderr-not-contains: required for string interpolation
fn show(x: a) -> String where a: Display { "{x}" }
fn main() { println(show({ y -> y })) }
