-- `"{e}"` equals `Error.message(e)` for a JsonError.
import json
fn main() {
    match json.parse("not valid json at all", String) {
        Ok(_) -> ()
        Err(e) -> {
            let display_form = "{e}"
            let message_form = Error.message(e)
            match display_form == message_form {
                true -> println("EQUIV")
                false -> {
                    println("DRIFT")
                    println(display_form)
                    println(message_form)
                }
            }
        }
    }
}
