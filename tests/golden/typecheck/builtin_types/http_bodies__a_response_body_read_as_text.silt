-- cmd: check
-- exit: 1
-- requires-feature: http
-- The body of a response is `Bytes`: what reads text does not take it
-- until the program has made text of it.
import http
import string

fn main() {
  match http.get("http://127.0.0.1:1/") {
    Ok(resp) -> println(string.length(resp.body))
    Err(e) -> println(Error.message(e))
  }
}
