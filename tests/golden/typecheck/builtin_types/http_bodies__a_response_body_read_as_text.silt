-- cmd: check
-- exit: 1
-- requires-feature: http
-- The body of a response is `Bytes`: what reads text does not take it
-- until the program has made text of it.
import http
import string
import url

fn main() {
  match http.get(url_of("http://127.0.0.1:1/")) {
    Ok(resp) -> println(string.length(resp.body))
    Err(e) -> println("{e}")
  }
}

fn url_of(text: String) -> url.Url {
  match url.parse(text) {
    Ok(u) -> u
    Err(e) -> panic("{e}")
  }
}
