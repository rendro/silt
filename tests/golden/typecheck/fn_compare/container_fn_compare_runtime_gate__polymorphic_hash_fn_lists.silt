-- `.hash()` through a polymorphic wrapper on lists of functions fails.
-- exit: 1
-- stderr-contains: error[type]: type 'List(Fn(_) -> _)' does not implement trait 'Hash': element is of type 'Fn(_) -> _', which does not
fn h(a: x) -> Int where x: Hash { a.hash() }
fn main() {
  println(h([{ y -> y }]) == h([{ z -> z * 99 }]))
}
