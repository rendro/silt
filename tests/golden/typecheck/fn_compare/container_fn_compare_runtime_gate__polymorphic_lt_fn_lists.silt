-- A polymorphic `<` on lists of functions fails at the execution site.
-- exit: 1
-- stderr-contains: error[type]: type 'List(Fn(_) -> _)' does not implement trait 'Compare': element is of type 'Fn(_) -> _', which does not
fn lt(a: x, b: x) -> Bool where x: Compare { a < b }
fn main() {
  let xs = [{ y -> y }]
  let ys = [{ y -> y }]
  println(lt(xs, ys))
}
