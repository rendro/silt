-- A polymorphic `<` on lists of functions fails at the execution site.
-- exit: 1
-- stderr-contains: error[type]: type 'Fn' does not implement trait 'Compare'
-- stderr-contains: 'Fn'
fn lt(a: x, b: x) -> Bool where x: Compare { a < b }
fn main() {
  let xs = [{ y -> y }]
  let ys = [{ y -> y }]
  println(lt(xs, ys))
}
