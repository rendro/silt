-- The gate walks the right operand too (empty list on the left).
-- exit: 1
-- stderr-contains: error[type]: type 'List(Fn(_) -> _)' does not implement trait 'Equal': element is of type 'Fn(_) -> _', which does not
fn eq(a: x, b: x) -> Bool where x: Equal { a == b }
fn main() {
  println(eq([], [{ y -> y }]))
}
