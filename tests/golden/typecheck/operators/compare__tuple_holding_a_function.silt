-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type '(Int, Fn(_) -> _)' does not implement trait 'Compare': part #2 is of type 'Fn(_) -> _', which does not
-- A tuple has `Compare` when its parts do: one that holds a function,
-- a map or a set does not.
import list
fn lt(x: a, y: a) -> Bool where a: Compare { x < y }
fn main() {
  let f = { n -> n }
  println((1, f) < (1, f))
  println(lt((1, f), (2, f)))
  println(list.sort([(1, #{ "a": 1 })]))
  println((1, #[1]).compare((1, #[2])))
}
