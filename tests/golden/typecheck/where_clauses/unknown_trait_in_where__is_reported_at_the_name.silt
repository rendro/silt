-- cmd: check
-- exit: 1
-- A bound that names no trait (here a variant of the module) is reported
-- at the name in the `where` clause, not at the whole declaration: of a
-- function, of an impl's header, of an impl's method (once), of a trait's
-- method, and on a line of its own after another bound (audit R9, review
-- rv-o8 N6, rv-o9 N2).
type T { Foo(Int), Bar }

trait Loud {
  fn loud(self) -> String
  fn twice(self, x: b) -> String
}

fn u(x: a) -> Int where a: Foo { 1 }

trait Loud for List(a) where a: Bar {
  fn loud(self) -> String { "x" }
  fn twice(self, x: b) -> String where b: Foo { "y" }
}

trait Quiet {
  fn quiet(self, x: b) -> Int where b: Bar
}

fn w(x: a, y: b) -> Int
  where a: Display,
        b: Foo
{ 1 }

fn main() {
  println((u(1), w(1, 2), Foo(2), Bar))
}
