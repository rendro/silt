-- cmd: check
-- exit: 1
-- stderr-contains: type 'String' does not implement trait 'Greet'
type Box(a) { Box(a) }
trait Greet { fn greet(self) -> String }
trait Greet for Int { fn greet(self) -> String { "int" } }
trait Greet for Box(a) where a: Greet {
  fn greet(self) -> String {
    match self { Box(inner) -> Greet.greet(inner) }
  }
}
fn main() {
  let b = Box("hello")
  println(Greet.greet(b))
}
