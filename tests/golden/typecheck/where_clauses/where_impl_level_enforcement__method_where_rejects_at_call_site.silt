-- cmd: check
-- exit: 1
-- stderr-contains: adds the bound `a: Greet`, which the trait does not declare for it
-- stderr-contains: type 'String' does not implement trait 'Greet'
-- A bound on the impl's type variable belongs on the impl's header: a
-- call through the trait does not know a method's own.
type Box(T) { Box(T) }
trait Greet { fn greet(self) -> String }
trait Greet for Int { fn greet(self) -> String { "int" } }
trait Wrap { fn unwrap(self) -> String }
trait Wrap for Box(a) {
  fn unwrap(self) -> String where a: Greet {
    match self { Box(inner) -> inner.greet() }
  }
}
fn main() {
  let b = Box("hello")
  println(b.unwrap())
}
