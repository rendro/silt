-- A header bound with a trait argument types the body: `x.conv()` is an
-- Int.
trait Conv(to) { fn conv(self) -> to }
trait Conv(Int) for String { fn conv(self) -> Int { 5 } }
type Box(a) { Wrap(a) }
trait Foo { fn do_it(self) -> Int }
trait Foo for Box(a) where a: Conv(Int) {
    fn do_it(self) -> Int {
      match self {
          Wrap(x) -> {
            let n: Int = x.conv()
            n + 100
          }
      }
    }
}
fn main() {
    let b: Box(String) = Wrap("five")
    println(b.do_it())
}
