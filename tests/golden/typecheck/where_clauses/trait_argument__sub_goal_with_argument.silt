-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'Bool' does not implement trait 'Conv(String)'
-- An impl's header bound with a trait argument, on a part still unknown,
-- is owed with its argument.
trait Conv(to) { fn conv(self) -> to }
trait Conv(String) for Int { fn conv(self) -> String { "an int" } }
fn s(x: a, y: b) -> b where a: Conv(b) { x.conv() }
type Box(a) { Box(a) }
trait Conv(String) for Box(a) where a: Conv(String) { fn conv(self) -> String { match self { Box(i) -> i.conv() } } }
fn w(y) { s(Box(y), "q") }
fn main() { println(w(true)) }
