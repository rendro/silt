-- exit: 1
-- stderr-contains: `Cast` takes 1 type argument here: write `Cast(to)`
-- `silt run` fails on the impl-level over-arity bound; the method never dispatches.
trait Cast(to) { fn cast(self) -> to }
trait Cast(Float) for Int { fn cast(self) -> Float { 1.5 } }
trait Use { fn use_it(self) -> Float }
trait Use for List(a) where a: Cast(Int, String) {
    fn use_it(self) -> Float {
      match self {
          [] -> 0.0
          [x, ..rest] -> x.cast() + Use.use_it(rest)
      }
    }
}
fn main() {
    let xs: List(Int) = [1]
    println(Use.use_it(xs))
}
