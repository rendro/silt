-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type 'String' does not implement trait 'Greet'
-- A method without `self` called on its type owes the bounds of the
-- impl's header like any use of the method: on the type's name and on
-- a value that holds the type.
trait Greet { fn greet(self) -> String }
trait Greet for Int { fn greet(self) -> String { "int" } }
trait Mk { fn mk() -> Self }
type Box(a) { v: List(a) }
trait Mk for Box(a) where a: Greet { fn mk() -> Self { Box { v: [] } } }
fn main() {
  let d = Box
  let b: Box(String) = d.mk()
  println(b)
}
