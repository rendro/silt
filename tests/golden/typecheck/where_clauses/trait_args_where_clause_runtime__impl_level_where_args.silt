-- An impl-level where-clause with mismatched trait args is rejected at
-- check time, so the run fails.
-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: does not implement trait 'Conv(Int)'
trait Conv(to) { fn conv(self) -> to }
trait Conv(String) for Int { fn conv(self) -> String { "an int" } }
trait UseIt { fn use_it(self) -> Int }
trait UseIt for List(a) where a: Conv(Int) {
    fn use_it(self) -> Int {
      match self {
          [] -> 0
          [x, ..rest] -> {
            let n: Int = Conv.conv(x)
            n + UseIt.use_it(rest)
          }
      }
    }
}
fn main() {
    let xs: List(Int) = [1, 2, 3]
    let r: Int = UseIt.use_it(xs)
    println(r)
}
