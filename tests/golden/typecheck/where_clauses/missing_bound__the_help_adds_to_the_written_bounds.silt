-- cmd: check
-- exit: 1
-- A variable that lacks a bound its body needs: the help adds the bound
-- to the ones the where clause writes, with `+`, every one of them (not
-- those a supertrait brings), or writes a where clause when there is none.
trait Loud {
  fn loud(self) -> String
}

trait Quiet: Loud {
  fn quiet(self) -> String
}

fn one(x: a, y: a) -> Bool where a: Display {
  x == y
}

fn sup(x: a, y: a) -> Bool where a: Quiet {
  x == y
}

trait Conv(b) {
  fn show(self) -> String
}

trait Sub(b): Conv(b) {
  fn sub(self) -> String
}

fn mixed(x: a, y: a) -> Bool where a: Sub(Int) + Conv(String) {
  x == y
}

fn written(x: a) -> Set(a) where a: Compare + Equal {
  #[x]
}

fn none(x: a, y: a) -> Bool {
  x == y
}

fn main() {
  println(1)
}
