-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: does not implement trait 'Show2'
-- stderr-contains: the only impl is for '(_, _)'
type Pair(a) = (a, a)
trait Show2 { fn show2(self) -> String }
trait Show2 for Pair(a) where a: Display {
  fn show2(self) -> String {
    let (x, y) = self
    "{x} and {y}"
  }
}
fn describe(x: p) -> String where p: Show2 { x.show2() }
fn main() {
  let f = { n -> n + 1 }
  println(describe((1, f)))
}
