-- cmd: check
-- exit: 1
-- A call through a trait whose argument two bounds give differently is
-- ambiguous: `Sub(Int)` gives `Conv(Int)` through its supertrait, beside
-- `Conv(String)`, and two bounds of a subtrait give two too; a bound and
-- a subtrait's bound at one argument are one.
trait Conv(b) {
  fn show(self) -> String
}

trait Sub(b): Conv(b) {
  fn sub(self) -> String
}

fn mixed(x: a) -> String where a: Sub(Int), a: Conv(String) {
  Conv.show(x)
}

fn subs(x: a) -> String where a: Sub(Int), a: Sub(String) {
  Conv.show(x)
}

fn same(x: a) -> String where a: Sub(Int), a: Conv(Int) {
  Conv.show(x)
}

fn main() {
  println(1)
}
