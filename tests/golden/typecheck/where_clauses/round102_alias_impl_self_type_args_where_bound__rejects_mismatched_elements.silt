-- List(String) against the List(Int)-only alias impl is rejected at check
-- time (the run fails with a type error, citing both types).
-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: does not implement trait 'Total'
-- stderr-contains: List(String)
-- stderr-contains: List(Int)
import list
type Bytes2 = List(Int)
trait Total { fn total(self) -> Int }
trait Total for Bytes2 { fn total(self) -> Int = list.fold(self, 0, { acc, x -> acc + x }) }
fn sum_it(x: a) -> Int where a: Total { x.total() }
fn main() { println(sum_it(["a", "b"])) }
