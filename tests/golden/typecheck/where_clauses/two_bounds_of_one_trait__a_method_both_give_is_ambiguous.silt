-- cmd: check
-- exit: 1
-- Two bounds of one trait at different arguments are two bounds: a call
-- through the trait whose type does not decide the argument is
-- ambiguous (`Conv.show`), one whose result type does is not
-- (`Conv.conv` returning String); a constructor on a `type a` both give
-- is ambiguous, with the bounds help; a function that needs one of the
-- two is given it, and one that needs a third is told the two that are
-- declared.
trait Conv(b) {
  fn show(self) -> String
  fn conv(self) -> b
}

trait Make(b) {
  fn make() -> Self
}

fn shown(x: a) -> String where a: Conv(Int) + Conv(String) {
  Conv.show(x)
}

fn converted(x: a) -> String where a: Conv(Int) + Conv(String) {
  Conv.conv(x)
}

fn made(type a) -> a where a: Make(Int) + Make(String) {
  a.make()
}

fn one(x: a) -> String where a: Conv(String) {
  Conv.show(x)
}

fn passes(x: a) -> String where a: Conv(Int) + Conv(String) {
  one(x)
}

fn other(x: a) -> String where a: Conv(Bool) {
  Conv.show(x)
}

fn wrong(x: a) -> String where a: Conv(Int) + Conv(String) {
  other(x)
}

fn main() {
  println(1)
}
