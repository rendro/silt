-- An impl-level bare bound on a parameterized trait is an arity error.
trait Cast(to) { fn cast(self) -> to }
trait Use { fn use_it(self) -> Int }
trait Use for List(a) where a: Cast {
    fn use_it(self) -> Int { 0 }
}
fn main() { }
