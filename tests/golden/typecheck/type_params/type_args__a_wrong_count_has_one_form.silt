-- cmd: check
-- exit: 1
-- A type is written one way: without parentheses when it takes no type
-- arguments, with all of them when it takes some. A wrong number of
-- arguments is refused in one form, with the caret on the type. (Empty
-- parentheses are refused by the parser:
-- frontend/parser/empty_parens__behind_a_name_rejected.)
type Flat {
  v: Int,
}

type Box(a) {
  v: a,
}

fn e(x: Flat(Int)) -> Int { 0 }

fn f(x: Bytes(Int)) -> Int { 0 }

fn g(x: Box(Int, Int)) -> Int { 0 }

fn main() {
  println(1)
}
