-- A type of a builtin module given to a `type a` parameter is its
-- descriptor, as a program's type is: an enum (`time.Weekday`), an
-- opaque type (`task.Handle`), a type imported by its name.
import json
import task
import time
import time.{ Weekday }

trait Name {
  fn name() -> String
}

trait Name for time.Weekday {
  fn name() -> String {
    "weekday"
  }
}

trait Name for task.Handle(a) {
  fn name() -> String {
    "handle"
  }
}

fn n(type a) -> String where a: Name {
  a.name()
}

fn main() {
  println(n(time.Weekday))
  println(n(Weekday))
  println(n(task.Handle))
  println(json.parse("1", json.Value))
}
