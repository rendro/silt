-- cmd: check
-- exit: 0
-- A user function with `type a` forwards the descriptor to json.parse.
import json

type Todo { id: Int, title: String }

fn decode(body: String, type a) -> Result(a, JsonError) {
    json.parse(body, a)
}

fn use_it(body: String) {
    let _ = decode(body, Todo)
}

fn main() {}
