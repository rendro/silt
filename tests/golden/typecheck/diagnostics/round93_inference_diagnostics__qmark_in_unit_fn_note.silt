-- cmd: check
-- exit: 1
-- stderr-contains: ? operator can only be used inside a function that returns Result or Option
-- stderr-contains: note: the ?-ed expression is Result(Int, String), but the enclosing function returns ()
-- `?` in an unannotated fn whose body gives `()`: the function returns
-- neither a Result nor an Option, which is the `?`'s error, at the `?`.
fn parse() -> Result(Int, String) {
  Ok(1)
}

fn get() {
  let x = parse()?
  println(x)
}

fn main() {
  get()
}
