import list

fn count(xs: List(Int)) -> Int {
  let string = [1]
  string.length(string) + list.length(xs)
}

fn odd() -> Int {
  let list = [1]
  list.frobnicate(list)
}

fn main() {
  let list = {length: 3}
  println(list.length)
  println(count([1]))
  println(odd())
}
