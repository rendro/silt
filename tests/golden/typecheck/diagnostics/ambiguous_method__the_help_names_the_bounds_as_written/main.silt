-- cmd: check
-- exit: 1
-- The help of a method two bounds of a type variable give names the
-- bounds as the program writes them: a trait of another module with its
-- module (`shapes.Ar`), a prelude trait by its name (`Display`), and a
-- bound whose supertrait gives the method (`S`), not the supertrait.
-- Where one bound gives the method by two of its supertraits, those
-- are named.
import shapes

trait Ar {
  fn show(self) -> String
}

trait Br {
  fn show(self) -> String
}

trait S: Ar {
  fn other(self) -> Int
}

trait Both: Ar + Br {
  fn other(self) -> Int
}

trait Shows {
  fn display(self) -> String
}

fn of_another_module(x: a) -> String where a: shapes.Ar, a: Br {
  x.show()
}

fn of_the_prelude(x: a) -> String where a: Display, a: Shows {
  x.display()
}

fn by_a_supertrait(x: a) -> String where a: S, a: Br {
  x.show()
}

fn by_one_bound(x: a) -> String where a: Both {
  x.show()
}

fn main() {}
