-- cmd: check
-- exit: 1
-- A method that makes a value, which the bounds of a type variable
-- each give, is ambiguous called on the variable as a `type`
-- parameter; the variable is bounded already, so the help names the
-- bounds and says to call the method from a function bounded by only
-- one of them.
trait A {
  fn make() -> Self
}

trait B {
  fn make() -> Self
}

fn on_type(type a) -> a where a: A + B {
  a.make()
}

fn main() {}
