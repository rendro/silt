-- A call through a trait counts every argument it writes, the one of
-- type Self and a piped value among them.
trait Adder { fn add(self, x: Int) -> Int }
trait Adder for Int { fn add(self, x: Int) -> Int { self + x } }
fn main() {
  println(5 |> Adder.add(3, 1))
  println(Adder.add(3))
  println(5 |> Adder.add(3))
}
