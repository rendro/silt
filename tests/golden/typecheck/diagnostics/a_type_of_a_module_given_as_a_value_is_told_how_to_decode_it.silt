-- cmd: check
-- exit: 1
-- A type of a builtin module is a value, but no type argument of a
-- decoder (but json.Value): given to one, the decoder refuses it, and the
-- help says how a decoder decodes it where it decodes it at all.
import json
import time
import toml

fn main() {
  let _ = toml.parse_map("a = 1979-05-27T00:32:00", time.DateTime)
  let _ = json.parse("1", DateTime)
  let _ = json.parse("1", time.Duration)
}
