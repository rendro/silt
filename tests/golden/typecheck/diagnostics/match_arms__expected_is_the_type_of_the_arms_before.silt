-- cmd: check
-- exit: 1
-- An arm whose type differs from the arms before it is the one reported,
-- and what is expected is the function's declared result, where there
-- is one, else the type of the arms before (the `let` of `m`).
fn word(n: Int) -> String {
  match n {
    0 -> "zero"
    _ -> n
  }
}

fn checked(n: Int) -> Result(Int, String) {
  match n {
    0 -> Err("zero")
    _ -> n
  }
}

fn main() {
  let m = match 3 {
    0 -> 1
    _ -> "s"
  }
  println("{word(1)} {checked(2)} {m}")
}
