-- A function of the module hands its bounded argument on to another
-- module, which calls the module's impl: the `let` that calls the
-- wrapper is initialised after what the impl reads.
-- (Before the reach counted code outside the module, each of these
-- passed the check and stopped at run time: the `let` read was "used
-- before its top-level definition has run".)
import other
type P { n: Int }
trait other.Greet for P { fn greet(self) -> String { "p {self.n} {later}" } }
fn wrap(x: a) -> String where a: other.Greet { other.run(x) }
let v = wrap(P { n: 1 })
let later = {
  println("later")
  5
}
fn main() {
  println(v)
}
