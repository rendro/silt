-- The default `message` of the builtin trait Error calls `display`: a
-- `let` that calls it on a type of the module is initialised after what
-- the module's Display impl reads.
-- (Before the reach counted code outside the module, each of these
-- passed the check and stopped at run time: the `let` read was "used
-- before its top-level definition has run".)
type MyErr { code: Int }
trait Display for MyErr { fn display(self) -> String { "E{self.code}/{late}" } }
trait Error for MyErr { }
let m = MyErr { code: 1 }.message()
let late = {
  println("late")
  5
}
fn main() {
  println(m)
}
