-- Another module's function is bound in a block and called, and called
-- inside a closure that is called at once.
-- (Before the reach counted code outside the module, each of these
-- passed the check and stopped at run time: the `let` read was "used
-- before its top-level definition has run".)
import other
type P { n: Int }
trait other.Greet for P { fn greet(self) -> String { "p {self.n} {later}" } }
let v = {
  let h = other.greet2
  h(P { n: 1 })
}
let w = { x -> other.greet2(x) }(P { n: 2 })
let later = {
  println("later")
  5
}
fn main() {
  println(v)
  println(w)
}
