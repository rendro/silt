-- A default method of another module's trait, called on a bounded
-- variable, calls the module's impl of the trait.
-- (Before the reach counted code outside the module, each of these
-- passed the check and stopped at run time: the `let` read was "used
-- before its top-level definition has run".)
import other
type P { n: Int }
trait other.Tag for P { fn tag(self) -> String { "main.P.tag {late}" } }
fn tg(x: a) -> String where a: other.Tag { x.tagged() }
let v = tg(P { n: 1 })
let late = {
  println("late")
  5
}
fn main() {
  println(v)
}
