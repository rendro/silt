-- What a function's body spreads is part of what another module reads
-- of it: a row its signature writes and its body spreads takes no
-- declared record, one its body only passes on does.
import shapes
fn main() {
  println(shapes.keep(shapes.mk()))
  println(shapes.tag({name: "a", k: 1}))
  println(shapes.ext(shapes.mk()))
  println(shapes.tag(shapes.mk()))
  println(shapes.wrap(shapes.mk()))
}
