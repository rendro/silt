-- cmd: check
-- exit: 1
-- A field's value of the wrong type has the help of its whole value: a
-- `Result` where its Ok value is wanted is told about `?`; a list of
-- `Result`s, where a `?` on the list does not reach them, is not.
import string

type Bag { items: List(Int) }

type W { v: Int }

fn parse(s: String) -> Result(Int, String) { Ok(string.length(s)) }

fn main() {
  let b = Bag { items: [parse("1")] }
  let w = W { v: parse("1") }
  println("{b.items} {w.v}")
}
