-- cmd: check
-- exit: 1
-- stderr-contains: error[type]: type mismatch: expected Person, got {name: String, age: Int}
-- What a spread makes is an anonymous record, not the declared type.
type Person { name: String, age: Int }
fn greet(p: Person) -> String { p.name }
fn main() {
  let p = Person { name: "Bob", age: 42 }
  println(greet({...p}))
}
