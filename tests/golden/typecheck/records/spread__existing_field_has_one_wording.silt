-- A spread that writes a field its base has says so in one way,
-- wherever the base's fields are known: at the spread, or at the call
-- that gives the row a record with the field.
fn f(p) {
  let n: String = p.name
  {...p, name: 1}
}
fn g(p: {name: String, ...r}) -> {name: Int, ...r} { {...p, name: 1} }
fn ext(p) { {...p, age: 30} }
fn main() {
  println(ext({age: 1}))
  let mk = { n -> {age: n} }
  println({ x -> ext(mk(x)) }("old"))
}
