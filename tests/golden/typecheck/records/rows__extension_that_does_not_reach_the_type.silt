-- A function that extends a record owes that the record it is given
-- has no such field, whether or not what it makes reaches its type:
-- for a row it infers, for a row its signature writes, and through a
-- function that passes its parameter on.
fn f(p) {
  let x = {...p, age: 1}
  x.age + 1
}
fn g(p: {name: String, ...r}) -> Int {
  let x = {...p, age: 1}
  x.age + 1
}
fn wrap(p) { g(p) }
fn outer(p: {name: String, ...q}) -> Int { g(p) }
fn pass(p: {name: String, ...r}) -> {name: String, ...r} { p }
fn main() {
  println(f({name: "a"}))
  println(g({name: "a"}))
  println(wrap({name: "a", k: 1}))
  println(pass({name: "a", age: 1}).age)
  println(f({name: "a", age: "old"}))
  println(g({name: "a", age: "old"}))
  println(wrap({name: "a", age: "old"}))
  println(outer({name: "a", age: "old"}))
}
