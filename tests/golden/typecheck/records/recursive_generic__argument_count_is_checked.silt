-- A generic record named in a field before its own declaration ends,
-- by itself or by a record declared later, takes exactly its
-- parameters.
-- cmd: check
-- exit: 1
-- stderr-contains: `Tree` takes 1 type argument here: write `Tree(a)`
-- stderr-contains: `Box` takes 2 type arguments here: write `Box(a, b)`
type Tree(a) { val: a, kids: List(Tree(a, a)) }
type Leaf(a) { kids: List(Box(a)) }
type Box(a, b) { v: a, w: b }

fn main() {
  println(1)
}
