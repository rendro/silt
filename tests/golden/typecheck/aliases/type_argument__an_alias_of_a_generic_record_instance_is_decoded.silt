-- An alias that gives a generic record its arguments names one instance
-- of it, which a decoder decodes as it does `Box(Int)`: each field as
-- the declaration writes it, with `Int` for `a`.
import json

type Box(a) {
  v: a,
}

type IntBox = Box(Int)

fn main() {
  match json.parse("""{"v": 3}""", IntBox) {
    Ok(b) -> println(b.v)
    Err(e) -> println(e)
  }
  println(json.parse("""{"v": "3"}""", IntBox))
}
