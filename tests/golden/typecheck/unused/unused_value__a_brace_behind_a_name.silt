-- cmd: check
-- exit: 1
-- verdict: same
-- `point { x }` with a lower-case name is two statements: the name,
-- and a block that nothing uses. The help names the likely mistake.
type Point {
  x: Int,
  y: Int,
}

fn main() {
  let point = Point { x: 0, y: 0 }
  let x = 1
  let p = point { x }
  println(p.x)
}
