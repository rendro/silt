-- cmd: check
-- exit: 1
-- verdict: same
-- A Result left unused hides the error it may hold: the message says
-- what to do with it. `?` hands the error on; a Result that `?` leaves
-- behind as an Int is an unused Int.
import int
import int.{ ParseError }
import io
import io.{ IoError }

fn save(path: String) -> Result((), IoError) {
  io.write_file(path, "a")
  io.write_file(path, "b")?
  Ok(())
}

fn total(a: String) -> Result(Int, ParseError) {
  int.parse(a)?
  int.parse(a)
}

fn main() {
  let _ = save("/nonexistent-dir/x.txt")
  let _ = total("1")
}
