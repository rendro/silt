-- The body of an impl's method and of a trait's default method.
trait Describe {
  fn name(self) -> String
  fn twice(self) -> String {
    Describe.name(self)
    "{Describe.name(self)} {Describe.name(self)}"
  }
}

trait Describe for Int {
  fn name(self) -> String {
    self + 1
    "int"
  }
}

fn main() {
  println(Describe.twice(3))
}
