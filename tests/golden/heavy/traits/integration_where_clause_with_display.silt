import io
type Shape { Circle(Float), Rect(Float, Float) }

trait Display for Shape {
  fn display(self) -> String {
    match self {
      Circle(r) -> "Circle({r})"
      Rect(w, h) -> "Rect({w}, {h})"
    }
  }
}

fn show(x: a) where a: Display {
  x.display()
}

fn program() {
  let s = Circle(3.14)
  show(s)
}

fn main() {
  println(io.inspect(program()))
}
