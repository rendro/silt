-- Pattern has ordinary (unnamed) capture groups but no `(?P<name>..)`.
-- The contract: return None rather than Some(empty map).
import io
import regex
fn program() {
  match regex.compile("(\\w+)@(\\w+)") {
    Ok(re) -> regex.captures_named("user@host", re)
    Err(_) -> None
  }
}

fn main() {
  println(io.inspect(program()))
}
