-- exit: 1
-- stderr-contains: loop has 1 binding, but `loop(...)` supplies 2 arguments
-- Lock the full production phrase so that any generic error
-- containing the word "argument" cannot satisfy the assertion.
fn main() {
  loop x = 0 {
    match x > 5 {
      true -> x
      _ -> loop(x + 1, 99)
    }
  }
}
