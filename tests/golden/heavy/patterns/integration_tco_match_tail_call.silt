-- Tail call inside match arm — should use constant stack space.
-- frame-budget: 1
-- 200_000 levels are far more than a frame budget of 1 MiB holds, proving
-- TCO is active.
import io
fn count_down(n, acc) {
  match n {
    0 -> acc
    _ -> count_down(n - 1, acc + 1)
  }
}
fn program() {
  count_down(200000, 0)
}

fn main() {
  println(io.inspect(program()))
}
