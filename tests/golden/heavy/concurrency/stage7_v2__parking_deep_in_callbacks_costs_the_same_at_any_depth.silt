-- timeout: 120
-- A task that parks deep inside functions that builtins call goes on
-- where it was: the cost of a park does not grow with the depth. 2,000
-- parks take about as long 900 calls deep as they do at the top (they
-- took several times as long when every park unwound and rebuilt the
-- calls in progress).
import channel
import int
import list
import task
import time

fn echo(asks, answers) {
  channel.each(asks) { n -> channel.send(answers, n) }
}

fn parks(count, asks, answers) {
  loop i = 0 {
    match i >= count {
      true -> i
      false -> {
        channel.send(asks, i)
        let _ = channel.receive(answers)
        loop(i + 1)
      }
    }
  }
}

fn at_depth(n, asks, answers) {
  match n {
    0 -> parks(2000, asks, answers)
    _ -> list.fold([n], 0) { acc, x -> acc + at_depth(x - 1, asks, answers) }
  }
}

fn timed(n) {
  let asks = channel.new(0)
  let answers = channel.new(0)
  let server = task.spawn({ -> echo(asks, answers) })
  let started = time.now()
  let parked = task.join(task.spawn({ -> at_depth(n, asks, answers) }))
  let took = time.now().epoch_ns - started.epoch_ns
  channel.close(asks)
  task.join(server)
  match parked == 2000 {
    true -> took
    false -> panic("parked {parked} times")
  }
}

fn best(n) {
  list.fold(1..4, timed(n)) { least, _ -> int.min(least, timed(n)) }
}

fn main() {
  let top = best(0)
  let deep = best(900)
  println(match deep < top * 3 {
    true -> "as fast 900 calls deep as at the top"
    false -> "at the top: {top / 1000000} ms, 900 calls deep: {deep / 1000000} ms"
  })
}
