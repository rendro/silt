-- repeat: 3
import io
import channel
fn program() {
  let ch = channel.new(10)
  channel.send(ch, 1)
  channel.close(ch)
  when let Some(a) = channel.receive(ch) else { panic("pattern did not match") }
  let b = channel.receive(ch)
  match b {
    None -> a
    Some(_) -> -1
  }
}

fn main() {
  println(io.inspect(program()))
}
