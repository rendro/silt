-- repeat: 3
-- Select across multiple empty channels plus a timeout — timeout should win.
import io
import channel
fn program() {
  let ch1 = channel.new(1)
  let ch2 = channel.new(1)
  let ch3 = channel.new(1)
  let timer = channel.timeout(50)

  match channel.select([channel.Recv(ch1), channel.Recv(ch2), channel.Recv(ch3), channel.Recv(timer)]) {
    (_, channel.Closed) -> "timeout_won"
    (_, channel.Message(_)) -> "got_data"
    _ -> "other"
  }
}

fn main() {
  println(io.inspect(program()))
}
