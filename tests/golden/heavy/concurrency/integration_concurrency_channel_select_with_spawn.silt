-- repeat: 3
import io
import channel
import task
fn program() {
  let ch1 = channel.new(10)
  let ch2 = channel.new(10)

  let p = task.spawn(fn() {
    channel.send(ch1, "first")
  })
  task.join(p)

  match channel.select([Recv(ch1), Recv(ch2)]) {
    (^ch1, Message(msg)) -> msg
    (^ch2, Message(msg)) -> msg
    _ -> "none"
  }
}

fn main() {
  println(io.inspect(program()))
}
