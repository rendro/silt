-- repeat: 3
-- 20 tasks all sending through a rendezvous channel — every message must arrive.

import channel
import io
import list
import task

fn program() {
  let ch = channel.new(0)

  -- 20 senders
  let senders = loop i = 0, acc = [] {
    match i >= 20 {
      true -> acc
      _ -> {
        let s = { -> channel.send(ch, i) }
        loop(i + 1, list.append(acc, s))
      }
    }
  }

  -- Receive all 20 messages and sum them, while every sender runs
  let total = task.background(senders) { ->
    loop i = 0, acc = 0 {
      match i >= 20 {
        true -> acc
        _ -> {
          when let Some(val) = channel.receive(ch) else {
            panic("pattern did not match")
          }
          loop(i + 1, acc + val)
        }
      }
    }
  }

  -- Sum of 0..19 = 190
  total
}

fn main() {
  println(io.inspect(program()))
}
