-- repeat: 3
import io
import channel
import task
fn program() {
  let ch = channel.new(10)

  let producer = task.spawn(fn() {
    channel.send(ch, "hello")
    channel.send(ch, "world")
  })

  task.join(producer)
  when let Message(msg1) = channel.receive(ch) else { panic("pattern did not match") }
  when let Message(msg2) = channel.receive(ch) else { panic("pattern did not match") }
  "{msg1} {msg2}"
}

fn main() {
  println(io.inspect(program()))
}
