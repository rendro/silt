-- repeat: 3
-- A scheduled task blocks on receive, gets woken by a send from another task.

import channel
import io
import task

fn program() {
  let ch = channel.new(1)

  -- The producer sends while the consumer, the body, waits for it.
  let producer = { -> channel.send(ch, 21) }
  task.background([producer]) { ->
    when let Some(val) = channel.receive(ch) else {
      panic("pattern did not match")
    }
    val * 2
  }
}

fn main() {
  println(io.inspect(program()))
}
