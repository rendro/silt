-- repeat: 3
-- Producer sends N items through buffered channel; consumer processes all.
-- 1+2+...+10 = 55

import channel
import io
import task

fn program() {
  let ch = channel.new(10)

  let producer = { ->
    let step = { i ->
      match i > 10 {
        true -> return channel.close(ch)
        _ -> {
          channel.send(ch, i)
          step(i + 1)
        }
      }
    }
    step(1)
  }

  task.background([producer]) { ->
    let go = { total ->
      match channel.receive(ch) {
        Some(val) -> go(total + val)
        None -> total
      }
    }
    go(0)
  }
}

fn main() {
  println(io.inspect(program()))
}
