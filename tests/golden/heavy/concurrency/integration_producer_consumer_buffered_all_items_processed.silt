-- repeat: 3
-- Producer sends N items through buffered channel; consumer processes all.
-- 1+2+...+10 = 55

import channel
import io
import task

fn program() {
  let ch = channel.new(10)

  let producer = { ->
    loop i = 1 {
      match i > 10 {
        true -> channel.close(ch)
        _ -> {
          channel.send(ch, i)
          loop(i + 1)
        }
      }
    }
  }

  task.background([producer]) { ->
    loop total = 0 {
      match channel.receive(ch) {
        Some(val) -> loop(total + val)
        None -> total
      }
    }
  }
}

fn main() {
  println(io.inspect(program()))
}
