-- repeat: 3
-- Messages through a rendezvous channel maintain FIFO order
-- when there is exactly one sender and one receiver.
-- We receive a known count to avoid close/receive race.

import channel
import io
import list
import task

fn program() {
  let ch = channel.new(0)

  let producer = { ->
    channel.send(ch, 1)
    channel.send(ch, 2)
    channel.send(ch, 3)
    channel.send(ch, 4)
    channel.send(ch, 5)
  }

  task.background([producer]) { ->
    let go = { i, acc ->
      match i >= 5 {
        true -> acc
        _ -> {
          when let Some(val) = channel.receive(ch) else {
            panic("pattern did not match")
          }
          go(i + 1, list.append(acc, val))
        }
      }
    }
    go(0, [])
  }
}

fn main() {
  println(io.inspect(program()))
}
