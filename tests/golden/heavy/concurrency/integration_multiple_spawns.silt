-- repeat: 3

import channel
import io
import task

fn program() {
  let ch = channel.new(10)

  let h1 = { -> channel.send(ch, 1) }

  let h2 = { -> channel.send(ch, 2) }

  let h3 = { -> channel.send(ch, 3) }

  task.join([h1, h2, h3])

  when let Some(a) = channel.receive(ch) else {
    panic("pattern did not match")
  }
  when let Some(b) = channel.receive(ch) else {
    panic("pattern did not match")
  }
  when let Some(c) = channel.receive(ch) else {
    panic("pattern did not match")
  }
  a + b + c
}

fn main() {
  println(io.inspect(program()))
}
