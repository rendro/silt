-- repeat: 3
-- A chain of producer -> transformer -> consumer should complete without deadlock.
-- (10*2) + (20*2) = 60

import channel
import io
import task

fn program() {
  let input = channel.new(5)
  let output = channel.new(5)

  let producer = { ->
    channel.send(input, 10)
    channel.send(input, 20)
    channel.close(input)
  }

  let transformer = { ->
    when let Some(a) = channel.receive(input) else {
      panic("pattern did not match")
    }
    channel.send(output, a * 2)
    when let Some(b) = channel.receive(input) else {
      panic("pattern did not match")
    }
    channel.send(output, b * 2)
    channel.close(output)
  }

  task.background([producer, transformer]) { ->
    when let Some(x) = channel.receive(output) else {
      panic("pattern did not match")
    }
    when let Some(y) = channel.receive(output) else {
      panic("pattern did not match")
    }
    x + y
  }
}

fn main() {
  println(io.inspect(program()))
}
