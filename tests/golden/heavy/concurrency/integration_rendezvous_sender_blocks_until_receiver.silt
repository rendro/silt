-- repeat: 3
-- Sender on rendezvous channel must block until receiver is ready.
import io
import channel
import task
fn program() {
  let ch = channel.new()

  let _ = task.spawn({ ->
    channel.send(ch, 42)
  })

  when let channel.Message(val) = channel.receive(ch) else { panic("pattern did not match") }
  val
}

fn main() {
  println(io.inspect(program()))
}
