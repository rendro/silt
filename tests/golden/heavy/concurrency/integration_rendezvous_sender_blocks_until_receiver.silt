-- repeat: 3
-- Sender on rendezvous channel must block until receiver is ready.

import channel
import io
import task

fn program() {
  let ch = channel.new(0)

  let sender = { -> channel.send(ch, 42) }

  task.background([sender]) { ->
    when let Some(val) = channel.receive(ch) else {
      panic("pattern did not match")
    }
    val
  }
}

fn main() {
  println(io.inspect(program()))
}
