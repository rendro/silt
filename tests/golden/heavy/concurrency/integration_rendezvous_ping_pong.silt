-- repeat: 3
-- Two tasks alternate send/receive on two rendezvous channels.
-- 1 -> +1 = 2 -> +1 = 3 -> +1 = 4
import io
import channel
import task
fn program() {
  let ping = channel.new()
  let pong = channel.new()

  let t1 = task.spawn({ ->
    -- Send ping, wait for pong, repeat
    channel.send(ping, 1)
    when let channel.Message(v1) = channel.receive(pong) else { panic("pattern did not match") }
    channel.send(ping, v1 + 1)
    when let channel.Message(v2) = channel.receive(pong) else { panic("pattern did not match") }
    v2
  })

  let t2 = task.spawn({ ->
    -- Receive ping, send pong, repeat
    when let channel.Message(v1) = channel.receive(ping) else { panic("pattern did not match") }
    channel.send(pong, v1 + 1)
    when let channel.Message(v2) = channel.receive(ping) else { panic("pattern did not match") }
    channel.send(pong, v2 + 1)
  })

  task.join(t2)
  task.join(t1)
}

fn main() {
  println(io.inspect(program()))
}
