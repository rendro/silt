-- repeat: 3
import io
import channel
fn program() {
  let ch1 = channel.new(10)
  let ch2 = channel.new(10)

  channel.send(ch2, "from ch2")

  match channel.select([channel.Recv(ch1), channel.Recv(ch2)]) {
    channel.Received(^ch1, Some(msg)) -> "got from ch1"
    channel.Received(^ch2, Some(msg)) -> msg
    _ -> "none"
  }
}

fn main() {
  println(io.inspect(program()))
}
