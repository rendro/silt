-- repeat: 3
-- Normal programs with tasks that complete cleanly should not trigger deadlock.

import channel
import io
import task

fn program() {
  let ch = channel.new(5)

  let producer = { ->
    channel.send(ch, 1)
    channel.send(ch, 2)
    channel.send(ch, 3)
    channel.close(ch)
  }

  task.background([producer]) { ->
    let total = 0
    when let Some(a) = channel.receive(ch) else {
      panic("pattern did not match")
    }
    when let Some(b) = channel.receive(ch) else {
      panic("pattern did not match")
    }
    when let Some(c) = channel.receive(ch) else {
      panic("pattern did not match")
    }
    a + b + c
  }
}

fn main() {
  println(io.inspect(program()))
}
