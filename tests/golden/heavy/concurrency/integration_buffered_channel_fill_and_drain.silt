-- repeat: 3
-- Fill a buffered channel to capacity, then drain it completely.
import io
import channel
fn program() {
  let ch = channel.new(5)

  -- Fill to capacity
  channel.send(ch, 1)
  channel.send(ch, 2)
  channel.send(ch, 3)
  channel.send(ch, 4)
  channel.send(ch, 5)

  -- Drain all
  when let Message(a) = channel.receive(ch) else { panic("pattern did not match") }
  when let Message(b) = channel.receive(ch) else { panic("pattern did not match") }
  when let Message(c) = channel.receive(ch) else { panic("pattern did not match") }
  when let Message(d) = channel.receive(ch) else { panic("pattern did not match") }
  when let Message(e) = channel.receive(ch) else { panic("pattern did not match") }

  a + b + c + d + e
}

fn main() {
  println(io.inspect(program()))
}
