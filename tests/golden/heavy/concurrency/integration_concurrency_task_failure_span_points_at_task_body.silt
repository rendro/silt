-- repeat: 3
-- stderr-contains: division
-- stderr-contains: --> integration_concurrency_task_failure_span_points_at_task_body.silt:15:
-- stderr-not-contains: --> integration_concurrency_task_failure_span_points_at_task_body.silt:18:
-- Regression test for commit d9dd98b: a piece's failure points at the
-- failing instruction inside the closure (line 15, the division by
-- zero), not at the `task.join` site in the parent (line 18), which the
-- call stack lists below the closure.
import task

fn main() {
  let h = { ->
    let y = 10
    let x = y / 0
    let _ = x
  }
  task.join([h])
}
