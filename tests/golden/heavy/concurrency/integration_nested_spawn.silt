-- repeat: 3
-- Task that runs tasks that run tasks.
import io
import task

-- The value of `f`, called in a task of its own.
fn in_a_task(f: Fn() -> Int) -> Int {
  when let [v] = task.map([f], 1) { g -> g() } else {
    panic("one value")
  }
  v
}

fn program() {
  in_a_task { ->
    let inner = in_a_task { ->
      let innermost = in_a_task { -> 42 }
      innermost + 1
    }
    inner + 1
  }
}

fn main() {
  println(io.inspect(program()))
}
