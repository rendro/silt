-- repeat: 3
-- Rendezvous: sender blocks until receiver is ready.
-- The body receives while the helper sends.

import channel
import io
import task

fn program() {
  let ch = channel.new(0)

  let producer = { -> channel.send(ch, 99) }

  task.background([producer]) { ->
    when let Some(val) = channel.receive(ch) else {
      panic("pattern did not match")
    }
    val
  }
}

fn main() {
  println(io.inspect(program()))
}
