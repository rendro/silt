-- repeat: 3
-- When each worker does a single receive, all workers should get
-- a message (not just the first worker).
-- 10*2 + 20*2 + 30*2 = 20 + 40 + 60 = 120

import channel
import io
import task

fn program() {
  let jobs = channel.new(10)
  let results = channel.new(10)

  channel.send(jobs, 10)
  channel.send(jobs, 20)
  channel.send(jobs, 30)

  let w1 = { ->
    when let Some(n) = channel.receive(jobs) else {
      panic("pattern did not match")
    }
    channel.send(results, n * 2)
  }

  let w2 = { ->
    when let Some(n) = channel.receive(jobs) else {
      panic("pattern did not match")
    }
    channel.send(results, n * 2)
  }

  let w3 = { ->
    when let Some(n) = channel.receive(jobs) else {
      panic("pattern did not match")
    }
    channel.send(results, n * 2)
  }

  task.join([w1, w2, w3])

  when let Some(a) = channel.receive(results) else {
    panic("pattern did not match")
  }
  when let Some(b) = channel.receive(results) else {
    panic("pattern did not match")
  }
  when let Some(c) = channel.receive(results) else {
    panic("pattern did not match")
  }
  a + b + c
}

fn main() {
  println(io.inspect(program()))
}
