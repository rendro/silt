-- repeat: 3
-- channel.timeout should close after the specified duration
import io
import channel
import time
fn program() {
  let timer = channel.timeout(time.ms(50))
  let result = channel.receive(timer)
  match result {
    None -> "timed_out"
    Some(_) -> "unexpected"
  }
}

fn main() {
  println(io.inspect(program()))
}
