-- repeat: 3
-- exit: 1
-- stderr-contains: error[runtime]: send on closed channel 0
-- A select with a Send arm on a closed channel is the error of a send
-- on it.
import channel
fn main() {
  let ch = channel.new(1)
  channel.close(ch)
  match channel.select([channel.Send(ch, 42)]) {
    (_, channel.Sent) -> println("sent")
    _ -> println("other")
  }
}
