-- repeat: 3
-- When multiple channels have data, select picks one (non-deterministic but valid).
import io
import channel
fn program() {
  let ch1 = channel.new(1)
  let ch2 = channel.new(1)
  let ch3 = channel.new(1)

  channel.send(ch1, 10)
  channel.send(ch2, 20)
  channel.send(ch3, 30)

  -- Select should pick one of the three
  match channel.select([channel.Recv(ch1), channel.Recv(ch2), channel.Recv(ch3)]) {
    channel.Received(_, Some(val)) -> val > 0
    _ -> false
  }
}

fn main() {
  println(io.inspect(program()))
}
