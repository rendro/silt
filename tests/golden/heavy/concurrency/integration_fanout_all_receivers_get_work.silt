-- repeat: 3
-- One sender, multiple receivers — verify all receivers participate.
-- (1+2+...+9) * 10 = 45 * 10 = 450

import channel
import io
import task

fn program() {
  let jobs = channel.new(20)
  let results = channel.new(20)

  -- Send 9 jobs
  let step = { i ->
    match i > 9 {
      true -> return channel.close(jobs)
      _ -> {
        channel.send(jobs, i)
        step(i + 1)
      }
    }
  }
  step(1)

  -- Spawn 3 workers
  let w1 = { -> channel.each(jobs) { n -> channel.send(results, n * 10) } }
  let w2 = { -> channel.each(jobs) { n -> channel.send(results, n * 10) } }
  let w3 = { -> channel.each(jobs) { n -> channel.send(results, n * 10) } }

  task.join([w1, w2, w3])

  -- Collect all results and sum
  let go = { i, total ->
    match i >= 9 {
      true -> total
      _ -> {
        when let Some(v) = channel.receive(results) else {
          panic("pattern did not match")
        }
        go(i + 1, total + v)
      }
    }
  }
  go(0, 0)
}

fn main() {
  println(io.inspect(program()))
}
