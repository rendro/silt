-- repeat: 3
-- Multiple senders on a rendezvous channel, one receiver collects all.

import channel
import io
import task

fn program() {
  let ch = channel.new(0)

  let s1 = { -> channel.send(ch, 10) }
  let s2 = { -> channel.send(ch, 20) }
  let s3 = { -> channel.send(ch, 30) }

  -- Receive all three messages
  task.background([s1, s2, s3]) { ->
    when let Some(a) = channel.receive(ch) else {
      panic("pattern did not match")
    }
    when let Some(b) = channel.receive(ch) else {
      panic("pattern did not match")
    }
    when let Some(c) = channel.receive(ch) else {
      panic("pattern did not match")
    }

    -- Sum should be 60 regardless of order
    a + b + c
  }
}

fn main() {
  println(io.inspect(program()))
}
