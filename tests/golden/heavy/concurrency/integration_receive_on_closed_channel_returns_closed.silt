-- repeat: 3
-- Receiving on a closed empty channel should return None.
import io
import channel
fn program() {
  let ch = channel.new(5)
  channel.close(ch)
  match channel.receive(ch) {
    None -> "got_closed"
    Some(_) -> "unexpected_message"
  }
}

fn main() {
  println(io.inspect(program()))
}
