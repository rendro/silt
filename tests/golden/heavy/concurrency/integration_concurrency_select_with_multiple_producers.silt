-- repeat: 3
-- Multiple producers on different channels, select should pick up messages.

import channel
import io
import task

fn program() {
  let ch1 = channel.new(10)
  let ch2 = channel.new(10)
  let ch3 = channel.new(10)

  let p1 = { -> channel.send(ch1, 1) }
  let p2 = { -> channel.send(ch2, 2) }
  let p3 = { -> channel.send(ch3, 3) }

  task.join([p1, p2, p3])

  -- Select three times to collect all messages
  loop i = 0, total = 0 {
    match i >= 3 {
      true -> total
      _ -> match channel.select([channel.Recv(ch1), channel.Recv(ch2), channel.Recv(ch3)]) {
        channel.Received(_, Some(val)) -> loop(i + 1, total + val)
        _ -> total
      }
    }
  }
}

fn main() {
  println(io.inspect(program()))
}
