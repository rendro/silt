-- repeat: 20
-- When several workers use channel.each on the same channel, a message
-- goes to a worker that is free, not always to the first one.
--
-- Each worker holds on to its job until the program opens the gate, so
-- a worker that has a job cannot take the next: the first three jobs
-- go to three different workers, whatever the scheduling. The other
-- three are sent once the gate is open.
-- Count messages per worker (100-series = w1, 200-series = w2, 300-series = w3)
import io
import channel
import list
import set
import task
fn program() {
  let jobs = channel.new(1)
  let results = channel.new(32)
  let gate = channel.new(0)

  let w1 = task.spawn({ ->
    channel.each(jobs) { n ->
      let _ = channel.receive(gate)
      channel.send(results, 100 + n)
    }
  })

  let w2 = task.spawn({ ->
    channel.each(jobs) { n ->
      let _ = channel.receive(gate)
      channel.send(results, 200 + n)
    }
  })

  let w3 = task.spawn({ ->
    channel.each(jobs) { n ->
      let _ = channel.receive(gate)
      channel.send(results, 300 + n)
    }
  })

  channel.send(jobs, 1)
  channel.send(jobs, 2)
  channel.send(jobs, 3)
  -- The buffer holds one job; a fourth send returns only when a worker
  -- has taken the third. Then every worker has a job.
  channel.send(jobs, 4)
  channel.close(gate)
  channel.send(jobs, 5)
  channel.send(jobs, 6)
  channel.close(jobs)

  task.join(w1)
  task.join(w2)
  task.join(w3)

  -- Collect all results into a list
  when let channel.Message(a) = channel.receive(results) else { panic("expected a result") }
  when let channel.Message(b) = channel.receive(results) else { panic("expected a result") }
  when let channel.Message(c) = channel.receive(results) else { panic("expected a result") }
  when let channel.Message(d) = channel.receive(results) else { panic("expected a result") }
  when let channel.Message(e) = channel.receive(results) else { panic("expected a result") }
  when let channel.Message(f) = channel.receive(results) else { panic("expected a result") }

  let values = [a, b, c, d, e, f]
  -- Results are tagged by worker: 1xx from w1, 2xx from w2, 3xx from w3.
  -- Fan-out means more than one worker took a job.
  let active_workers = values |> list.map { v -> v / 100 } |> set.from_list |> set.length
  (list.length(values), active_workers)
}

fn main() {
  println(io.inspect(program()))
}
