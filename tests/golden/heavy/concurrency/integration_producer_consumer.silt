-- repeat: 3
import channel
import task
fn main() {
  let ch = channel.new(10)

  let producer = task.spawn({ ->
    channel.send(ch, "hello")
    channel.send(ch, "world")
  })

  let consumer = task.spawn({ ->
    when let channel.Message(msg1) = channel.receive(ch) else { panic("pattern did not match") }
    when let channel.Message(msg2) = channel.receive(ch) else { panic("pattern did not match") }
    println("{msg1} {msg2}")
  })

  task.join(producer)
  task.join(consumer)
}
