-- repeat: 3
-- select with a timeout channel — timeout should fire when no data arrives
import io
import channel
import time
fn program() {
  let ch = channel.new(1)
  let timer = channel.timeout(time.ms(50))

  match channel.select([channel.Recv(ch), channel.Recv(timer)]) {
    channel.Received(_, None) -> "timeout"
    channel.Received(_, Some(_)) -> "data"
    _ -> "other"
  }
}

fn main() {
  println(io.inspect(program()))
}
