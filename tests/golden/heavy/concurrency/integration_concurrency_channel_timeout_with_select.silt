-- repeat: 3
-- select with a timeout channel — timeout should fire when no data arrives
import io
import channel
fn program() {
  let ch = channel.new(1)
  let timer = channel.timeout(50)

  match channel.select([Recv(ch), Recv(timer)]) {
    (_, Closed) -> "timeout"
    (_, Message(_)) -> "data"
    _ -> "other"
  }
}

fn main() {
  println(io.inspect(program()))
}
