-- repeat: 3
-- If data arrives before timeout, select should return the data
import io
import channel
import task
fn program() {
  let ch = channel.new(1)
  let timer = channel.timeout(5000)

  channel.send(ch, "fast")

  match channel.select([channel.Recv(ch), channel.Recv(timer)]) {
    (_, channel.Message(val)) -> val
    (_, channel.Closed) -> "timeout"
    _ -> "other"
  }
}

fn main() {
  println(io.inspect(program()))
}
