-- repeat: 3
-- Verify channel.each with multiple consumers processes all items.
-- 1 + 2 + 3 + 4 = 10
import io
import channel
import task
fn program() {
  let jobs = channel.new(10)
  let results = channel.new(10)

  channel.send(jobs, 1)
  channel.send(jobs, 2)
  channel.send(jobs, 3)
  channel.send(jobs, 4)
  channel.close(jobs)

  let w1 = task.spawn({ ->
    channel.each(jobs) { n ->
      channel.send(results, n + 100)
    }
  })
  let w2 = task.spawn({ ->
    channel.each(jobs) { n ->
      channel.send(results, n + 200)
    }
  })

  task.join(w1)
  task.join(w2)

  -- Collect 4 results
  when let Message(a) = channel.receive(results) else { panic("pattern did not match") }
  when let Message(b) = channel.receive(results) else { panic("pattern did not match") }
  when let Message(c) = channel.receive(results) else { panic("pattern did not match") }
  when let Message(d) = channel.receive(results) else { panic("pattern did not match") }

  -- Each original value is processed exactly once.
  -- Strip the worker prefix and sum the base values.
  let base_a = match a > 200 { true -> a - 200  _ -> a - 100 }
  let base_b = match b > 200 { true -> b - 200  _ -> b - 100 }
  let base_c = match c > 200 { true -> c - 200  _ -> c - 100 }
  let base_d = match d > 200 { true -> d - 200  _ -> d - 100 }
  base_a + base_b + base_c + base_d
}

fn main() {
  println(io.inspect(program()))
}
