-- repeat: 3
-- 100 tasks all sending through a single channel to verify M:N scheduling.
-- Sum of 0..99 = 4950

import channel
import io
import list
import task

fn program() {
  let ch = channel.new(200)

  let senders = loop i = 0, acc = [] {
    match i >= 100 {
      true -> acc
      _ -> {
        let s = { -> channel.send(ch, i) }
        loop(i + 1, list.append(acc, s))
      }
    }
  }

  -- Run all of them
  task.join(senders)

  -- Drain all messages and sum them
  loop i = 0, total = 0 {
    match i >= 100 {
      true -> total
      _ -> {
        when let Some(val) = channel.receive(ch) else {
          panic("pattern did not match")
        }
        loop(i + 1, total + val)
      }
    }
  }
}

fn main() {
  println(io.inspect(program()))
}
