-- repeat: 3
-- 100 tasks all sending through a single channel to verify M:N scheduling.
-- Sum of 0..99 = 4950

import channel
import io
import list
import task

fn program() {
  let ch = channel.new(200)

  let step = { i, acc ->
    match i >= 100 {
      true -> acc
      _ -> {
        let s = { -> channel.send(ch, i) }
        step(i + 1, list.append(acc, s))
      }
    }
  }
  let senders = step(0, [])

  -- Run all of them
  task.join(senders)

  -- Drain all messages and sum them
  let go = { i, total ->
    match i >= 100 {
      true -> total
      _ -> {
        when let Some(val) = channel.receive(ch) else {
          panic("pattern did not match")
        }
        go(i + 1, total + val)
      }
    }
  }
  go(0, 0)
}

fn main() {
  println(io.inspect(program()))
}
