-- repeat: 3
-- After close, receive on empty channel returns Closed
import io
import channel
fn program() {
  let ch = channel.new(10)
  channel.send(ch, 1)
  channel.close(ch)
  when let Message(a) = channel.receive(ch) else { panic("pattern did not match") }
  let b = channel.receive(ch)
  match b {
    Closed -> a
    _ -> -1
  }
}

fn main() {
  println(io.inspect(program()))
}
