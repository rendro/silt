import io
import time
fn program() {
  let dt = time.datetime(must_date(2024, 3, 15), must_time(14, 30, 0))
  "{dt}"
}

fn must_date(y, m, d) {
  match time.date(y, m, d) {
    Ok(date) -> date
    Err(_) -> panic("invalid date")
  }
}

fn must_time(h, m, s) {
  match time.time(h, m, s) {
    Ok(t) -> t
    Err(_) -> panic("invalid time")
  }
}

fn main() {
  println(io.inspect(program()))
}
