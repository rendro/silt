-- Jan 31 + 1 month = Feb 29 (2024 is leap year, clamped)
import io
import time
fn program() { must_date(2024, 1, 31) |> time.add_months(1) }

fn must_date(y, m, d) {
  match time.date(y, m, d) {
    Ok(date) -> date
    Err(_) -> panic("invalid date")
  }
}

fn main() {
  println(io.inspect(program()))
}
