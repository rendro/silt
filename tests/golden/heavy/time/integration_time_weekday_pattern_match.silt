import io
import time
fn program() {
  let day = must_date(2024, 1, 1) |> time.weekday
  match day {
    time.Monday -> "mon"
    time.Tuesday -> "tue"
    time.Wednesday -> "wed"
    time.Thursday -> "thu"
    time.Friday -> "fri"
    time.Saturday -> "sat"
    time.Sunday -> "sun"
  }
}

fn must_date(y, m, d) {
  match time.date(y, m, d) {
    Ok(date) -> date
    Err(_) -> panic("invalid date")
  }
}

fn main() {
  println(io.inspect(program()))
}
