-- cmd: check
-- exit: 1
-- An enum whose variant has a field no decoder exists for (here Bytes)
-- has no json decoder, so a record with a field of it, or the enum
-- itself, is refused whatever the document would hold: another
-- variant, the key left out, an empty list. And toml has no decoder for
-- an enum, so a record with an enum field is refused too.
-- (Through a `type a` parameter: the checker asks of each type a call
-- gives it what the decoder the function gives it to asks.)
import json
import toml

type Blob {
  Raw(Bytes),
  Empty,
}

type File { name: String, blob: Blob }

type Status {
  Active,
  Paused(Int),
}

type Config { status: Option(Status) }

fn from_json(text: String, type a) -> Result(a, json.JsonError) where a: json.Decode {
  json.parse(text, a)
}

fn list_of(text: String, type a) -> Result(List(a), json.JsonError) where a: json.Decode {
  json.parse_list(text, a)
}

fn from_toml(text: String, type a) -> Result(a, toml.TomlError) {
  toml.parse(text, a)
}

fn show(r: Result(a, e)) where e: Error {
  match r {
    Ok(_) -> println("ok")
    Err(e) -> println(e.message())
  }
}

fn main() {
  show(from_json("""{"name": "x", "blob": "Empty"}""", File))
  show(from_json("""{"name": "x"}""", File))
  show(list_of("[]", Blob))
  show(list_of("""["Empty"]""", Blob))
  show(from_toml("", Config))
}
