import io
import json
type Employee { name: String, salary: Int }
fn program() {
  match json.parse_list("[\{\"name\": \"Alice\", \"salary\": \"not_a_number\"\}]", Employee) {
    Ok(_) -> "unexpected"
    Err(json.TypeMismatch(expected, actual)) -> "{expected}/{actual}"
    Err(e) -> Error.message(e)
  }
}

fn main() {
  println(io.inspect(program()))
}
