import io
import json
type Employee { name: String }
fn program() {
  match json.parse_list("\{\"name\": \"Alice\"\}", Employee) {
    Ok(_) -> "unexpected"
    Err(json.JsonTypeMismatch(expected, actual)) -> "{expected}/{actual}"
    Err(e) -> e.message()
  }
}

fn main() {
  println(io.inspect(program()))
}
