import io
import json
import list
import time
type Event { name: String, date: Date }
fn program() {
  when let Ok(events) = json.parse_list("[\{\"name\": \"a\", \"date\": \"2024-01-15\"\}, \{\"name\": \"b\", \"date\": \"2024-12-25\"\}]", Event) else { panic("unexpected Err") }
  events |> list.map { e -> e.date.month }
}

fn main() {
  println(io.inspect(program()))
}
