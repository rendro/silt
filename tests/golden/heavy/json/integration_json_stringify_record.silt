-- Lock exact serialization shape, not loose substring presence.
-- A record's fields are written in the order its type declares them
-- (src/builtins/json.rs `value_to_json`), so the stable output is
-- `{"name":"Alice","age":30}` (name first).
-- The previous chain of 4 `contains` checks didn't verify that the
-- name↔value bindings were correct; e.g. `{"name":"30","age":"Alice"}`
-- would have passed all four.
import io
import json
type User { name: String, age: Int }
fn program() {
  let u = User { name: "Alice", age: 30 }
  json.stringify(u)
}

fn main() {
  println(io.inspect(program()))
}
