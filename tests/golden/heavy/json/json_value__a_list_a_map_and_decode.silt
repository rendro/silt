-- json.parse of a list or a map of json.Value, and json.decode, take
-- json.Value too, and json.decode takes the primitive types json.parse
-- takes.
import json

fn as_type(v: json.Value, type a) -> Result(a, json.JsonError) where a: json.Decode {
  json.decode(v, a)
}

fn main() {
  println(json.parse("""[1, "a", null, [true]]""", List(json.Value)))
  println(json.parse("""{"a": 1}""", List(json.Value)))
  println(json.parse("""{"x": 1, "y": [true]}""", Map(String, json.Value)))
  println(json.decode(json.Int(3), Int))
  println(json.decode(json.Float(3.5), Int))
  println(json.decode(json.String("s"), Bool))
  println(json.decode(json.Array([json.Int(1)]), json.Value))
  println(as_type(json.Float(0.5), Float))
  println(as_type(json.Null, json.Value))
}
