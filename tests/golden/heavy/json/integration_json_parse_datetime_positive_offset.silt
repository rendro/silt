import io
import json
import time
type Event { name: String, ts: time.DateTime }
fn program() {
  -- 18:00 in UTC+9 = 09:00 UTC
  when let Ok(e) = json.parse("\{\"name\": \"x\", \"ts\": \"2024-03-15T18:00:00+09:00\"\}", Event) else { panic("unexpected Err") }
  e.ts.time.hour
}

fn main() {
  println(io.inspect(program()))
}
