import io
import json
import time
type Task { name: String, due: Option(time.Date) }
fn program() {
  when let Ok(t) = json.parse("\{\"name\": \"write tests\", \"due\": \"2024-06-01\"\}", Task) else { panic("unexpected Err") }
  match t.due {
    Some(d) -> d.year
    None -> 0
  }
}

fn main() {
  println(io.inspect(program()))
}
