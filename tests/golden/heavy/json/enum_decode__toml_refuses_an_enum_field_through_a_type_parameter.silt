-- cmd: check
-- exit: 1
-- toml has no decoder for an enum: a record with an enum field given
-- through a `type a` parameter is refused at the call that gives it,
-- naming the field, as for any field without a decoder.
import toml

type Status {
  Active,
  Paused(Int),
}

type Config { status: Status }

fn read(text: String, type a) -> Result(a, toml.TomlError) {
  toml.parse(text, a)
}

fn main() {
  println(read("status = 1", Config))
}
