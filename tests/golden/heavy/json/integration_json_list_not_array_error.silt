import io
import json
type Employee { name: String }
fn program() {
  match json.parse("\{\"name\": \"Alice\"\}", List(Employee)) {
    Ok(_) -> "unexpected"
    Err(json.TypeMismatch(expected, actual, _, _, _)) -> "{expected}/{actual}"
    Err(e) -> "{e}"
  }
}

fn main() {
  println(io.inspect(program()))
}
