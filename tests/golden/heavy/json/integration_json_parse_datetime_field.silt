import io
import json
import time
type Meeting { title: String, start: time.DateTime }
fn program() {
  when let Ok(m) = json.parse("\{\"title\": \"standup\", \"start\": \"2024-03-15T09:00:00\"\}", Meeting) else { panic("unexpected Err") }
  m.start.time.hour
}

fn main() {
  println(io.inspect(program()))
}
