import io
import json
import time
type Event { name: String, ts: time.DateTime }
fn program() {
  -- 05:00 in UTC-4 = 09:00 UTC
  when let Ok(e) = json.parse("\{\"name\": \"x\", \"ts\": \"2024-03-15T05:00:00-04:00\"\}", Event) else { panic("unexpected Err") }
  e.ts.time.hour
}

fn main() {
  println(io.inspect(program()))
}
