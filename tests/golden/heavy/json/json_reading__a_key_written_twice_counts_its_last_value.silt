-- Of a key written twice in an object the last value counts, in a
-- record, a map and a json.Value alike: a bad value before a good one
-- is no error, a good one before a bad one is.
import json

type P { x: Int, y: Option(String) }

fn main() {
  println(json.parse("\{\"x\": \"bad\", \"x\": 1}", P))
  println(json.parse("\{\"x\": 1, \"x\": \"bad\"}", P))
  println(json.parse("\{\"a\": \"bad\", \"a\": 1}", Map(String, Int)))
  println(json.parse("\{\"a\": 1, \"a\": \"bad\"}", Map(String, Int)))
  println(json.parse("\{\"a\": 1, \"a\": [2]}", json.Value))
  println(json.parse("[\{\"x\": [], \"y\": \"s\", \"x\": 2}]", List(P)))
}
