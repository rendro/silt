-- Multiple levels with locals at each level; the innermost closure
-- captures from several ancestors while intermediate scopes have
-- their own locals that should not interfere.
import io
fn program() {
  let a = 1
  let f = { ->
    let b = 10
    let g = { ->
      let c = 100
      let h = { -> a + b + c }
      h()
    }
    g()
  }
  f()
}

fn main() {
  println(io.inspect(program()))
}
