-- repeat: 3
import io
import task

fn main() {
  let _ = io.write_file("a.txt", "aaa")
  let _ = io.write_file("b.txt", "bbb")
  let h1 = task.spawn({ -> io.read_file("a.txt") })
  let h2 = task.spawn({ -> io.read_file("b.txt") })
  let a = task.join(h1)
  let b = task.join(h2)
  println(io.inspect((a, b)))
}
