-- repeat: 3
-- Paths are relative: the harness runs each case in a fresh temporary copy.
import io
import list
import task

fn main() {
  let _ = io.write_file("async.txt", "hello async")
  list.each(task.map(["async.txt"], 1) { path -> io.read_file(path) }) { r ->
    println(io.inspect(r))
  }
}
