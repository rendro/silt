-- requires-feature: postgres
-- cmd: check
-- exit: 1
-- A trait method that gives its parameters to a postgres statement as
-- its connection and its parameters, called on a value of a known
-- type, asks of the types each call gives what the statement asks.
import postgres
type Repo { url: String }
trait Runner {
  fn run(self, c: a, ps: p) -> Result(Int, postgres.PostgresError)
}
trait Runner for Repo {
  fn run(self, c: a, ps: p) -> Result(Int, postgres.PostgresError) { postgres.execute(c, "SELECT 1", ps) }
}
fn main() {
  println(Repo { url: "" }.run("x", 5))
}
