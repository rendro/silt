-- cmd: check
-- requires-feature: postgres
-- exit: 1
-- stderr-contains: `postgres.query` cannot decode `List(Int)`: its type argument must be a record type, json.Value, or a type with a `json.Decode` impl
-- stderr-contains: `postgres.query` cannot decode `(Int, String)`: its type argument must be a record type, json.Value, or a type with a `json.Decode` impl
-- stderr-contains: help: declare a record type with a field for each column
-- stderr-not-contains: is not callable
-- A row type written as a type applied to types, or as a tuple of
-- types, is that type, which the postgres decoder refuses with its own
-- error and the row help.
import postgres

fn lists(db: postgres.PgPool) {
  let _ = postgres.query(db, "SELECT 1", (), List(Int))
  let _ = postgres.query(db, "SELECT 1, 'a'", (), (Int, String))
}

fn main() {
  println(1)
}
