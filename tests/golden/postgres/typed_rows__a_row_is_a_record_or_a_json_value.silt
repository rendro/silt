-- stderr-contains: `postgres.query` cannot decode `Int`: its type argument must be a record type or json.Value
-- stderr-contains: help: declare a record type with a field for each column, and decode into the record
-- A row is decoded into a record type, its fields read from the
-- columns of their names, or into a `json.Value`: not into an `Int`,
-- even for a row of one column.
import postgres

fn count(db: postgres.PgPool) -> Result(List(Int), postgres.PostgresError) {
  postgres.query(db, "SELECT count(*) FROM users", (), Int)
}

fn main() {
  println(1)
}
