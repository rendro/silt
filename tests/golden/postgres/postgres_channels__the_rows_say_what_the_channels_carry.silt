-- cmd: check
-- requires-feature: postgres
-- `postgres.stream` gives a channel of rows of the type it is given,
-- each `Ok(row)` or the error that ended the query, and
-- `postgres.listen` a channel of `Notification` records: the signatures
-- say so, and a program reads them as that.
import channel
import postgres

type Payment { id: Int, amount: Int }

fn rows(pool: postgres.PgPool) -> Int {
  match postgres.stream(pool, "SELECT id, amount FROM payments", (), Payment) {
    Ok(ch) -> {
      let typed: Channel(Result(Payment, postgres.PostgresError)) = ch
      match channel.receive(typed) {
        Some(Ok(row)) -> row.amount
        Some(Err(e)) -> {
          println(Error.message(e))
          0
        }
        _ -> 0
      }
    }
    Err(_) -> 0
  }
}

fn notes(pool: postgres.PgPool) -> String {
  match postgres.listen(pool, "jobs") {
    Ok(ch) -> match channel.receive(ch) {
      Some(note) -> "{note.channel}: {note.payload} from {note.pid}"
      None -> "closed"
    }
    Err(e) -> Error.message(e)
  }
}

fn main() {
  println(1)
}
