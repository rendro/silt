-- cmd: check
-- requires-feature: postgres
-- exit: 1
-- stderr-contains: error[type]: the parameters of `postgres.execute` must be a tuple, got `List(Int)`
-- stderr-contains: help: write (id,)
-- A list is one parameter (an array, or JSON), not the parameters of
-- the statement.
import postgres

fn drop_them(db: postgres.PgPool) -> Result(Int, postgres.PostgresError) {
  postgres.execute(db, "DELETE FROM users WHERE id = $1 OR id = $2", [1, 2])
}

fn main() {
  println(1)
}
