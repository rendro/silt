-- exit: 5
-- repeat: 3
-- main waits on a channel nobody sends on; a task's exit ends the program
-- with its code, not with a deadlock. The task is the feed of a stream,
-- which runs while main waits.
import channel
import process
import stream
import time

fn main() {
  let never = channel.new(0)
  let _exits = stream.from_fn { _ ->
    time.sleep(time.ms(20))
    process.exit(5)
  }
  let _ = channel.receive(never)
  println("never")
}
