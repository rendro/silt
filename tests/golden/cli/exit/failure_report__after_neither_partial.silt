-- exit: 1
-- The report of a failure after `println("out")` and `io.eprintln("err")`, stdout and stderr two pipes:
-- on a line of its own on stderr; stdout is left as the program wrote it.
import io
import list

fn main() {
  println("out")
  io.eprintln("err")
  let n = 1 / (list.length([1]) - 1)
  println(n)
}
