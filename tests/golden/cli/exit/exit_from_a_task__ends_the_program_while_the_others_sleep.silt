-- exit: 4
-- repeat: 3
-- A task's process.exit ends the whole program at once: main, which
-- waits in task.join, and the tasks that sleep are not waited for.
import process
import task
import time

fn main() {
  task.join(
    [
      { -> time.sleep(time.seconds(600)) },
      { -> time.sleep(time.seconds(600)) },
      { ->
        time.sleep(time.ms(20))
        print("exiting")
        process.exit(4)
      },
    ],
  )
  println("never")
}
