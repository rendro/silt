-- exit: 1
-- A failure an impl gets from elsewhere is its failure too: a task.join
-- whose piece panicked.
import task

type Joined {
  a: Int,
}

trait Display for Joined {
  fn display(self) -> String {
    task.join([{ -> panic("in a task") }])
    "joined"
  }
}

fn main() -> Result((), Joined) {
  Err(Joined { a: 1 })
}
