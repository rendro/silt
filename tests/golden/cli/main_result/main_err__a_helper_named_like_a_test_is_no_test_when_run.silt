-- A function named like a test is a test only in a test file (a name
-- ending in `_test.silt`) or a file given to `silt test`: a run holds
-- it to no rule of a test, neither its signature nor the Display of its
-- error.
fn test_connection() -> Result((), Fn(Int) -> Int) { Ok(()) }
fn main() {
  match test_connection() {
    Ok(_) -> println("fine")
    Err(_) -> println("no")
  }
}
