import string

type Long {
  s: String,
}

trait Display for Long {
  fn display(self) -> String {
    panic("{string.repeat("x", 300000)}\nsecond line")
  }
}

fn main() -> Result((), Long) {
  Err(Long { s: string.repeat("y", 300000) })
}
