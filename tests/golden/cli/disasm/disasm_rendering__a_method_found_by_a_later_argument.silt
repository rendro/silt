-- cmd: disasm
-- A call through a trait whose argument of type Self is not the first,
-- on a bounded type variable: `CallMethod` finds the method by that
-- argument, which the disassembly names.
-- stdout-contains: TailCallMethod       0     2   ; "scale" of Scale, by argument 1
trait Scale {
  fn scale(by: Int, x: Self) -> Self
}

trait Scale for Int {
  fn scale(by: Int, x: Self) -> Self {
    by * x
  }
}

fn twice(x: a) -> a where a: Scale {
  Scale.scale(2, x)
}

fn main() {
  println(twice(5))
}
