-- cmd: disasm
-- A call through a trait whose argument of type Self is not the first,
-- on a bounded type variable: `CallDict` calls the method of the
-- variable's dictionary (in the callee's slot, below the arguments)
-- and checks the receiver at that argument, which the disassembly
-- names.
-- stdout-contains: TailCallDict         0     2   ; receiver: argument 2
trait Scale {
  fn scale(by: Int, x: Self) -> Self
}

trait Scale for Int {
  fn scale(by: Int, x: Self) -> Self {
    by * x
  }
}

fn twice(x: a) -> a where a: Scale {
  Scale.scale(2, x)
}

fn main() {
  println(twice(5))
}
