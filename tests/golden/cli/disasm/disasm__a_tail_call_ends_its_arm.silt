-- cmd: disasm
-- A match arm that ends in a tail call ends there: no jump to the end
-- of the match follows it, and no second Return ends the function. A
-- tail call of the function to itself is a `Recur` to its start.
fn count(n, acc) {
  match n {
    0 -> acc
    _ -> count(n - 1, acc + 1)
  }
}

fn start(n) {
  match n {
    0 -> 0
    _ -> count(n, 0)
  }
}

fn main() {
  println(start(3))
}
