-- cmd: disasm
-- A function bounded by a trait of type constructors takes the impl's
-- dictionary as a hidden parameter, and calls the trait's methods
-- through it: one that takes the type's values (`map`) and one that
-- only makes one (`point`).
-- stdout-contains: == bump (arity=1, dictionaries=1, upvalues=0) ==
-- stdout-contains: TailCallDict         0     2
-- stdout-contains: == wrap (arity=2, dictionaries=1, upvalues=0) ==
-- stdout-contains: TailCallDict         0     1
-- stdout-contains: Constant             1     ; <dict:Functor for Box>
-- stdout-contains: Constant             5     ; <dict:Pointed for Box>
trait Functor {
  fn map(xs: Self(a), f: Fn(a) -> b) -> Self(b)
}
trait Pointed: Functor {
  fn point(x: a) -> Self(a)
}
type Box(a) { value: a }
trait Functor for Box(_) {
  fn map(xs, f) { Box { value: f(xs.value) } }
}
trait Pointed for Box(_) {
  fn point(x) { Box { value: x } }
}
fn bump(xs: m(Int)) -> m(Int) where m: Functor { Functor.map(xs) { x -> x + 1 } }
fn wrap(x: a, type m) -> m(a) where m: Pointed { m.point(x) }
fn main() {
  println(bump(Box { value: 1 }).value)
  println(wrap(2, Box).value)
}
