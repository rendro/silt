-- cmd: disasm
-- The operand rendering of the opcodes main compiles to. `q.display()`
-- on a record with no Display impl of its own is the VM's own method
-- of the trait (CallMethod).
-- (Variant construction compiles to the constructor as a constant + Call.)
-- stdout-contains: == main (arity=0, upvalues=0) ==
-- stdout-contains: RecordUpdate         1
-- stdout-contains: |  field 3     ; "x"
-- stdout-contains: CallMethod           7     1   ; "display" of Display
-- stdout-contains: CallBuiltin          1     ; string.length
-- stdout-contains: Constant             9     ; <constructor:Circle>
import string

type Point { x: Int, y: Int }

type Shape {
  Circle(Int),
  Square(Int),
}

fn main() {
  let p = Point { x: 1, y: 2 }
  let q = p.{ x: 5 }
  println(q.display())
  println(string.length("abc"))
  let s = Circle(3)
  println(s)
}
