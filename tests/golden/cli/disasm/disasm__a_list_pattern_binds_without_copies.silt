-- cmd: disasm
-- A match tests its scrutinee itself and binds from it: no copy of the
-- scrutinee for a test or for an arm, none of a list for each level of
-- its pattern, and a name of a part is the part where it was taken
-- out. A step of this walk is ten instructions: the scrutinee, two
-- tests, the rest, and the loop's arguments.
fn walk(cs: List(String)) -> Int {
  loop cs = cs, n = 0 {
    match cs {
      [] -> n
      [_, ..rest] -> loop(rest, n + 1)
    }
  }
}

fn pairs(xs: List((Int, Int))) -> Int {
  match xs {
    [(a, b), ..rest] -> a + b + pairs(rest)
    _ -> 0
  }
}

fn main() {
  println(walk(["a", "b"]) + pairs([(1, 2)]))
}
