-- cmd: fmt --test-tamper=0x10=>16
-- exit: 1
-- When `silt fmt` would write something that fails its own check, it
-- refuses: the file stays as it is, and the refusal is a diagnostic
-- with a place. (The flag makes the printer's result wrong, as a defect
-- of the printer would: it would spell the number another way.)
fn main() {
  println( 0x10 )
}
