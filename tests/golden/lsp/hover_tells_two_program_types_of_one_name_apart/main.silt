-- Two program types of one name, the file's own `Regex` and `s.Regex`:
-- the other module's is written with its module, as the messages write it.
import shapes as s

type Regex { n: Int }

fn both(mine: Regex, theirs: s.Regex) -> String { "{mine.n} {theirs.pattern}" }

fn main() {
  let mine = Regex { n: 1 }
  let theirs = s.Regex { pattern: "ab" }
  println(both(mine, theirs))
  println(s.pair(theirs))
}
