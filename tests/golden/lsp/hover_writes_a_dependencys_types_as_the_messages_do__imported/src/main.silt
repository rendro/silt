-- Hover writes a type of another module as the messages beside it do: a
-- module of the package by its name, a dependency's library by its key
-- (here imported by it), what no import can reach described.
import da
import shapes

type Pt { y: Int }

type AppError { Mine }

fn main() {
  let p = shapes.pt()
  let a = da.app()
  let u = da.util_err()
  let i = da.inner_err()
  let bad1: Int = p
  let bad2: Int = a
  let bad3: Int = u
  let bad4: Int = i
  println((Pt { y: 1 }, Mine))
}
