-- A rename edits what the name means and nothing else. A method name at
-- a call is no name of its trait (and has no rename); its definition is
-- the method. `self` is not renamed. A field written without its value
-- is written out. The binders of an or-pattern's alternatives are one
-- binding. A new name that is taken where the old one is written is
-- refused. A block ends its `let`s. `<T as Trait>::Item` names the trait.
type Box {
  w: Int,
}

trait Sized {
  fn scale(self, by: Int) -> Int {
    self.size() * by
  }
  fn size(self) -> Int
}

trait Sized for Box {
  fn size(self) -> Int {
    self.w
  }
}

type Side {
  Left(Int),
  Right(Int),
}

fn twice(x: a) -> Int where a: Sized {
  x.scale(2) + x.size()
}

fn unbox(b: Box) -> Int {
  let Box { w } = b
  w + Box { w: w }.w
}

fn either(s: Side) -> Int {
  match s {
    Left(n) | Right(n) -> n + 1
  }
}

fn scopes(n: Int) -> Int {
  let m = n + 1
  let f = { k -> k + m }
  f(n)
}

fn blocks(n: Int) -> Int {
  let r = {
    let n = n * 2
    n + 1
  }
  n + r
}

fn loops(n: Int) -> Int {
  loop n = n + 1 {
    match n > 5 {
      true -> n
      false -> loop(n + 1)
    }
  }
}

trait Container {
  type Item
  fn first(self) -> Self::Item
}

fn head(c: t) -> <t as Container>::Item where t: Container {
  c.first()
}

fn main() {
  let b = Box { w: 3 }
  println(twice(b) + unbox(b) + either(Left(1)) + scopes(1) + blocks(1) + loops(1) + b.size())
}
