-- Hover in a comment, in the space between tokens and in the text of a
-- string has nothing to describe; the code of an interpolation in a string
-- is code (`name`), and so is a name outside a string (`json`).
import json
fn main() {
  let name = "Ada" -- json.Value
  let v = json.Null
  println("hi {name} and json.Value")
  println(v)
}
