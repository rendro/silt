-- Hover on a type of the prelude in a type position shows its
-- declaration, as a builtin module's type does (see
-- `hover_on_a_builtin_module_type`): an enum one variant a line, another
-- type its name and its type parameters. No docs page has a section on
-- one of them.
import json
import channel

type Ids = List(Int)

type Row { name: String, score: Float, tags: Set(String) }

type Cell { Full(Bool), Many(Map(String, Bytes)) }

fn f(o: Option(Int), r: Result(Int, String), ch: Channel(Int), u: Unit) -> Int {
  let n: Int = 1
  let g = { x: Int -> x + n }
  g(0)
}

fn main() {
  let parsed: Result(Int, json.JsonError) = json.parse("1", Int)
  println(parsed)
  println(f(None, Ok(1), channel.new(1), ()))
}
