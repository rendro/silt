-- cmd: lsp
-- lsp: rename 10:4 sum
-- lsp: rename 20:10 m
-- lsp: references 10:4
-- lsp: highlight 10:4
-- A rename is the same program under another name, or it is refused:
-- `has_error` does not parse, so the names in it are not known, and no
-- name of the file is renamed. References and highlight answer what is
-- known (the uses in `has_error` are not among them).
fn add(a: Int, b: Int) -> Int {
  a + b
}

fn has_error(v: Int) -> Int {
  let w = add(v, 1)
  let x = 1 @ v
  add(w, x)
}

fn after(n: Int) -> Int {
  add(n, n)
}

fn main() {
  println("{add(1, 2)} {after(3)}")
}
