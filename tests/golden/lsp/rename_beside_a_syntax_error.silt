-- cmd: lsp
-- lsp: rename 17:4 sum
-- lsp: prepare-rename 17:4
-- lsp: rename 27:10 m
-- lsp: prepare-rename 27:10
-- lsp: rename 21:14 value
-- lsp: prepare-rename 21:14
-- lsp: references 17:4
-- lsp: highlight 17:4
-- A rename is the same program under another name, or it is refused:
-- `has_error` does not parse, so the names in it are not known, and no
-- function of the file is renamed. A parameter of a function that is
-- whole is used in that function only, and is renamed; the parameter
-- of `has_error` is not. prepareRename says no where rename refuses.
-- References and highlight answer what is known (the uses in
-- `has_error` are not among them).
fn add(a: Int, b: Int) -> Int {
  a + b
}

fn has_error(v: Int) -> Int {
  let w = add(v, 1)
  let x = 1 @ v
  add(w, x)
}

fn after(n: Int) -> Int {
  add(n, n)
}

fn main() {
  println("{add(1, 2)} {after(3)}")
}
