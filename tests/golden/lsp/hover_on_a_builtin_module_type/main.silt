-- Hover on the type of a builtin module after the dot shows its
-- declaration as the registry has it, written as a program names it
-- (`json.Value` inside `json.Value`), one variant or field a line, and
-- below it the section of a reference page on it: its own (`json.Value`)
-- or, for the module's error enum, the errors page's. An opaque type
-- shows its name.
-- The types of a module behind a cargo feature are in cases of their own
-- (`hover_on_a_tcp_type`, `hover_on_a_postgres_type`).
import bytes
import channel
import crypto
import url
import float
import fs
import http
import int
import io
import json
import csv
import regex
import task
import time
import toml
import uuid

fn f0(x: io.IoError) -> Int { 0 }
fn f1(x: int.IntError) -> Int { 0 }
