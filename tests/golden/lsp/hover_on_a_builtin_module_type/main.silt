fn f15(x: time.DateTime) -> Int { 0 }
fn f16(x: time.Duration) -> Int { 0 }
fn f17(x: time.Weekday) -> Int { 0 }
fn f18(x: time.TimeError) -> Int { 0 }
fn f19(x: http.Method) -> Int { 0 }
fn f20(x: http.Response) -> Int { 0 }
fn f21(x: http.Request) -> Int { 0 }
fn f22(x: http.HttpError) -> Int { 0 }
fn f23(x: fs.FileStat) -> Int { 0 }
