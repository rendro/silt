-- A constructor in a pattern shows what an expression that names it
-- shows: a variant with fields a function to the type of the value it
-- matches, one without that type, and the variant's docs; not the type
-- of the expression around the pattern. Its type definition is its
-- enum. A name the pattern binds inside it has the type of its field.
-- Builtin and program enums, qualified and bare, nested, generic, in a
-- `match`, a `let`, a `when let`, a parameter.
-- (The head of an arm's pattern keeps the scrutinee's type.)
import json
import shapes
import shapes.{ Circle }
import string

type Pair(a) { P(a, a), One(a) }

type Two(a) { T(a, a) }

type Box { B(Option(shapes.Shape)) }

fn decode(r: Result(json.Value, json.JsonError)) -> Int {
  match r {
    Err(json.Syntax(msg, at)) -> at
    Err(json.MissingField(f)) -> string.length(f)
    Err(_) -> 1
    Ok(_) -> 2
  }
}

fn nested(b: Box) -> Float {
  match b {
    B(Some(shapes.Circle(r))) -> r
    B(Some(Circle(q))) | B(Some(shapes.Shape.Square(q))) -> q
    B(Some(shapes.Dot)) -> 0.0
    B(None) -> 1.0
  }
}

fn generic(p: Option(Pair(String))) -> String {
  match p {
    Some(P(x, _)) -> x
    Some(One(y)) -> y
    None -> ""
  }
}

fn bound(t: (Two(Int), Int)) -> Int {
  let (T(a, c), _) = t
  a + c
}

fn when_let(o: Option(Pair(Float))) -> Float {
  when let Some(One(v)) = o else { return 0.0 }
  v
}

fn param(B(inner): Box) -> Int {
  match inner {
    Some(_) -> 1
    None -> 0
  }
}

fn main() {
  println(decode(Ok(json.Null)))
  println(nested(B(None)))
  println(generic(None))
  println(bound((T(1, 3), 2)))
  println(when_let(None))
  println(param(B(None)))
}
