-- cmd: lsp
-- lsp: completion 15:14
-- lsp: completion 16:23
-- After a dot on a value completion offers its fields, no method of any
-- trait; after `json.Decode.` nothing: `decode` takes no value of the
-- type, so it is called through the type (`Money.decode`).
import json

type Money {
  cents: Int,
}

fn main() {
  let m = Money { cents: 5 }
  println(m.c)
  println(json.Decode.d)
}
