-- cmd: lsp
-- lsp: hover 18:7
-- lsp: hover 19:7
-- lsp: hover 20:7
-- lsp: hover 21:7
-- lsp: hover 19:18
-- Hover writes a type of another module as the messages beside it do: a
-- module of the package by its name, a dependency's library by its key
-- (not imported here: the types come through shapes), the rest described.

import shapes

type Pt { y: Int }

type AppError { Mine }

fn main() {
  let p = shapes.pt()
  let a = shapes.app()
  let u = shapes.util_err()
  let i = shapes.inner_err()
  let bad1: Int = p
  let bad2: Int = a
  let bad3: Int = u
  let bad4: Int = i
  println((Pt { y: 1 }, Mine))
}
