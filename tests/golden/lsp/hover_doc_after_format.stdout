-- The comments directly above a declaration are its documentation, and
-- stay that after `silt fmt`: the formatter keeps them where they are,
-- and the parser reads them from the comments in front of the
-- declaration's first token.

-- Adds one to `x`.
--
--     inc(1) == 2
fn inc(x) {
  x + 1
}

{- Doubles `x`.
   Twice as much.
-}
pub fn double(x) {
  x * 2
}

fn main() {
  println(inc(double(1)))
  println(inc(1))
}
