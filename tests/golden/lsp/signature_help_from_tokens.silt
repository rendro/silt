-- The call the cursor is in is read from the tokens in front of it:
-- comments and strings hold no arguments, a call inside a string
-- interpolation is a call, and a list, a record or a closure that is
-- open inside the call is part of the argument being written. In
-- order: a comma inside a string; inside a line comment; inside a block
-- comment; behind an inner call; inside the inner call; a triple-quoted
-- string; inside a string interpolation; in its second interpolation;
-- behind a closure argument that spans lines; inside that closure;
-- inside a list argument; behind it; a builtin of a module; no call.

import list

fn add(a: Int, b: Int) -> Int {
  a + b
}

fn mul(x: Int, y: Int) -> Int {
  x * y
}

fn join(sep: String, n: Int) -> String {
  "{sep}{n}"
}

fn apply(xs: List(Int), f: Fn(Int) -> Int, n: Int) -> List(Int) {
  list.map(xs) { x -> f(x) + n }
}

fn main() {
  let a = join("hello, world", 42)
  let b = add(
    1,
    -- a, b, c (
    2,
  )
  let c = add(1, {- a, b ( -} 2)
  let d = add(mul(1, 2), 3)
  let e = join("""hello, (world""", 42)
  let f = "sum {add(1, 2)} and {mul(3, 4)}"
  let g = apply([1, 2], { x ->
    x + 1
  }, 3)
  let h = list.length([c, d])
  let k = 42
  println("{a} {b} {e} {f} {g} {h} {k}")
}
