-- Navigation reaches what a name means: the field a field access reads,
-- the module a qualifier names, the type an annotation names and the
-- module an import names (hover), the type of a binder and of a list of
-- records (typeDefinition), the modules an import may name.
import helpers
import list
import li

type P { name: String, age: Int }

fn older(p: P) -> P {
  p.{ age: p.age + 1 }
}

fn main() {
  let q = older(P { name: "a", age: 1 })
  println(q.age)
  println(helpers.div(4, 2))
  let ps = list.map([q], older)
  println(ps)
}
