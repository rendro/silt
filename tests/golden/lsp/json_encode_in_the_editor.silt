-- The editor knows `json.Encode`: a hover on it in a `where` clause, on
-- `json.stringify` and on `json.Encode.encode`, the method offered after
-- `json.Encode.`, and no definition in a file (it is json's).
import json

type Money {
  cents: Int,
}

fn send(x: a) -> String where a: json.Encode {
  json.stringify(x)
}

fn main() {
  let m = Money { cents: 5 }
  println(json.Encode.encode(m))
  println(json.Encode.enc)
  println(send(m))
}
