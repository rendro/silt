-- cmd: lsp
-- lsp: completion 13:16
-- lsp: completion 14:14
-- Without `import json` no value has the method `encode`: completion
-- after a dot does not offer it (`display` it does).
type Money {
  cents: Int,
}

fn main() {
  let m = Money { cents: 5 }
  println(m.cents)
  println(m.enc)
  println(m.d)
}
