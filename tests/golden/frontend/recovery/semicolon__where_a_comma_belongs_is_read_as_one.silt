-- cmd: check
-- exit: 1
-- A semicolon where a comma belongs (between record fields, arguments,
-- list elements) is the one error, read as that comma: the rest is
-- still checked.
type P { x: Int; y: Int }

fn add(a: Int, b: Int) -> Int {
  a + b
}

fn main() {
  let r = add(1; 2)
  let p = P { x: 1; y: 2 }
  let q = [1; 2]
  let s: String = r
  println("{p} {q} {s}")
}
