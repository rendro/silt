-- `(Int)` is `Int`, so a tuple of one does not fit it; `(Int,)` is the
-- tuple, so an Int does not fit that.
fn main() {
  let a: (Int) = (1,)
  let b: (Int,) = 1
  println(a)
  println(b)
}
