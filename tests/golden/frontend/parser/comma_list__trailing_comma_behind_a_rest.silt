-- The rest of a pattern is the last element of its list, and a comma
-- may follow it as it may follow any last element.
type User { name: String, age: Int }

fn main() {
  match [1, 2, 3] {
    [first, ..others,] -> println("{first} then {others}")
    [] -> println("empty")
  }
  match User { name: "Ada", age: 36 } {
    User { name, .., } -> println(name)
  }
}
