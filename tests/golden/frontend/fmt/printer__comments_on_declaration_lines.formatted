-- cmd: fmt
-- A comment behind the opening brace of a type stays there, and one
-- behind a declaration's closing brace stays behind it (FRONTEND-4 e,
-- the snippet of docs/language/modules.md), and one behind a member of
-- a trait stays behind it.
pub type Shape { -- exports the type and all variants
  Circle(Float),
  Rect(Float, Float),
}

fn helper(x) {
  x * 2
} -- not exported

trait Container {
  fn first(self) -> Int -- every impl gives one
}

trait Container for Box {
  fn first(self) -> Int {
    1
  }
}
