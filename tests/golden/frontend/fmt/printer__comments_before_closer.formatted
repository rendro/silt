-- cmd: fmt
-- A comment in front of a closing brace, bracket or parenthesis stays
-- inside what the bracket closes, at the indentation of its content.
type P {
  x: Int,
  -- no more fields
}

trait Named {
  fn name(self) -> String
  -- no more methods
}

fn main() {
  let xs = [
    1,
    2,
    -- no more items
  ]
  let p = P {
    x: 0,
    -- no more values
  }
  let y = add(
    1,
    2,
    -- no more arguments
  )
  match y {
    3 -> println("three")
    _ -> println("other")
    -- no more arms
  }
  let ys = list.map(xs) { x ->
    x + 1
    -- the end of the closure
  }
  let z = (
    y
    -- inside parentheses
  )
  println("{xs} {p.x} {ys} {z}")
  -- the end of main
}

fn add(a, b) {
  a + b
}
-- the end of the file
