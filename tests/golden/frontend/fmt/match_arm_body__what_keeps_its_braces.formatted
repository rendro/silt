-- cmd: fmt
-- An arm has no other spelling for statements, for one `let` or `when`,
-- or for nothing: these blocks stay. (`()` is the unit value, another
-- thing than the empty block.)
fn pick(n, o) {
  match n {
    1 -> {
      println("one")
      println(n + 1)
    }
    2 -> {
      let m = n
    }
    3 -> {
      when n > 2 else {
        return
      }
    }
    4 -> {
      when let Some(m) = o else {
        return
      }
    }
    5 -> {}
    6 -> {}
    7 -> ()
    8 -> ()
    _ -> {}
  }
}

fn main() {
  pick(1, Some(1))
}
