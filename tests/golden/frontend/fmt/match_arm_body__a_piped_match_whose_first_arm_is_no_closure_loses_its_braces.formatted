-- cmd: fmt
-- An inner body whose first arm is no closure's parameters and arrow
-- (a text, a pin, alternatives that are numbers, a guard) is the body of
-- its match whatever follows it, as the parser reads it: the braces
-- around such a match go, as for any other expression.
fn up(x) {
  x
}

fn braced(r, text, k) {
  match r {
    { a: 1 } -> match text |> up {
      "one" -> 1
      _ -> 0
    }
    { a: 2 } -> match k |> up {
      ^k -> 2
      _ -> 0
    }
    { a: 3 } -> match k |> up {
      n when n > 2 -> 3
      _ -> 0
    }
    { a: 4 } -> match k |> up {
      1 | 2 -> 4
      _ -> 0
    }
    { a } -> a
  }
}

fn bare(r, text, k) {
  match r {
    { a: 1 } -> match text |> up {
      "one" -> 1
      _ -> 0
    }
    { a: 2 } -> match k |> up {
      ^k -> 2
      _ -> 0
    }
    { a: 3 } -> match k |> up {
      n when n > 2 -> 3
      _ -> 0
    }
    { a: 4 } -> match k |> up {
      1 | 2 -> 4
      _ -> 0
    }
    { a } -> a
  }
}

fn main() {
  println((braced({ a: 1 }, "one", 2), bare({ a: 1 }, "one", 2)))
}
