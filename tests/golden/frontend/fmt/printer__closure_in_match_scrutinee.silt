-- cmd: fmt
-- A closure argument in a `match` scrutinee stays between the call's
-- parentheses, where a `{` cannot be taken for the block of the match
-- (FRONTEND-3 d, FIX-PLAN row 89); elsewhere it goes behind them.
import list

fn main() {
  match list.map([1], { x -> x + 1 }) {
    [2] -> println("two")
    _ -> println("other")
  }
  match (list.map([1]) { x -> x + 1 }) {
    _ -> println("any")
  }
  let n = match [1, 2] |> list.filter { x -> x > 1 } |> list.length {
    1 -> "one"
    _ -> "more"
  }
  println(n)
  -- With a comment beside it the closure does not hug the parentheses,
  -- so that a second pass, which finds it between them, agrees.
  let k = match [1, 2] |> list.filter {- keep -} { x -> -- the large ones
    x > 1
  } |> list.length {
    _ -> "any"
  }
  println(k)
  -- Behind a pipeline, a match body that looks like a closure is read
  -- as one if the expression goes on behind it. The parentheses or the
  -- line break that keep it the body stay.
  let p = match (7 |> dbl) { x -> x } |> pick { _ -> 1 }
  let q = match 7 |> dbl
  { x -> x } |> pick { _ -> 1 }
  let r = match (7 |> dbl) { 14 -> 1
    _ -> 0 }
  let s = (match 7 |> dbl { x -> x }) + 1
  println(p + q + r + s)
  let m = match 7 |> dbl {
    14 -> 1
    _ -> 0
  } + 1
  println(m)
  let ys = list.map([1], { x -> x + 1 })
  println(ys)
}

fn dbl(n) { n * 2 }

fn pick(n, f) { f(n) }
