-- cmd: fmt
-- A comment behind a pipeline's first operand, behind `|>` and behind a
-- stage (FRONTEND-4 b).
import list

fn main() {
  [1, 2] -- explain the list
  |> list.each { v -> println("{v}") } -- done
  let a = [1, 2] |> -- behind the operator
    list.map { x -> x + 1 }
  let b = [1, 2]
    -- a line of its own
    |> list.map { x -> x + 1 } -- first stage
    |> list.filter { x -> x > 1 }
  let c = [1, 2] {- inline -} |> list.length
  println("{a} {b} {c}")
}
