-- cmd: fmt
-- An expression that goes on over several lines inside its braces goes
-- on behind the arrow without them, and one that does not fit the line
-- is laid out as it is without braces: by its own rules. Text that
-- cannot be broken passes the margin.
import list
import string

fn pick(n, xs, name) {
  match n {
    1 -> xs |> list.map { x -> x + 1 } |> list.filter { x -> x > 1 } |> list.length
    2 -> n * 2 + 1
    3 -> name.length
    4 -> list.fold(xs, 0) { acc, x ->
      let y = x * 2
      acc + y
    }
    5 -> some_function_with_a_long_name(n, list.length(xs), string.length(name.first), n + 100000) +
      1
    6 -> xs
      |> list.map { x -> x * 1000 }
      |> list.filter { x -> x > 100000 }
      |> list.fold(0) { acc, x -> acc + x }
    7 -> string.length(
      "a text that is long and stands between parentheses, which break and take it between them",
    )
    8 -> string.length(name.first) +
      1000000 +
      n +
      2000000 +
      n +
      3000000 +
      n +
      4000000 +
      n +
      5000000 +
      n
    _ -> 0
  }
}

fn label(n) {
  match n {
    1 -> "a text that is long and has no place to break it, so that the line of its arm passes the margin"
    _ -> "a short text"
  }
}

fn some_function_with_a_long_name(a, b, c, d) {
  a + b + c + d
}

fn main() {
  println((pick(1, [1, 2], { first: "a", length: 1 }), label(1)))
}
