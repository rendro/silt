-- cmd: fmt
-- A closure's body that is one expression in braces of its own is
-- written without them, wherever the closure stands.
import list

fn main() {
  let inc = { x -> x + 1 }
  let one = { -> 1 }
  let add = { x, y -> x + y }
  let made = list.map([1, 2]) { x -> x * 2 }
  let trailing = list.map([1, 2]) { x -> x * 2 }
  let piped = [1, 2] |> list.map { x -> x * 2 } |> list.filter { x -> x > 2 }
  let nested = { x -> { y -> x + y } }
  let matched = { x ->
    match x {
      1 -> "one"
      _ -> "more"
    }
  }
  let text = "{list.map([1]) { x -> x + 1 }}"
  println((inc(1), one(), add(1, 2), made, trailing, piped, nested(1)(2), matched(1), text))
}
