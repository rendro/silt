-- cmd: fmt
-- A call that ends in a closure in a `match` header is written with the
-- closure in its parentheses, as in a `loop` header; a second run
-- changes nothing.
import list
import string
import task
import time

fn main() {
  let xs = [1, 2, 3]
  match list.find(xs, { x -> x > 1 }) {
    Some(x) -> println(x)
    None -> println("none")
  }
  match list.map(xs, { x -> x * 10 }) {
    [10, ..rest] -> println(rest)
    _ -> println("no")
  }
  match task.deadline(time.ms(5000), { -> 7 }) {
    Ok(v) -> println(v)
    Err(_) -> println("late")
  }
  let n = 2
  let r = match n {
    1 -> "one"
    _ -> "other"
  } |> string.length
  println(r)
}
