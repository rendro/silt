-- cmd: fmt
-- The formatter does not look at where the body of the inner match
-- starts: on a line of its own it is no closure and the arm would parse
-- without its braces, and they stay all the same. So this arm has two
-- spellings, each kept as written.
import list

fn first(xs) {
  list.head(xs)
}

fn braced(r, xs) {
  match r {
    { a: 1 } -> {
      match xs |> first
      {
        x -> 1
      }
    }
    { a } -> a
  }
}

fn bare(r, xs) {
  match r {
    { a: 1 } -> match xs |> first
    {
      x -> 1
    }
    { a } -> a
  }
}

fn main() {
  println((braced({ a: 1 }, [1]), bare({ a: 1 }, [1])))
}
