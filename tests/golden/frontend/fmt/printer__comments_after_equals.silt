-- cmd: fmt
-- A comment behind `=`, at the end of the line or on a line of its own
-- (FRONTEND-4 b): in a `let`, a top-level `let`, a `when let` and a type
-- alias.
type Id = -- an alias
  Int

let limit = -- the limit
  10

fn main() {
  let x = -- why one
    1
  let y =
    -- on its own line
    2
  let z = {- inline -} 3
  when let Some(v) = -- the option
    Some(x) else {
    return
  }
  println("{x} {y} {z} {v} {limit}")
}
