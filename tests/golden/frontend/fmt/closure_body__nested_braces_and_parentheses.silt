-- cmd: fmt
-- Braces in braces, and parentheses around them, all go in one pass:
-- the body is what the innermost block holds.
fn main() {
  let a = { x -> { { x } } }
  let b = { x -> ({ x }) }
  let c = { x -> (({ x })) }
  let d = { x -> { ({ { x } }) } }
  let e = { x -> { {
    let y = x
    y
  } } }
  let f = { x -> ({
    let y = x
    y
  }) }
  println((a(1), b(1), c(1), d(1), e(1), f(1)))
}
