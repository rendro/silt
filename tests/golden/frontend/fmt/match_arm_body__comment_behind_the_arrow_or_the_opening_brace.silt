-- cmd: fmt
-- A comment behind the arrow or behind the opening brace ends the
-- arrow's line; the expression stands behind the arrow if the comment
-- can end its line, and under it if not.
fn pick(n) {
  match n {
    1 -> { -- behind the brace
      n + 1
    }
    2 -> -- behind the arrow
      { n + 2 }
    3 -> -- behind the arrow
      { -- and behind the brace
        n + 3 }
    4 -> { -- behind the brace
      match n {
        4 -> 44
        _ -> 0
      }
    }
    _ -> { -- behind the brace
      -- and on the next line
      0
    }
  }
}

fn main() {
  println(pick(1))
}
