-- cmd: fmt
-- A loop header too long for its line has each binding on a line of its
-- own, one level in, and the body's `{` on the next line; a short one
-- stays on one line.
fn main() {
  loop first_counter = 0, second_accumulator = [], third_state_value = "a long initial string value", fourth = (1, 2, 3) {
    match { first_counter < 3 -> loop(first_counter + 1, [first_counter, ..second_accumulator], third_state_value, fourth)
      _ -> println((second_accumulator, third_state_value, fourth)) }
  }
  loop i = 0, acc = [] {
    match { i < 2 -> loop(i + 1, [i, ..acc])
      _ -> println(acc) }
  }
}
