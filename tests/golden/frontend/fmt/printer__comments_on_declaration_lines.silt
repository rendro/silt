-- cmd: fmt --next
-- A comment behind the opening brace of a type stays there, and one
-- behind a declaration's closing brace stays behind it (FRONTEND-4 e,
-- the snippets of docs/language/modules.md and generics.md).
pub type Shape {      -- exports the type and all variants
  Circle(Float),
  Rect(Float, Float),
}

fn helper(x) { x * 2 }       -- not exported

trait Container {
  type Item: Compare
  fn first(self) -> Self::Item
}

trait Container for Box {
  type Item = Int           -- OK: Int auto-derives Compare
  fn first(self) -> Int { 1 }
}
