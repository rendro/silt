import list
import option

fn outcome() {
  let xs = [1, 2, 3]
  -- list.head returns Option(Int); `|> option.map { ... }`
  -- transforms it; `?` propagates None.
  let _first = xs
               |> list.head
               |> option.map { n -> n * 10 }
  match _first {
    Some(n) -> n
    None -> -1
  }
}

fn main() {
  println(outcome())
}
