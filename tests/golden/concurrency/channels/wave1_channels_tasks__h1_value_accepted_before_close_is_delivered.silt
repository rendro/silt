-- repeat: 10
-- stderr-not-contains: deadlock on main thread
-- A producer notes each send that the channel accepted, a consumer
-- counts the values it received until `Closed`, and the main thread
-- closes the channel in the middle. Every accepted value must arrive.
-- Without the fix a send can be accepted after the consumer has seen
-- `Closed`; that is rare (about one run in ten loses a value).
--
-- The close ends the producer: its next send is a runtime error, which
-- the cancel dismisses. What it sent before is what it noted in `acks`
-- (a note is written after its send, so the notes never count a send
-- that was not accepted).
import channel
import task

fn spin(n) {
  match n {
    0 -> 0
    _ -> spin(n - 1)
  }
}

fn consume(ch, n) {
  match channel.receive(ch) {
    channel.Message(_) -> consume(ch, n + 1)
    _ -> n
  }
}

fn produce(ch, acks, n) {
  channel.send(ch, n)
  channel.send(acks, n)
  produce(ch, acks, n + 1)
}

fn noted(acks, n) {
  match channel.try_receive(acks) {
    channel.Message(_) -> noted(acks, n + 1)
    _ -> n
  }
}

fn go(i, rounds, lost) {
  match i < rounds {
    true -> {
      let ch = channel.new(8)
      let acks = channel.new(65536)
      let c = task.spawn({ -> consume(ch, 0) })
      let s = task.spawn({ -> produce(ch, acks, 0) })
      let _ = spin(200 + i % 97)
      channel.close(ch)
      let received = task.join(c)
      task.cancel(s)
      let sent = noted(acks, 0)
      match sent > received {
        true -> go(i + 1, rounds, lost + sent - received)
        false -> go(i + 1, rounds, lost)
      }
    }
    false -> lost
  }
}

fn main() {
  let lost = go(0, 100, 0)
  println("values accepted and never delivered: {lost}")
}
