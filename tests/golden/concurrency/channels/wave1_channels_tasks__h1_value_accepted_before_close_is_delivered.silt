-- repeat: 10
-- stderr-not-contains: deadlock
-- A producer notes each send that the channel accepted, a consumer
-- counts the values it received until `None`, and a third task
-- closes the channel in the middle. Every accepted value must arrive.
-- Without the fix a send can be accepted after the consumer has seen
-- `None`; that is rare (about one run in ten loses a value).
--
-- The close ends the producer: its next send is a runtime error, which
-- its guard catches. What it sent before is what it noted in `acks`
-- (a note is written after its send, so the notes never count a send
-- that was not accepted).
import channel
import task

fn spin(n) {
  match n {
    0 -> 0
    _ -> spin(n - 1)
  }
}

fn consume(ch, n) {
  match channel.receive(ch) {
    Some(_) -> consume(ch, n + 1)
    None -> n
  }
}

fn produce(ch, acks, n) {
  channel.send(ch, n)
  channel.send(acks, n)
  produce(ch, acks, n + 1)
}

fn noted(acks, n) {
  match channel.try_receive(acks) {
    channel.Message(_) -> noted(acks, n + 1)
    _ -> n
  }
}

fn go(i, rounds, lost) {
  match i < rounds {
    true -> {
      let ch = channel.new(8)
      let acks = channel.new(65536)
      let counted = channel.new(1)
      let consumer = { -> channel.send(counted, consume(ch, 0)) }
      let producer = { ->
        let _ = task.guard { -> produce(ch, acks, 0) }
      }
      let closer = { ->
        let _ = spin(200 + i % 97)
        channel.close(ch)
      }
      task.join([consumer, producer, closer])
      let received = match channel.receive(counted) {
        Some(n) -> n
        None -> 0
      }
      let sent = noted(acks, 0)
      match sent > received {
        true -> go(i + 1, rounds, lost + sent - received)
        false -> go(i + 1, rounds, lost)
      }
    }
    false -> lost
  }
}

fn main() {
  let lost = go(0, 100, 0)
  println("values accepted and never delivered: {lost}")
}
