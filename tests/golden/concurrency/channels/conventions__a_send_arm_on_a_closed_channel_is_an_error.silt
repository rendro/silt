-- exit: 1
-- stderr-contains: error[runtime]: send on closed channel 1
-- A select with a `Send` arm on a closed channel is the error of a send
-- on it, whatever its other arms could do. A `Recv` arm on a closed
-- channel is what it was: `None`, a value.
import channel

fn main() {
  let ready = channel.new(1)
  let closed = channel.new(1)
  channel.send(ready, 7)
  channel.close(closed)
  match channel.select([channel.Recv(closed)]) {
    channel.Received(_, value) -> println("a Recv arm on the closed channel: {value}")
    channel.Sent(_) -> println("a Recv arm on the closed channel: sent")
  }
  match channel.select([channel.Recv(closed), channel.Send(ready, 8)]) {
    channel.Received(_, value) -> println("a Send arm on an open channel that is full, beside it: {value}")
    channel.Sent(_) -> println("a Send arm on an open channel that is full, beside it: sent")
  }
  match channel.select([channel.Recv(ready), channel.Send(closed, 9)]) {
    _ -> println("not reached")
  }
}
