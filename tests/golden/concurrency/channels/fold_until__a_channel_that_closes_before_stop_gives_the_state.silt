-- A channel that is closed and empty ends `channel.fold_until` with the
-- last state: the start state when no message came.
import channel

fn sum_below(ch: Channel(Int), limit: Int) -> Int {
  channel.fold_until(ch, 0) { acc, n ->
    match acc + n > limit {
      true -> Stop(acc)
      false -> Continue(acc + n)
    }
  }
}

fn main() {
  let ch = channel.new(5)
  channel.send(ch, 1)
  channel.send(ch, 2)
  channel.send(ch, 3)
  channel.close(ch)
  println(sum_below(ch, 100))
  let empty = channel.new(1)
  channel.close(empty)
  println(sum_below(empty, 100))
}
