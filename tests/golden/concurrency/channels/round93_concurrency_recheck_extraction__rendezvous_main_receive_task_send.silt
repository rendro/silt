-- repeat: 3
-- Main-thread receive from a sender in a task (the function of a
-- `stream.from_fn`) over a rendezvous channel completes, 20 times in a
-- row (the receive wait loop's re-check path).
import channel
import stream

fn main() {
  let go = { i ->
    match i >= 20 {
      true -> return println("done")
      _ -> {
        let ch = channel.new(0)
        let producer = stream.from_fn { _ -> channel.send(ch, 7) }
        let v = match channel.receive(ch) {
          Some(v) -> v
          None -> -1
        }
        let _ = stream.collect(producer)
        match v == 7 {
          true -> go(i + 1)
          _ -> return println("iteration {i}: rendezvous receive lost, got {v}")
        }
      }
    }
  }
  go(0)
}
