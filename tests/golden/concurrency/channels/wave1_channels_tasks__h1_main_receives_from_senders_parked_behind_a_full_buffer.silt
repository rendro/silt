-- repeat: 10
-- stderr-not-contains: deadlock on main thread
-- Two values are buffered and four senders are parked when the main
-- thread starts to receive. Without the fix the run stops after three
-- or four values, every time. (The senders are the pieces of a
-- `task.join` in the function of a `stream.from_fn`, which runs beside
-- the program's own thread.)
import channel
import list
import stream
import task
import time

fn main() {
  let ch = channel.new(2)
  let senders = stream.from_fn { _ ->
    task.join(list.map([1, 2, 3, 4, 5, 6]) { i -> { -> channel.send(ch, i) } })
  }
  time.sleep(time.ms(200))
  loop n = 0 {
    match n < 6 {
      true -> {
        match channel.receive(ch) {
          Some(_) -> println("got one")
          None -> println("got none")
        }
        loop(n + 1)
      }
      false -> ()
    }
  }
  let _ = stream.collect(senders)
  println("done")
}
