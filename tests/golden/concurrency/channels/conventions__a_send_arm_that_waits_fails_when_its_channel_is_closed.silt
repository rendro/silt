-- exit: 1
-- repeat: 20
-- stderr-contains: error[runtime]: joined task failed: send on closed channel 0
-- A task that waits in a select to send (nobody receives) is woken when
-- the channel is closed, and fails as a `channel.send` that waited does.
-- (Whether the task waits already when the channel is closed or comes
-- to its select afterwards, the error is the same.)
import channel
import task

fn main() {
  let quiet = channel.new(0)
  let sender = task.spawn { -> channel.select([channel.Send(quiet, 1)]) }
  channel.close(quiet)
  println("joining")
  let _ = task.join(sender)
  println("not reached")
}
