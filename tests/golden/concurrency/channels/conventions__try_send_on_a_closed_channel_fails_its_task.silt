-- exit: 1
-- repeat: 20
-- stderr-contains: error[runtime]: send on closed channel 0
-- In a task as on the main thread: `channel.try_send` on a closed
-- channel fails the task, and the join of it raises that.
import channel
import task

fn main() {
  let closed = channel.new(1)
  channel.close(closed)
  let sender = { ->
    let _ = channel.try_send(closed, 1)
  }
  println("joining")
  task.join([sender])
  println("not reached")
}
