-- repeat: 3
-- Eight senders, eight recv_timeout calls: every value arrives, no timer
-- wins ahead of a value (1+..+8 = 36).
import channel
import task
import time
fn main() {
  let ch = channel.new(0)
  let _s0 = task.spawn({ -> channel.send(ch, 1) })
  let _s1 = task.spawn({ -> channel.send(ch, 2) })
  let _s2 = task.spawn({ -> channel.send(ch, 3) })
  let _s3 = task.spawn({ -> channel.send(ch, 4) })
  let _s4 = task.spawn({ -> channel.send(ch, 5) })
  let _s5 = task.spawn({ -> channel.send(ch, 6) })
  let _s6 = task.spawn({ -> channel.send(ch, 7) })
  let _s7 = task.spawn({ -> channel.send(ch, 8) })
  let total = loop c = 0, acc = 0 {
    match c >= 8 {
      true -> acc
      _ -> match channel.recv_timeout(ch, time.ms(5000)) {
        Ok(v) -> loop(c + 1, acc + v)
        Err(_) -> -1
      }
    }
  }
  println("{total}")
}
