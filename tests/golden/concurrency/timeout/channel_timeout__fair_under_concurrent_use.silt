-- repeat: 3
-- Eight senders, eight receive_timeout calls: every value arrives, no timer
-- wins ahead of a value (1+..+8 = 36). (The senders are the pieces of a
-- `task.join` in the function of a `stream.from_fn`, which runs while
-- the program's own thread receives.)
import channel
import list
import stream
import task
import time

fn main() {
  let ch = channel.new(0)
  let senders = stream.from_fn { _ ->
    task.join(list.map(1..8) { i -> { -> channel.send(ch, i) } })
  }
  let go = { c, acc ->
    match c >= 8 {
      true -> acc
      _ -> match channel.receive_timeout(ch, time.ms(5000)) {
        channel.Message(v) -> go(c + 1, acc + v)
        _ -> -1
      }
    }
  }
  let total = go(0, 0)
  let _ = stream.collect(senders)
  println("{total}")
}
