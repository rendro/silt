-- repeat: 3
-- stderr-not-contains: deadlock
-- The main thread joins a task that waits for the send of a task that
-- waits for a timer. Without the fix the join is told "deadlock".
import channel
import task
import time

fn main() {
  let x = channel.new(0)
  let got = channel.new(1)
  let waiter = { ->
    let t = channel.timeout(time.ms(600))
    let _ = channel.receive(t)
    channel.send(x, 7)
  }
  let relay = { ->
    match channel.receive(x) {
      Some(v) -> channel.send(got, v * 2)
      None -> channel.send(got, 0 - 1)
    }
  }
  task.join([waiter, relay])
  match channel.receive(got) {
    Some(v) -> println("main got: {v}")
    None -> println("main got nothing")
  }
}
