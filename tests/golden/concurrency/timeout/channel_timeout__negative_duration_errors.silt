-- exit: 1
-- stderr-contains: channel.receive_timeout: duration must be non-negative
-- A negative Duration built from the raw record literal is rejected at
-- runtime, not treated as a zero wait.
import channel
import time
fn main() {
  let ch = channel.new(4)
  match channel.receive_timeout(ch, time.Duration { ns: -1 }) {
    channel.Message(_) -> println("ok")
    _ -> println("err")
  }
}
