-- repeat: 3
-- The 500 ms gives the receiver time to park before its deadline even
-- on a slow runner: a task stopped before it parks keeps running
-- (CONC-8, stage 7), which would make this print "leaked" for the
-- wrong reason. A task parked in receive_timeout is ended by its
-- deadline; afterwards no receiver is parked, so a rendezvous try_send
-- fails (no phantom send).
import channel
import task
import time

fn main() {
  let ch = channel.new(0)
  let _ = task.deadline(time.ms(500)) { ->
    match channel.receive_timeout(ch, time.ms(5000)) {
      channel.Message(_) -> 1
      _ -> 0
    }
  }
  time.sleep(time.ms(50))
  let r = match channel.try_send(ch, 42) {
    true -> "leaked"
    false -> "ok"
  }
  println(r)
}
