-- A closed, empty channel gives Closed.
import channel
import time
fn main() {
  let ch = channel.new(0)
  channel.close(ch)
  let r = match channel.receive_timeout(ch, time.ms(500)) {
    channel.Message(_) -> "ok"
    channel.Empty -> "timeout"
    channel.Closed -> "closed"
    channel.Sent -> "sent"
  }
  println(r)
}
