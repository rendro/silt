-- repeat: 3
-- stderr-not-contains: deadlock on main thread
-- The same with `channel.receive_timeout`, which parks the task on a
-- select with a timer arm.
import channel
import task
import time

fn main() {
  let quiet = channel.new(1)
  let x = channel.new(0)
  let h = task.spawn({ ->
    let waited = match channel.receive_timeout(quiet, time.ms(600)) {
      channel.Message(_) -> "value"
      channel.Empty -> "timed out"
      channel.Closed -> "closed"
    }
    channel.send(x, waited)
  })
  match channel.receive(x) {
    Some(v) -> println("main got: {v}")
    None -> println("main got no message")
  }
  task.join(h)
}
