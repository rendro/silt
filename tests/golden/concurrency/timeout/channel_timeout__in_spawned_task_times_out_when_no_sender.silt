-- repeat: 3
-- receive_timeout inside a spawned task really expires: a timer wake must
-- not re-arm a fresh full-duration timer (round 101 livelock).
import channel
import task
import time
fn main() {
  let ch = channel.new(1)
  let h = task.spawn({ ->
    match channel.receive_timeout(ch, time.ms(50)) {
      channel.Message(_) -> "got value"
      channel.Empty -> "timed out"
      channel.Closed -> "closed"
    }
  })
  println(task.join(h))
}
