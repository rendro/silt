-- repeat: 3
-- receive_timeout inside a task really expires: a timer wake must
-- not re-arm a fresh full-duration timer (round 101 livelock).
import channel
import list
import task
import time

fn main() {
  let ch = channel.new(1)
  let outcomes = task.map([ch], 1) { c ->
    match channel.receive_timeout(c, time.ms(50)) {
      channel.Message(_) -> "got value"
      channel.Empty -> "timed out"
      channel.Closed -> "closed"
    }
  }
  list.each(outcomes) { o -> println(o) }
}
