-- No sender and no other task: recv_timeout surfaces Err(ChannelTimeout),
-- not a main-thread deadlock.
import channel
import time
fn main() {
  let ch = channel.new(0)
  let r = match channel.recv_timeout(ch, time.ms(50)) {
    Ok(_) -> "ok"
    Err(channel.ChannelTimeout) -> "timeout"
    Err(channel.ChannelClosed) -> "closed"
  }
  println(r)
}
