-- No sender and no other task: receive_timeout gives Empty,
-- not a main-thread deadlock.
import channel
import time
fn main() {
  let ch = channel.new(0)
  let r = match channel.receive_timeout(ch, time.ms(50)) {
    channel.Message(_) -> "ok"
    channel.Empty -> "timeout"
    channel.Closed -> "closed"
    channel.Sent -> "sent"
  }
  println(r)
}
