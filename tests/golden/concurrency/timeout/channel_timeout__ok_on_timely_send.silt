-- repeat: 3
-- A sibling sends well within the timeout: receive_timeout gives Message(v).
import channel
import task
import time
fn main() {
  let ch = channel.new(0)
  let _h = task.spawn({ ->
    time.sleep(time.ms(20))
    channel.send(ch, 42)
  })
  let r = match channel.receive_timeout(ch, time.ms(1000)) {
    channel.Message(v) -> v
    _ -> -1
  }
  println("{r}")
}
