-- A function that task.deadline ends at its time, inside a guard that
-- runs work that never waits: the guard does not return, and the
-- deadline gives None.
import channel
import task
import time

fn spin(n: Int) -> Int {
  spin(n + 1)
}

fn main() {
  let said: Channel(String) = channel.new(4)
  let ended = task.deadline(time.ms(20)) { ->
    let caught = task.guard { -> spin(0) }
    channel.send(said, "the guard returned {caught}")
  }
  println(ended)
  println(channel.try_receive(said))
}
