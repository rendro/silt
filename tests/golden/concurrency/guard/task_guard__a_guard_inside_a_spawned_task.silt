-- A guard runs on the task that calls it: inside a task it catches
-- there, and the task goes on and returns. A failure of a piece of a
-- join, raised at the join, is caught by a guard around the join.
import list
import task

fn fail(n: Int) -> Int {
  panic("task {n} failed")
}

fn main() {
  let caught = task.map([1], 1) { n ->
    match task.guard({ -> fail(n) }) {
      Ok(_) -> "no error"
      Err(e) -> "the task caught {e.message}"
    }
  }
  list.each(caught) { line -> println(line) }
  let failing = { ->
    let _ = fail(2)
  }
  match task.guard({ -> task.join([failing]) }) {
    Ok(_) -> println("no error")
    Err(e) -> println("main caught {e.message}")
  }
}
