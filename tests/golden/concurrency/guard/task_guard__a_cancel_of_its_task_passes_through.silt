-- A stop of the task that runs a guard (here a helper of
-- `task.background`, stopped when the body returns) ends the task
-- where it is: the guard does not return, and what follows it does not
-- run.
import channel
import task
import time

fn main() {
  let said: Channel(String) = channel.new(4)
  let started: Channel(Int) = channel.new(1)
  let guarded = { ->
    let caught = task.guard { ->
      channel.send(started, 1)
      time.sleep(time.hours(1))
    }
    channel.send(said, "the guard returned {caught}")
  }
  task.background([guarded]) { ->
    let _ = channel.receive(started)
  }
  println(channel.try_receive(said))
}
