-- cmd: check
-- exit: 0
-- The docs/concurrency.md wildcard-select snippet, with its `_` catch-all,
-- typechecks.
import channel

fn main() {
  let ch1 = channel.new(1)
  let ch2 = channel.new(1)
  match channel.select([channel.Recv(ch1), channel.Recv(ch2)]) {
    (_, channel.Message(val)) -> println("got {val} from somewhere")
    (_, channel.Closed)       -> println("all done")
    _                 -> ()
  }
}
