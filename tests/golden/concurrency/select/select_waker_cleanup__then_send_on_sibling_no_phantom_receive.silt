-- repeat: 3
-- A task select resolved via `a` must not leave its waker on `b`: a later
-- send on `b` hands off to the real receiver, not a phantom.
import channel
import task
import time

fn main() {
  let a = channel.new(0)
  let b = channel.new(0)

  -- Resolve the select via a, after giving it time to register both
  -- wakers. With the bug, b's waiting_receivers stays at 1 forever even
  -- after the select completes.
  let resolve = { ->
    time.sleep(time.ms(50))
    channel.send(a, 1)
  }
  -- The body selects over a and b; it expects to resolve via a.
  let v1 = task.background([resolve]) { ->
    match channel.select([channel.Recv(a), channel.Recv(b)]) {
      channel.Received(_, Some(_)) -> "got_one"
      _ -> "other"
    }
  }

  -- Send into b after giving its real receiver time to park. If the
  -- leaked select-waker still inflates b's waiting_receivers, this
  -- might falsely succeed without the receiver ever waking. With the
  -- fix, this blocks until the receiver is the actual one.
  let feed = { ->
    time.sleep(time.ms(50))
    channel.send(b, 2)
  }
  -- The body is the real consumer of b.
  let v2 = task.background([feed]) { -> channel.receive(b) }

  match v2 {
    Some(_) -> println("ok:{v1}")
    None -> println("fail:{v1}")
  }
}
