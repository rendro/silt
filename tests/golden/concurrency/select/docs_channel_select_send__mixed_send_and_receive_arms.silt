-- Mixed send/receive arms: the send would park on a rendezvous channel,
-- the receive is ready (preloaded), so the receive arm wins.
import channel
import task
fn main() {
    let out = channel.new(0)
    let inp = channel.new(1)
    channel.send(inp, 7)
    let r = match channel.select([channel.Send(out, 99), channel.Recv(inp)]) {
        (^out, channel.Sent) -> 1
        (^inp, channel.Message(v)) -> v
        _ -> -1
    }
    println("{r}")
}
