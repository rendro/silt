-- cmd: check
-- exit: 0
-- The docs/concurrency.md variable-binding select snippet typechecks.
import channel

fn main() {
  let ch1 = channel.new(1)
  let ch2 = channel.new(1)
  match channel.select([channel.Recv(ch1), channel.Recv(ch2)]) {
    (_source, channel.Message(val)) -> println("got {val}")
    (_, channel.Closed)             -> println("all done")
    _                       -> ()
  }
}
