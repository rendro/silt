-- repeat: 200
-- stderr-not-contains: the pipeline gave
-- When the body returns, the stages (they wait on a gate nobody feeds)
-- and the helpers in `collect` (they wait on the stages' output) are
-- stopped. The stop of a stage closes its output; the helper that
-- reads it does not run on with a list that the pipeline never
-- produced.
import channel
import stream
import task

fn gated(gate) {
  stream.from_list([1, 2, 3])
    |> stream.map { x ->
      match channel.receive(gate) {
        Some(k) -> x * k
        None -> 0
      }
    }
}

fn main() {
  let gate = channel.new(0)
  let s = gated(gate)
  let t = gated(gate)
  task.background(
    [
      { -> println(stream.collect(s)) },
      { ->
        let xs = stream.collect(t)
        panic("the pipeline gave {xs}")
      },
    ],
  ) { -> println("main") }
}
