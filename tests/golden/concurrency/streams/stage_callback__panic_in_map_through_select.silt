-- exit: 1
-- A panic in the callback of `stream.map` ends the program
-- through `channel.select` on its output, as `channel.each` and the
-- sinks raise it: the error is the panic, not a close.
import channel
import stream

fn read(s) {
  match channel.select([channel.Recv(s)]) {
    channel.Received(_, Some(v)) -> println("got {v}")
    channel.Received(_, None) -> println("closed")
    _ -> println("other")
  }
}

fn main() {
  read(stream.map(stream.from_list([2])) { x -> panic("map failed on {x}") })
  println("not reached")
}
