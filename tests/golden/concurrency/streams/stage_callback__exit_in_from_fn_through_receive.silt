-- exit: 31
-- `process.exit` in the function of `stream.from_fn` ends the program
-- with its code while `channel.receive` waits on the stage.
import channel
import process
import stream

fn read(s) {
  match channel.receive(s) {
    Some(v) -> println("got {v}")
    None -> println("closed")
  }
}

fn main() {
  read(stream.from_fn { ch -> process.exit(31) })
  println("not reached")
}
