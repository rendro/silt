-- exit: 1
-- stderr-contains: cannot send into a stream: channel
-- stderr-contains: is the output of stream.take
-- A stream that has nothing to give (a take of none) is a stream's
-- channel all the same: a send into it is refused as one, not as a send
-- on a closed channel.
import channel
import stream

fn main() {
  let q = stream.take(stream.from_range(1, 3), 0)
  channel.send(q, 99)
  println("not reached: {stream.collect(q)}")
}
