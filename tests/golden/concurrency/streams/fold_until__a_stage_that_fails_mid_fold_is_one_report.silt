-- exit: 1
-- A stage that fails while `stream.fold_until` reads it makes the fold
-- raise its failure, once, after the values that came before it.
import stream

fn main() {
  let quotients = stream.from_list([2, 1, 0, 5]) |> stream.map({ x -> 10 / x })
  let total = stream.fold_until(quotients, 0) { acc, q ->
    println("got {q}")
    Continue(acc + q)
  }
  println("unreachable {total}")
}
