-- exit: 1
-- A feed that sends after it closed its own channel fails with a send on
-- a closed channel, at its send. Its stream had ended at the close, so
-- the reader has what came before; the failure is reported as the feed's.
import channel
import stream
import time

fn main() {
  let s = stream.from_fn { ch ->
    channel.send(ch, 1)
    channel.close(ch)
    channel.send(ch, 2)
  }
  println(stream.collect(s))
  time.sleep(time.ms(30))
  println("end")
}
