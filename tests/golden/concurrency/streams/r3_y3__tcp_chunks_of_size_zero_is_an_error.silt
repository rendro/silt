-- requires-feature: tcp
-- exit: 1
-- stderr-contains: stream.tcp_chunks: n must be positive
-- A chunk size of zero or less is an error, as for `stream.chunks`.
import stream
import tcp

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else { panic("cannot listen") }
  let port = tcp.local_port(listener)
  when let Ok(conn) = tcp.connect("127.0.0.1:{port}") else { panic("cannot connect") }
  println(stream.collect(stream.tcp_chunks(conn, 0)))
}
