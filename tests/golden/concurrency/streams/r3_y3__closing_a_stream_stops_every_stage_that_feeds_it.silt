-- repeat: 5
-- A read that does not wait asks the stream for a value; closing the
-- stream then stops every stage before it: the `stream.map` does not
-- run on what comes after the close, and the `stream.buffered` before it
-- takes none of it.
import channel
import stream
import time

fn main() {
  let c = channel.new(3)
  let s = c
    |> stream.buffered(4)
    |> stream.map { x ->
      println("map ran on {x}")
      x
    }
  match channel.try_receive(s) {
    channel.Message(v) -> println("got {v}")
    channel.Empty -> println("nothing yet")
    channel.Closed -> println("closed")
  }
  time.sleep(time.ms(20))
  channel.close(s)
  time.sleep(time.ms(20))
  channel.send(c, 1)
  channel.send(c, 2)
  channel.send(c, 3)
  channel.close(c)
  time.sleep(time.ms(20))
  println("the input still holds {stream.count(c)} of 3")
}
