-- repeat: 20
-- stderr-not-contains: deadlock
-- The function of a stage waits on a channel that a helper sends on.
-- The stage is a task like any other: while it can still be answered
-- there is no deadlock. (The stage runs its function when its reader
-- asks for a value: the reader is the body, which asks while the
-- helper sends.)
import channel
import stream
import task

fn main() {
  let gate = channel.new(0)
  let opened = stream.from_list([1, 2, 3])
    |> stream.map { x ->
      match channel.receive(gate) {
        Some(key) -> x * key
        None -> 0
      }
    }
  let got = task.background(
    [
      { ->
        channel.send(gate, 10)
        channel.send(gate, 100)
        channel.send(gate, 1000)
      },
    ],
  ) { -> stream.collect(opened) }
  println(got)
}
