-- exit: 37
-- `process.exit` in the callback of `stream.take_while` ends the
-- program with its code while `channel.receive` waits on the stage.
import channel
import process
import stream

fn read(s) {
  match channel.receive(s) {
    Some(v) -> println("got {v}")
    None -> println("closed")
  }
}

fn main() {
  read(stream.take_while(stream.from_list([7])) { x -> process.exit(30 + x) })
  println("not reached")
}
