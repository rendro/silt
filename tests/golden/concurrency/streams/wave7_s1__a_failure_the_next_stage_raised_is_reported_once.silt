-- exit: 1
-- repeat: 3
-- `stream.buffered` reads ahead without being asked: it asks the map,
-- which fails on its second value; buffered reads the failure and
-- fails with it. Nobody reads buffered: one report, for buffered.
import stream

fn main() {
  let src = stream.from_list([1, 2, 3])
  let a = stream.map(src) { x -> 10 / (x - 2) }
  let _b = stream.buffered(a, 4)
  println("done")
}
