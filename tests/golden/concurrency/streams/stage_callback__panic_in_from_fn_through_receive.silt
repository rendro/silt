-- exit: 1
-- A panic in the function of `stream.from_fn` ends the program through
-- `channel.receive` on its output, as `channel.each` and the sinks
-- raise it: the error is the panic, not a close.
import channel
import stream

fn read(s) {
  match channel.receive(s) {
    Some(v) -> println("got {v}")
    None -> println("closed")
  }
}

fn main() {
  read(stream.from_fn { ch -> panic("from_fn failed") })
  println("not reached")
}
