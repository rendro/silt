-- exit: 1
-- stderr-contains: deadlock on main thread: channel receive with no counterparty
-- stderr-not-contains: stage at
-- A deadlock while a feed waits for its reader names the feed's call once.
import channel
import stream

fn counting() {
  stream.from_fn { ch ->
    let go = { i ->
      channel.send(ch, i)
      go(i + 1)
    }
    go(0)
  }
}

fn main() {
  let other = channel.new(0)
  let s = counting()
  println(channel.receive(s))
  let _ = channel.receive(other)
  println(channel.receive(s))
}
