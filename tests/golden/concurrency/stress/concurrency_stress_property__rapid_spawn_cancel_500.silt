-- repeat: 3
-- stderr-not-contains: deadlock
-- stderr-not-contains: panicked
-- 500 long-sleeping helpers, stopped together when the body returns:
-- the scheduler stays clean, main exits promptly, no deadlock
-- diagnostic.
import list
import task
import time

fn main() {
  let sleepers = 1..500 |> list.map { _ -> { -> time.sleep(time.ms(5000)) } }
  task.background(sleepers) { -> () }
  println("stopped=500")
}
