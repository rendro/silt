-- repeat: 100
-- stderr-not-contains: deadlock
-- 3,000 times a helper is started and stopped at once (its body
-- returns), each before or while it parks on a channel nobody sends
-- to. None is left on the channel: a send finds no receiver.
import channel
import task

fn main() {
  let never = channel.new(0)
  let wait = { ->
    let _ = channel.receive(never)
  }
  loop left = 3000 {
    match left {
      0 -> ()
      _ -> {
        task.background([wait]) { -> () }
        loop(left - 1)
      }
    }
  }
  println("sent={channel.try_send(never, 1)}")
}
