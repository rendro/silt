-- repeat: 5
-- stderr-not-contains: deadlock
-- stderr-not-contains: panicked
-- 32 senders hand off to one receiver over a rendezvous channel; every
-- value arrives (1+..+32 = 528) and no false deadlock fires.
import channel
import list
import task

fn main() {
  let ch = channel.new(0)
  let done = channel.new(32)
  let senders = 1..32
    |> list.map { i ->
      { ->
        channel.send(ch, i)
        let _ = channel.try_send(done, i)
      }
    }
  -- The receiver drains 32 values.
  let receiver = { ->
    let go = { c, acc ->
      match c >= 32 {
        true -> acc
        _ -> match channel.receive(ch) {
          Some(v) -> go(c + 1, acc + v)
          None -> acc
        }
      }
    }
    let sum = go(0, 0)
    -- 1+2+...+32 == 32*33/2 == 528
    println("sum={sum}")
  }
  task.join(list.append(senders, receiver))
}
