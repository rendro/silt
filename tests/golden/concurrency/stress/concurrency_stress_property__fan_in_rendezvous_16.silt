-- repeat: 8
-- stderr-not-contains: deadlock
-- stderr-not-contains: panicked
-- Fan-in: 16 senders hand off to one receiver over a rendezvous channel
-- (1+..+16 = 136); no false deadlock, no scheduler panic.
import channel
import list
import task

fn main() {
  let ch = channel.new(0)
  let senders = 1..16 |> list.map { i -> { -> channel.send(ch, i) } }
  let receiver = { ->
    let go = { c, acc ->
      match c >= 16 {
        true -> acc
        _ -> match channel.receive(ch) {
          Some(v) -> go(c + 1, acc + v)
          None -> acc
        }
      }
    }
    let sum = go(0, 0)
    println("sum={sum}")
  }
  task.join(list.append(senders, receiver))
}
