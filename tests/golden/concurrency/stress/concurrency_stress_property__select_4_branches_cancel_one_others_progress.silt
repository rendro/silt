-- repeat: 3
-- stderr-not-contains: deadlock
-- stderr-not-contains: panicked
-- Select over four channels with one (slow) sender cancelled: the other
-- three still deliver (1+2+4 = 7).
import channel
import task
import time

fn main() {
  let a = channel.new(0)
  let b = channel.new(0)
  let c = channel.new(0)
  let d = channel.new(0)

  let sa = task.spawn({ ->
    time.sleep(time.ms(5))
    channel.send(a, 1)
  })
  let sb = task.spawn({ ->
    time.sleep(time.ms(10))
    channel.send(b, 2)
  })
  let sc = task.spawn({ ->  -- slow; will be cancelled
    time.sleep(time.ms(500))
    channel.send(c, 3)
  })
  let sd = task.spawn({ ->
    time.sleep(time.ms(20))
    channel.send(d, 4)
  })

  time.sleep(time.ms(1))
  task.cancel(sc)

  -- Drain a, b, d via select (c never delivers).
  let sum = loop collected = 0, acc = 0 {
    match collected >= 3 {
      true -> acc
      _ -> {
        match channel.select([channel.Recv(a), channel.Recv(b), channel.Recv(c), channel.Recv(d)]) {
          (_, channel.Message(v)) -> loop(collected + 1, acc + v)
          (_, channel.Closed) -> acc
          (_, channel.Empty) -> acc
          (_, channel.Sent) -> acc
        }
      }
    }
  }
  println("sum={sum}")
}
