-- repeat: 100
-- stderr-not-contains: deadlock
-- 40 senders push 25 jobs each through a channel of capacity 10 to 4
-- workers, which push the results through another: every job arrives
-- once (the sum of 1..1000 doubled).
import channel
import list
import task

fn main() {
  let jobs = channel.new(10)
  let results = channel.new(10)
  let senders = 0..39
    |> list.map { s -> { -> 1..25 |> list.each { j -> channel.send(jobs, s * 25 + j) } } }
  let send_all = { ->
    task.join(senders)
    channel.close(jobs)
  }
  let work = { -> task.each(jobs, 4) { n -> channel.send(results, n * 2) } }
  let collect = { ->
    let go = { left, acc ->
      match left {
        0 -> acc
        _ -> match channel.receive(results) {
          Some(v) -> go(left - 1, acc + v)
          None -> acc
        }
      }
    }
    let sum = go(1000, 0)
    println("sum={sum}")
  }
  task.join([send_all, work, collect])
}
