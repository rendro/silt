-- timeout: 60
-- repeat: 20
-- A duration of zero or less is a time that is over when the function
-- starts, and the rule is the one of every function whose time is
-- over: it takes nothing new, and it runs on only for the steps a late
-- function has. So a function that returns without taking or waiting
-- is `Ok`, and one that gives what it holds (a send into room) is too.
-- A function that receives is ended there, `Err(Timeout)`, whether or
-- not a value is there, every time: the values that were there are
-- still there afterwards. One that would wait is ended there, and one
-- that computes on is ended when those steps are used up.
import channel
import task
import time

fn count(n, acc) {
  match n {
    0 -> acc
    _ -> count(n - 1, acc + 1)
  }
}

fn main() {
  let empty: Channel(Int) = channel.new(1)
  let full: Channel(Int) = channel.new(2)
  channel.send(full, 7)
  channel.send(full, 8)
  let room: Channel(Int) = channel.new(2)
  println("returns at once: {task.deadline(time.ms(0), { -> 1 })}")
  println("returns at once, negative: {task.deadline(time.ms(-5), { -> 1 })}")
  println("computes a little: {task.deadline(time.ms(0), { -> count(100, 0) })}")
  println("sends into room: {task.deadline(time.ms(0), { -> channel.send(room, 1) })}")
  println("receives, a value is there: {task.deadline(time.ms(0), { -> channel.receive(full) })}")
  let tried = task.deadline(time.ms(0), { -> channel.try_receive(full) })
  println("tries to receive, a value is there: {tried}")
  let selected = task.deadline(time.ms(0), { ->
    match channel.select([channel.Recv(empty), channel.Recv(full)]) {
      channel.Received(_, value) -> value
      channel.Sent(_) -> None
    }
  })
  println("selects, a value is there: {selected}")
  println("receives, nothing is there: {task.deadline(time.ms(0), { -> channel.receive(empty) })}")
  let negative = task.deadline(time.ms(-5), { -> channel.receive(empty) })
  println("receives, nothing is there, negative: {negative}")
  println("sleeps: {task.deadline(time.ms(0), { -> time.sleep(time.ms(1)) })}")
  println("computes on: {task.deadline(time.ms(0), { -> count(2000000000, 0) })}")
  println("what was sent is there: {channel.try_receive(room)}")
  println("what was there is still there: {channel.try_receive(full)} {channel.try_receive(full)}")
  println("and nothing else: {channel.try_receive(empty)} {channel.try_receive(full)}")
}
