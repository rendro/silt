-- timeout: 120
-- A deadline inside a deadline, and the outer time comes first: the
-- inner function has the outer time too, and is ended by the same
-- rule. It took a value, and the outer `task.deadline` gives `Some` of
-- the inner `Some`; or it took none, and the outer one gives
-- `None`. The inner `None` is never the outer
-- function's value: when the inner function was ended at the outer
-- time, the outer function is over too.
import channel
import task
import time

fn main() {
  let ch: Channel(Int) = channel.new(0)
  let producer = { ->
    let step = { i ->
      match i >= 100 {
        true -> return channel.close(ch)
        false -> {
          time.sleep(time.ms(3))
          channel.send(ch, i)
          step(i + 1)
        }
      }
    }
    step(0)
  }
  let consumer = { ->
    let go = { got, sum, inner_timeouts ->
      let out = task.deadline(time.ms(3)) { ->
        task.deadline(time.hours(1)) { -> channel.receive(ch) }
      }
      match out {
        Some(Some(Some(v))) -> go(got + 1, sum + v, inner_timeouts)
        Some(Some(None)) -> (got, sum, inner_timeouts)
        Some(None) -> go(got, sum, inner_timeouts + 1)
        None -> go(got, sum, inner_timeouts)
      }
    }
    let r = go(0, 0, 0)
    match r {
      (got, sum, inner_timeouts) -> {
        println("sent 100 (sum 4950), received {got} (sum {sum})")
        println("the inner None as the outer function's value: {inner_timeouts}")
      }
    }
  }
  task.join([producer, consumer])
}
