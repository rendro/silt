-- timeout: 120
-- A send under a deadline was either done, and `task.deadline` gives
-- `Some`, or was not, and it gives `None`: never a value that
-- arrived from a send reported as timed out. The sender tries each of
-- 150 numbers again until its send is `Some`; the consumer takes one
-- about every 3 ms. Whatever the timing, it gets each number once.
import channel
import task
import time

fn main() {
  let ch: Channel(Int) = channel.new(0)
  let consumer = { ->
    let step = { n, sum ->
      time.sleep(time.ms(3))
      match channel.receive(ch) {
        Some(v) -> step(n + 1, sum + v)
        None -> (n, sum)
      }
    }
    let r = step(0, 0)
    match r {
      (got, sum) ->
        println("150 sends were Ok (sum 11175); the consumer received {got} (sum {sum})")
    }
  }
  let sender = { ->
    let go = { i ->
      match i >= 150 {
        true -> ()
        false -> match task.deadline(time.ms(3), { -> channel.send(ch, i) }) {
          Some(_) -> go(i + 1)
          None -> go(i)
        }
      }
    }
    go(0)
    channel.close(ch)
  }
  task.join([consumer, sender])
}
