-- exit: 1
-- stderr-contains: error[runtime]: division by zero
-- A function that fails in the time slice in which its time passes
-- (here the time is over from the start) has failed: `task.deadline`
-- raises the failure, and never answers `Err(Timeout)` for it.
import task
import time

fn main() {
  let zero = 0
  println(task.deadline(time.ms(0), { -> 1 / zero }))
}
