-- timeout: 60
-- A deadline ends its function and nothing else. A task the function
-- spawned goes on and does its work; a task the function was joining
-- goes on, and its result is there for a later join. Each of the two
-- waits for a message that is sent only after the deadline has given
-- `Err(Timeout)`, so the order does not depend on the clock.
import channel
import task
import time

fn main() {
  let go: Channel(Int) = channel.new(2)
  let done: Channel(String) = channel.new(2)
  let joined = task.spawn { ->
    let _ = channel.receive(go)
    "the task that was being joined returned"
  }
  let out = task.deadline(time.ms(20), { ->
    let _ = task.spawn { ->
      let _ = channel.receive(go)
      channel.send(done, "the task that the function spawned went on")
    }
    task.join(joined)
  })
  println(out)
  channel.send(go, 1)
  channel.send(go, 2)
  println(channel.receive(done))
  println(task.join(joined))
}
