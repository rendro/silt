-- `task.deadline(dur, f)` gives `Ok` of what `f` returns when `f`
-- returns before `dur` has passed: a value, a `Result` of its own, the
-- value of a builtin function.
import task
import time
import uuid

fn main() {
  println(task.deadline(time.seconds(60), { -> 1 + 1 }))
  println(task.deadline(time.seconds(60), { ->
    time.sleep(time.ms(5))
    "slept"
  }))
  println(task.deadline(time.seconds(60), { -> time.date(2024, 2, 30) }))
  println(task.deadline(time.seconds(60), uuid.nil))
  let run = task.deadline
  match run(time.seconds(60), { -> [1, 2, 3] }) {
    Ok(xs) -> println(xs)
    Err(task.Timeout) -> println("timed out")
    Err(e) -> println(Error.message(e))
  }
}
