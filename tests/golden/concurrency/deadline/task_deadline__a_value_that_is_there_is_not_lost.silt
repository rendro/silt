-- timeout: 120
-- A buffered channel holds one value. A receive under a deadline that
-- answers `Err(Timeout)` has left it there. 500 rounds with the
-- function sleeping first for about as long as its deadline, so that
-- the time passes around the receive, and 500 with a deadline that is
-- over when the function starts.
import channel
import task
import time

fn round(dur, before) {
  let ch: Channel(Int) = channel.new(1)
  channel.send(ch, 7)
  let out = task.deadline(dur, { ->
    time.sleep(before)
    channel.receive(ch)
  })
  match (out, channel.try_receive(ch)) {
    (Ok(channel.Message(7)), channel.Empty) -> 0
    (Err(_), channel.Message(7)) -> 0
    _ -> 1
  }
}

fn wrong(dur, before) {
  loop i = 0, wrong = 0 {
    match i >= 500 {
      true -> wrong
      false -> loop(i + 1, wrong + round(dur, before))
    }
  }
}

fn main() {
  println("the value neither received nor left, deadline about the sleep: {wrong(time.micros(300), time.micros(300))}")
  println("the value neither received nor left, deadline zero: {wrong(time.ms(0), time.ms(0))}")
}
