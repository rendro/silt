-- A past deadline short-circuits http.get at entry with the http
-- module's own typed timeout, HttpTimeout.
import http
import task
import time

fn main() {
  let outcome = task.deadline(time.ms(0), { ->
    http.get("http://127.0.0.1:1/does-not-exist")
  })
  match outcome {
    Ok(_) -> println("unexpected ok")
    Err(http.HttpTimeout) -> println("http-timeout")
    Err(other) -> println("other: {other.message()}")
  }
}
