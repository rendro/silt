-- Once task.deadline's scope ends, later I/O runs with no deadline.
import io
import task
import time

fn main() {
  let _inside = task.deadline(time.ms(0), { ->
    io.read_file("/nonexistent_path")
  })
  match io.read_file("fixture.txt") {
    Ok(content) -> println(content)
    Err(msg) -> println(msg)
  }
}
