-- timeout: 120
-- requires-feature: tcp
-- An accept under a deadline: a connection is given to the function,
-- and `task.deadline` gives `Some` of it, or it stays with the listener
-- for the next accept. A client connects 100 times, about every 3 ms;
-- the server gives its accept up every 3 ms and accepts again. When
-- the client has stopped, the server accepts until nothing has come
-- for 20 deadlines. Whatever the timing, it is given every connection
-- that was made.
import channel
import task
import tcp
import time

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let port = tcp.local_port(listener)
  let done: Channel(Int) = channel.new(1)
  let client = { ->
    let step = { i, made ->
      match i >= 100 {
        true -> made
        false -> {
          time.sleep(time.ms(3))
          match tcp.connect("127.0.0.1:{port}") {
            Ok(_) -> step(i + 1, made + 1)
            Err(_) -> step(i + 1, made)
          }
        }
      }
    }
    let made = step(0, 0)
    channel.close(done)
    made
  }
  let server = { ->
    let go = { given, idle ->
      match task.deadline(time.ms(3), { -> tcp.accept(listener) }) {
        Some(Ok(c)) -> {
          tcp.close(c)
          go(given + 1, 0)
        }
        Some(Err(e)) -> panic("accept failed: {e}")
        None -> match channel.try_receive(done) {
          channel.Closed -> match idle >= 20 {
            true -> given
            false -> go(given, idle + 1)
          }
          _ -> go(given, idle)
        }
      }
    }
    go(0, 0)
  }
  match task.map([client, server], 2, { f -> f() }) {
    [made, given] -> println("connections made and not given to the server: {made - given}")
    _ -> panic("two counts")
  }
}
