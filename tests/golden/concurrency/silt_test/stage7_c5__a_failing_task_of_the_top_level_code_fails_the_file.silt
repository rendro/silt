-- A task of the file's top-level code that a test makes fail is a
-- failure of the file, reported after the file's last test;
-- the test itself is judged by what it did. The next test, which
-- needs the task, is deadlocked, and told so at once.
import channel
import task
import test

let requests = channel.new(0)
let server = task.spawn({ ->
  channel.each(requests) { n -> 10 / n }
})

fn test_asks_for_too_much() {
  channel.send(requests, 0)
  test.assert_eq(1, 1)
}

fn test_finds_nobody() {
  channel.send(requests, 1)
}
