-- cmd: test
-- exit: 1
-- repeat: 20
-- stderr-contains: FAIL stage7_c5__a_task_that_fails_after_its_test_returned_fails_that_test.silt::test_a_leaves_a_task_that_fails
-- stderr-contains: PASS stage7_c5__a_task_that_fails_after_its_test_returned_fails_that_test.silt::test_b_is_not_charged
-- stderr-contains: PASS stage7_c5__a_task_that_fails_after_its_test_returned_fails_that_test.silt::test_c_does_not_wait_for_what_others_left
-- stderr-contains: 3 tests: 2 passed, 1 failed
-- A test has ended when its tasks can do no more. A task that fails
-- after the test function returned fails that test, not a later one;
-- and a later test neither waits for nor is told of what an earlier
-- test left parked.
import channel
import task
import test
import time

fn test_a_leaves_a_task_that_fails() {
  let never = channel.new(0)
  let _parked = task.spawn({ -> channel.receive(never) })
  let _late = task.spawn({ ->
    time.sleep(time.ms(5))
    1 / 0
  })
  test.assert_eq(1, 1)
}

fn test_b_is_not_charged() {
  test.assert_eq(1 + 1, 2)
}

fn test_c_does_not_wait_for_what_others_left() {
  let ch = channel.new(0)
  let h = task.spawn({ -> channel.send(ch, 5) })
  when let channel.Message(v) = channel.receive(ch) else { panic("closed") }
  task.join(h)
  test.assert_eq(v, 5)
}
