-- A test that returns `Err` has failed, like one whose assertion
-- fails: its ticker is stopped, and the next test runs.
import task
import test
import time

fn step() -> Result(Int, String) {
  Err("no luck")
}

fn test_a_gives_up() -> Result(Int, String) {
  let ticker = task.spawn { ->
    loop {
      time.sleep(time.ms(1))
      loop()
    }
  }
  let v = step()?
  task.cancel(ticker)
  Ok(v)
}

fn test_b_runs() {
  test.assert_eq(1, 1)
}
