-- After its time is over a function takes nothing new; it may still
-- give what it holds. In the steps it has left, a send that can be done
-- at once is done (`channel.send`, `channel.try_send`, a `Send` arm of
-- a `channel.select`). The first operation that would take something
-- ends the function, whether or not the thing is there: the value on
-- the `Recv` arm of its last select is still in its channel afterwards,
-- and the `Send` arm beside it, which had no room, sent nothing. This
-- is the rule of every stopped task.
--
-- The deadline is zero, a time that is over from the start, so the
-- stop comes at a known place, whatever the machine does. The function
-- gives a last value before the select that ends it; `main` looks when
-- the deadline has given `None`.
import channel
import task
import time

fn main() {
  let given: Channel(Int) = channel.new(8)
  let full: Channel(Int) = channel.new(1)
  channel.send(full, 1)
  let out = task.deadline(time.ms(0)) { ->
    println("past its time, and still running")
    channel.send(given, 1)
    println("a send into room: done")
    println("a try_send into room: {channel.try_send(given, 2)}")
    let how = match channel.select([channel.Recv(full), channel.Send(given, 3)]) {
      channel.Sent(_) -> "sent"
      _ -> "something else"
    }
    println("a select with a value to receive and room to send: {how}")
    println("the next select has a value to receive and no room to send")
    channel.send(given, 4)
    let _ = channel.select([channel.Recv(full), channel.Send(full, 9)])
    println("not reached")
  }
  println("the deadline gave {out}")
  let got = loop got = [] {
    match channel.receive(given) {
      Some(4) -> got
      Some(v) -> loop([..got, v])
      None -> got
    }
  }
  println("what the function gave before its last select: {got}")
  println("the value to receive is still there: {channel.receive(full)}")
  println("and nothing was sent after it: {channel.try_receive(full)}")
}
