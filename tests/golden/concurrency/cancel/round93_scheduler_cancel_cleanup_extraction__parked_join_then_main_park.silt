-- repeat: 3
-- stderr-not-contains: deadlock
-- Cancelling a task parked on task.join leaves the scheduler clean.
import channel
import task
import time

fn main() {
  let dead = channel.new(0)
  let joinee = task.spawn({ -> channel.receive(dead) })
  let victim = task.spawn({ -> task.join(joinee) })
  time.sleep(time.ms(50))
  task.cancel(victim)
  task.cancel(joinee)
  time.sleep(time.ms(50))
  let ch = channel.new(0)
  let feeder = task.spawn({ -> channel.send(ch, 42) })
  let got = match channel.receive(ch) {
    channel.Message(v) -> v
    _ -> 0
  }
  let _ = task.join(feeder)
  println("{got}")
}
