-- repeat: 3
-- stderr-not-contains: deadlock
-- Stopping a task parked on task.join (and its piece, parked on a receive) (its deadline passed) leaves
-- the scheduler clean. (The feeder is the function of a
-- `stream.from_fn`, which runs beside the program's own thread.)
import channel
import stream
import task
import time

fn main() {
  let dead = channel.new(0)
  let joinee = { ->
    let _ = channel.receive(dead)
  }
  let _ = task.deadline(time.ms(50)) { -> task.join([joinee]) }
  time.sleep(time.ms(50))
  let ch = channel.new(0)
  let feeder = stream.from_fn { _ -> channel.send(ch, 42) }
  let got = match channel.receive(ch) {
    Some(v) -> v
    None -> 0
  }
  let _ = stream.collect(feeder)
  println("{got}")
}
