-- repeat: 3
-- stderr-not-contains: deadlock
-- B4: as B3 on a full buffered channel (capacity 1) after a drain.
import channel
import task
import time

fn main() {
  let ch = channel.new(1)
  channel.send(ch, 100) -- fill the buffer
  -- blocks until its deadline stops it
  let dead = { ->
    let _ = task.deadline(time.ms(100)) { -> channel.send(ch, 999) }
  }
  -- queued behind
  let real = { ->
    time.sleep(time.ms(50))
    channel.send(ch, 7)
  }
  -- Drain the initial value after the stop. With the bug, wake_send pops
  -- the dead waker (no-op) and `real` never wakes. With the fix, `real`
  -- wakes and its value lands in the buffer.
  let drain = { ->
    time.sleep(time.ms(150))
    match channel.receive(ch) {
      Some(_) -> ()
      None -> ()
    }
    -- After `real` sent, its 7 must be in the buffer.
    match channel.receive(ch) {
      Some(v) -> println(v)
      None -> println("CLOSED_OR_EMPTY")
    }
  }
  task.join([dead, real, drain])
}
