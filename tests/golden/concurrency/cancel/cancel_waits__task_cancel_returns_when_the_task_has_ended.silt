-- The stop of a helper (its body returned) waits until the helper has
-- ended: what a stopped task does in its last steps is done when
-- `task.background` returns, so a close after it loses nothing.
import channel
import list
import task

-- A few hundred steps of work: fewer than a stopped task has.
fn work(n: Int) -> Int {
  list.fold(1..100, n) { acc, i -> acc + i % 3 }
}

-- How many values a closed channel still holds.
fn count(ch: Channel(Int)) -> Int {
  let go = { n ->
    match channel.try_receive(ch) {
      channel.Message(_) -> go(n + 1)
      _ -> n
    }
  }
  go(0)
}

fn main() {
  -- A worker that was handed an item when the stop came still puts its
  -- result into the output channel, which has room: the stop waits for
  -- that.
  let input = channel.new(0)
  let out = channel.new(10)
  let worker = { -> channel.each(input) { item -> channel.send(out, work(item)) } }
  task.background([worker]) { -> channel.send(input, 1) }
  channel.close(out)
  println("results after the stop: {count(out)}")
}
