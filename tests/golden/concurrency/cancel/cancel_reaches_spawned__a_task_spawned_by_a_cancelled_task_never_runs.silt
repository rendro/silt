-- A join that a function calls after its time is over ends the
-- function there: none of its pieces runs. The deadline is zero, a time
-- that is over from the start, so the stop comes at a known place.
import channel
import task
import time

fn main() {
  let ran: Channel(String) = channel.new(1)
  let given: Channel(Int) = channel.new(1)
  let _ = task.deadline(time.ms(0)) { ->
    channel.send(given, 1)
    task.join([{ -> channel.send(ran, "the piece ran") }])
    println("not reached")
  }
  println("the function went on: {channel.receive(given)}")
  -- A piece that ran would have sent by now.
  time.sleep(time.ms(20))
  println("its piece: {channel.try_receive(ran)}")
}
