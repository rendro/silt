-- repeat: 10
-- stderr-not-contains: deadlock
-- A helper is parked in `channel.receive`; a second helper wakes it
-- while the body returns, which stops it. Without the fix about two of
-- three runs hang inside the stop.
import channel
import task
import time

fn spin(n) {
  match n {
    0 -> 0
    _ -> spin(n - 1)
  }
}

fn go(i, n) {
  match i < n {
    true -> {
      let ch = channel.new(1)
      let parked = { ->
        let _ = channel.receive(ch)
      }
      let waker = { ->
        time.sleep(time.ms(2))
        let _ = channel.try_send(ch, i)
      }
      task.background([parked, waker]) { ->
        time.sleep(time.ms(2))
        let _ = spin(i % 30)
      }
      go(i + 1, n)
    }
    false -> ()
  }
}

fn main() {
  go(0, 100)
  println("completed 100 rounds")
}
