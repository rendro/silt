-- repeat: 3
-- stderr-not-contains: deadlock
-- B3: a stopped sender at the head of the waker queue must not starve
-- a real sender queued behind it (rendezvous channel).
import channel
import task
import time

fn main() {
  let ch = channel.new(0)
  -- First sender: its deadline stops it. Its waker is HEAD of FIFO.
  let dead = { ->
    let _ = task.deadline(time.ms(100)) { -> channel.send(ch, 999) }
  }
  -- Second sender: real, behind `dead` in FIFO.
  let real = { ->
    time.sleep(time.ms(50))
    channel.send(ch, 7)
  }
  -- Bring a receiver after the stop. With the bug, wake_send pops the
  -- dead waker first (no-op) and `real` never wakes. With the fix, the
  -- dead waker was deregistered on the stop, so `real` is at the head
  -- and handshakes normally.
  let recv = { ->
    time.sleep(time.ms(150))
    match channel.receive(ch) {
      Some(v) -> println(v)
      None -> println(-1)
    }
  }
  task.join([dead, real, recv])
}
