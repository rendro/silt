-- repeat: 100
-- stderr-not-contains: deadlock
-- A send and a stop race for a helper that receives. Whichever wins,
-- the helper is gone when `task.background` has returned: a second
-- send finds no receiver, 300 times.
import channel
import task

fn main() {
  let stale = loop left = 300, stale = 0 {
    match left {
      0 -> stale
      _ -> {
        let ch = channel.new(0)
        let receiver = { ->
          let _ = channel.receive(ch)
        }
        task.background([receiver]) { ->
          let _ = channel.try_send(ch, left)
        }
        match channel.try_send(ch, left) {
          true -> loop(left - 1, stale + 1)
          false -> loop(left - 1, stale)
        }
      }
    }
  }
  println("receivers left after a stop: {stale}")
}
