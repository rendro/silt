-- A task that is cancelled and still runs completes a `channel.select`
-- of which an arm is ready, as it completes a `channel.receive` of a
-- value that is there; a select that would have to wait ends the task,
-- with nothing taken and nothing sent. It is the rule of a function
-- that is past its `task.deadline`.
--
-- The task cancels itself, so the cancel comes at a known place,
-- whatever the machine does: from there on it is cancelled and
-- running, and the few steps below are well within what it has.
import channel
import task
import time

fn main() {
  let own: Channel(task.Handle(())) = channel.new(1)
  let full: Channel(Int) = channel.new(1)
  channel.send(full, 1)
  let room: Channel(Int) = channel.new(1)
  let empty: Channel(Int) = channel.new(1)
  let meet: Channel(Int) = channel.new(0)
  let timed_out = channel.timeout(time.ms(0))
  let _ = channel.receive(timed_out)
  let t = task.spawn { ->
    match channel.receive(own) {
      channel.Message(me) -> task.cancel(me)
      _ -> ()
    }
    println("cancelled, and still running")
    match channel.select([channel.Recv(full)]) {
      (_, channel.Message(v)) -> println("a value on the Recv arm: received {v}")
      _ -> println("a value on the Recv arm: something else")
    }
    match channel.select([channel.Send(room, 2)]) {
      (_, channel.Sent) -> println("room on the Send arm: sent")
      _ -> println("room on the Send arm: something else")
    }
    match channel.select([channel.Recv(empty), channel.Recv(timed_out)]) {
      (_, channel.Closed) -> println("a timeout arm that has closed: closed")
      _ -> println("a timeout arm that has closed: something else")
    }
    match channel.select([channel.Recv(empty), channel.Send(meet, 3), channel.Recv(room)]) {
      (_, channel.Message(v)) -> println("three arms, the last one ready: received {v}")
      _ -> println("three arms, the last one ready: something else")
    }
    println("no arm is ready now: the task ends in this select")
    let _ = channel.select(
      [channel.Recv(empty), channel.Send(meet, 4), channel.Recv(channel.timeout(time.hours(1)))],
    )
    println("not reached")
  }
  channel.send(own, t)
}
