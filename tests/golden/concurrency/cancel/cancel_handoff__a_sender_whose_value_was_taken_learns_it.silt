-- timeout: 120
-- A task that waited to send, in a `select` with a `Send` arm, and
-- whose value a receiver took is not dropped when a cancel arrives
-- before it has run again: it goes on, knowing that it sent, for a
-- bounded number of steps, enough to say so by an operation that does
-- not wait.
--
-- Each round a sender waits to send one number, a receiver takes it
-- or gives up, and the sender is cancelled at about that moment.
-- Whenever the receiver has the number, the sender's own record of the
-- send (`sent`) comes: `main` waits for it without a time limit, and a
-- record that never came would leave `main` waiting for ever, which is
-- a deadlock. And when the receiver gave up, the sender was cancelled
-- while it waited, or before it ran: it sent nothing and recorded
-- nothing.
import channel
import task
import time

-- 1 if the number of round `i` was received, and its sender recorded
-- that; 0 if it was not received.
fn round(i) {
  let ch: Channel(Int) = channel.new(0)
  let sent: Channel(Int) = channel.new(1)
  let sender = task.spawn { ->
    match channel.select([channel.Send(ch, i)]) {
      (_, channel.Sent) -> channel.send(sent, i)
      _ -> ()
    }
  }
  let receiver = task.spawn { ->
    time.sleep(time.ms(1))
    match channel.select([channel.Recv(ch), channel.Recv(channel.timeout(time.ms(3)))]) {
      (_, channel.Message(v)) -> v
      _ -> -1
    }
  }
  time.sleep(time.ms(1))
  task.cancel(sender)
  match task.join(receiver) {
    -1 -> match channel.try_receive(sent) {
      channel.Empty -> 0
      _ -> panic("round {i}: a record of a number that nobody received")
    }
    v -> match channel.receive(sent) {
      channel.Message(^v) -> 1
      _ -> panic("round {i}: another record than of the number that was received")
    }
  }
}

fn main() {
  let all = loop i = 0, recorded = 0, received = 0 {
    match i >= 400 {
      true -> recorded == received
      false -> {
        let n = round(i)
        loop(i + 1, recorded + n, received + n)
      }
    }
  }
  println("every number that a receiver took has its sender's record: {all}")
}
