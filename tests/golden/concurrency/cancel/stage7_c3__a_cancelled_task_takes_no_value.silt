-- repeat: 100
-- timeout: 30
-- A helper that is stopped while it runs (its body returned) takes
-- nothing new: it is ended where it next looks for `go`, never reaches
-- its receives, and the two values in the buffer stay.
--
-- The stop comes before the work, whatever the machine does: the
-- helper looks for `go` without waiting, the body returns when it has
-- started, and `main` only then sends `go`. (And between `go` and the first receive lies far
-- more work than the steps a cancelled task has.)
import channel
import task
import time

fn spin(n) {
  match n {
    0 -> ()
    _ -> spin(n - 1)
  }
}

fn until_go(go) {
  match channel.try_receive(go) {
    channel.Message(_) -> ()
    _ -> until_go(go)
  }
}

fn main() {
  let buf = channel.new(2)
  channel.send(buf, 1)
  channel.send(buf, 2)
  let started = channel.new(1)
  let go = channel.new(1)
  let taken = channel.new(2)
  let helper = { ->
    channel.send(started, ())
    until_go(go)
    spin(100000)
    loop {
      match channel.receive(buf) {
        Some(v) -> {
          channel.send(taken, v)
          loop()
        }
        None -> ()
      }
    }
  }
  task.background([helper]) { ->
    let _ = channel.receive(started)
  }
  channel.send(go, ())
  time.sleep(time.ms(250))
  println("taken: {channel.try_receive(taken)}")
  println("left: {channel.try_receive(buf)} {channel.try_receive(buf)}")
}
