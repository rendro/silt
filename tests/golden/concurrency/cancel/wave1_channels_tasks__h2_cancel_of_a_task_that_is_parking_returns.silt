-- repeat: 10
-- stderr-not-contains: deadlock
-- Stop a helper (its body returns) while it is about to park, or has
-- just parked, in `channel.receive`. Without the fix about half of the
-- runs hang inside the stop.
import channel
import task

fn spin(n) {
  match n {
    0 -> 0
    _ -> spin(n - 1)
  }
}

fn go(i, n) {
  match i < n {
    true -> {
      let ch = channel.new(1)
      let parked = { ->
        let _ = channel.receive(ch)
      }
      task.background([parked]) { ->
        let _ = spin(i % 40)
      }
      go(i + 1, n)
    }
    false -> ()
  }
}

fn main() {
  go(0, 200)
  println("completed 200 rounds")
}
