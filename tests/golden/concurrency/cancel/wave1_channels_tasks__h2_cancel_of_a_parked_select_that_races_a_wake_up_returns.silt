-- repeat: 10
-- stderr-not-contains: deadlock on main thread
-- The same race with a task that is parked in `channel.select`. The
-- select arm of the scheduler keeps the waker registrations of its
-- arms apart from the other park arms, so it has a test of its own.
-- Without the fix nine of ten runs hang inside `task.cancel`.
import channel
import task
import time

fn spin(n) {
  match n {
    0 -> 0
    _ -> spin(n - 1)
  }
}

fn go(i, n) {
  match i < n {
    true -> {
      let a = channel.new(1)
      let b = channel.new(1)
      let t = task.spawn({ -> channel.select([Recv(a), Recv(b)]) })
      time.sleep(time.ms(2))
      let s = task.spawn({ -> channel.try_send(b, i) })
      let _ = spin(i % 30)
      task.cancel(t)
      let _ = task.join(s)
      go(i + 1, n)
    }
    false -> ()
  }
}

fn main() {
  go(0, 100)
  println("completed 100 rounds")
}
