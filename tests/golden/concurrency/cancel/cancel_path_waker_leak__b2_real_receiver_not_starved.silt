-- repeat: 3
-- stderr-not-contains: deadlock
-- B2: a cancelled receiver at the head of the waker queue must not
-- starve a real receiver queued behind it.
import channel
import task
import time

fn main() {
  let ch = channel.new(0)
  -- First receiver: gets cancelled. Its waker stays at HEAD of FIFO.
  let dead = task.spawn({ ->
    match channel.receive(ch) {
      Message(_v) -> 1
      _ -> -1
    }
  })
  time.sleep(time.ms(50))
  -- Second receiver: real, behind `dead` in FIFO.
  let real = task.spawn({ ->
    match channel.receive(ch) {
      Message(v) -> v
      _ -> -1
    }
  })
  time.sleep(time.ms(50))
  task.cancel(dead)
  time.sleep(time.ms(50))
  -- Send a value. With the bug, wake_recv pops the dead waker (no-op)
  -- and `real` never wakes. With the fix, the dead waker was
  -- deregistered on cancel, so `real` is at the head and wakes
  -- normally.
  let snd = task.spawn({ ->
    channel.send(ch, 7)
  })
  time.sleep(time.ms(50))
  let r = task.join(real)
  let _ = task.join(snd)
  println(r)
}
