-- A task that only computes inside `list.fold` gives way like any other:
-- with every worker busy in such a task, a task that does nothing still
-- gets its turn long before any of them is done.
--
-- Shown by order, not by a clock: every task says on one channel when
-- it has run to its end, and the first to say so is the idle one. It is
-- queued behind 64 folds of nine million steps each; if a fold did not
-- give way, the workers would run folds to their ends first.
import channel
import list
import task

fn busy(done) {
  let sum = list.fold(1..3000, 0) { acc, x ->
    list.fold(1..3000, acc) { inner, y -> (inner + x * y) % 1000003 }
  }
  channel.send(done, "a fold of sum {sum}")
}

fn main() {
  let done = channel.new(128)
  let workers = list.map(1..64) { _ -> task.spawn { -> busy(done) } }
  let idle = task.spawn { -> channel.send(done, "the idle task") }
  match channel.receive(done) {
    channel.Message(first) -> println("first to end: {first}")
    _ -> println("nothing ended")
  }
  list.each(workers, task.cancel)
  task.join(idle)
}
