-- exit: 1
-- The failure that task.join raises points at where the piece failed,
-- and its call stack goes on, below the piece's own calls, with the
-- calls that led to the join: wait_for's task.join and main's call of
-- wait_for.
import task

fn work(n) {
  let _ = 100 / n
}

fn wait_for(pieces) {
  task.join(pieces)
}

fn main() {
  wait_for([{ -> work(0) }])
  println("not reached")
}
