-- exit: 1
-- A failure that goes through several joins is one report: the call
-- stack shows the pieces it went through and their joins.
import task

fn work(n) {
  let _ = 100 / n
}

fn inner() {
  task.join([{ -> work(0) }])
}

fn middle() {
  task.join([{ -> inner() }])
}

fn main() {
  task.join([{ -> middle() }])
  println("not reached")
}
