-- timeout: 10
-- A worker pool is left waiting for jobs (dropped at the end, by the
-- rule), and a `select` timeout of a minute lost its race. No task
-- waits on the timeout channel, so it holds nothing up: the program
-- ends at once.
import channel
import list
import task

fn main() {
  let jobs = channel.new(0)
  let results = channel.new(1)
  let _workers = 1..3 |> list.map { _ ->
    task.spawn { -> channel.each(jobs) { j -> channel.send(results, j + 1) } }
  }
  channel.send(jobs, 6)
  match channel.select([channel.Recv(results), channel.Recv(channel.timeout(60000))]) {
    (_, channel.Message(v)) -> println("got {v}")
    _ -> println("timed out")
  }
}
