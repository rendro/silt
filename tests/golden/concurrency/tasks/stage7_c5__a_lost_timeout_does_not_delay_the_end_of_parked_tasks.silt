-- timeout: 10
-- A worker pool is left waiting for jobs (stopped when the body
-- returns), and a `select` timeout of a minute lost its race. No task
-- waits on the timeout channel, so it holds nothing up: the program
-- ends at once.
import channel
import list
import task
import time

fn main() {
  let jobs = channel.new(0)
  let results = channel.new(1)
  let workers = 1..3
    |> list.map { _ -> { -> channel.each(jobs) { j -> channel.send(results, j + 1) } } }
  task.background(workers) { ->
    channel.send(jobs, 6)
    match channel.select([channel.Recv(results), channel.Recv(channel.timeout(time.ms(60000)))]) {
      channel.Received(_, Some(v)) -> println("got {v}")
      _ -> println("timed out")
    }
  }
}
