-- A task that calls itself for ever gives way like any other: 64 tasks
-- that never end are started before a 65th that sends a mark, and the
-- body of the `task.background` waits for that mark. With every worker
-- busy in a spinner, the 65th task gets its turn only because the
-- spinners give way; the body then has the mark. When the body has
-- returned, its scope stops the spinners, and the program goes on behind
-- it and ends.
import channel
import list
import task

fn spin(n: Int) {
  spin(n + 1)
}

fn main() {
  let mark: Channel(Int) = channel.new(0)
  let spinners = list.map(1..64) { _ -> { -> spin(0) } }
  let last = { -> channel.send(mark, 1) }
  let said = task.background([..spinners, last]) { -> channel.receive(mark) }
  println(said)
  println("the scope stopped every spinner")
}
