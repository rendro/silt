-- exit: 1
-- stderr-contains: panic: item 3 failed
-- stderr-contains: --> task_each__a_failing_function_stops_the_other_workers.silt:14:3
-- stderr-contains: main  at task_each__a_failing_function_stops_the_other_workers.silt:21:3
-- stderr-not-contains: never joined
-- stderr-not-contains: failed too
-- A call of the function that fails stops the other workers (two wait)
-- and its failure is the caller's: one report and exit 1.
import channel
import list
import task

fn fail(n: Int) -> () {
  panic("item {n} failed")
}

fn main() {
  let never: Channel(Int) = channel.new(0)
  let work = channel.new(5)
  list.each(1..5) { i -> channel.send(work, i) }
  task.each(work, 3) { n ->
    match n == 3 {
      true -> fail(n)
      false -> {
        let _ = channel.receive(never)
      }
    }
  }
  println("not reached")
}
