-- exit: 1
-- stderr-contains: error[runtime]: panic: the text says {at}
-- stderr-contains: = note: another piece failed too, at task_join__a_note_keeps_the_text_of_the_failure_it_quotes.silt:12:3: panic: the text says {at}
-- stderr-not-contains: never joined
-- A note names the place of the failure it is about; a "{at}" in the
-- text of that failure is the program's own text and stays as it is.
-- (Both pieces are woken by one close, as in the golden of two failures.)
import channel
import task

fn boom() -> () {
  panic("the text says \{at\}")
}

fn worker(ready: Channel(Int), go: Channel(Int)) -> Fn() -> () {
  { ->
    channel.send(ready, 1)
    let _ = channel.receive(go)
    boom()
  }
}

fn main() {
  let ready: Channel(Int) = channel.new(2)
  let go: Channel(Int) = channel.new(0)
  task.join(
    [
      worker(ready, go),
      worker(ready, go),
      { ->
        let _ = channel.receive(ready)
        let _ = channel.receive(ready)
        channel.close(go)
      },
    ],
  )
}
