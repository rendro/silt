-- exit: 1
-- stderr-contains: error[runtime]: panic: boom
-- stderr-contains: = note: another piece failed too, at task_join__two_failures_give_the_first_and_a_note.silt:15:3: panic: boom
-- stderr-not-contains: never read
-- Two pieces fail: the first failure is raised, and the one that came
-- while the pieces were stopped is a note under it.
-- Both failures are certain: the two pieces meet on a channel with no
-- room, so each fails only after that meeting, and after it neither
-- takes anything more. A piece that is stopped then still has the steps
-- to reach its failure, and neither was stopped before it ran.
import channel
import task

fn boom() -> () {
  panic("boom")
}

fn main() {
  let meet: Channel(Int) = channel.new(0)
  task.join(
    [
      { ->
        channel.send(meet, 1)
        boom()
      },
      { ->
        let _ = channel.receive(meet)
        boom()
      },
    ],
  )
}
