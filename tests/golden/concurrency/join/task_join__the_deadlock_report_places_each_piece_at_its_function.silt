-- Each line of the deadlock report places its piece where the piece's
-- function is written, not at the join: two pieces that wait on the same
-- channel are told apart. A function given by name is placed at its fn.
import channel
import task

fn stuck() {
  let never: Channel(Int) = channel.new(0)
  let _ = channel.receive(never)
}

fn main() {
  let a: Channel(Int) = channel.new(0)
  let b: Channel(Int) = channel.new(0)
  task.join(
    [
      { ->
        let _ = channel.receive(a)
      },
      { ->
        let _ = channel.receive(a)
      },
      { -> channel.send(b, 1) },
      stuck,
    ],
  )
}
