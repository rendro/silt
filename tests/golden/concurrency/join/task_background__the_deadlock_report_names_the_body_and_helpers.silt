-- stderr-contains: help: a helper of `task.background` at task_background__the_deadlock_report_names_the_body_and_helpers.silt:12:11 waits to receive from <channel:0>
-- stderr-contains: help: the body of `task.background` at task_background__the_deadlock_report_names_the_body_and_helpers.silt:12:11 waits to receive from <channel:0>
-- A background whose body and helpers can never go on is a deadlock of
-- the program's thread: the report has one line for each of them.
import channel
import task

fn main() {
  let a: Channel(Int) = channel.new(0)
  let _ = task.background(
    [
      { ->
        let _ = channel.receive(a)
      },
    ],
  ) { -> channel.receive(a) }
}
