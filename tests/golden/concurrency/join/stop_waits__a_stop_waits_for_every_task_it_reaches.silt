-- A stop waits for every task it reaches, however deep. The stopped
-- helper waits in a task.join, one of whose pieces waits in a
-- task.background, whose helper waits in a task.deadline, whose function
-- has taken an item: when the outer task.background returns, that work
-- is in the output. (The nested part of
-- cancel/cancel_waits__task_cancel_returns_when_the_task_has_ended, in
-- the new calls.)
-- It holds by construction: the body's send has no room, so it ends only
-- when the child has taken the item; then the body returns and the stop
-- comes. A stopped task takes nothing new but has the steps to finish
-- what it holds, and every frame that owns tasks (a join's, a
-- background's, a deadline's) waits, when the stop reaches its caller,
-- until those tasks have ended: the stop waits for every task it
-- reaches, however deep.
import channel
import list
import task
import time

-- A few hundred steps of work: fewer than a stopped task has.
fn work(n: Int) -> Int {
  list.fold(1..100, n) { acc, i -> acc + i % 3 }
}

-- How many values a closed channel still holds.
fn count(ch: Channel(Int)) -> Int {
  let step = { n ->
    match channel.try_receive(ch) {
      channel.Message(_) -> step(n + 1)
      _ -> n
    }
  }
  step(0)
}

fn forever() {
  let _ = channel.receive(channel.new(0))
}

-- Takes items, and puts the work of each into `out`, which has room.
fn serve(handed: Channel(Int), out: Channel(Int)) -> () {
  channel.each(handed) { item -> channel.send(out, work(item)) }
}

fn round() -> Int {
  let handed = channel.new(0)
  let out = channel.new(10)
  let deepest = { ->
    let _ = task.deadline(time.hours(1)) { -> serve(handed, out) }
  }
  let middle = { -> task.background([deepest]) { -> forever() } }
  let parent = { -> task.join([middle, { -> forever() }]) }
  task.background([parent]) { -> channel.send(handed, 2) }
  channel.close(out)
  count(out)
}

-- The shape, 300 times over: a stop that ended before the tasks it
-- reached shows in a few rounds in a hundred, so one run of the program
-- catches it.
fn main() {
  let go = { i, missed ->
    match i == 300 {
      true -> missed
      false -> go(i + 1, missed + 1 - round())
    }
  }
  let missed = go(0, 0)
  println("rounds without the work after the stop: {missed} of 300")
}
