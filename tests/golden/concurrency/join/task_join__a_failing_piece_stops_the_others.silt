-- A piece that fails stops the others (one that waits, one that only
-- computes) and its failure is the caller's: one report, with the
-- piece's own place and the calls that led to the join, and exit 1.
import channel
import task

fn fail(n: Int) -> Int {
  panic("piece {n} failed")
}

fn spin(n: Int) -> Int {
  spin(n + 1)
}

fn main() {
  let never: Channel(Int) = channel.new(0)
  task.join(
    [
      { ->
        let _ = channel.receive(never)
      },
      { ->
        let _ = spin(0)
      },
      { ->
        let _ = fail(3)
      },
    ],
  )
  println("not reached")
}
