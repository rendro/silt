-- exit: 1
-- repeat: 5
-- stderr-contains: deadlock on main thread: channel send with no counterparty
-- stderr-contains: the `stream.map` stage at r3_y3__the_verdict_names_a_stream_stage_and_its_place.silt:16:12 waits for its output to be read
-- stderr-contains: the `stream.filter` stage at r3_y3__the_verdict_names_a_stream_stage_and_its_place.silt:17:11 waits to receive from <channel:1>
-- stderr-not-contains: task <handle:
-- The deadlock report names each stream stage that waits, and the place
-- of the call that started it. The `map` waits for its reader to ask (it
-- sends nothing); the `filter` was asked, and waits for its input.
import channel
import stream

fn main() {
  let c = channel.new(0)
  let d = channel.new(0)
  let _s = c |> stream.map { x -> x + 1 }
  let t = d |> stream.filter { x -> x > 0 }
  let _ = channel.try_receive(t)
  channel.send(c, 1)
}
