-- repeat: 100
-- stderr-not-contains: deadlock
-- 16 senders wait on a channel without a buffer while the program is
-- busy between its receives. Every sender waits, and the program does
-- not: that is no deadlock, and every value arrives (1+..+16 = 136).
-- (The senders are the pieces of a `task.join` in the function of a
-- `stream.from_fn`, which runs beside the program's own thread.)
import channel
import list
import stream
import task

fn main() {
  let ch = channel.new(0)
  let senders = stream.from_fn { _ ->
    task.join(list.map(1..16) { i -> { -> channel.send(ch, i) } })
  }
  let step = { c, acc ->
    let go = { k ->
      match k >= 5000 {
        true -> 0
        _ -> go(k + 1)
      }
    }
    let _ = go(0)
    match c >= 16 {
      true -> acc
      _ -> match channel.receive(ch) {
        Some(v) -> step(c + 1, acc + v)
        None -> acc
      }
    }
  }
  let sum = step(0, 0)
  let _ = stream.collect(senders)
  println(sum)
}
