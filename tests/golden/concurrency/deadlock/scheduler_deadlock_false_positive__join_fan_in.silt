-- repeat: 25
-- stderr-not-contains: deadlock
-- Probabilistic: under contention the main-thread detector must not act
-- on a transiently starved snapshot. Main joins eight CPU workers.
import list
import task

fn busy(id, n) {
  loop i = 0, acc = id {
    match i >= n {
      true -> acc
      _ -> loop(i + 1, acc + i)
    }
  }
}

fn main() {
  let sums = task.map(1..8, 8) { id -> busy(id, 400) }
  println("joined {list.length(sums)}")
}
