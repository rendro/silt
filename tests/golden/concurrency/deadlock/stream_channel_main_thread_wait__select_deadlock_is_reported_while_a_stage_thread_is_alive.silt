-- exit: 1
-- repeat: 3
-- stderr-contains: deadlock on main thread
-- The same for a `channel.select` that has no stream arm.
import channel
import stream

fn main() {
  println(stream.repeat("x") |> stream.take(3) |> stream.collect)
  let a = channel.new(0)
  let b = channel.new(0)
  match channel.select([channel.Recv(a), channel.Send(b, 1)]) {
    _ -> println("unreachable")
  }
}
