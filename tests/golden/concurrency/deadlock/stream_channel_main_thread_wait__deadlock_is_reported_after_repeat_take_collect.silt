-- exit: 1
-- repeat: 3
-- stderr-contains: deadlock on main thread
-- An infinite source cut short by `take`.
import channel
import stream

fn main() {
  println(stream.repeat("x") |> stream.take(3) |> stream.collect)
  let fresh = channel.new(0)
  let _ = channel.receive(fresh)
  println("unreachable")
}
