-- exit: 1
-- repeat: 3
-- stderr-contains: deadlock on main thread
-- Two tasks (the functions of two `stream.from_fn`, which run beside
-- the program's own thread) and main all receive on a channel nobody
-- sends to: once both tasks park, main's receive is reported as a
-- deadlock.
import channel
import stream

fn main() {
  let ch = channel.new(0)
  let _feed1 = stream.from_fn { _ ->
    let _ = channel.receive(ch)
  }
  let _feed2 = stream.from_fn { _ ->
    let _ = channel.receive(ch)
  }
  match channel.receive(ch) {
    Some(_) -> println("unreachable")
    None -> println("unreachable")
  }
}
