-- exit: 1
-- repeat: 3
-- stderr-contains: deadlock on main thread
-- Two spawned tasks and main all receive on a channel nobody sends to:
-- once both tasks park, main's receive is reported as a deadlock.
import channel
import task

fn main() {
  let ch = channel.new(0)
  let _h1 = task.spawn({ ->
    match channel.receive(ch) {
      Message(_) -> 0
      _ -> 0
    }
  })
  let _h2 = task.spawn({ ->
    match channel.receive(ch) {
      Message(_) -> 0
      _ -> 0
    }
  })
  match channel.receive(ch) {
    Message(_) -> println("unreachable")
    _ -> println("unreachable")
  }
}
