-- The report of a piece's failure names the program's file, shows the
-- source line, and gives a call stack whose frames name the file too.
import task

fn inner(n) { 10 / n }
fn outer(n) { inner(n) + 1 }
fn main() {
  task.join([{ -> let _ = outer(0) }])
  println("not reached")
}
