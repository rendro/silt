-- The report names the program's file, shows the source line of the
-- failure, and gives a call stack whose frames name the file too.
import task
import time
fn inner(n) { 10 / n }
fn outer(n) { inner(n) + 1 }
fn main() {
  let _ = task.spawn(fn() { outer(0) })
  time.sleep(time.ms(300))
  println("main done")
}
