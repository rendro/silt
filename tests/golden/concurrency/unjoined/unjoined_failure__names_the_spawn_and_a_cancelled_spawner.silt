-- exit: 1
-- repeat: 5
-- A task that failed and that nobody joined is named by where it was
-- spawned, since nobody holds its handle, and the help says when the
-- task that spawned it was cancelled: here the worker, cancelled after
-- its children had failed. (A cancel of the worker cancels the children
-- that still run; one that has failed keeps its failure, which is
-- reported.)
import channel
import list
import task
import time

fn main() {
  let cmds = channel.new(16)
  let gate = channel.new(0)
  let ready = channel.new(1)
  let never = channel.new(0)
  let worker = task.spawn { ->
    let kids = list.map(1..2) { i ->
      task.spawn { ->
        let _ = channel.receive(gate)
        channel.send(cmds, i)
      }
    }
    channel.send(ready, ())
    let _ = channel.receive(never)
    list.each(kids, task.join)
  }
  let _ = channel.receive(ready)
  channel.close(cmds)
  channel.close(gate)
  -- The children fail at once on the closed channel.
  time.sleep(time.ms(50))
  task.cancel(worker)
  println("stopped")
}
