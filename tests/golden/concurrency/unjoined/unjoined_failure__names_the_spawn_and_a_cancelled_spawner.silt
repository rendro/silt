-- exit: 1
-- repeat: 3
-- A task that failed and that nobody joined is named by where it was
-- spawned, since nobody holds its handle, and the help says when the
-- task that spawned it was cancelled: here the worker, cancelled while
-- it joined its children, which fail later.
import channel
import list
import task

fn main() {
  let cmds = channel.new(16)
  let gate = channel.new(0)
  let ready = channel.new(1)
  let worker = task.spawn { ->
    let kids = list.map(1..2) { i ->
      task.spawn { ->
        let _ = channel.receive(gate)
        channel.send(cmds, i)
      }
    }
    channel.send(ready, ())
    list.each(kids, task.join)
  }
  let _ = channel.receive(ready)
  task.cancel(worker)
  channel.close(cmds)
  channel.close(gate)
  println("stopped")
}
