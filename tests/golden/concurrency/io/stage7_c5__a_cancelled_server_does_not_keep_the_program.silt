-- timeout: 10
-- requires-feature: http
-- A server that runs as a helper of `task.background` is stopped when
-- the body returns, before `main` returns. The server ends with the
-- helper that served: the program ends. (The listener is
-- bound before the server starts, so the first request needs no
-- waiting: it is queued until the server accepts it.)
import bytes
import http
import task
import tcp
import url

fn get(link) {
  match http.get(url_of(link)) {
    Ok(r) -> "status {r.status}"
    Err(e) -> "error {e}"
  }
}

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let link = "http://127.0.0.1:{tcp.local_port(listener)}"
  let server = { ->
    http.serve(listener) { req ->
      match url.path(req.url) {
        "/boom" -> panic("handler fails")
        _ -> http.Response { status: 200, body: bytes.from_string("ok"), headers: #{} }
      }
    }
  }
  task.background([server]) { ->
    println(get("{link}/"))
    println(get("{link}/boom"))
  }
  println("server stopped")
}

fn url_of(text: String) -> url.Url {
  match url.parse(text) {
    Ok(u) -> u
    Err(e) -> panic("{e}")
  }
}
