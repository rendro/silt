-- timeout: 60
-- requires-feature: http
-- What of a request goes on where a redirect leads, for each status and
-- for a location on the same host, on another host name, on another port
-- and on another scheme. The credentials never do: the `authorization`
-- that the URL's user and password make, `proxy-authorization` and
-- `cookie`. Every other header of the program's does (`x-api-key`), and
-- so does the body after a 307 or 308, as curl and Go send them; after a
-- 301, 302 or 303 a POST goes on as a GET without its body and its
-- `content-type`. (Another scheme leads to `https` on a server that
-- speaks none: the client gives up in the TLS handshake, before any
-- header is sent.)
import bytes
import http
import int
import list
import map
import result
import string
import task
import tcp

fn text(body: Bytes) -> String {
  bytes.to_string(body) |> result.unwrap_or("not text")
}

-- The headers of the request, of those a redirect may drop or keep.
fn seen(req: http.Request) -> String {
  let names = ["authorization", "proxy-authorization", "cookie", "x-api-key", "content-type"]
  string.join(list.filter(names) { name -> map.contains(req.headers, name) }, " ")
}

fn answer(server: String, a: Int, b: Int, req: http.Request) -> http.Response {
  println("  {server}: {req.method} {req.path} [{text(req.body)}] {seen(req)}")
  match string.split(req.path, "/") {
    ["", "to", status, class] -> {
      let location = match class {
        "host" -> "http://localhost:{a}/echo"
        "port" -> "http://127.0.0.1:{b}/echo"
        "scheme" -> "https://127.0.0.1:{a}/echo"
        _ -> "/echo"
      }
      let status = int.parse(status) |> result.unwrap_or(500)
      http.Response { status: status, body: bytes.empty(), headers: #{"location": location} }
    }
    _ -> http.Response { status: 200, body: bytes.empty(), headers: #{} }
  }
}

fn main() {
  when let Ok(la) = tcp.listen("127.0.0.1:0") else { panic("cannot listen") }
  when let Ok(lb) = tcp.listen("127.0.0.1:0") else { panic("cannot listen") }
  let (a, b) = (tcp.local_port(la), tcp.local_port(lb))
  let server_a = task.spawn { -> http.serve(la) { req -> answer("A", a, b, req) } }
  let server_b = task.spawn { -> http.serve(lb) { req -> answer("B", a, b, req) } }
  let headers = #{
    "proxy-authorization": "Basic cHJveHk6c2VjcmV0",
    "cookie": "session=1",
    "x-api-key": "key",
    "content-type": "text/plain"
  }
  list.each([301, 302, 303, 307, 308]) { status ->
    list.each(["same", "host", "port", "scheme"]) { class ->
      println("POST {status} {class}")
      let url = "http://user:secret@127.0.0.1:{a}/to/{status}/{class}"
      match http.request(http.POST, url, bytes.from_string("body=1"), headers) {
        Ok(resp) -> println("  the client: {resp.status}")
        Err(http.Tls(_)) -> println("  the client: Tls")
        Err(_) -> println("  the client: another error")
      }
    }
  }
  task.cancel(server_a)
  task.cancel(server_b)
}
