-- timeout: 60
-- requires-feature: http
-- A request's body takes the server's room for bodies (256 MiB in all) by
-- the bytes of it that have come, not by the length its head announces.
-- Twenty-seven peers announce 268,435,454 bytes in all, two bytes short of
-- the room (26 of them 10,000,000 bytes each), and send one byte of each:
-- they hold 27 bytes of it. An upload whose body comes a moment after its
-- head is served, and so is a GET.
import bytes
import http
import list
import option
import result
import string
import task
import tcp
import time

fn crlf() -> String {
  let cr = string.from_char_code(13) |> option.unwrap_or("")
  "{cr}\n"
}

-- The status line of what the server answers on `conn`.
fn status(conn: tcp.TcpStream) -> String {
  let answer = match tcp.read(conn, 65536) {
    Ok(got) -> bytes.to_string(got) |> result.unwrap_or("(no text)")
    Err(e) -> "{e}"
  }
  string.split(answer, crlf()) |> list.get(0) |> option.unwrap_or("?")
}

fn send(conn: tcp.TcpStream, text: String) {
  let _ = tcp.write(conn, bytes.from_string(text))
}

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let port = tcp.local_port(listener)
  let server = { ->
    http.serve(listener) { req ->
      let text = "{bytes.length(req.body)} bytes"
      http.Response { status: 200, body: bytes.from_string(text), headers: #{} }
    }
  }
  task.background([server]) { ->
    let n = crlf()
    let peers = 1..27
      |> list.filter_map { peer ->
        when let Ok(conn) = tcp.connect("127.0.0.1:{port}") else {
          return None
        }
        let length = match peer {
          27 -> 8435454
          _ -> 10000000
        }
        send(conn, "POST /up HTTP/1.1{n}Host: h{n}Content-Length: {length}{n}{n}x")
        Some(conn)
      }
    println("peers: {list.length(peers)}")
    time.sleep(time.ms(500))
    list.each([1, 2]) { try ->
      when let Ok(conn) = tcp.connect("127.0.0.1:{port}") else {
        panic("cannot connect")
      }
      send(conn, "POST /mid HTTP/1.1{n}Host: h{n}Content-Length: 1000{n}{n}")
      time.sleep(time.ms(300))
      send(conn, string.repeat("y", 1000))
      println("an upload whose body comes later, try {try}: {status(conn)}")
      tcp.close(conn)
    }
    when let Ok(conn) = tcp.connect("127.0.0.1:{port}") else {
      panic("cannot connect")
    }
    send(conn, "GET /x HTTP/1.1{n}Host: h{n}{n}")
    println("a GET: {status(conn)}")
    tcp.close(conn)
    list.each(peers) { conn -> tcp.close(conn) }
  }
}
