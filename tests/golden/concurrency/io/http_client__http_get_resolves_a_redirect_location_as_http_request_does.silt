-- timeout: 30
-- requires-feature: http
-- `http.get` follows a redirect as `http.request` does, and resolves
-- its location against the URL that answered as RFC 3986 says: a
-- query alone (`?y=2`) on that URL's path, a location without a scheme
-- (`//host:port/x`) on that host, an empty location or a fragment
-- alone (`#top`) as that URL itself, its path and query.
import bytes
import channel
import http
import list
import task
import tcp

fn moved(location: String) -> http.Response {
  http.Response { status: 302, body: bytes.empty(), headers: #{"location": location} }
}

fn echo(server: String, req: http.Request) -> http.Response {
  println("  {server}: {req.method} {req.path} ?{req.query}")
  http.Response { status: 200, body: bytes.empty(), headers: #{} }
}

fn main() {
  when let Ok(first) = tcp.listen("127.0.0.1:0") else { panic("cannot listen") }
  when let Ok(second) = tcp.listen("127.0.0.1:0") else { panic("cannot listen") }
  let other = "//127.0.0.1:{tcp.local_port(second)}"
  let locations = channel.new(2)
  channel.send(locations, "")
  channel.send(locations, "#top")
  let one = task.spawn { ->
    http.serve(first) { req ->
      match req.path {
        "/q" when req.query == "x=1" -> moved("?y=2")
        "/far" -> moved("{other}/there")
        "/a/b" -> {
          let _ = echo("first", req)
          match channel.try_receive(locations) {
            channel.Message(location) -> {
              println("  302 to \"{location}\"")
              moved(location)
            }
            _ -> http.Response { status: 200, body: bytes.empty(), headers: #{} }
          }
        }
        _ -> echo("first", req)
      }
    }
  }
  let two = task.spawn { -> http.serve(second) { req -> echo("second", req) } }
  let url = "http://127.0.0.1:{tcp.local_port(first)}"
  list.each(["/q?x=1", "/far", "/a/b?x=1"]) { path ->
    println("GET {path}")
    match http.get("{url}{path}") {
      Ok(resp) -> println("  the client: {resp.status}")
      Err(e) -> println("  the client: {e}")
    }
  }
  task.cancel(one)
  task.cancel(two)
}
