-- timeout: 30
-- requires-feature: http
-- A query string comes from whoever sent the request. One that does not
-- decode is an error value in the handler, which answers 400 itself and
-- goes on serving: the next request is answered as the first was.
import bytes
import http
import list
import map
import option
import result
import string
import task
import tcp

-- A body as text.
fn text(body: Bytes) -> String {
  bytes.to_string(body) |> result.unwrap_or("(no text)")
}

fn answer(req: http.Request) -> http.Response {
  match http.parse_query(req.query) {
    Ok(query) -> match map.get(query, "name") {
      Some([name, ..rest]) -> http.Response { status: 200, body: bytes.from_string("hello, {name}"), headers: #{} }
      _ -> http.Response { status: 200, body: bytes.from_string("hello"), headers: #{} }
    }
    Err(e) -> http.Response { status: 400, body: bytes.from_string("bad query: {e}"), headers: #{} }
  }
}

-- What the server answers to `GET path`, sent by hand: a client of
-- silt's sends no query that does not decode. The status and the body.
fn ask(port: Int, path: String) -> String {
  let cr = string.from_char_code(13) |> option.unwrap_or("")
  when let Ok(conn) = tcp.connect("127.0.0.1:{port}") else { return "cannot connect" }
  let request = "GET {path} HTTP/1.1{cr}\nHost: h{cr}\nConnection: close{cr}\n{cr}\n"
  let _ = tcp.write(conn, bytes.from_string(request))
  let answer = text(read_all(conn, bytes.empty()))
  tcp.close(conn)
  let status = answer |> string.split(" ") |> list.get(1) |> option.unwrap_or("?")
  let body = answer |> string.split("{cr}\n{cr}\n") |> list.get(1) |> option.unwrap_or("")
  "{status} {body}"
}

fn read_all(conn: tcp.TcpStream, got: Bytes) -> Bytes {
  match tcp.read(conn, 65536) {
    Ok(more) when bytes.length(more) > 0 -> read_all(conn, bytes.concat(got, more))
    _ -> got
  }
}

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else { panic("cannot listen") }
  let port = tcp.local_port(listener)
  let server = task.spawn { -> http.serve(listener, answer) }
  list.each(["/?name=a%20b", "/?name=%ZZ", "/?name=%FF", "/?other=1", "/?name=c"]) { path ->
    println(ask(port, path))
  }
  task.cancel(server)
}
