-- timeout: 30
-- requires-feature: http
-- While `http.serve` serves a listener, the listener is the server's
-- alone: a `tcp.accept` on it is an error at once, and takes no
-- connection from the server. When the server has been stopped the
-- listener is the program's again, for an accept or for another
-- server.
import bytes
import http
import list
import result
import task
import tcp
import url

-- A body as text.
fn text(body: Bytes) -> String {
  bytes.to_string(body) |> result.unwrap_or("(no text)")
}

fn get(link) {
  match http.get(url_of(link)) {
    Ok(r) -> "{r.status} {text(r.body)}"
    Err(e) -> "error: {e}"
  }
}

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let port = tcp.local_port(listener)
  let link = "http://127.0.0.1:{port}/"
  let first = { ->
    http.serve(listener) { _req ->
      http.Response { status: 200, body: bytes.from_string("first"), headers: #{} }
    }
  }
  task.background([first]) { ->
    -- The server serves when it has answered.
    println(get(link))
    let refused = 1..100
      |> list.map { _ ->
        match tcp.accept(listener) {
          Ok(_) -> "a connection"
          Err(e) -> "{e}"
        }
      }
    println(refused |> list.unique)
    println(1..20 |> list.map { _ -> get(link) } |> list.unique)
  }

  -- An accept of the program's own.
  let client = { ->
    when let Ok(conn) = tcp.connect("127.0.0.1:{port}") else {
      panic("cannot connect")
    }
    let _ = tcp.write(conn, bytes.from_string("hello"))
    tcp.close(conn)
  }
  task.background([client]) { ->
    match tcp.accept(listener) {
      Ok(conn) -> match tcp.read_exact(conn, 5) {
        Ok(hello) -> println("accepted a client that sent {bytes.length(hello)} bytes")
        Err(e) -> println("accepted a connection that says nothing: {e}")
      }
      Err(e) -> println("accept: {e}")
    }
  }

  -- And another server.
  let second = { ->
    http.serve(listener) { _req ->
      http.Response { status: 200, body: bytes.from_string("second"), headers: #{} }
    }
  }
  task.background([second]) { -> println(get(link)) }
}

fn url_of(text: String) -> url.Url {
  match url.parse(text) {
    Ok(u) -> u
    Err(e) -> panic("{e}")
  }
}
