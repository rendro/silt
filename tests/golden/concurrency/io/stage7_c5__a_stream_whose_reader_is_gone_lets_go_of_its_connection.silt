-- timeout: 10
-- requires-feature: tcp
-- The reader of a stream on a connection has gone when the source
-- comes with its first line: the source ends there, and lets go of its
-- connection like one that is stopped in a read; what it had read is
-- gone with it. `conn` still holds the connection: the peer, which sent
-- its lines when the stream was closed and waits for more, reads what
-- the program writes then. (The source shut the connection, for every
-- holder.)
import bytes
import channel
import stream
import task
import tcp

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let gone = channel.new(0)
  let seen = channel.new(1)
  let _peer = task.spawn { ->
    when let Ok(conn) = tcp.accept(listener) else {
      panic("cannot accept")
    }
    let _ = channel.receive(gone)
    let _ = tcp.write(conn, bytes.from_string("one\ntwo\n"))
    -- The end of the connection is a read of no bytes, or an error
    -- where the system resets a connection that is shut down with
    -- bytes of the peer unread (Windows).
    match tcp.read(conn, 16) {
      Ok(read) -> match bytes.length(read) {
        0 -> channel.send(seen, "the peer saw the connection end")
        n -> channel.send(seen, "the peer read {n} bytes")
      }
      Err(_) -> channel.send(seen, "the peer saw the connection end")
    }
  }
  when let Ok(conn) = tcp.connect("127.0.0.1:{tcp.local_port(listener)}") else {
    panic("cannot connect")
  }
  let lines = stream.tcp_lines(conn)
  channel.close(lines)
  channel.send(gone, ())
  -- `conn` still holds the connection: it is open both ways.
  match tcp.write(conn, bytes.from_string("x")) {
    Ok(_) -> println("the connection is still open")
    Err(e) -> println("the write: {e}")
  }
  when let Some(said) = channel.receive(seen) else {
    panic("the peer said nothing")
  }
  println(said)
  tcp.close(conn)
}
