-- timeout: 30
-- requires-feature: http
-- The helper that runs a server is stopped (its body returned) while
-- five requests wait in their handlers. Each of them is answered 503 at
-- the stop and its
-- connection closed: no client waits for a server that is gone. A
-- request that was answered before is not touched, and the program
-- ends.
import bytes
import channel
import http
import list
import result
import task
import tcp
import url

-- A body as text.
fn text(body: Bytes) -> String {
  bytes.to_string(body) |> result.unwrap_or("(no text)")
}

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let port = tcp.local_port(listener)
  let never = channel.new(0)
  let entered = channel.new(0)
  let server = { ->
    http.serve(listener) { req ->
      match url.path(req.url) {
        "/quick" -> http.Response { status: 200, body: bytes.from_string("quick"), headers: #{} }
        _ -> {
          channel.send(entered, ())
          let _ = channel.receive(never)
          http.Response { status: 200, body: bytes.from_string("late"), headers: #{} }
        }
      }
    }
  }
  let get = { path ->
    match http.get(url_of("http://127.0.0.1:{port}{path}")) {
      Ok(r) -> "{r.status} {text(r.body)}"
      Err(e) -> "error: {e}"
    }
  }
  let answered = channel.new(1)
  let clients = { -> channel.send(answered, task.map(1..5, 5) { _ -> get("/wait") }) }
  let serves = { ->
    task.background([server]) { ->
      1..5
        |> list.each { _ ->
          let _ = channel.receive(entered)
        }
      println(get("/quick"))
    }
    println("server stopped")
  }
  task.join([clients, serves])
  when let Some(answers) = channel.receive(answered) else {
    panic("no answers")
  }
  answers |> list.each { answer -> println(answer) }
  println("main returns")
}

fn url_of(text: String) -> url.Url {
  match url.parse(text) {
    Ok(u) -> u
    Err(e) -> panic("{e}")
  }
}
