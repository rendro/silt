-- timeout: 30
-- requires-feature: http
-- stderr-contains: http.serve: handler returned malformed Response: Response.status out of range: 1000
-- stderr-contains: http.serve: handler returned malformed Response: Response.status out of range: 600 is not the status of a response (200..=599)
-- stderr-contains: http.serve: handler error: panic: boom
-- stderr-not-contains: error[runtime]
-- A handler that fails, or returns a response that is none, is answered
-- 500, and the failure is written to stderr as one line: its message
-- only, with no diagnostic header nested in it. A status is one of
-- 200 to 599: 600 is none.
import bytes
import http
import task
import tcp
import url

fn answer(req: http.Request) -> http.Response {
  match url.segments(req.url) {
    ["status"] -> http.Response { status: 1000, body: bytes.empty(), headers: #{} }
    ["six"] -> http.Response { status: 600, body: bytes.empty(), headers: #{} }
    ["five"] -> http.Response { status: 599, body: bytes.empty(), headers: #{} }
    ["fail"] -> panic("boom")
    _ -> http.Response { status: 200, body: bytes.from_string("ok"), headers: #{} }
  }
}

fn show(label: String, answered: Result(http.Response, http.HttpError)) {
  match answered {
    Ok(response) -> println("{label}: {response.status}")
    Err(e) -> println("{label}: {e}")
  }
}

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let base = "http://127.0.0.1:{tcp.local_port(listener)}"
  let server = { -> http.serve(listener, answer) }
  task.background([server]) { ->
    show("status", http.get(url_of("{base}/status")))
    show("six", http.get(url_of("{base}/six")))
    show("five", http.get(url_of("{base}/five")))
    show("fail", http.get(url_of("{base}/fail")))
    show("after", http.get(url_of("{base}/")))
  }
}

fn url_of(text: String) -> url.Url {
  match url.parse(text) {
    Ok(u) -> u
    Err(e) -> panic("{e}")
  }
}
