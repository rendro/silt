-- timeout: 30
-- repeat: 50
-- requires-feature: http
-- Twelve requests at once, each of whose handlers waits on a channel:
-- every one of them is in its handler before any is released. No
-- request waits for another connection to end. (A handler that did
-- not start would leave `main` waiting for it: the case would time
-- out.)
import bytes
import channel
import http
import list
import result
import task
import tcp
import url

-- A body as text.
fn text(body: Bytes) -> String {
  bytes.to_string(body) |> result.unwrap_or("(no text)")
}

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let port = tcp.local_port(listener)
  let release = channel.new(0)
  let entered = channel.new(0)
  let server = { ->
    http.serve(listener) { _req ->
      channel.send(entered, ())
      let _ = channel.receive(release)
      http.Response { status: 200, body: bytes.from_string("released"), headers: #{} }
    }
  }
  task.background([server]) { ->
    let answered = channel.new(1)
    let clients = { ->
      let answers = task.map(1..12, 12) { _ ->
        match http.get(url_of("http://127.0.0.1:{port}/wait")) {
          Ok(r) -> "{r.status} {text(r.body)}"
          Err(e) -> "error: {e}"
        }
      }
      channel.send(answered, answers)
    }
    let release_all = { ->
      1..12
        |> list.each { _ ->
          let _ = channel.receive(entered)
        }
      println("12 handlers wait")
      channel.close(release)
    }
    task.join([clients, release_all])
    when let Some(answers) = channel.receive(answered) else {
      panic("no answers")
    }
    println(list.unique(answers))
  }
}

fn url_of(text: String) -> url.Url {
  match url.parse(text) {
    Ok(u) -> u
    Err(e) -> panic("{e}")
  }
}
