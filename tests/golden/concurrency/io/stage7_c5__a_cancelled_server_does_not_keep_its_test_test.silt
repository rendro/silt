-- cmd: test
-- timeout: 10
-- requires-feature: http
-- stderr-contains: PASS stage7_c5__a_cancelled_server_does_not_keep_its_test_test.silt::test_a_uses_a_server
-- stderr-contains: PASS stage7_c5__a_cancelled_server_does_not_keep_its_test_test.silt::test_b_runs
-- stderr-contains: 2 tests: 2 passed, 0 failed
-- A test runs a server as a helper of `task.background`, stopped when
-- the body (the test's last line) returns: the test ends, and the next
-- one runs.
import bytes
import http
import task
import tcp
import test
import url

fn get(link) {
  match http.get(url_of(link)) {
    Ok(r) -> r.status
    Err(e) -> panic("{e}")
  }
}

fn test_a_uses_a_server() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let server = { ->
    http.serve(listener) { _req ->
      http.Response { status: 200, body: bytes.from_string("ok"), headers: #{} }
    }
  }
  task.background([server]) { ->
    test.assert_eq(get("http://127.0.0.1:{tcp.local_port(listener)}/"), 200)
  }
}

fn test_b_runs() {
  test.assert_eq(1, 1)
}

fn url_of(text: String) -> url.Url {
  match url.parse(text) {
    Ok(u) -> u
    Err(e) -> panic("{e}")
  }
}
