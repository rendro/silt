-- requires-feature: http
-- timeout: 60
-- What a request that fails gives is decided by the kind of the
-- failure, as the transport says it: a Url whose scheme is not http or
-- https is `InvalidUrl` with the URL (a text that is no URL is refused
-- by url.parse before); a port nobody listens on is `Connect`; a server that goes
-- away before its response is complete is `ClosedEarly`; one that
-- sends what is no HTTP is `InvalidResponse`.
import bytes
import http
import option
import string
import task
import tcp
import url

fn kind(r) {
  match r {
    Ok(_) -> "Ok"
    Err(http.InvalidUrl(link)) -> "InvalidUrl(\"{link}\")"
    Err(http.Connect(_)) -> "Connect"
    Err(http.ClosedEarly) -> "ClosedEarly"
    Err(http.InvalidResponse(_)) -> "InvalidResponse"
    Err(http.Timeout) -> "Timeout"
    Err(http.Tls(_)) -> "Tls"
    Err(http.TooManyRedirects) -> "TooManyRedirects"
    Err(http.Other(why)) -> "Other({why})"
  }
}

-- A server that takes one connection, reads the request, writes
-- `answer` (nothing if it is empty) and goes away.
fn against(answer) {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let port = tcp.local_port(listener)
  let server = { ->
    when let Ok(conn) = tcp.accept(listener) else {
      panic("cannot accept")
    }
    let _ = tcp.read(conn, 1024)
    let _ = tcp.write(conn, bytes.from_string(answer))
    tcp.close(conn)
  }
  let out = task.background([server]) { -> http.get(url_of("http://127.0.0.1:{port}/")) }
  out
}

fn main() {
  let cr = string.from_char_code(13) |> option.unwrap_or("")
  let nl = "{cr}\n"
  println("another scheme: {kind(http.get(url_of("ftp://127.0.0.1/file")))}")
  println(
    "a posted one: {kind(http.request(http.POST, url_of("file:///etc/hosts"), bytes.from_string("body"), #{}))}",
  )
  println("nobody listens: {kind(http.get(url_of("http://127.0.0.1:1/")))}")
  println("the server goes away: {kind(against(""))}")
  println("in the head: {kind(against("HTTP/1.1 200 OK{nl}Content-Le"))}")
  println("in the body: {kind(against("HTTP/1.1 200 OK{nl}Content-Length: 10{nl}{nl}abc"))}")
  println("no HTTP: {kind(against("garbage{nl}{nl}"))}")
  println("a response: {kind(against("HTTP/1.1 200 OK{nl}Content-Length: 2{nl}{nl}ok"))}")
}

fn url_of(text: String) -> url.Url {
  match url.parse(text) {
    Ok(u) -> u
    Err(e) -> panic("{e}")
  }
}
