-- requires-feature: http
-- timeout: 60
-- What a request that fails gives is decided by the kind of the
-- failure, as the transport says it: a URL that cannot be read as one
-- or whose scheme is not http is `InvalidUrl` with the URL as it was
-- written; a port nobody listens on is `Connect`; a server that goes
-- away before its response is complete is `ClosedEarly`; one that
-- sends what is no HTTP is `InvalidResponse`.
import bytes
import http
import option
import string
import task
import tcp

fn kind(r) {
  match r {
    Ok(_) -> "Ok"
    Err(http.InvalidUrl(url)) -> "InvalidUrl(\"{url}\")"
    Err(http.Connect(_)) -> "Connect"
    Err(http.ClosedEarly) -> "ClosedEarly"
    Err(http.InvalidResponse(_)) -> "InvalidResponse"
    Err(http.Timeout) -> "Timeout"
    Err(http.Tls(_)) -> "Tls"
    Err(http.StatusCode(_, _)) -> "StatusCode"
    Err(http.Other(why)) -> "Other({why})"
  }
}

-- A server that takes one connection, reads the request, writes
-- `answer` (nothing if it is empty) and goes away.
fn against(answer) {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else { panic("cannot listen") }
  let port = tcp.local_port(listener)
  let server = task.spawn { ->
    when let Ok(conn) = tcp.accept(listener) else { panic("cannot accept") }
    let _ = tcp.read(conn, 1024)
    let _ = tcp.write(conn, bytes.from_string(answer))
    tcp.close(conn)
  }
  let out = http.get("http://127.0.0.1:{port}/")
  task.join(server)
  out
}

fn main() {
  let cr = string.from_char_code(13) |> option.unwrap_or("")
  let nl = "{cr}\n"
  println("not a url: {kind(http.get("not a url"))}")
  println("no scheme: {kind(http.get("example.com/page"))}")
  println("empty: {kind(http.get(""))}")
  println("another scheme: {kind(http.get("ftp://127.0.0.1/file"))}")
  println("a posted one: {kind(http.request(http.POST, "not a url", "body", #{}))}")
  println("nobody listens: {kind(http.get("http://127.0.0.1:1/"))}")
  println("the server goes away: {kind(against(""))}")
  println("in the head: {kind(against("HTTP/1.1 200 OK{nl}Content-Le"))}")
  println("in the body: {kind(against("HTTP/1.1 200 OK{nl}Content-Length: 10{nl}{nl}abc"))}")
  println("no HTTP: {kind(against("garbage{nl}{nl}"))}")
  println("a response: {kind(against("HTTP/1.1 200 OK{nl}Content-Length: 2{nl}{nl}ok"))}")
}
