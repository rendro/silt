-- timeout: 10
-- requires-feature: tcp
-- A size of 0 or less is a runtime error for `tcp.read` and
-- `tcp.read_exact`, as for the chunk sources: an empty `Ok` of a read is
-- the end of the data, never a read of nothing. Each read is in a
-- `task.guard` of its own, which gives its error as an `Err`.
import bytes
import channel
import list
import task
import tcp

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let done = channel.new(0)
  let peer = { ->
    when let Ok(conn) = tcp.accept(listener) else {
      panic("cannot accept")
    }
    let _ = tcp.write(conn, bytes.from_string("abc"))
    let _ = channel.receive(done)
  }
  task.background([peer]) { ->
    when let Ok(conn) = tcp.connect("127.0.0.1:{tcp.local_port(listener)}") else {
      panic("cannot connect")
    }
    let reads = [
      { -> tcp.read(conn, 0) },
      { -> tcp.read(conn, -1) },
      { -> tcp.read_exact(conn, 0) },
      { -> tcp.read_exact(conn, -1) },
    ]
    list.each(reads) { read ->
      match task.guard(read) {
        Ok(got) -> println("no error: {got}")
        Err(e) -> println(e.message)
      }
    }
    println(tcp.read(conn, 3))
    channel.close(done)
  }
}
