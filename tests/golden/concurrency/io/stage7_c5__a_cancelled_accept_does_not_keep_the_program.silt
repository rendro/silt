-- timeout: 10
-- requires-feature: tcp
-- A helper that waits in `tcp.accept` is stopped (its body returned)
-- before `main` returns. Nobody waits for the operation any more, so it is not
-- pending for the program, which ends.
import task
import tcp
import time

fn main() {
  when let Ok(listener) = tcp.listen("127.0.0.1:0") else {
    panic("cannot listen")
  }
  let acceptor = { ->
    let _ = tcp.accept(listener)
  }
  task.background([acceptor]) { -> time.sleep(time.ms(20)) }
  println("stopped")
}
