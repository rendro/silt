-- A method that calls itself 50,000 deep, in a task: a method call takes
-- a frame of the VM like any call, and no native stack.
import task

trait Countdown {
  fn down(self) -> Int
}

trait Countdown for Int {
  fn down(self) -> Int {
    match self {
      0 -> 0
      _ -> 1 + Countdown.down(self - 1)
    }
  }
}

fn main() {
  let h = task.spawn({ -> Countdown.down(50000) })
  println(task.join(h))
  println(Countdown.down(50000))
}
