-- frame-budget: 16
-- A recursion of the program's own code that has returned does not
-- count against the pieces of a `task.map`: together they would take
-- more than the budget of 16 MiB.
import task

fn deep(n: Int) -> Int {
  match n {
    0 -> 0
    _ -> 1 + deep(n - 1)
  }
}

fn main() {
  println(deep(150000))
  println(task.map([1, 2], 2) { _ -> deep(30000) })
}
