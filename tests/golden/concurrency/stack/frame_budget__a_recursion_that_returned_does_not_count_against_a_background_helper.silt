-- frame-budget: 16
-- A recursion of the program's own code that has returned does not
-- count against a helper of `task.background`, which recurses while
-- the body waits on a channel: together the two would take more than
-- the budget of 16 MiB.
import channel
import task

deep fn deep(n: Int) -> Int {
  match n {
    0 -> 0
    _ -> 1 + deep(n - 1)
  }
}

fn main() {
  println(deep(150000))
  let gate: Channel(Int) = channel.new(0)
  task.background([{ ->
    channel.send(gate, deep(60000))
  }]) { -> println(channel.receive(gate)) }
}
