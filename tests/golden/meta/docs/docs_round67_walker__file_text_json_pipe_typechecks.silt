-- cmd: check
-- exit: 0
import io
import json
import result

type Todo {
  id: Int,
  title: String,
}

fn process(t: Todo) -> Todo { t }

fn read_todo(path: String) -> Result(Todo, io.IoError) {
  let text = io.read_file(path)?
  let _parsed = text
    |> json.parse(Todo)
    |> result.map(process)
  Ok(Todo { id: 1, title: "" })
}

fn main() {
  ()
}
