-- cmd: check
-- exit: 1
-- requires-feature: http
-- stderr-contains: error[type]
-- stderr-contains: type mismatch
import http
import json
import result
import url

type Todo {
  id: Int,
  title: String,
}

fn process(t: Todo) -> Todo { t }

fn fetch_todo(link: String) -> Result(Todo, http.HttpError) {
  let _x = http.get(url_of(link))?
    |> json.parse(Todo)
    |> result.map(process)
  Ok(Todo { id: 1, title: "" })
}

fn main() {
  ()
}

fn url_of(text: String) -> url.Url {
  match url.parse(text) {
    Ok(u) -> u
    Err(e) -> panic("{e}")
  }
}
