-- Each line groups differently if the two operators swapped levels
-- (docs/language/operators.md precedence table, lowest first).
fn main() {
  -- `||` (20) below `&&` (30)
  println(true || false && false)
  -- `&&` (30) below `==` (40)
  println(false && false == false)
  -- `==` (40) below `<` (50)
  println(1 < 2 == true)
  -- `<` (50) below `+` (70)
  println(1 + 1 < 3)
  -- `+` (70) below `*` (80)
  println(2 + 3 * 4)
  -- `-` and `/` are left-associative within their level
  println(10 - 4 - 3)
  println(24 / 4 / 2)
}
