type Point { x: Int, y: Int, }
fn cmp_gen(a: a, b: a) -> Int where a: Compare { Compare.compare(a, b) }
fn eq_gen(a: a, b: a) -> Bool where a: Equal { a == b }
fn h(a: a) -> Int where a: Hash { Hash.hash(a) }
fn d(a: a) -> String where a: Display { "{a}" }
fn main() {
    let p = Point { x: 1, y: 2 }
    let q = Point { x: 1, y: 3 }
    println(cmp_gen(p, q))
    println(eq_gen(p, q))
    println(h(p) == Hash.hash(p))
    println(d(p))
    println(Compare.compare(p, q))
    println(p == q)
    println("{p}")
}
