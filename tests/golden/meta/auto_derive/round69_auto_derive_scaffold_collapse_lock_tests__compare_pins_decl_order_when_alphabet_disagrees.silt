fn cmp_gen(a: a, b: a) -> Int where a: Compare { a.compare(b) }
fn eq_gen(a: a, b: a) -> Bool where a: Equal { a.equal(b) }
fn h(a: a) -> Int where a: Hash { a.hash() }
fn d(a: a) -> String where a: Display { a.display() }
type ZAM { Z, A, M, }
fn main() {
    println(cmp_gen(Z, A))
    println(cmp_gen(A, M))
    println(cmp_gen(M, Z))
}
