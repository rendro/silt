-- `.message()` dispatches for a variant of every stdlib error enum
-- (the registry-driven `<Enum>.message` globals and trait-dispatch table).
-- The enums of modules a build may leave out are in cases of their own:
-- HttpError and TcpError in
-- round73_error_enum_registry_parity_tests__the_http_and_tcp_error_enum_messages_dispatch;
-- PostgresError is left out.
import io
import json
import toml
import int
import regex
import time
import bytes

fn main() {
  println(io.NotFound("missing.txt").message())
  println(json.MissingField("name").message())
  println(toml.MissingField("key").message())
  println(int.Empty.message())
  println(regex.TooBig.message())
  println(time.OutOfRange("month 13").message())
  println(bytes.InvalidHex("zz").message())
}
