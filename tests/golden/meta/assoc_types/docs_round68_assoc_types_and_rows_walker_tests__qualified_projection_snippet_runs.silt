trait Producer {
  type Out
  fn produce(self) -> Self::Out
}

type Wrap { v: Int }

trait Producer for Wrap {
  type Out = Int
  fn produce(self) -> Int { self.v }
}

fn first_out(w: Wrap) -> <Wrap as Producer>::Out {
  w.produce()
}

fn main() {
  let w = Wrap { v: 100 }
  println(first_out(w))
}
