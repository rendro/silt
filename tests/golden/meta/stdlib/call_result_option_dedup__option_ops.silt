import option

fn main() {
  println(option.unwrap_or(Some(7), 0))
  println(option.unwrap_or(None, 42))
  println(option.is_some(Some(1)))
  println(option.is_some(None))
  println(option.is_none(None))
  println(option.is_none(Some(1)))
  println(option.map(Some(3), { x -> x * 2 }))
  println(option.map(None, { x -> x * 2 }))
  println(option.flat_map(Some(3), { x -> Some(x + 10) }))
  println(option.flat_map(None, { x -> Some(x) }))
  println(option.to_result(Some(5), "err"))
  println(option.to_result(None, "err"))
}
