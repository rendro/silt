-- cmd: disasm
-- stdout-contains: Recur                2  slot 2
-- stdout-contains: 0085  Recur
-- stdout-contains: 0089  Jump                 -76   -> 0018
-- Recur carries a u8 arg_count and a u16 first_slot (3 operand bytes):
-- the next instruction starts 4 bytes after Recur. It is the jump back
-- to the start of the loop, whose distance is negative.
fn main() {
  let a = 1
  let b = 2
  let total = loop i = 0, acc = 0 {
    match i >= 3 {
      true -> acc
      false -> loop(i + 1, acc + i)
    }
  }
  println(total + a + b)
}
