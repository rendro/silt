-- cmd: disasm
-- stdout-contains: 0030  Recur                2  slot 0  -38   -> 0000
-- stdout-contains: 0038  Return
-- Recur carries a u8 count of parameters, a u16 first slot and the i32
-- distance of its jump back to the start of the function, which is
-- negative (7 operand bytes): the next instruction starts 8 bytes
-- after Recur.
fn total(i: Int, acc: Int) -> Int {
  match i >= 3 {
    true -> acc
    false -> total(i + 1, acc + i)
  }
}

fn main() {
  println(total(0, 0))
}
