-- cmd: disasm
-- stdout-contains: 0048  Recur                2  slot 2  -38   -> 0018
-- stdout-contains: 0056  Slide
-- Recur carries a u8 count of bindings, a u16 first slot and the i32
-- distance of its jump back to the start of the loop, which is
-- negative (7 operand bytes): the next instruction starts 8 bytes
-- after Recur.
fn main() {
  let a = 1
  let b = 2
  let total = loop i = 0, acc = 0 {
    match i >= 3 {
      true -> acc
      false -> loop(i + 1, acc + i)
    }
  }
  println(total + a + b)
}
