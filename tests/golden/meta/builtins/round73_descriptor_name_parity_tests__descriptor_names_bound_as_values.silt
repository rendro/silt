-- Every builtin primitive and generic-container descriptor name
-- (module::BUILTIN_PRIMITIVE_NAMES / BUILTIN_GENERIC_CONTAINER_NAMES) is
-- bound as a value in both the typechecker and the VM. Tuple is VM-only.
fn main() {
  let _int = Int
  let _float = Float
  let _string = String
  let _bool = Bool
  let _list = List
  let _map = Map
  let _set = Set
  let _channel = Channel
  println("ok")
}
