fn cmp_gen(a: a, b: a) -> Int where a: Compare { Compare.compare(a, b) }
fn eq_gen(a: a, b: a) -> Bool where a: Equal { a == b }
fn h(a: a) -> Int where a: Hash { Hash.hash(a) }
fn d(a: a) -> String where a: Display { "{a}" }
type Inner { x: Int }
type Wrap { r: Inner, tag: Int }
fn main() {
    let h1 = h(Wrap { r: Inner { x: 7 }, tag: 0 })
    let h2 = h(Wrap { r: Inner { x: 7 }, tag: 0 })
    let h3 = h(Wrap { r: Inner { x: 8 }, tag: 0 })
    println(eq_gen(h1, h2))
    println(eq_gen(h1, h3))
}
