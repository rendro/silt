fn cmp_gen(a: a, b: a) -> Int where a: Compare { Compare.compare(a, b) }
fn eq_gen(a: a, b: a) -> Bool where a: Equal { a == b }
fn h(a: a) -> Int where a: Hash { Hash.hash(a) }
fn d(a: a) -> String where a: Display { "{a}" }
type One { x: Int }
fn main() {
    let a = One { x: 1 }
    let b = One { x: 2 }
    let c = One { x: 1 }
    println(cmp_gen(a, b))
    println(cmp_gen(b, a))
    println(cmp_gen(a, c))
}
