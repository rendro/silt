import channel
fn process(v) { println("{v}") }
fn drain(ch) {
  match channel.receive(ch) {
    channel.Message(val) -> {
      process(val)
      drain(ch)
    }
    channel.Closed -> ()
    _ -> drain(ch)
  }
}
fn main() {
  let ch = channel.new(2)
  channel.send(ch, "x")
  channel.close(ch)
  drain(ch)
}
