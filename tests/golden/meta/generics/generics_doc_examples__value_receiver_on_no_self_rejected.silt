-- cmd: check
-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: type 'Int' has no field 'default'
-- stderr-contains: call it on the type, `Int.default()`
trait Default {
    fn default() -> Self
}

trait Default for Int {
    fn default() -> Self { 0 }
}

fn use_it() {
    let _ = 5.default()
}

fn main() { use_it() }
