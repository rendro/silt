-- cmd: check
-- exit: 0
import map

type Cache(k, v) {
    store: Map(k, v),
    capacity: Int,
}

fn get(c: Cache(k, v), key: k) -> Option(v) where k: Hash + Equal {
    map.get(c.store, key)
}

fn put(c: Cache(k, v), key: k, value: v) -> Cache(k, v)
    where k: Hash + Equal
{
    c.{ store: map.set(c.store, key, value) }
}

fn main() { () }
