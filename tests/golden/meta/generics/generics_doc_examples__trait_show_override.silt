trait Show {
  fn show(self) -> String { "default" }
  fn debug(self) -> String
}

type Item { v: Int }

trait Show for Item {
  fn show(self) -> String { "explicit-show" }
  fn debug(self) -> String { "item-debug" }
}

fn main() {
  println(Show.show(Item { v: 1 }))
  println(Show.debug(Item { v: 1 }))
}
