-- cmd: check
-- exit: 0
import int

trait Decode {
    fn decode(body: String) -> Result(Self, int.IntError)
}

trait Decode for Int {
    fn decode(body: String) -> Result(Int, int.IntError) {
        int.parse(body)
    }
}

fn parse(body: String, type a) -> Result(a, int.IntError) where a: Decode {
    a.decode(body)
}

fn use_it() {
    let _ = parse("42", Int)
}

fn main() { use_it() }
