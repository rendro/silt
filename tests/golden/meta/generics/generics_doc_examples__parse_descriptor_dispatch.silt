-- cmd: check
-- exit: 0
import int

trait Parse {
    fn parse(body: String) -> Result(Self, int.IntError)
}

trait Parse for Int {
    fn parse(body: String) -> Result(Int, int.IntError) {
        int.parse(body)
    }
}

fn parse(body: String, type a) -> Result(a, int.IntError) where a: Parse {
    a.parse(body)
}

fn use_it() {
    let _ = parse("42", Int)
}

fn main() { use_it() }
