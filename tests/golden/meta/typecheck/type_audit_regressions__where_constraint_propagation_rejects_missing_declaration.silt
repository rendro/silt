-- cmd: check
-- exit: 1
-- stderr-contains: error[type]
-- stderr-contains: enclosing function does not declare constraint required by call to 'show': `a: Showable`
trait Showable {
  fn present(self) -> String
}
trait Showable for Int {
  fn present(self) -> String { "i" }
}
fn show(x: a) -> String where a: Showable { x.present() }
fn indirect(x: a) -> String { show(x) }
fn main() { println(indirect(5)) }
