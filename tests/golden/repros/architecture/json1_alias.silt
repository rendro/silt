-- verdict: same
import json

type Tags = List(String)
type Count = Int

type Post {
  title: String,
  tags: Tags,
  n: Count,
}

fn main() {
  let raw = "\{\"title\": \"hi\", \"tags\": [\"a\", \"b\"], \"n\": 3\}"
  match json.parse(raw, Post) {
    Ok(p) -> println("ok: {p.title} {p.tags} {p.n}")
    Err(e) -> println("err: {e.message()}")
  }
}
