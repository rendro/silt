-- verdict: same
trait Monoid {
  fn empty() -> Self
  fn combine(a: Self, b: Self) -> Self
}

trait Monoid for Int {
  fn empty() -> Self { 0 }
  fn combine(a: Self, b: Self) -> Self { a + b }
}

fn main() {
  let zero = Int.empty()                 -- concrete dispatch
  let five = Int.combine(2, 3)
  println("{zero} {five}")
}
