-- verdict: same
import channel
import task

fn do_job(id, job) {
  when job != "poison" else { panic("worker {id} hit poison pill") }
  println("worker {id} handled {job}")
}

fn worker_body(id, jobs) {
  channel.each(jobs) { job -> do_job(id, job) }
}

-- A worker that fails is started again, up to a budget of restarts.
fn supervise(id, jobs, remaining_restarts) {
  match task.guard(fn() { worker_body(id, jobs) }) {
    Ok(_) -> ()
    Err(e) -> {
      println("worker {id} failed: {e.message}")
      when remaining_restarts > 0 else { return }
      supervise(id, jobs, remaining_restarts - 1)
    }
  }
}

fn main() {
  let jobs = channel.new(10)

  let sender = fn() {
    channel.send(jobs, "a")
    channel.send(jobs, "b")
    channel.close(jobs)
  }

  task.join([fn() { supervise(1, jobs, 3) }, fn() { supervise(2, jobs, 3) }, sender])
}
