{- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- {- 