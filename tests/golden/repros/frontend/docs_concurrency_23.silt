-- verdict: same
import channel
import task
fn main() {
  let ch = channel.new(10)

  let producer = fn() {
    channel.send(ch, "hello")
    channel.send(ch, "from")
    channel.send(ch, "silt")
    channel.close(ch)
  }

  let consumer = fn() {
    channel.each(ch) { msg ->
      println(msg)
    }
  }

  task.join([producer, consumer])
}
-- prints:
--   hello
--   from
--   silt
