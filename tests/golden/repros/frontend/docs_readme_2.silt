-- verdict: same
import channel
import list
import task

fn main() {
  let ch = channel.new(10)

  let w1 = fn() {
    channel.each(ch) { msg -> println("w1: {msg}") }
  }
  let w2 = fn() {
    channel.each(ch) { msg -> println("w2: {msg}") }
  }
  let sender = fn() {
    list.each(1..100) { n -> channel.send(ch, n) }
    channel.close(ch)
  }

  task.join([w1, w2, sender])
}
