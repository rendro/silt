-- verdict: same
import io
import task
import time

fn main() {
  let outcome = task.deadline(time.ms(200), fn() {
    io.read_file("/var/log/slow.log")
  })
  match outcome {
    Ok(Ok(contents)) -> println(contents)
    Ok(Err(_)) -> println("io error")
    Err(_) -> println("the deadline passed")
  }
}
