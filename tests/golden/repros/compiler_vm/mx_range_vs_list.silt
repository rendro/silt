-- verdict: same
import list
import set
import map
import json
import io
fn main() {
  let r = 1..3
  let l = [1, 2, 3]
  println("r == l: {r == l}")
  println("display: {r} vs {l}")
  println("inspect: {io.inspect(r)} vs {io.inspect(l)}")
  println(".display(): {r.display()} vs {l.display()}")
  println("hash eq: {r.hash() == l.hash()}")
  println("set: {set.from_list([r, l])}")
  println("json: {json.stringify(r)} vs {json.stringify(l)}")
  println("empty: {5..1} == []: {5..1 == []}")
  println("compare: {r.compare(l)}  r < l: {r < l}")
  let m = #{ r: "range" }
  println(map.get(m, l))
}
