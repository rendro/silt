import list
import set
import string
type T {
  Leaf,
  Node(List(T))
}
fn build(n) {
  let leaf = Leaf
  let go = { i, acc ->
    match i >= n {
      true -> acc
      false -> go(i + 1, Node([acc]))
    }
  }
  go(0, leaf)
}
fn main() {
  let a = build(100000)
  let b = build(100000)
  println("built")
  println(1)
  println("done")
}
