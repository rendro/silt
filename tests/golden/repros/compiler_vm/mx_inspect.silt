import io
type P { s: String, f: Float }
type E { V(String, Float) }
fn main() {
  println(io.inspect(1.0))
  println(io.inspect("a\"b\\c"))
  println(io.inspect(["x", "y\"z"]))
  println(io.inspect(P { s: "q\"r", f: 2.0 }))
  println(io.inspect(V("s", 3.0)))
  println(io.inspect({ a: 1, b: "two" }))
  println(io.inspect(1..3))
  println("{1.0} {2.5} {1.0e21} {1.0e-7} {100000000000000000000.0}")
}
