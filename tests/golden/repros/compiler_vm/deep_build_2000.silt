-- verdict: same
type L {
  Nil,
  Cons(Int, L)
}
fn build(n) {
  let nil = Nil
  let step = { i, acc ->
    match i >= n {
      true -> acc
      false -> step(i + 1, Cons(i, acc))
    }
  }
  step(0, nil)
}
fn len(xs) {
  let go = { cur, n ->
    match cur {
      Nil -> n
      Cons(_, rest) -> go(rest, n + 1)
    }
  }
  go(xs, 0)
}
fn main() {
  let a = build(2000)
  println(len(a))
}
