-- verdict: same
type L {
  Nil,
  Cons(Int, L)
}
fn build(n) {
  let nil = Nil
  loop i = 0, acc = nil {
    match i >= n {
      true -> acc
      false -> loop(i + 1, Cons(i, acc))
    }
  }
}
fn len(xs) {
  loop cur = xs, n = 0 {
    match cur {
      Nil -> n
      Cons(_, rest) -> loop(rest, n + 1)
    }
  }
}
fn main() {
  let a = build(2000)
  println(len(a))
}
