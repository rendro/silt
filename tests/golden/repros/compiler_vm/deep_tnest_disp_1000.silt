import list
import set
import string
import task
type T {
  Leaf,
  Node(List(T))
}
fn build(n) {
  let leaf = Leaf
  loop i = 0, acc = leaf {
    match i >= n {
      true -> acc
      false -> loop(i + 1, Node([acc]))
    }
  }
}
fn work() {
  let a = build(1000)
  let b = build(1000)
  string.length("{a}")
}
fn main() {
  println(task.map([0], 1, fn(_) { work() }))
  println("done")
}
