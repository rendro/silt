-- verdict: same
import task
import list

type L {
  Nil,
  Cons(Int, L)
}

fn build(n) {
  let nil = Nil
  let go = { i, acc ->
    match i >= n {
      true -> acc
      false -> go(i + 1, Cons(i, acc))
    }
  }
  go(0, nil)
}

fn work() {
  let a = build(30)
  let b = build(30)
  a == b
}

fn main() {
  println(task.map([0], 1, fn(_) { work() }))
}
