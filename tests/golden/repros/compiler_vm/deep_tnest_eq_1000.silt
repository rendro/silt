-- verdict: same
import list
import set
import string
import task
type T {
  Leaf,
  Node(List(T))
}
fn build(n) {
  let leaf = Leaf
  let go = { i, acc ->
    match i >= n {
      true -> acc
      false -> go(i + 1, Node([acc]))
    }
  }
  go(0, leaf)
}
fn work() {
  let a = build(1000)
  let b = build(1000)
  a == b
}
fn main() {
  println(task.map([0], 1, fn(_) { work() }))
  println("done")
}
