-- verdict: same
import list
import set
import string
type T {
  Leaf,
  Node(List(T))
}
fn build(n) {
  let leaf = Leaf
  loop i = 0, acc = leaf {
    match i >= n {
      true -> acc
      false -> loop(i + 1, Node([acc]))
    }
  }
}
fn main() {
  let a = build(1000000)
  let b = build(1000000)
  println("built")
  println(a < b)
  println("done")
}
