-- verdict: same
import channel
let ch = channel.new(3)
fn drain() {
  loop {
    match channel.receive(ch) {
      Some(v) -> {
        println("got {v}")
        loop()
      }
      None -> println("done")
    }
  }
}
fn main() {
  channel.send(ch, 1)
  channel.send(ch, 2)
  channel.close(ch)
  drain()
}
