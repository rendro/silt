import math
fn takes_ext(x: ExtFloat) -> ExtFloat { x }
fn takes_float(x: Float) -> Float { x }
fn main() {
  let a: ExtFloat = 1.0
  println(takes_ext(2.0))
  let xs = [1.0, 1.0 / 2.0]
  println(xs)
  let m = match true { true -> 1.0, false -> 1.0 / 2.0 }
  println(m)
  let ys: List(ExtFloat) = [1.0, 2.0]
  println(ys)
  println(takes_float(1.0 / 2.0))
}
