-- verdict: same
import channel
let ch = channel.new(3)
fn drain(unused) {
  loop {
    match channel.receive(ch) {
      Message(v) -> {
        println("got {v}")
        loop()
      }
      _ -> println("done")
    }
  }
}
fn main() {
  channel.send(ch, 1)
  channel.send(ch, 2)
  channel.close(ch)
  drain(0)
}
