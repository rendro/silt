-- verdict: same
type P { x: Int, y: Float, s: String }
type E { A(Int, String), B, C(P) }
fn main() {
  let p = P { x: 1, y: 2.0, s: "hi" }
  println(p)
  println(p.display())
  println("{p}")
  println([p])
  println(C(p))
  println(C(p).display())
  println("{C(p)}")
  println(A(1, "s"))
  println(Some("s"))
  println(("s", 1))
  println(["s"])
  println(#{"k": "v"})
  println("s")
  println(Some(2.0))
  println(2.0.display())
  println(Ok(()))
}
