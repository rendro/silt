-- verdict: same
type P { x: Int, y: String }
type B(a) { v: a, w: Int }
type E { A(Int), C }
type G(a) { Wrap(a), Nil }
fn main() {
  let p = P { x: 1, y: "s" }
  let b = B { v: 1, w: 2 }
  println("{p}")
  println("{b}")
  println("{A(1)}")
  println("{Wrap(1)}")
  println("{p} {b}")
  println(p == p)
  println(b == b)
  println(Compare.compare(p, P { x: 2, y: "a" }))
  println(Compare.compare(b, B { v: 2, w: 0 }))
  println(Hash.hash(p) == Hash.hash(p))
  println(Hash.hash(b) == Hash.hash(b))
  println(p < P { x: 2, y: "a" })
  println(Compare.compare(Wrap(1), Nil))
  println(Compare.compare(A(1), C))
}
