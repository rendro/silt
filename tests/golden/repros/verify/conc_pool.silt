-- verdict: same
import channel
import task
import list
fn collect(ch, n, acc) {
  match n {
    0 -> acc
    _ -> {
      match channel.receive(ch) {
        Some(v) -> collect(ch, n - 1, acc + v)
        None -> acc
      }
    }
  }
}
fn main() {
  let results = channel.new(10)
  let ids = 1..41
  let senders = ids |> list.map { i -> fn() { channel.send(results, i * i) } }
  let total = task.background(senders, fn() { collect(results, 40, 0) })
  println("total {total}")
}
