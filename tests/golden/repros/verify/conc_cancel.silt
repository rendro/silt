-- verdict: same
import channel
import task

fn spin(n) {
  match n {
    0 -> 0
    _ -> spin(n - 1)
  }
}

fn go(i, n) {
  match i < n {
    true -> {
      let ch = channel.new(1)
      println("A{i} before spawn")
      let h = task.spawn(fn() { channel.receive(ch) })
      let _ = spin(i % 40)
      println("B{i} before cancel")
      task.cancel(h)
      println("C{i} after cancel")
      go(i + 1, n)
    }
    false -> ()
  }
}

fn main() {
  go(0, 3000)
  println("completed 3000 spawn+cancel rounds")
}
