-- verdict: same
import channel
import task
import time
fn main() {
  let ch = channel.new(1)
  channel.send(ch, 0)
  -- a helper blocks in send on a full buffer
  let sender = fn() {
    channel.send(ch, 99)
    println("sender resumed (should not happen after the stop)")
  }
  task.background([sender], fn() { time.sleep(time.ms(100)) })
  time.sleep(time.ms(50))
  -- drain: the stopped sender's value must not appear
  match channel.try_receive(ch) { channel.Message(v) -> println("got {v}")  _ -> println("none") }
  match channel.try_receive(ch) { channel.Message(v) -> println("got {v}")  _ -> println("none (stopped send did not deliver)") }
  -- is the channel still usable? a fresh sender/receiver pair
  task.join([fn() { channel.send(ch, 7) }])
  match channel.receive(ch) { Some(v) -> println("fresh got {v}")  _ -> println("other") }
}
