-- verdict: same
import channel
import task
fn main() {
  let ch = channel.new(0)
  let consumer = fn() {
    println(match channel.receive(ch) {
      Some(v) -> "got {v}"
      None -> "closed"
    })
  }
  let producer = fn() {
    let x = 0
    channel.send(ch, 10 / x)
  }
  task.join([consumer, producer])
}
