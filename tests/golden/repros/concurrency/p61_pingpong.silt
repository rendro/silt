-- verdict: same
import channel
import list
import option
import task

fn player(inp, out, rounds) {
  match rounds {
    0 -> 0
    _ -> {
      match channel.receive(inp) {
        Some(v) -> {
          channel.send(out, v + 1)
          player(inp, out, rounds - 1)
        }
        None -> 0 - 1
      }
    }
  }
}

-- 1000 pairs (2000 tasks) ping-ponging 20 rounds each over rendezvous channels
fn main() {
  let finals = channel.new(1000)
  let pairs = 1..1000 |> list.flat_map { i ->
    let a = channel.new(0)
    let b = channel.new(0)
    let p1 = fn() {
      let _ = player(a, b, 20)
    }
    let p2 = fn() {
      channel.send(a, 0)
      let _ = player(b, a, 19)
      channel.send(finals, match channel.receive(b) {
        Some(v) -> v
        None -> 0 - 1
      })
    }
    [p1, p2]
  }
  task.join(pairs)
  channel.close(finals)
  let total = 1..1000 |> list.fold(0) { acc, _ -> acc + (channel.receive(finals) |> option.unwrap_or(0)) }
  println("sum of final tokens: {total} (expected {1000 * 39})")
}
