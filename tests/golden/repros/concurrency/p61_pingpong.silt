-- verdict: same
import channel
import list
import task

fn player(inp, out, rounds) {
  match rounds {
    0 -> 0
    _ -> {
      match channel.receive(inp) {
        Message(v) -> {
          channel.send(out, v + 1)
          player(inp, out, rounds - 1)
        }
        _ -> 0 - 1
      }
    }
  }
}

-- 1000 pairs (2000 tasks) ping-ponging 20 rounds each over rendezvous channels
fn main() {
  let pairs = 1..1000 |> list.map { i ->
    let a = channel.new()
    let b = channel.new()
    let p1 = task.spawn(fn() { player(a, b, 20) })
    let p2 = task.spawn(fn() {
      channel.send(a, 0)
      player(b, a, 19)
      match channel.receive(b) {
        Message(v) -> v
        _ -> 0 - 1
      }
    })
    p2
  }
  let total = pairs |> list.fold(0) { acc, h -> acc + task.join(h) }
  println("sum of final tokens: {total} (expected {1000 * 39})")
}
