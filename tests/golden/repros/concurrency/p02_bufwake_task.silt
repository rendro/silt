-- verdict: same
import channel
import task
import time
import list

fn recv_n(ch, n) {
  match n {
    0 -> ()
    _ -> {
      match channel.receive(ch) {
        Message(v) -> println("got {v}")
        _ -> println("other")
      }
      recv_n(ch, n - 1)
    }
  }
}

fn main() {
  let ch = channel.new(3)
  let hs = [1, 2, 3, 4, 5, 6, 7, 8] |> list.map { i ->
    task.spawn(fn() { channel.send(ch, i) })
  }
  time.sleep(time.ms(200))
  let r = task.spawn(fn() { recv_n(ch, 8) })
  task.join(r)
  println("done")
}
