-- verdict: same
import channel
import task
import time
import list

fn recv_n(ch, n) {
  match n {
    0 -> ()
    _ -> {
      match channel.receive(ch) {
        Some(v) -> println("got {v}")
        None -> println("other")
      }
      recv_n(ch, n - 1)
    }
  }
}

fn main() {
  let ch = channel.new(3)
  let senders = [1, 2, 3, 4, 5, 6, 7, 8] |> list.map { i ->
    fn() { channel.send(ch, i) }
  }
  let receiver = fn() {
    time.sleep(time.ms(200))
    recv_n(ch, 8)
  }
  task.join(list.append(senders, receiver))
  println("done")
}
