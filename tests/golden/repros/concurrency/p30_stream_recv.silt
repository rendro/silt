-- verdict: same
import channel
import stream
import time
fn main() {
  -- a slow stream source: one element every 300ms
  let s = stream.unfold(0) { n ->
    time.sleep(time.ms(300))
    match n < 3 {
      true -> Some((n, n + 1))
      false -> None
    }
  }
  -- streams ARE channels, so channel.receive is a legal consumer
  match channel.receive(s) {
    Some(v) -> println("got {v}")
    None -> println("closed")
  }
  -- the rest is not wanted: the program ends when the stream has stopped
  channel.close(s)
}
