-- verdict: same
import channel
import task
import time

fn spin_loop(n, acc) {
  match n {
    0 -> acc
    _ -> spin_loop(n - 1, acc + n)
  }
}

fn worker(ch, n) {
  -- busy for a while (so the stop arrives while RUNNING), then park on receive
  let _ = spin_loop(30000, 0)
  match channel.receive(ch) {
    Some(v) -> {
      println("worker: processed message {v} (iteration {n})")
      worker(ch, n + 1)
    }
    None -> println("worker: channel closed")
  }
}

fn main() {
  let ch = channel.new(8)
  task.background([fn() { worker(ch, 0) }], fn() { time.sleep(time.ms(20)) })
  println("main: stopped worker while it was running")
  channel.send(ch, 1)
  channel.send(ch, 2)
  channel.send(ch, 3)
  time.sleep(time.ms(3000))
  println("main: done")
}
