-- verdict: same
import channel
import task
import time

fn spin_loop(n, acc) {
  match n {
    0 -> acc
    _ -> spin_loop(n - 1, acc + n)
  }
}

fn worker(ch, n) {
  -- busy for a while (so cancel arrives while RUNNING), then park on receive
  let _ = spin_loop(30000, 0)
  match channel.receive(ch) {
    channel.Message(v) -> {
      println("worker: processed message {v} (iteration {n})")
      worker(ch, n + 1)
    }
    _ -> println("worker: channel closed")
  }
}

fn main() {
  let ch = channel.new(8)
  let h = task.spawn(fn() { worker(ch, 0) })
  time.sleep(time.ms(20))
  task.cancel(h)
  println("main: cancelled worker while it was running")
  channel.send(ch, 1)
  channel.send(ch, 2)
  channel.send(ch, 3)
  time.sleep(time.ms(3000))
  println("main: done")
}
