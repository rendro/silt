-- verdict: same
import channel
import option
import task

fn one_round(i) {
  let ch = channel.new(1)
  let got = channel.new(1)
  let a = fn() {
    channel.send(got, match channel.receive(ch) {
      Some(v) -> v
      None -> 0 - 1
    })
  }
  let b = fn() { channel.send(ch, i) }
  task.join([a, b])
  channel.receive(got) |> option.unwrap_or(0 - 1)
}

fn go(i, acc) {
  match i < 150 {
    true -> go(i + 1, acc + one_round(i))
    false -> acc
  }
}

fn main() {
  println("sum {go(0, 0)}")
}
