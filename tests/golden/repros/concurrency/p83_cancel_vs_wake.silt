-- verdict: same
import channel
import task
import time

fn spin(n) {
  match n {
    0 -> 0
    _ -> spin(n - 1)
  }
}

-- T is fully PARKED in channel.receive (the body waits 2ms to be sure).
-- Then a sender wakes it while the end of the body stops it.
fn go(i, n) {
  match i < n {
    true -> {
      let ch = channel.new(1)
      let sent = channel.new(1)
      task.background([fn() { let _ = channel.receive(ch) }], fn() {
        time.sleep(time.ms(2))
        task.background([fn() { channel.send(sent, channel.try_send(ch, i)) }], fn() {
          let _ = spin(i % 30)
          println("B{i} before stop")
        })
      })
      println("C{i} after stop")
      go(i + 1, n)
    }
    false -> ()
  }
}

fn main() {
  go(0, 1500)
  println("completed 1500 rounds")
}
