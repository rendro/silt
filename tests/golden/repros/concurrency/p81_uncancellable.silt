-- verdict: same
import channel
import task
import time

fn spin_loop(n, acc) {
  match n {
    0 -> acc
    _ -> spin_loop(n - 1, acc + n)
  }
}

fn worker(ch, n) {
  let _ = spin_loop(30000, 0)
  match channel.receive(ch) {
    Some(v) -> {
      println("worker: processed message {v}")
      worker(ch, n + 1)
    }
    None -> println("worker: channel closed")
  }
}

fn main() {
  let ch = channel.new(8)
  -- the stop comes while the worker runs; it must end at its next receive
  task.background([fn() { worker(ch, 0) }], fn() { time.sleep(time.ms(20)) })
  println("main: stop (worker running)")
  time.sleep(time.ms(1500))
  channel.send(ch, 1)
  time.sleep(time.ms(1000))
  println("main: done")
}
