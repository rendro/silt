-- verdict: same
import channel
import task
import time
import list

fn main() {
  let ch = channel.new(2)
  let senders = [1, 2, 3, 4, 5, 6] |> list.map { i ->
    fn() { channel.send(ch, i) }
  }
  task.background(senders, fn() {
    time.sleep(time.ms(200))
    -- now 2 values buffered, 4 senders parked
    let go = { n ->
      match n < 6 {
        true -> {
          match channel.receive(ch) {
            Some(v) -> println("got {v}")
            None -> println("other")
          }
          go(n + 1)
        }
        false -> ()
      }
    }
    go(0)
  })
  println("done")
}
