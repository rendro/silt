-- verdict: same
import channel
import option
import task
import time

fn main() {
  let a = channel.new(4)
  let b = channel.new(4)
  let out1 = channel.new(1)
  let out2 = channel.new(1)
  -- R1: one-shot select over a and b
  let r1 = fn() {
    channel.send(out1, match channel.select([channel.Recv(a), channel.Recv(b)]) {
      channel.Received(^a, Some(v)) -> "r1 took a:{v}"
      channel.Received(^b, Some(v)) -> "r1 took b:{v}"
      _ -> "r1 other"
    })
  }
  -- R2: plain receive on a (registered behind R1 in a's waker FIFO)
  let r2 = fn() {
    time.sleep(time.ms(50))
    channel.send(out2, match channel.receive(a) {
      Some(v) -> "r2 took a:{v}"
      None -> "r2 other"
    })
  }
  -- one value for each channel: enough for both receivers
  let sender = fn() {
    time.sleep(time.ms(100))
    channel.send(a, 1)
    channel.send(b, 2)
  }
  task.join([r1, r2, sender])
  println(channel.receive(out1) |> option.unwrap_or(""))
  println(channel.receive(out2) |> option.unwrap_or(""))
}
