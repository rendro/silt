-- verdict: known-divergent run
import channel
import task

fn spin(n) {
  match n {
    0 -> 0
    _ -> spin(n - 1)
  }
}

fn go(i, n) {
  match i < n {
    true -> {
      let ch = channel.new(1)
      let h = task.spawn(fn() { channel.receive(ch) })
      let _ = spin(i % 40)
      task.cancel(h)
      match i % 50 {
        0 -> println("round {i}")
        _ -> ()
      }
      go(i + 1, n)
    }
    false -> ()
  }
}

fn main() {
  go(0, 3000)
  println("completed 3000 spawn+cancel rounds")
}
