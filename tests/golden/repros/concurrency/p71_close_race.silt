-- verdict: same
import channel
import option
import task

fn spin(n) {
  match n {
    0 -> 0
    _ -> spin(n - 1)
  }
}

fn consume(ch, n) {
  match channel.receive(ch) {
    Some(_) -> consume(ch, n + 1)
    None -> n
  }
}

fn produce(ch, n) {
  match channel.select([channel.Send(ch, n)]) {
    channel.Sent(_) -> produce(ch, n + 1)
    _ -> n
  }
}

fn go(i, lost_rounds, lost_values) {
  match i < 400 {
    true -> {
      let ch = channel.new(8)
      let received_count = channel.new(1)
      let sent_count = channel.new(1)
      let c = fn() { channel.send(received_count, consume(ch, 0)) }
      let s = fn() { channel.send(sent_count, produce(ch, 0)) }
      let closer = fn() {
        let _ = spin(200 + i % 97)
        channel.close(ch)
      }
      task.join([c, s, closer])
      let sent = channel.receive(sent_count) |> option.unwrap_or(0)
      let received = channel.receive(received_count) |> option.unwrap_or(0)
      match sent > received {
        true -> go(i + 1, lost_rounds + 1, lost_values + sent - received)
        false -> go(i + 1, lost_rounds, lost_values)
      }
    }
    false -> println("rounds with sends acknowledged but never delivered: {lost_rounds}/400, values lost: {lost_values}")
  }
}

fn main() {
  go(0, 0, 0)
}
