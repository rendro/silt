-- verdict: same
import list
import task
import time

fn spin_loop(n, acc) {
  match n {
    0 -> acc
    _ -> spin_loop(n - 1, acc + n)
  }
}

fn main() {
  let t0 = time.now()
  -- 4 CPU-bound tasks (= number of workers on this 4-core box).
  -- Variant A: plain recursion (top-level opcodes, preemptible every 2000 ops)
  let hogs = [1, 2, 3, 4] |> list.map { i ->
    task.spawn(fn() { spin_loop(300000, 0) })
  }
  let quick = task.spawn(fn() { time.now() })
  let tq = task.join(quick)
  println("A (recursion hogs): quick task ran after {time.since(t0, tq)}")
  let _ = hogs |> list.map { h -> task.join(h) }

  let t1 = time.now()
  -- Variant B: same work inside a higher-order builtin callback
  let hogs2 = [1, 2, 3, 4] |> list.map { i ->
    task.spawn(fn() { 1..300000 |> list.fold(0) { acc, n -> acc + n } })
  }
  let quick2 = task.spawn(fn() { time.now() })
  let tq2 = task.join(quick2)
  println("B (list.fold hogs): quick task ran after {time.since(t1, tq2)}")
  let _ = hogs2 |> list.map { h -> task.join(h) }
  println("total {time.since(t0, time.now())}")
}
