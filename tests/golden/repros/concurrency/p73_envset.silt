-- verdict: same
import env
import stream
import task

fn main() {
  -- from a spawned task: rejected
  let h = task.spawn(fn() { env.set("SILT_PROBE_A", "task") })
  println("joined")
  -- from a stream pump thread (an OS thread that is NOT the main thread): accepted
  let out = stream.from_list([1, 2, 3])
    |> stream.map { x ->
      env.set("SILT_PROBE_B", "pump {x}")
      x
    }
    |> stream.collect
  println(out)
  println(env.get("SILT_PROBE_B"))
  task.join(h)
}
