-- verdict: same
import channel
import list
import stream
import task
import time

-- streams are channels: a user channel fed by a task is a legal stream.
-- 4 consumer tasks (= worker count) each run a stream sink on their own
-- channel; the 4 producers start them 200 ms later.
fn main() {
  let chans = [1, 2, 3, 4] |> list.map { i -> channel.new(4) }
  let producers = chans |> list.map { ch ->
    fn() {
      time.sleep(time.ms(200))
      channel.send(ch, 1)
      channel.close(ch)
    }
  }
  let outs = task.background(producers, fn() { task.map(chans, 4, fn(ch) { stream.collect(ch) }) })
  println(outs)
}
