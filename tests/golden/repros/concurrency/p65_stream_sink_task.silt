-- verdict: same
import channel
import list
import stream
import task
import time

-- streams are channels: a user channel fed by a task is a legal stream.
-- 4 consumer tasks (= worker count) each run a stream sink on their own
-- channel; the 4 producers are spawned afterwards.
fn main() {
  let chans = [1, 2, 3, 4] |> list.map { i -> channel.new(4) }
  let consumers = chans |> list.map { ch ->
    task.spawn(fn() { stream.collect(ch) })
  }
  time.sleep(time.ms(200))
  let producers = chans |> list.map { ch ->
    task.spawn(fn() {
      channel.send(ch, 1)
      channel.close(ch)
    })
  }
  let outs = consumers |> list.map { h -> task.join(h) }
  println(outs)
}
