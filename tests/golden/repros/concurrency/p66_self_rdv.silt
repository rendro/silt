-- verdict: same
import channel
import task

fn main() {
  let ch = channel.new(0)
  -- a single task offering BOTH directions on one unbuffered channel.
  -- There is no second party, so neither arm can ever complete.
  let h = task.spawn(fn() {
    match channel.select([channel.Recv(ch), channel.Send(ch, 7)]) {
      channel.Sent(_) -> "Sent (to whom?)"
      channel.Received(_, Some(v)) -> "Message {v}"
      channel.Received(_, None) -> "Closed"
      _ -> "other"
    }
  })
  println(task.join(h))
  println("leftover in channel: {channel.try_receive(ch)}")
}
