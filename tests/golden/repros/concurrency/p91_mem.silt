-- verdict: same
import channel
import task
import list
import time

fn main() {
  let ch = channel.new(1)
  let parked = 1..5000 |> list.map { i -> fn() { let _ = channel.receive(ch) } }
  let n = task.background(parked, fn() {
    time.sleep(time.ms(500))
    println("READY")
    time.sleep(time.ms(2500))
    list.length(parked)
  })
  println(n)
}
