-- verdict: same
import channel
import list
import task
import time

fn outer(g, ys) {
  "outer called with a function and {list.length(ys)} results"
}

fn inner(c, ys) {
  "INNER called instead: second arg has {list.length(ys)} results"
}

fn main() {
  let a = channel.new(1)
  let sender = { ->
    time.sleep(time.ms(50))
    channel.send(a, 1)
  }
  task.join([sender, { -> println(outer(inner, list.map([a], channel.receive))) }])
}
