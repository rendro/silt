-- verdict: same
import int
import float
import list
fn main() {
  ["42", " 42 ", "+42", "-0", "0x1F", "1_000", "1e3", "12.0", "", "   ", "9223372036854775808", "-9223372036854775809", "٤٢", "42abc", "--1", "+"]
  |> list.each { s -> println("int.parse({s}) = {int.parse(s)}") }
  ["1.5", " 1.5 ", "1e400", "-1e400", "nan", "NaN", "inf", "-inf", "Infinity", ".5", "5.", "1_0.0", "0x10", "", "1,5", "-0.0", "1e-400", "1e", "+1.5"]
  |> list.each { s -> println("float.parse({s}) = {float.parse(s)}") }
}
