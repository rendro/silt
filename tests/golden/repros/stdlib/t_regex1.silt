-- verdict: same
import regex
import result
import string
fn main() {
  println(regex.compile("a+") |> result.map { compiled_re -> "caaat" |> regex.replace_first(compiled_re, "X") })
  println("caaat" |> string.replace("aaa", "X"))
  println(regex.compile("[,;]") |> result.map { compiled_re -> "a,b;c" |> regex.split(compiled_re) })
  println("a,b;c" |> string.split(","))
}
