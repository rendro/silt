-- verdict: same
import time
import channel
fn main() {
  let a = time.now()
  let b = time.add(a, time.seconds(5))
  println(time.since(a, b))
  println(time.since(b, a))
  when let Ok(d1) = time.date(2024, 1, 1) else { return }
  when let Ok(d2) = time.date(2024, 1, 11) else { return }
  println(time.days_between(d1, d2))
  println(time.ms(1500))
  println(time.hours(2))
  println(time.to_utc(a) == time.to_datetime(a, 0))
  println(time.weekday(d1))
  println(d1)
  println(time.datetime(d1, time.time(1, 2, 3) |> fn(r) { match r { Ok(t) -> t
    Err(_) -> panic("x") } }))
  println(time.seconds(-5))
  println(time.nanos(1))
  println(time.ms(90061001))
}
