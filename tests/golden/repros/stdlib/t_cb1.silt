-- verdict: same
import channel
import list
import stream
import time

-- builtin passed directly as callback; it must block (yield)
fn main() {
  let a = stream.from_fn { ch ->
    time.sleep(time.ms(50))
    channel.send(ch, 1)
  }
  let b = stream.from_fn { ch ->
    time.sleep(time.ms(100))
    channel.send(ch, 2)
  }
  let marker = "marker"
  let r = list.map([a, b], channel.receive)
  let after = "after"
  println(marker)
  println(r)
  println(after)
}
