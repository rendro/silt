-- verdict: same
import time
import result
fn main() {
  when let Ok(d) = time.date(2024, 1, 31) else { return }
  println((time.format_date(d, "%Y-%m-%d") |> result.unwrap_or("")))
  println((time.format_date(d, "%Q %Y") |> result.unwrap_or("")))
  println((time.format_date(d, "%H:%M") |> result.unwrap_or("")))
  println((time.format_date(d, "%") |> result.unwrap_or("")))
  println(time.parse_date("2024-01-31", "%Q"))
  println(time.parse("2024-01-31", "%Y-%m-%d"))
  println(time.parse_date("2024-01-31 10:00", "%Y-%m-%d %H:%M"))
}
