-- verdict: same
import set
import map
fn main() {
  let f = fn(x) { x + 1 }
  let g = fn(x) { x + 1 }
  let s = #[f, g, f]
  println(set.length(s))
  println(set.contains(s, f))
  println(set.contains(s, fn(x) { x + 1 }))
  let m = #{ f: 1, g: 2 }
  match m {
    #{ ^f: v } -> println(v)
    _ -> println("none")
  }
}
