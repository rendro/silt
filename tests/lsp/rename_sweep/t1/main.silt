trait Scale {
  fn scale(self, by: Int) -> Int {
    Scale.size(self) * by
  }
  fn size(self) -> Int
}

type Box {
  w: Int,
}

trait Scale for Box {
  fn size(self) -> Int {
    self.w
  }
}

fn twice(x: a) -> Int where a: Scale {
  Scale.scale(x, 2) + Scale.size(x)
}

fn main() {
  let b = Box { w: 3 }
  println(Scale.scale(b, 2) + twice(b) + Scale.size(b))
}
