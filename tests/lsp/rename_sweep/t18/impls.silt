import shapes

pub trait Area {
  fn area(self) -> Int
}

trait Area for shapes.Shape {
  fn area(self) -> Int {
    match self {
      shapes.Dot -> 0
      shapes.Box(w) -> w * w
    }
  }
}

pub fn total(xs: List(shapes.Shape)) -> Int {
  match xs {
    [] -> 0
    [x, ..rest] -> x.area() + total(rest)
  }
}
