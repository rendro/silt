type Meters {
  Meters(Int),
}

type Box(a) {
  item: a,
}

type Wide = Box(Meters)

type Applied {
  m: Meters,
  n: Int,
}

trait Container(item) {
  fn unwrap(self) -> item
}

trait Container(a) for Box(a) {
  fn unwrap(self) -> a {
    self.item
  }
}

trait Container(Int) for Meters {
  fn unwrap(self) -> Int {
    match self {
      Meters(n) -> n
    }
  }
}

fn apply(f: Fn(Meters) -> Meters, pair: (Meters, Int)) -> Applied {
  let (m, n) = pair
  Applied { m: f(m), n: n }
}

fn get(c: t) -> Int where t: Container(Int) {
  Container.unwrap(c)
}

fn main() {
  let w: Wide = Box { item: Meters(2) }
  let g = { x: Meters -> x }
  let inner: Meters = Container.unwrap(w)
  let r = apply(g, (inner, 3))
  let v: List(Meters) = [r.m]
  let k = (Meters(4) as Meters)
  println(get(k) + get(Box { item: 1 }) + r.n)
  match v {
    [Meters(q)] -> println(q)
    _ -> println(0)
  }
}
