-- exit: 1
-- An impl of `json.Decode` that fails while a stream's row is finished
-- ends the stream with its failure, as a failing stream stage does:
-- `channel.receive` on the stream raises it, after the rows before it,
-- as `channel.each` does.
import channel
import env
import json
import postgres

type Code { digits: String }

trait json.Decode for Code {
  fn decode(value: json.Value) -> Result(Self, json.JsonError) {
    match value {
      json.Int(n) -> Ok(Code { digits: "{100 / n}" })
      _ -> Err(json.Other("no code here"))
    }
  }
}

type R { code: Code }

fn url() -> String {
  match env.get("SILT_TEST_POSTGRES_URL") {
    Some(url) -> url
    None -> ""
  }
}

fn drain(rows: Channel(Result(R, postgres.PostgresError))) {
  match channel.receive(rows) {
    Some(row) -> {
      println(row)
      drain(rows)
    }
    None -> println("not reached")
  }
}

fn main() {
  match postgres.connect(url()) {
    Ok(db) -> {
      let sql = "SELECT to_jsonb(3 - g) AS code FROM generate_series(1, 4) g"
      match postgres.stream(db, sql, (), R) {
        Ok(rows) -> drain(rows)
        Err(e) -> println(Error.message(e))
      }
      println("not reached")
    }
    Err(e) -> println(Error.message(e))
  }
}
