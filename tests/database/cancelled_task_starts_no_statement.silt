-- A function whose time is over takes nothing new, and so starts no
-- statement: `postgres.stream` still gives it a channel, but no
-- statement is sent for it, and at `postgres.execute` the function
-- ends. Neither row reaches the table.
--
-- The deadline is zero, a time that is over from the start, so the
-- stop comes at a known place, whatever the machine does.
--
-- That nothing was started is not read off the table at a moment the
-- case picks: a statement that was sent might not be there yet. The
-- program itself would say so: the function prints a line if it gets
-- past `postgres.execute`, and a helper of `main` prints whatever the
-- stream's channel gives, and when it is closed, while `main` counts.
-- With nothing started those lines are never printed, the reader waits
-- on a channel nobody sends on and is stopped when the counts are done,
-- and the counts are of a table that nothing writes to any more.
import channel
import env
import json
import postgres
import task
import time

fn url() -> String {
  match env.get("SILT_TEST_POSTGRES_URL") {
    Some(url) -> url
    None -> ""
  }
}

-- How many rows `sql` gives, counted as they come from a stream.
fn count(pool: postgres.PgPool, sql: String) -> Int {
  match postgres.stream(pool, sql, (), json.Value) {
    Ok(rows) -> loop n = 0 {
      match channel.receive(rows) {
        Some(Ok(_)) -> loop(n + 1)
        Some(Err(e)) -> {
          println("count: {e}")
          -1
        }
        _ -> n
      }
    }
    Err(e) -> {
      println("count: {e}")
      -1
    }
  }
}

fn main() {
  match postgres.connect(url()) {
    Ok(pool) -> {
      let _ = postgres.execute(pool, "DROP TABLE IF EXISTS silt_database_cancelled", ())
      let _ = postgres.execute(pool, "CREATE TABLE silt_database_cancelled (who text)", ())
      let said: Channel(String) = channel.new(1)
      let streams: Channel(Channel(Result(json.Value, postgres.PostgresError))) = channel.new(1)
      let _ = postgres.execute(
        pool,
        "INSERT INTO silt_database_cancelled VALUES ('before the deadline')",
        (),
      )
      let _ = task.deadline(time.ms(0)) { ->
        channel.send(said, "past its time, and still running")
        match postgres.stream(
          pool,
          "INSERT INTO silt_database_cancelled VALUES ('a stream after the deadline') RETURNING who",
          (),
          json.Value,
        ) {
          Ok(rows) -> channel.send(streams, rows)
          Err(e) -> println("postgres.stream: {e}")
        }
        let _ = postgres.execute(
          pool,
          "INSERT INTO silt_database_cancelled VALUES ('a statement after the deadline')",
          (),
        )
        println("the function went on after postgres.execute")
      }
      println(channel.receive(said))
      let counts = { ->
        let before = count(
          pool,
          "SELECT 1 FROM silt_database_cancelled WHERE who = 'before the deadline'",
        )
        let all = count(pool, "SELECT 1 FROM silt_database_cancelled")
        println("rows from before the deadline: {before}")
        println("rows in the table: {all}")
      }
      match channel.try_receive(streams) {
        channel.Message(rows) -> {
          println("postgres.stream gave the function a channel")
          let reader = { ->
            channel.each(rows) { _ -> println("the stream's channel gave something") }
            println("the stream's channel was closed")
          }
          task.background([reader], counts)
        }
        _ -> {
          println("postgres.stream gave the function no channel")
          counts()
        }
      }
      let _ = postgres.execute(pool, "DROP TABLE silt_database_cancelled", ())
      postgres.close(pool)
    }
    Err(e) -> println("connect: {e}")
  }
}
