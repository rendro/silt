-- A pool is opened on the server and answers `SELECT 1 AS one`: one
-- row, decoded into the record type the program names.
import env
import postgres

type One { one: Int }

fn url() -> String {
  match env.get("SILT_TEST_POSTGRES_URL") {
    Some(url) -> url
    None -> ""
  }
}

fn main() {
  match postgres.connect(url()) {
    Ok(pool) -> {
      match postgres.query(pool, "SELECT 1 AS one", (), One) {
        Ok(rows) -> println(rows)
        Err(e) -> println("query: {Error.message(e)}")
      }
      postgres.close(pool)
    }
    Err(e) -> println("connect: {Error.message(e)}")
  }
}
