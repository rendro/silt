-- A row that does not fit the record type the call names is the call's
-- `Err`, never a value. The columns are checked against the fields once
-- per result, before the statement runs: a field with no column
-- (`NoSuchColumn`, for an `Option` field too), a column whose type
-- cannot fill its field (`TypeMismatch`, whatever the values: no row at
-- all, or a `float8` that holds 2.0), two columns of the name a field
-- reads. So an `INSERT ... RETURNING` whose rows do not fit inserts
-- nothing. A cell that cannot be decoded (a NULL for a field that is no
-- `Option`, a NaN, a document that does not fit) is an error as it is
-- read; a document `null` fills an `Option` with `None`, as json.parse
-- gives it. An array of more dimensions, or of fewer, than its field's
-- list has levels is named with its dimensions. The message of a
-- mismatch says to cast the column in SQL, but not for a NULL, and not
-- for what a json or jsonb column holds (its actual part begins with
-- the column's type).
import env
import json
import postgres
import time

type Id { id: Int }

type Nick { id: Int, nick: Option(String) }

type Ratio { r: Float }

type Xs { x: List(Int) }

type Meta { level: Int }

type Doc { doc: Meta }

type MaybeDoc { doc: Option(Meta) }

type Grid { g: List(List(Int)) }

type Day { d: time.Date }

fn url() -> String {
  match env.get("SILT_TEST_POSTGRES_URL") {
    Some(url) -> url
    None -> ""
  }
}

-- The error, and what its `message()` says.
fn said(e: postgres.PostgresError) -> String {
  let variant = match e {
    postgres.TypeMismatch(column, expected, actual) -> "TypeMismatch({column}, {expected}, {actual})"
    postgres.NoSuchColumn(column) -> "NoSuchColumn({column})"
    postgres.Other(text) -> "Other({text})"
    _ -> "another error"
  }
  "{variant}\n  {e.message()}"
}

fn show(what: String, answer: Result(List(a), postgres.PostgresError)) where a: Display {
  match answer {
    Ok(rows) -> println("{what}: {rows}")
    Err(e) -> println("{what}: {said(e)}")
  }
}

fn main() {
  match postgres.connect(url()) {
    Ok(db) -> {
      show("a field with no column", postgres.query(db, "SELECT 1 AS x", (), Id))
      show("an Option field with no column", postgres.query(db, "SELECT 1 AS id", (), Nick))
      show("a column the server lacks", postgres.query(db, "SELECT nope FROM generate_series(1, 2)", (), Id))
      show("a float8 for an Int", postgres.query(db, "SELECT 2.0::float8 AS id", (), Id))
      show("a numeric for an Int", postgres.query(db, "SELECT 2::numeric AS id", (), Id))
      show("text for an Int, no rows", postgres.query(db, "SELECT 'a'::text AS id WHERE false", (), Id))
      show("an interval", postgres.query(db, "SELECT '1 day'::interval AS r", (), Ratio))
      show("an interval in a json.Value row", postgres.query(db, "SELECT '1 day'::interval AS r", (), json.Value))
      show("two columns a field reads", postgres.query(db, "SELECT 1 AS id, 2 AS id", (), Id))
      show("two columns no field reads", postgres.query(db, "SELECT 1 AS id, 2 AS x, 3 AS x", (), Id))
      show("two columns of a json.Value row", postgres.query(db, "SELECT 1 AS x, 2 AS x", (), json.Value))
      show("a NULL for an Int", postgres.query(db, "SELECT NULL::int4 AS id", (), Id))
      show("a NULL element", postgres.query(db, "SELECT ARRAY[1, NULL]::int4[] AS x", (), Xs))
      show("a NaN", postgres.query(db, "SELECT 'NaN'::float8 AS r", (), Ratio))
      show("a NaN in a json.Value row", postgres.query(db, "SELECT 'NaN'::float8 AS r", (), json.Value))
      show("a document that does not fit", postgres.query(db, """SELECT '{"level": "high"}'::jsonb AS doc""", (), Doc))
      show("a document null for an Option", postgres.query(db, "SELECT 'null'::jsonb AS doc", (), MaybeDoc))
      show("an array of 1 dimension for a list of lists", postgres.query(db, "SELECT ARRAY[1, 2] AS g", (), Grid))
      show("an array of 2 dimensions for a list", postgres.query(db, "SELECT ARRAY[[1], [2]] AS x", (), Xs))
      show("a date that is infinity", postgres.query(db, "SELECT 'infinity'::date AS d", (), Day))

      let _ = postgres.execute(db, "DROP TABLE IF EXISTS pg2_fit", ())
      let _ = postgres.execute(db, "CREATE TABLE pg2_fit (id int4, r float8)", ())
      show(
        "an INSERT whose RETURNING does not fit",
        postgres.query(db, "INSERT INTO pg2_fit VALUES (1, 0.5) RETURNING r AS id", (), Id),
      )
      show("rows in the table", postgres.query(db, "SELECT count(*) AS id FROM pg2_fit", (), Id))
      let _ = postgres.execute(db, "DROP TABLE pg2_fit", ())
      postgres.close(db)
    }
    Err(e) -> println("connect: {e.message()}")
  }
}
