-- A function is ended by its `task.deadline` while the server works
-- on its statement. `task.deadline` answers `Err(Timeout)`. The
-- statement is not interrupted: it goes on in the server, and
-- meanwhile the pool answers other statements.
--
-- The statement waits for an advisory lock that `main` holds in a
-- transaction, so it is still in flight when the deadline passes,
-- however long that takes, and `main` reads in `pg_locks` whether it
-- still waits. When `main` has committed, the statement gets the lock
-- and ends.
import channel
import env
import postgres
import task
import time

fn url() -> String {
  match env.get("SILT_TEST_POSTGRES_URL") {
    Some(url) -> url
    None -> ""
  }
}

-- How many rows `sql` gives, counted as they come from a stream.
fn count(pool: postgres.PgPool, sql: String) -> Int {
  match postgres.stream(pool, sql, []) {
    Ok(rows) -> loop n = 0 {
      match channel.receive(rows) {
        channel.Message(Ok(_)) -> loop(n + 1)
        channel.Message(Err(e)) -> {
          println("count: {e.message()}")
          -1
        }
        _ -> n
      }
    }
    Err(e) -> {
      println("count: {e.message()}")
      -1
    }
  }
}

-- How many sessions wait for the case's lock.
fn waiting(pool: postgres.PgPool) -> Int {
  count(
    pool,
    "SELECT 1 FROM pg_locks WHERE locktype = 'advisory' AND objid = 7302 AND NOT granted AND database = (SELECT oid FROM pg_database WHERE datname = current_database())",
  )
}

-- Look until `n` sessions wait for it.
fn until_waiting(pool: postgres.PgPool, n: Int) -> Int {
  loop seen = waiting(pool) {
    match seen == n {
      true -> seen
      false -> {
        time.sleep(time.ms(5))
        loop(waiting(pool))
      }
    }
  }
}

fn main() {
  match postgres.connect(url()) {
    Ok(pool) -> {
      let done = postgres.transact(pool) { tx ->
        let _ = postgres.query(tx, "SELECT pg_advisory_xact_lock(7302)", [])?
        println("main holds the lock")
        let late = task.deadline(time.ms(500)) { ->
          match postgres.query(pool, "SELECT pg_advisory_xact_lock(7302)", []) {
            Ok(_) -> "the statement's answer"
            Err(e) -> e.message()
          }
        }
        println(
          match late {
            Ok(said) -> "the function ended with {said}"
            Err(e) -> "task.deadline: {e.message()}"
          },
        )
        println("statements that wait for the lock in the server: {until_waiting(pool, 1)}")
        let one = count(pool, "SELECT 1")
        println("the pool answers meanwhile: {one} row")
        Ok(())
      }
      println("main's transaction: {done}")
      println("statements that wait for the lock now: {until_waiting(pool, 0)}")
      postgres.close(pool)
    }
    Err(e) -> println("connect: {e.message()}")
  }
}
