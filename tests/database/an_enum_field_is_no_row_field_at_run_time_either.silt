-- postgres has no decoder for an enum: a row type with an enum field
-- (or an Option, List or Map of one) is refused before any column is
-- matched, whatever the result holds, a json or jsonb column holding a
-- variant too. (The type arrives at run time: written at the call, the
-- compiler refuses it.) A record nested in a field is filled from a json
-- document by json's rules, which decode an enum.
import env
import list
import postgres

type Status {
  Active,
  Paused(Int),
}

type Job { state: Status }

type Jobs { states: List(Status) }

type Inner { state: Status }

type Wrapped { inner: Inner }

fn url() -> String {
  match env.get("SILT_TEST_POSTGRES_URL") {
    Some(url) -> url
    None -> ""
  }
}

fn rows(db: postgres.PgPool, sql: String, type a) -> Result(List(a), postgres.PostgresError) {
  postgres.query(db, sql, (), a)
}

fn show(r: Result(List(a), postgres.PostgresError)) {
  match r {
    Ok(rows) -> println("{list.length(rows)} rows")
    Err(e) -> println(e.message())
  }
}

fn main() {
  match postgres.connect(url()) {
    Ok(db) -> {
      show(rows(db, """SELECT '{"variant": "Active"}'::jsonb AS state""", Job))
      show(rows(db, "SELECT 1 AS other", Job))
      show(rows(db, """SELECT '[]'::jsonb AS states""", Jobs))
      show(rows(db, """SELECT '{"state": {"variant": "Active"}}'::jsonb AS inner""", Wrapped))
      postgres.close(db)
    }
    Err(e) -> println("connect: {e.message()}")
  }
}
