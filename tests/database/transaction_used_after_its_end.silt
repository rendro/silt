-- A transaction's `PgTx` that outlives `postgres.transact` (here it is
-- handed out through a channel) is a transaction that has ended: a
-- statement on it, a stream, a cursor, and the next batch of a cursor
-- opened in it are each `Err(Closed)`, as on a connection that is gone,
-- and nothing runs in the server. A cursor the program closed itself
-- says so instead.
import channel
import env
import json
import postgres

fn url() -> String {
  match env.get("SILT_TEST_POSTGRES_URL") {
    Some(url) -> url
    None -> ""
  }
}

fn said(answer: Result(a, postgres.PostgresError)) -> String {
  match answer {
    Ok(_) -> "Ok"
    Err(postgres.Closed) -> "Closed"
    Err(e) -> "another error: {e.message()}"
  }
}

fn main() {
  match postgres.connect(url()) {
    Ok(pool) -> {
      let out: Channel(postgres.PgTx) = channel.new(1)
      let opened: Channel(postgres.PgCursor) = channel.new(2)
      let done = postgres.transact(pool) { tx ->
        channel.send(out, tx)
        let left = postgres.cursor(tx, "SELECT g FROM generate_series(1, 5) AS g", (), 2, json.Value)?
        channel.send(opened, left)
        let shut = postgres.cursor(tx, "SELECT 1", (), 2, json.Value)?
        let _ = postgres.cursor_close(shut)?
        println("a cursor closed in it, again: {said(postgres.cursor_next(shut))}")
        postgres.query(tx, "SELECT 1", (), json.Value)
      }
      println("the transaction: {said(done)}")
      match channel.receive(out) {
        Some(tx) -> {
          println("a statement on it afterwards: {said(postgres.query(tx, "SELECT 1", (), json.Value))}")
          println("an execute: {said(postgres.execute(tx, "SELECT 1", ()))}")
          println("a stream: {said(postgres.stream(tx, "SELECT 1", (), json.Value))}")
          println("a cursor: {said(postgres.cursor(tx, "SELECT 1", (), 10, json.Value))}")
        }
        None -> println("no transaction came out")
      }
      match channel.receive(opened) {
        Some(left) -> println(
          "the next batch of a cursor left open: {said(postgres.cursor_next(left))}",
        )
        None -> println("no cursor came out")
      }
      postgres.close(pool)
    }
    Err(e) -> println("connect: {e.message()}")
  }
}
