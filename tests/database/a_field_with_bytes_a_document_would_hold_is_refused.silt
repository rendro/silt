-- A row's field fills Bytes only from a bytea column: as the field, in
-- an Option or in a List. Bytes in a Map, a tuple or a record type the
-- field names would come from a json document, which has no bytes, so
-- such a field is refused whatever the result holds: a column that is
-- there, one that is not, a NULL. The error names the field (of the
-- nested record type). Bytes as the field itself is read. (The type
-- arrives at run time: written at the call, the compiler refuses it.)
import env
import list
import postgres

type Blob { b: Bytes }
type InMap { m: Map(String, Bytes) }
type InTuple { t: (Int, Bytes) }
type Nested { blob: Option(Blob) }
type Listed { blobs: List(Blob) }
type Plain { b: Bytes, bs: List(Bytes) }

fn url() -> String {
  match env.get("SILT_TEST_POSTGRES_URL") {
    Some(url) -> url
    None -> ""
  }
}

fn rows(db: postgres.PgPool, sql: String, type a) -> Result(List(a), postgres.PostgresError) {
  postgres.query(db, sql, (), a)
}

fn show(r: Result(List(a), postgres.PostgresError)) {
  match r {
    Ok(rows) -> println("{list.length(rows)} rows")
    Err(e) -> println(e.message())
  }
}

fn main() {
  match postgres.connect(url()) {
    Ok(db) -> {
      show(rows(db, """SELECT '{"a": [1]}'::jsonb AS m""", InMap))
      show(rows(db, "SELECT 1 AS other", InTuple))
      show(rows(db, "SELECT NULL::jsonb AS blob", Nested))
      show(rows(db, "SELECT 1 AS other", Listed))
      show(rows(db, "SELECT '\\x00ff'::bytea AS b, ARRAY['\\x01'::bytea] AS bs", Plain))
      postgres.close(db)
    }
    Err(e) -> println("connect: {e.message()}")
  }
}
