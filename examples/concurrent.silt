import channel
import task

fn main() {
  let ch = channel.new(10)
  -- Two pieces run together: a producer that sends messages and then
  -- closes the channel, and a consumer that receives them.
  -- task.join returns when both have returned.
  task.join(
    [
      { ->
        channel.send(ch, "hello")
        channel.send(ch, "from")
        channel.send(ch, "silt")
        channel.close(ch)
      },
      { ->
        when let Some(msg1) = channel.receive(ch) else {
          return
        }
        when let Some(msg2) = channel.receive(ch) else {
          return
        }
        when let Some(msg3) = channel.receive(ch) else {
          return
        }
        println("{msg1} {msg2} {msg3}")
      },
    ],
  )
  -- Fan-out and fan-in: task.map runs the workers together and gives
  -- their values in the order of the list
  let results = task.map([1, 2, 3], 3) { id -> id * 10 }
  println("Worker results: {results}")
  -- First answer wins: task.first_ok gives the first Ok and stops the rest
  let found = task.first_ok([{ -> Err("mirror a is down") }, { -> Ok("mirror b") }])
  println("Fetched from: {found}")
  -- Select: wait on multiple channels, match which one fired with ^pin
  let urgent = channel.new(5)
  let normal = channel.new(5)
  channel.send(normal, "background task done")
  channel.send(urgent, "alert!")
  -- channel.select returns Received(channel, Some(value) or None) or Sent(channel); ^pin identifies which channel
  match channel.select([channel.Recv(urgent), channel.Recv(normal)]) {
    channel.Received(^urgent, Some(msg)) -> println("Urgent: {msg}")
    channel.Received(^normal, Some(msg)) -> println("Normal: {msg}")
    channel.Received(_, None) -> println("Channel closed")
    _ -> println("No message")
  }
}
