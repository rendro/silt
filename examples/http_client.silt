import bytes
import http
import json
import list
import string
import url

-- Fetch GitHub repos for a user and display the top 5 by stars.

type Repo {
  name: String,
  description: String,
  stargazers_count: Int,
  language: String,
}

fn fetch_repos(user) {
  -- url.parse and url.add_segments return UrlError, http.get
  -- HttpError, bytes.to_string BytesError and json.parse JsonError.
  -- Fold them into a single `String` channel via `"{e}"` so fetch_repos
  -- surfaces one uniform error type to its caller.
  let users = match url.parse("https://api.github.com/users") {
    Ok(u) -> u
    Err(e) -> return Err("{e}")
  }
  -- The user's name is one segment, escaped: a name with `/` or `?` in it
  -- asks for no other resource.
  let repos = match url.add_segments(users, [user, "repos"]) {
    Ok(u) -> u
    Err(e) -> return Err("{e}")
  }
  let resp = match http.get(repos) {
    Ok(r) -> r
    Err(e) -> return Err("{e}")
  }
  -- The body is the bytes that arrived; JSON is text.
  let text = match bytes.to_string(resp.body) {
    Ok(text) -> text
    Err(e) -> return Err("{e}")
  }
  match json.parse(text, List(Repo)) {
    Ok(repos) -> Ok(repos)
    Err(e) -> Err("{e}")
  }
}

fn main() {
  match fetch_repos("torvalds") {
    Ok(repos) -> {
      println("Top repos by stars:\n")
      repos
        |> list.sort_by { r -> -r.stargazers_count }
        |> list.take(5)
        |> list.each { r ->
          let lang = match string.is_empty(r.language) {
            true -> "n/a"
            false -> r.language
          }
          println("  {r.name} ({lang}): {r.stargazers_count} stars")
        }
    }
    Err(e) -> println("Error: {e}")
  }
}
