import list
import map
import regex
import string

-- URL router/dispatcher that matches HTTP requests against route patterns,
-- extracts path parameters, and dispatches to handler closures.
-- Compiled pattern info: the regex and the list of param names
type CompiledPattern {
  re: regex.Regex,
  params: List(String),
}

-- A route definition with handler closure stored directly in the record,
-- and its pattern compiled once, where the route is made
type Route {
  method: String,
  pattern: String,
  handler: Fn(Map(String, String)) -> String,
  compiled: CompiledPattern,
}

-- A request to test
type Request {
  method: String,
  path: String,
}

-- Convert a route pattern like "/users/:id/posts/:post_id" into a regex
-- and extract param names.
fn pattern_to_regex(pattern) -> Result(CompiledPattern, regex.RegexError) {
  let segments = pattern |> string.split("/")
  let (source, params) = segments
    |> list.fold(("^", [])) { acc, seg ->
      let (source, params) = acc
      match {
        string.is_empty(seg) -> acc
        string.starts_with(seg, ":") -> {
          let param_name = string.slice(seg, 1, string.length(seg))
          ("{source}/([^/]+)", list.append(params, param_name))
        }
        _ -> ("{source}/{regex.escape(seg)}", params)
      }
    }
  let re = regex.compile("{source}$")?
  Ok(CompiledPattern { re: re, params: params })
}

-- A route, its pattern compiled.
fn route(method, pattern, handler) -> Result(Route, regex.RegexError) {
  let compiled = pattern_to_regex(pattern)?
  Ok(Route { method: method, pattern: pattern, handler: handler, compiled: compiled })
}

-- Extract path parameters from a URL path given a compiled route pattern.
-- Returns Some(map) with extracted params or None if no match.
fn extract_params(compiled, path) {
  match regex.captures(path, compiled.re) {
    None -> None
    Some(captures) -> {
      -- captures[0] is the full match, captures[1..] are the groups
      let groups = captures |> list.drop(1)
      let pairs = list.zip(compiled.params, groups)
      let params = pairs
        |> list.fold(#{}) { acc, pair ->
          match pair {
            (name, value) -> map.set(acc, name, value)
          }
        }
      Some(params)
    }
  }
}

-- Match a request method and path against a list of routes.
fn match_route(method, path, routes) {
  routes
    |> list.find { route ->
      match {
        route.method != method -> false
        _ -> regex.is_match(path, route.compiled.re)
      }
    }
}

-- Handler factory: returns a closure that formats handler output with params
fn make_handler(name) {
  { params ->
    let param_str = map.entries(params)
      |> list.map { entry ->
        match entry {
          (k, v) -> "{k}={v}"
        }
      }
      |> string.join(", ")
    match string.is_empty(param_str) {
      true -> "{name}()"
      _ -> "{name}({param_str})"
    }
  }
}

fn main() -> Result((), regex.RegexError) {
  -- Define routes with handler closures stored directly in Route records
  let routes = [
    route("GET", "/users", make_handler("list_users"))?,
    route("GET", "/users/:id", make_handler("get_user"))?,
    route("POST", "/users", make_handler("create_user"))?,
    route("PUT", "/users/:id", make_handler("update_user"))?,
    route("DELETE", "/users/:id", make_handler("delete_user"))?,
    route("GET", "/posts", make_handler("list_posts"))?,
    route("GET", "/posts/:id", make_handler("get_post"))?,
    route("GET", "/posts/:id/comments", make_handler("list_comments"))?,
    route("POST", "/posts/:id/comments", make_handler("create_comment"))?,
    route("GET", "/posts/:post_id/comments/:comment_id", make_handler("get_comment"))?,
    route("GET", "/categories/:cat_id/items/:item_id", make_handler("get_cat_item"))?,
  ]
  -- Test requests
  let requests = [
    Request { method: "GET", path: "/users" },
    Request { method: "GET", path: "/users/42" },
    Request { method: "POST", path: "/users" },
    Request { method: "PUT", path: "/users/7" },
    Request { method: "DELETE", path: "/users/99" },
    Request { method: "GET", path: "/posts" },
    Request { method: "GET", path: "/posts/5" },
    Request { method: "GET", path: "/posts/5/comments" },
    Request { method: "POST", path: "/posts/12/comments" },
    Request { method: "GET", path: "/posts/3/comments/77" },
    Request { method: "GET", path: "/categories/electronics/items/laptop-1" },
    Request { method: "GET", path: "/nonexistent" },
    Request { method: "PATCH", path: "/users/1" },
  ]
  println("=== URL Router Demo ===\n")
  requests
    |> list.each { req ->
      println("Request: {req.method} {req.path}")
      match match_route(req.method, req.path, routes) {
        None -> println("  => 404 Not Found\n")
        Some(route) -> {
          -- Extract parameters
          let params = match extract_params(route.compiled, req.path) {
            Some(p) -> p
            None -> #{}
          }
          -- Display match info
          println("  => Matched: {route.pattern}")
          -- Show extracted params using map.entries
          let entries = map.entries(params)
          match list.length(entries) {
            0 -> println("  => Params: (none)")
            _ -> {
              let param_parts = entries
                |> list.map { entry ->
                  match entry {
                    (k, v) -> "{k}={v}"
                  }
                }
              println("  => Params: {string.join(param_parts, ", ")}")
            }
          }
          -- Invoke handler closure directly from the route record
          let output = route.handler(params)
          println("  => Handler result: {output}")
          println("")
        }
      }
    }
  -- Demonstrate route table display using string.split
  println("=== Route Table ===")
  routes
    |> list.each { route ->
      let segments = route.pattern |> string.split("/") |> list.filter { s -> !string.is_empty(s) }
      let depth = list.length(segments)
      println("  {string.left(route.method, 7)} {string.left(route.pattern, 45)} (depth: {depth})")
    }
  Ok(())
}
